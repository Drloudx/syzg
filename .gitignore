# 依赖缓存
node_modules/
node_modules/**/build/
node_modules/.vite/

# 前端打包产物
dist/

# Android原生编译缓存
android/**/build/
android/.gradle/
android/gradle/wrapper/
android/app/build/

# 备份、临时文件
android_backup/
*.log
.DS_Store

# Vite缓存
.vite/

# Python相关
# 所有__pycache__编译缓存文件夹（各个子目录包括测试工具里面的都忽略）
__pycache__/
# pyc/pyo/pyd 编译字节码文件
*.py[cod]
*$py.class
# Python虚拟环境
.venv/
venv/
# pytest等工具缓存
.pytest_cache/
.coverage

# Playwright 测试产物
test-results/
playwright-report/

# 测试工具（一次性资源提取脚本，不进应用/构建）
测试工具/

# 一次性排查/探针脚本与残留（dev only）
test-monsters.js
test-*.mjs
probe-*.mjs
verify-*.mjs
shot-*.mjs
trace-*.mjs
repro-*.mjs
scripts/dev/scratch/
scratch/
.html
.tools/

# 未使用的重复地图资源
/map_w1_bg.png
/public/ui/test_map_w1_bg.png

# 原始素材全部构建产物，不进repo/构建产物，请看 scripts/dev/sync-raw.mjs 从Config_decrypted读取
/raw/
