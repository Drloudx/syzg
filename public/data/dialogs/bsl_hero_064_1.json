    },
    {
      "para": {
        "charaName": "伽拉忒亚",
        "text": "[show]以前我的脑海里只有知识和文献，现在我想记录下这个世界的鸟语花香，记录下属于我们的回忆。[l][cm]",
        "nameSide": "left"
