      "key": "text"
    },
    {
      "para": {
        "charaName": "伽拉忒亚",
        "text": "[show]在这里的感觉和大书院完全不一样，没有那么多沉重的文件，只有很亲切的大自然。[l][cm]",
        "nameSide": "left"
