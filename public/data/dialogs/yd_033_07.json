chara2","img":"chara033_1_face_chara033_1d"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"乌帕","text":"[show]咳咳……不管怎样，{myName}觉得我的耳朵可爱什么的……我很开心。[l][cm]"},"key":"text"},{"para":{"tag":"tag_7"},"key":"tag"},{"para":{"layer":"chara2","img":"chara033_1_face_chara033_1b"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"乌帕","text":"[show]你问能不能摸摸？当……当当当当然不——唔，好吧，那只能一下下哦！[l][cm]"},"key":"text"}],"des":"乌帕-亲密1","script":"yd_033_07"}