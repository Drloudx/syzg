{"script":"yd_025_06","exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"scaleX":1.5,"addImg":"","layer":"bg","noOut":false,"x":-500,"scaleY":1.5,"trans":true,"bright":1,"y":-125,"img":"bgblack"},"key":"setLayer"},{"para":{"noIn":false,"mirrow":false,"alpha":0.4,"scaleX":1.5,"addImg":"","layer":"bg","noOut":false,"x":-500,"transTime":300,"scaleY":1.5,"trans":true,"bright":1,"y":-125,"img":"bgblack"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"scaleX":1,"addImg":"chara025_1_face_chara025_1b","layer":"chara2","noOut":false,"x":165,"scaleY":1,"trans":true,"bright":1,"y":-272,"img":"chara025_1"},"key":"setLayer"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara025_1_face_chara025_1b","layer":"chara2","noOut":false,"x":165,"transTime":300,"scaleY":1,"trans":true,"bright":1,"y":-272,"img":"chara025_1"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"嘉莉缇","text":"[show]嘿嘿～我突然心血来潮，想在这里试试我的厨艺！[l][cm]"},"key":"text"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"img":"chara025_1_face_chara025_1a","layer":"chara2"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"嘉莉缇","text":"[show]身为黑森林的“宴会大师”，我的厨艺虽然比不上露比特那样的大厨，但要准备一桌好菜是完全没问题的。[l][cm]"},"key":"text"},{"para":{"tag":"tag_4"},"key":"tag"},{"para":{"nameSide":"left","charaName":"嘉莉缇","text":"[show]你想要吃什么？炒松茸？炖松茸？蒸松茸？又或者是……凉拌松茸？[l][cm]"},"key":"text"},{"para":{"tag":"tag_5"},"key":"tag"},{"para":{"img":"chara025_1_face_chara025_1c","layer":"chara2"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"嘉莉缇","text":"[show]你问为什么都是松茸？那当然是因为我唯一拿手，而且确认过好吃的食材，就只有松茸了～[l][cm]"},"key":"text"},{"para":{"tag":"tag_6"},"key":"tag"},{"para":{"img":"chara025_1_face_chara025_1b","layer":"chara2"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"嘉莉缇","text":"[show]不过现在既然暂时离开了森林，我也该试试其他食材了……那你能来教教我吗？[l][cm]"},"key":"text"}],"des":"嘉莉缇-熟识3"}