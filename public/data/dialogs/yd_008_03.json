xt"},{"para":{"tag":"tag_7"},"key":"tag"},{"para":{"layer":"chara2","img":"chara008_1_face_chara008_1b"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"夏库塔拉","text":"[show]不过当时咱也没有选择，毕竟那是晃荡了几个月后，唯一能找到的谋生手段了……[l][cm]"},"key":"text"}],"des":"夏库塔拉-友善3","script":"yd_008_03"}