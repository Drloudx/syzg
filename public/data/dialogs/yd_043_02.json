{"exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"alpha":0,"scaleX":1,"trans":true,"layer":"chara2","noOut":false,"noIn":false,"bright":1,"scaleY":1,"x":350,"mirrow":false,"y":-119,"img":"chara043_1","addImg":"chara043_1_face_chara043_1b"},"key":"setLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara2","noOut":false,"noIn":false,"bright":1,"transTime":300,"scaleY":1,"x":350,"mirrow":false,"y":-119,"img":"chara043_1","addImg":"chara043_1_face_chara043_1b"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]{myName}！我今天又搞定了好几个大单子呢～我厉害吧？[l][cm]"},"key":"text"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]要我说，你天天呆在这营地里啊，早晚坐吃山空。要不要我教教你怎么做出最有卖相的药水，准备准备扩张大业啊。放心，就收点咨询费而已，要不了几个钱啦。[l][cm]"},"key":"text"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"layer":"chara2","img":"chara043_1_face_chara043_1c"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]唉？不要？不是，真不要啊？别呀，来听听看嘛，前十五分钟不收费就是了——[l][cm]"},"key":"text"}],"script":"yd_043_02","des":"阿娜洛洁-2"}