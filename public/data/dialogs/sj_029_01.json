9_1e","layer":"chara2"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"安娜","text":"[show]哎呀，说我只是想蹭吃蹭喝？说什么呢。我怎么会呢～？[l][cm][hide]"},"key":"text"},{"para":{"tag":"tag_9"},"key":"tag"},{"para":{"alpha":0,"bright":1,"layer":"chara2","img":"chara029_1","mirrow":false,"transTime":300,"x":290,"trans":true,"y":-258,"noOut":false,"scaleX":1,"addImg":"chara029_1_face_chara029_1e","noIn":false,"scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"","text":"[hide]"},"key":"text"},{"para":{"end":true},"key":"end"}],"des":"安娜-对我们的营地感觉如何？"}