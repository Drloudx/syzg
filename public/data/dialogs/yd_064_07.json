      "key": "text"
    },
    {
      "para": {
        "nameSide": "left",
        "charaName": "伽拉忒亚",
        "text": "[show]不过，想着你的时候的感觉，和想着妈妈、还有奇瓦姐姐的时候，似乎有些不同……[l][cm]"
