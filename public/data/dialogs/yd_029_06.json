{"exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"alpha":0,"scaleX":1.5,"trans":true,"layer":"bg","bright":1,"mirrow":false,"noIn":false,"x":-500,"y":-125,"img":"bgblack","addImg":"","noOut":false,"scaleY":1.5},"key":"setLayer"},{"para":{"alpha":0.4,"scaleX":1.5,"trans":true,"layer":"bg","bright":1,"transTime":300,"mirrow":false,"noIn":false,"x":-500,"y":-125,"img":"bgblack","addImg":"","noOut":false,"scaleY":1.5},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"alpha":0,"scaleX":1,"trans":true,"layer":"chara2","bright":1,"mirrow":false,"noIn":false,"x":290,"y":-259,"img":"chara029_1","addImg":"chara029_1_face_chara029_1d","noOut":false,"scaleY":1},"key":"setLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara2","bright":1,"transTime":300,"mirrow":false,"noIn":false,"x":290,"y":-259,"img":"chara029_1","addImg":"chara029_1_face_chara029_1d","noOut":false,"scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"安娜","text":"[show]在我很小的时候，父母就因灾难去世了，我被一位大书院的老贤者抚养长大。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"charaName":"安娜","text":"[show]老贤者工作很忙，我的童年记忆大多是独自度过的。[r]为了不让我对着墙壁自言自语，老贤者给了我一把阿德鲁琴作为消遣。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_4"},"key":"tag"},{"para":{"layer":"chara2","img":"chara029_1_face_chara029_1b"},"key":"setLayerFace"},{"para":{"charaName":"安娜","text":"[show]然后我就爱上了弹琴，即使老贤者过世后，我也一直保持这个习惯。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_5"},"key":"tag"},{"para":{"charaName":"安娜","text":"[show]弹了这么多年……我在这方面也算有些造诣了，偶尔还会有学音乐的学者来交流呢。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_6"},"key":"tag"},{"para":{"layer":"chara2","img":"chara029_1_face_chara029_1h"},"key":"setLayerFace"},{"para":{"charaName":"安娜","text":"[show]那么……一曲意迷离，天涯何处觅知音。[r]就把这首我原创的乐曲献给你这位难得的知音吧……[l][cm]","nameSide":"left"},"key":"text"}],"script":"yd_029_06","des":"安娜-熟识3"}