    {
      "para": {
        "nameSide": "left",
        "charaName": "夏库塔拉",
        "text": "[show]安排训练时间、调整舞蹈表演、和比绍沟通，这些都是由她负责的。[l][cm]"
      },
      "key": "text"
    },
    {
      "para": {
        "nameSide": "left",
        "charaName": "夏库塔拉",
        "text": "[show]咱舞团今天能取得这样的成就，拉碧丝绝对功不可没。[l][cm]"
