{"exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"alpha":0,"scaleX":1,"trans":true,"layer":"chara2","noOut":false,"noIn":false,"bright":1,"y":-263,"x":260,"mirrow":false,"scaleY":1,"img":"chara008_1","addImg":"chara008_1_face_chara008_1f"},"key":"setLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara2","noOut":false,"noIn":false,"bright":1,"transTime":300,"y":-263,"x":260,"mirrow":false,"scaleY":1,"img":"chara008_1","addImg":"chara008_1_face_chara008_1f"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"夏库塔拉","text":"[show]咱们舞团的大姐头拉碧丝……虽然她看起来很威风，但她绝对是咱舞团压力最大的人。[l][cm]"},"key":"text"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"nameSide":"left","charaName":"夏库塔拉","text":"[show]安排训练时间、调整舞蹈表演、和比绍沟通，这些都是由她负责的。[l][cm]"},"key":"text"},{"para":{"tag":"tag_4"},"key":"tag"},{"para":{"img":"chara008_1_face_chara008_1b","layer":"chara2"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"夏库塔拉","text":"[show]咱舞团今天能取得这样的成就，拉碧丝绝对功不可没。[l][cm]"},"key":"text"},{"para":{"tag":"tag_5"},"key":"tag"},{"para":{"nameSide":"left","charaName":"夏库塔拉","text":"[show]而且她虽然表面上很严厉，但咱心里清楚她其实是个很温柔的人啦。[l][cm]"},"key":"text"},{"para":{"tag":"tag_6"},"key":"tag"},{"para":{"img":"chara008_1_face_chara008_1d","layer":"chara2"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"夏库塔拉","text":"[show]不过咱刚才的话你可不要跟拉碧丝说哦，不然她得给我加练了……[l][cm]"},"key":"text"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"alpha":0,"scaleX":1,"trans":true,"layer":"chara2","noOut":false,"noIn":false,"bright":1,"transTime":300,"y":-263,"x":260,"mirrow":false,"scaleY":1,"img":"chara008_1","addImg":"chara008_1_face_chara008_1d"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"end":true},"key":"end"}],"script":"yd_008_08-备份","des":"夏库塔拉-08"}