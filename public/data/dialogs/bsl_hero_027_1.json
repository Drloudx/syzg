    {
      "para": {
        "charaName": "梅莉莉",
        "text": "[show]今后我会让这个营地变得更好的，让你好好见识一下侍者领班的实力。[l][cm]",
        "nameSide": "left"
      },
      "key": "text"
    },
    {
      "para": {
        "charaName": "梅莉莉",
