        "nameSide": "left"
      },
      "key": "text"
    },
    {
      "para": {
        "charaName": "梅莉莉",
        "text": "[show]来，这是我作为领班的一点心意，这不是什么贵重的宝物，希望你能喜欢。[l][cm]",
        "nameSide": "left"
      },
      "key": "text"
