{
  "script": "sj_012_01",
  "des": "沃夫加-（对我们的营地感觉如何？）",
  "exps": [
    {
      "para": {
        "nameSide": "left",
        "charaName": "沃夫加",
        "text": "[show]让我来回答这个问题嘛……[l][cm]"
      },
      "key": "text"
    },
    {
      "para": {
        "nameSide": "left",
        "charaName": "沃夫加",
        "text": "[show]对一个常年在猎场风餐露宿的荒野客来说，拥有一个如此规模的营地已可谓是极尽奢侈。[l][cm]"
      },
      "key": "text"
    },
    {
      "para": {
        "nameSide": "left",
        "charaName": "沃夫加",
        "text": "[show]不过对我来说，可能这里还有些住不太惯呢。[l][cm]"
      },
      "key": "text"
    },
    {
      "para": {
        "nameSide": "left",
        "charaName": "沃夫加",
        "text": "[show]毕竟猎物并非总是呆在同一个地方。猎物如果逃离猎场，猎者的使命便是追逐它们。[l][cm]"
      },
      "key": "text"
    },
    {
      "para": {
        "nameSide": "left",
        "charaName": "沃夫加",
        "text": "[show]这么豪华的营地，可不好说搬就搬吧？哈哈哈。[l][cm]"
      },
      "key": "text"
    }
  ]
}