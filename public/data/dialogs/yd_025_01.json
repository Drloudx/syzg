      "key": "text"
    },
    {
      "para": {
        "nameSide": "left",
        "charaName": "嘉莉缇",
        "text": "[show]人也是一样的，我们或许会遇到困境，但只要坚持下来，就能走出阴霾，找到更幸福的生活～！[l][cm][hide]"
