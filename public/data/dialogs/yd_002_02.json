LayerFace"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]哎？你想造一间大房子，这样就更舒服了——好像也不错哦！[l][cm]"},"key":"text"}],"des":"米托拉-友善2","script":"yd_002_02"}