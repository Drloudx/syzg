{"exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"alpha":0,"scaleX":1.5,"trans":true,"layer":"bg","noOut":false,"noIn":false,"bright":1,"scaleY":1.5,"x":-500,"mirrow":false,"y":-125,"img":"bgblack","addImg":""},"key":"setLayer"},{"para":{"alpha":0.4,"scaleX":1.5,"trans":true,"layer":"bg","noOut":false,"noIn":false,"bright":1,"transTime":300,"scaleY":1.5,"x":-500,"mirrow":false,"y":-125,"img":"bgblack","addImg":""},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"alpha":0,"scaleX":1,"trans":true,"layer":"chara2","noOut":false,"noIn":false,"bright":1,"scaleY":1,"x":220,"mirrow":false,"y":-154,"img":"chara045_1","addImg":"chara045_1_face_chara045_1b"},"key":"setLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara2","noOut":false,"noIn":false,"bright":1,"transTime":300,"scaleY":1,"x":220,"mirrow":false,"y":-154,"img":"chara045_1","addImg":"chara045_1_face_chara045_1b"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"艾尔菲帕","text":"[show]嘿……嘿……嘿……[l][cm]"},"key":"text"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"nameSide":"left","charaName":"艾尔菲帕","text":"[show]你问我为什么在这里摇晃身体？这是我从书上学来的，叫做“鸟鸟健身操”。[l][cm]"},"key":"text"},{"para":{"tag":"tag_4"},"key":"tag"},{"para":{"nameSide":"left","charaName":"艾尔菲帕","text":"[show]书上说我这种久坐久站的人，就要这样摇摆身体……我做了几次，也觉得挺舒服的，所以就在继续啦。只要没事干的时候就这样摇一摇。[l][cm]"},"key":"text"},{"para":{"tag":"tag_5"},"key":"tag"},{"para":{"layer":"chara2","img":"chara045_1_face_chara045_1c"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"艾尔菲帕","text":"[show]你让我再来一遍？那可不行，你把我当成驿站旅店的舞娘了吗？[l][cm]"},"key":"text"},{"para":{"tag":"tag_6"},"key":"tag"},{"para":{"layer":"chara2","img":"chara045_1_face_chara045_1b"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"艾尔菲帕","text":"[show]不过……你好像也是久坐久站的人士耶。[r]要是你也想学的话，我给你示范几遍，倒也没问题哦？[l][cm]"},"key":"text"}],"des":"艾尔菲帕-熟识1","script":"yd_045_04"}