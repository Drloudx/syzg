{
  "script": "yd_036_06",
  "des": "贝尔卡-祈祷",
  "exps": [
    {
      "para": {
        "nameSide": "left",
        "charaName": "贝尔卡",
        "text": "[show]你起来啦？这么早？你每天都这个时候起来吗？[l][cm]"
      },
      "key": "text"
    },
    {
      "para": {
        "nameSide": "left",
        "charaName": "贝尔卡",
        "text": "[show]其实我也差不多是这个时候起床，不过并不是要晨练，而是祈祷。[l][cm]"
      },
      "key": "text"
    },
    {
      "para": {
        "nameSide": "left",
        "charaName": "贝尔卡",
        "text": "[show]毕竟和战士不一样，我们水占师的力量并不来自于身体，而是来自信仰和内心的调和。[l][cm]"
      },
      "key": "text"
    },
    {
      "para": {
        "nameSide": "left",
        "charaName": "贝尔卡",
        "text": "[show]祈祷不仅是在向神奉献，也是认清自己的过程。你有兴趣和我一起吗？[l][cm]"
      },
      "key": "text"
    }
  ]
}