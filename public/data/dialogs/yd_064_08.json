      "key": "text"
    },
    {
      "para": {
        "nameSide": "left",
        "charaName": "伽拉忒亚",
        "text": "[show]每天运算六小时……大概317年后，我就能够成为全能超人啦！[l][cm]"
      },
      "key": "text"
