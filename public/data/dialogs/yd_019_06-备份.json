      "key": "text"
    },
    {
      "para": {
        "nameSide": "left",
        "charaName": "奇瓦",
        "text": "[show]不过我觉得，你们这里似乎缺少了点什么……对，就是缺少了魔法方面的抵御措施！[l][cm]"
