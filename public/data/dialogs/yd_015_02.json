{"script":"yd_015_02","exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"scaleX":1,"addImg":"chara015_2_face_chara015_1a","layer":"chara2","noOut":false,"x":-120,"scaleY":1,"trans":true,"bright":1,"y":-474,"img":"chara015_2"},"key":"setLayer"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara015_2_face_chara015_1a","layer":"chara2","noOut":false,"x":-120,"transTime":300,"scaleY":1,"trans":true,"bright":1,"y":-474,"img":"chara015_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"芭杜尔","text":"[show]问我的饮食习惯，好为我准备餐食？[r]倒不必特意考虑我，而且，我们森林人的食谱和你们并无不同。[l][cm]"},"key":"text"},{"para":{"tag":"tag_5"},"key":"tag"},{"para":{"img":"chara015_2_face_chara015_1e","layer":"chara2"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"芭杜尔","text":"[show]除非本身就是草食类的魔人，否则想要维持身体机能，各种各样的营养都是必不可少的。[l][cm]"},"key":"text"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"img":"chara015_2_face_chara015_1a","layer":"chara2"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"芭杜尔","text":"[show]不过，在金弦之厅的文化中，我们一般不进行多余的捕猎，只捕到足够衣食的分量就够了。你可能很少看到我们吃肉食，有了不一样的印象。[l][cm]"},"key":"text"},{"para":{"tag":"tag_4"},"key":"tag"},{"para":{"img":"chara015_2_face_chara015_1b","layer":"chara2"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"芭杜尔","text":"[show]况且，这儿也不是黑森林。[r]所以请不用顾虑，我和大家都一样。[l][cm][hide]"},"key":"text"},{"para":{"tag":"tag_6"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"scaleX":1,"addImg":"chara015_2_face_chara015_1b","layer":"chara2","noOut":false,"x":-120,"transTime":300,"scaleY":1,"trans":true,"bright":1,"y":-474,"img":"chara015_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"end":true},"key":"end"}],"des":"芭杜尔-友善2"}