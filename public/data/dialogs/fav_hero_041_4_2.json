_chara041_1a","noIn":false,"x":276,"img":"chara041_1","scaleY":1,"bright":0.6,"layer":"chara2","y":-325,"mirrow":false},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"text":"埃迪蒂的形象很重要！","tag":"tag_53"},{"text":"无论大家怎么误解埃迪蒂，我都会站在你这边的。","tag":"tag_53"}]},"key":"option"},{"para":{"tag":"tag_53"},"key":"tag"},{"para":{"img":"chara041_1_face_chara041_1d","layer":"chara2"},"key":"setLayerFace"},{"para":{"transTime":300,"alpha":1,"scaleX":1,"trans":true,"noOut":false,"addImg":"chara041_1_face_chara041_1d","noIn":false,"x":276,"img":"chara041_1","scaleY":1,"bright":1,"layer":"chara2","y":-325,"mirrow":false},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"text":"[cm][show]{myName}……[l][cm]","charaName":"埃迪蒂","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_54"},"key":"tag"},{"para":{"img":"chara041_1_face_chara041_1e","layer":"chara2"},"key":"setLayerFace"},{"para":{"text":"[show]谢谢你，有你的支持，我很欣慰。[l][cm]","charaName":"埃迪蒂","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_55"},"key":"tag"},{"para":{"text":"[show]顺便告诉你一个好消息吧，刚刚的战斗中……我感觉自己终于突破了。我在这一分钟的战斗挥剑的次数已经超越150次了。[l]","charaName":"埃迪蒂","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_56"},"key":"tag"},{"para":{"transTime":300,"alpha":1,"scaleX":1,"trans":true,"noOut":false,"addImg":"chara041_1_face_chara041_1e","noIn":false,"x":276,"img":"chara041_1","scaleY":1,"bright":0.6,"layer":"chara2","y":-325,"mirrow":false},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"text":"恭喜突破！","tag":"tag_57"}]},"key":"option"},{"para":{"tag":"tag_57"},"key":"tag"},{"para":{"transTime":300,"alpha":1,"scaleX":1,"trans":true,"noOut":false,"addImg":"chara041_1_face_chara041_1e","noIn":false,"x":276,"img":"chara041_1","scaleY":1,"bright":1,"layer":"chara2","y":-325,"mirrow":false},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"text":"[cm][show]在休息过后，我的思绪不再像之前那么杂乱，剑法也比之前有序了许多。原来我实力无法取得进展，真的只是因为我太累了。[l][cm]","charaName":"埃迪蒂","nameSide":"left"},"ke