{"id":"wt_c2_03","name":"珍贵的装饰鸟羽！","des":"巴诺姆村的“皮匠”埃达需要一些更艳丽的鸟羽装饰他制作的皮甲，好送给他的梦中情人希瑟老师。","des2":"希瑟老师在巴诺姆村工作了这么久，我很想送她一件礼物作为感谢。但我一个普通的皮匠也想不出什么珍贵的礼物，只好打造一件皮甲送给她。不过听说希瑟老师这\r样的知识分子会喜欢一些艳丽珍贵的东西，所以我打算给皮甲加上一些鸟羽作为装饰，我想她一定会喜欢的！请尽快帮我狩猎几只哈比类魔物吧，我已经迫不及待地想要看见希瑟老师收下礼物的样子了。","type":3,"typeLabel":"委托","typeOrder":2,"subRaw":"C2","subLabel":"索利德山地","subKey":"C2","close":false,"reward":{"entries":[{"kind":"money","name":"银币","count":700,"rawMin":700,"rawMax":700,"min":700,"max":700,"countMin":700,"countMax":700,"typeId":"item_00001","icon":"/images/Common_ItemIcon/item_00001.webp","quality":5,"groupIndex":0,"groupRate":1,"groupCount":1,"actualProb":1,"cumulativeProb":1},{"kind":"item","name":"山地纪念币","count":7,"rawMin":7,"rawMax":7,"min":7,"max":7,"countMin":7,"countMax":7,"typeId":"item_29102","icon":"/Common_ItemIcon/item_29102.webp","quality":4,"groupIndex":1,"groupRate":1,"groupCount":1,"actualProb":1,"cumulativeProb":1},{"kind":"item","name":"鸟羽","count":4,"rawMin":4,"rawMax":4,"min":4,"max":4,"countMin":4,"countMax":4,"typeId":"item_10048","icon":"/Common_ItemIcon/item_10048.webp","quality":1,"groupIndex":2,"groupRate":1,"groupCount":1,"actualProb":1,"cumulativeProb":1}],"text":[]},"startLocation":"2-7 天梯之下","startNpc":{"name":"“皮匠”埃达","id":"cart_at_npc_ad"},"getTask":{"npc":{"name":"“皮匠”埃达","id":"cart_at_npc_ad","line":"","kind":"cart"},"title":"“皮匠”埃达","dialog":{"raw":"狩猎 5 只哈比类魔物。","isText":true,"name":""},"condition":"完成《蔓晶采石场》"},"predecessorTasks":[{"id":"m_2_6","name":"蔓晶采石场","type":"condition"}],"addTasks":[],"unlockTasks":[],"unlockStages":[],"steps":[{"index":1,"name":"狩猎 5 只哈比类魔物。","des":"巴诺姆村的“皮匠”埃达需要一些更艳丽的鸟羽装饰他制作的皮甲，好送给他的梦中情人希瑟老师。","type":"hunter","typeName":"狩猎怪物","reward":{"entries":[],"text":[]},"unlockStages":[],"unlockSuppressed":false,"detail":[{"label":"数量","value":"5 只"},{"label":"关卡","value":"2-7 天梯之下"}],"dialogs":[],"monsters":[{"id":"053","name":"哈比狂怒者","icon":"colect_mon_053","hasMonsterDetail":true},{"id":"054","name":"哈比巢母","icon":"colect_mon_054","hasM