{"id":"wt_c4_06","name":"宴席上的美味","des":"金弦之厅的梅尔科卡为了制作宴席菜肴，需要一些黑森林松茸干。","des2":"黑森林松茸是我们黑森林的特产，而经风干制成的松茸干更是美味绝伦。在下一场宴席上，我会亲自为各位展示松茸干烹饪的奥妙，只是松茸干的储备不太够用了。往常这种食材我都是亲自去拣摘的，但我已年老力衰，外面似乎也不太平。能否帮我这个老太婆带一些松茸干回来？我定会在宴会上让你们大饱口福。","type":3,"typeLabel":"委托","typeOrder":2,"subRaw":"C4","subLabel":"黑森林","subKey":"C4","close":false,"reward":{"entries":[{"kind":"money","name":"银币","count":700,"rawMin":700,"rawMax":700,"min":700,"max":700,"countMin":700,"countMax":700,"typeId":"item_00001","icon":"/images/Common_ItemIcon/item_00001.webp","quality":5,"groupIndex":0,"groupRate":1,"groupCount":1,"actualProb":1,"cumulativeProb":1},{"kind":"item","name":"黑森林纪念币","count":7,"rawMin":7,"rawMax":7,"min":7,"max":7,"countMin":7,"countMax":7,"typeId":"item_29104","icon":"/Common_ItemIcon/item_29104.webp","quality":4,"groupIndex":1,"groupRate":1,"groupCount":1,"actualProb":1,"cumulativeProb":1},{"kind":"item","name":"松茸鲜汤","count":1,"rawMin":1,"rawMax":1,"min":1,"max":1,"countMin":1,"countMax":1,"typeId":"item_30049","icon":"/Common_ItemIcon/item_30049.webp","quality":3,"groupIndex":2,"groupRate":1,"groupCount":1,"actualProb":1,"cumulativeProb":1}],"text":[]},"startLocation":"住民区1（黑森林 > 金弦之厅）","startNpc":{"name":"布宴者梅尔科卡","id":"cart_at_npc_Melkorka"},"getTask":{"npc":{"name":"布宴者梅尔科卡","id":"cart_at_npc_Melkorka","line":"","kind":"cart"},"title":"布宴者梅尔科卡","dialog":{"raw":"提交 3 份黑森林松茸干。","isText":true,"name":""},"condition":"开启风车平野委托（完成主线《无妄之灾》）"},"predecessorTasks":[],"addTasks":[],"unlockTasks":[],"unlockStages":[],"steps":[{"index":1,"name":"提交 3 份黑森林松茸干。","des":"金弦之厅的梅尔科卡为了制作宴席菜肴，需要一些黑森林松茸干。","type":"getItemNpc","typeName":"提交道具给NPC","reward":{"entries":[],"text":[]},"unlockStages":[],"unlockSuppressed":false,"detail":[{"label":"说明","value":"提交后扣除道具"},{"label":"NPC","value":"布宴者梅尔科卡"},{"label":"房间","value":"住民区1（黑森林 > 金弦之厅）"},{"label":"交互对话","value":"（提交黑森林松茸干。）"}],"dialogs":[{"label":"不满足条件","meta":{"raw":"wt_c4_06_1_n","isText":false,"name":"宴席上的美味"}},{"label":"满足条件","meta":{"raw":"wt_c4_06_1