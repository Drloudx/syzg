{"id":"wt_c5_04","name":"莲花与药锅","des":"大书院新街的药化系学生赫尔薇希望你们能带点冰莲回来给她当制药素材。","des2":"哎呀，在我第一次踏上这片土地的时候，我就知道我能在这里找到新的药材。本地的生态与我的故乡黑森林完全不同，寒冷使得本地药材稀少却极富营养价值，比如冰莲就是这种不错的药材。我目前正在用冰莲制药，但冰莲的数量不太够了，药锅里的浓汤还在沸腾呢。契约者们，求求你们带点冰莲过来吧！","type":3,"typeLabel":"委托","typeOrder":2,"subRaw":"C5","subLabel":"霜烬平原","subKey":"C5","close":false,"reward":{"entries":[{"kind":"money","name":"银币","count":700,"rawMin":700,"rawMax":700,"min":700,"max":700,"countMin":700,"countMax":700,"typeId":"item_00001","icon":"/images/Common_ItemIcon/item_00001.webp","quality":5,"groupIndex":0,"groupRate":1,"groupCount":1,"actualProb":1,"cumulativeProb":1},{"kind":"item","name":"霜烬平原纪念币","count":7,"rawMin":7,"rawMax":7,"min":7,"max":7,"countMin":7,"countMax":7,"typeId":"item_29105","icon":"/Common_ItemIcon/item_29105.webp","quality":4,"groupIndex":1,"groupRate":1,"groupCount":1,"actualProb":1,"cumulativeProb":1},{"kind":"item","name":"冰莲种子","count":2,"rawMin":2,"rawMax":2,"min":2,"max":2,"countMin":2,"countMax":2,"typeId":"item_15021","icon":"/Common_ItemIcon/item_15021.webp","quality":2,"groupIndex":2,"groupRate":1,"groupCount":1,"actualProb":1,"cumulativeProb":1}],"text":[]},"startLocation":"大书院·新街（霜烬平原）","startNpc":{"name":"药化系学生赫尔薇","id":"cart_at_npc_Helvi"},"getTask":{"npc":{"name":"药化系学生赫尔薇","id":"cart_at_npc_Helvi","line":"","kind":"cart"},"title":"药化系学生赫尔薇","dialog":{"raw":"收集 2 份冰莲。","isText":true,"name":""},"condition":"开启永冻之渊委托（完成主线《向那皑皑雪原》）"},"predecessorTasks":[],"addTasks":[],"unlockTasks":[],"unlockStages":[],"steps":[{"index":1,"name":"收集 2 份冰莲，交给药化系学生赫尔薇。","des":"大书院新街的药化系学生赫尔薇希望你们能带点冰莲回来给她当制药素材。","type":"getItemNpc","typeName":"提交道具给NPC","reward":{"entries":[],"text":[]},"unlockStages":[],"unlockSuppressed":false,"detail":[{"label":"说明","value":"提交后扣除道具"},{"label":"NPC","value":"药化系学生赫尔薇"},{"label":"房间","value":"大书院·新街（霜烬平原）"},{"label":"交互对话","value":"（提交冰莲。）"}],"dialogs":[{"label":"不满足条件","meta":{"raw":"wt_c5_04_1_n","isText":false,"name":"收集 2 份冰莲，交给药化系学生赫尔薇。","missing":true}},{"label":"满足条件"