:1,"name":"唯我独尊","des":"米拉贝尔每次进入 {狂怒} 时，强大的气场会震晕并击退附近的敌人造成 {300%物理攻击} 加成的物理伤害，眩晕会持续 {3} 秒。","cost":10},{"level":2,"name":"唯我独尊","des":"米拉贝尔每次进入 {狂怒} 时，强大的气场会震晕并击退附近的敌人造成 {400%物理攻击} 加成的物理伤害，眩晕会持续 {3} 秒。","cost":5},{"level":3,"name":"唯我独尊","des":"米拉贝尔每次进入 {狂怒} 时，强大的气场会震晕并击退附近的敌人造成 {500%物理攻击} 加成的物理伤害，眩晕会持续 {3} 秒。","cost":5},{"level":4,"name":"唯我独尊","des":"米拉贝尔每次进入 {狂怒} 时，强大的气场会震晕并击退附近的敌人造成 {600%物理攻击} 加成的物理伤害，眩晕会持续 {3} 秒。","cost":5}],"maxLevel":4},{"key":"starSkill3","id":"05007","icon":"skill_05007","name":"明镜止水","levelData":[{"level":1,"name":"明镜止水","des":"米拉贝尔处于 {冷静} 状态时，每秒会获得 {5%} 最大生命值的回复效果。","cost":10},{"level":2,"name":"明镜止水","des":"米拉贝尔处于 {冷静} 状态时，每秒会获得 {6%} 最大生命值的回复效果。","cost":5},{"level":3,"name":"明镜止水","des":"米拉贝尔处于 {冷静} 状态时，每秒会获得 {7%} 最大生命值的回复效果。","cost":5},{"level":4,"name":"明镜止水","des":"米拉贝尔处于 {冷静} 状态时，每秒会获得 {8%} 最大生命值的回复效果。","cost":5}],"maxLevel":4},{"key":"starSkill4","id":"05008","icon":"skill_05008","name":"野性解放","levelData":[{"level":1,"name":"野性解放","des":"处于 {狂怒} 状态时，物理攻击提高 {30%}，且每次普通攻击都会向敌人突进。","cost":15}],"maxLevel":1}],"talentSkills":[{"id":"05004","icon":"skill_05004","name":"怒火燎天","levelData":[{"level":1,"name":"怒火燎天","des":"米拉贝尔的普通攻击每次命中积攒 {5} 点怒气，技能每次命中积攒 {15} 点怒气。怒气达到 {100} 时，进入持续 {10} 秒的 {狂怒} 状态：使自身物理攻击提高 {75%}，攻速和移速加成提高 {75%}，受到的伤害降低 {60%}。狂怒期间无法使用技能；结束后进入持续 {5} 秒的 {冷静} 状态，期间无法积攒怒气。命中多个敌人时，怒气只计算一次。","mechanics":{"reviewStatus":"table-derived","damage":{"form":"none","formLabel":"无直接伤害","types":[],"typeLabels":[],"elements":[],"elementLabels":[],"scaling":[],"scalingLabels":[],"multiplier":0,"segments":[],"crit":"na"},"bonuses":{"applies":[],"excludes":[]},"features":["持续"],"effects":[],"outcomes":["statBuff","damageReduction"],"outcomeLabels":["属性增益","伤害减免"],"effectScalings":["phyAtk"],"effectScalingLabels":["物理攻击"],"conditions":[],"notes":[],"sourceRefs":[]}}]}],"jobTraits":[{"id":"heroJob1Buff1","name":"援护打击","des":"当生命值高于 {25%} 时，会跳向并撞击 {5} 格内正在攻击我方弱势单位的敌人，造成 {100%} 物理攻击加成的物理伤害，同时将其设为当前攻击目标，并立即刷新 <【挑衅】> 的冷却时间，该效果有 {12} 秒冷却时间。","values":{"status":[{"label":"生效时机","value":"友方受到普通攻击时"}],"groups":[{"title":"伤害","items":[{"label":"伤害倍率","value":"100% 物理攻击"}]},{"title":"时间与层数","items":[{"label":"触发冷却","value":"12 秒"},{"label":"生命值判定阈值","value":"25%"}]}],"nested":[],"linked":[]}},{"id":"heroJob1Buff2","name":"挑衅","des":"普攻命中敌人时<嘲讽>目标 {1} 秒，并在 {3} 秒内获得 {15%} 的免伤效果，该效果有 {12} 秒冷却。","values":{"status":[{"label":"生效时机","value":"普通攻击时追加伤害"}],"groups":[{"title":"时间与层数","items":[{"label":"触发冷却","value":"12 秒"}]}],"nested":[],"linked":[{"id":"2100","name":"嘲讽","note":"","known":true},{"id":"job1Buff1AddBuff","name":"免伤","note":"","known":true}]}}],"archives":[{"title":"欢迎来到我们的营地！","desc":"米拉贝尔：唷，小工匠！终于见到你了。\n米拉贝尔：山下的风就是舒服啊，轻轻一吹就感觉神清气爽，不像山里那样干燥闷热。\n米拉贝尔：你真是找了一个好地方啊，连我都有些羡慕了，要不是山里的事情太多，我都想直接赖在这里不走了。\n米拉贝尔：对了，收下这个吧，这是我从村子里带出来的。\n米拉贝尔：以后不管碰到什么麻烦都可以来找我。只要你开口，我这把大锤随时为你候着！","taskDesc":"","unlockFav":0,"type":4,"reward":{"id":"new_hero_first","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":1000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":50,"chance":1}]},"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{}},{"title":"契约信息","desc":"姓名：米拉贝尔\n所属：巴诺姆自卫团\n出身：巴诺姆村，索利德山\n技能：锤爆所有混蛋的脑袋\n住址：工头小屋，巴诺姆村\n武器：山神都怕的铁锤\n兴趣：照顾所有哥们姐们，吃胡萝卜\n契约附语：我来了！打谁，说话！","taskDesc":"","unlockFav":0,"type":0,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{}},{"title":"伙伴简介","desc":"　　索利德山巴诺姆村工头罗伯特的独生女。\n　　在村民们的眼中，她是一位美丽、谦逊而有礼的独角兔少女，宛如山间盛开的纯白花朵。但事实真的是这样吗？只有很少的人知道，其实这位少女，还有着更加狂野、更加凶暴的“另一面”。","taskDesc":"","unlockFav":0,"type":0,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{}},{"title":"淑女期望","desc":"　　米拉贝尔对母亲的记忆已然模糊，只剩下一些温柔触感与哼唱鼻音的碎片。母亲离世后，父亲罗伯特将对亡妻的全部思念，都化作了对女儿的期望——希望她能成为母亲那般温柔美好的“淑女”。","taskDesc":"","unlockFav":5,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"phyAtk":200,"magicAtk":200}},{"title":"淑女必修课","desc":"　　米拉贝尔发来信件，她想要来你的营地看看。","taskDesc":"　　罗伯特对女儿的淑女教育是全面而认真的。除了基本的读写，米拉贝尔还学习了简单的竖琴弹奏和巴诺姆村的传统舞蹈。罗伯特坚信，这些才艺能让她在任何场合都应对得体。米拉贝尔也确实学得很好，但她从未告诉父亲，比起拨弄琴弦，她更喜欢在练习的间隙，偷偷模仿矿工们挥舞铁镐的动作，感受力量在手臂中流动的踏实感。","unlockFav":10,"type":1,"reward":{"id":"heroArchives01","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":1000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1}]},"mail":{"id":"mail_fav_hero_050_1","mailType":2,"title":"想看看你的营地！","content":"[myName]：\n　　嘿！村子里的工作最近闲下来了，我想要借这个机会来看看你在草原的营地，你不会把我拒之门外吧？最近天气很热，我要是千里迢迢从索利德山跑过来，而你不让我进营地的话，我会在野外被热晕的。开玩笑啦！我的好伙伴怎么可能是那么绝情的人。\n　　对了，我还给你带了一些非常贵重的礼物，一定能让你惊讶到张大嘴巴！\n\n米拉贝尔","hasAttachment":false,"reward":{"id":"heroArchives01","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":1000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1}]},"taskTypeId":"fav_hero_050_1","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_050_1","taskName":"来自山上的朋友","dialogs":[{"id":"fav_hero_050_1_0","name":"米拉贝尔-营地对话【欢迎来到营地！】"},{"id":"fav_hero_050_1_1","name":"米拉贝尔-来自山上的朋友-进入战役"}],"stats":{}},{"title":"白兔的变身","desc":"　　对于含辛茹苦养大自己的父亲，米拉贝尔深深地感恩，为此她心甘情愿地扮演着父亲所期望的“淑女”角色。然而，在大兽潮之后，面对村庄日益凋敝的现实，她内心对于这种“百无一用”的身份感到越发厌烦与焦躁。最终，米拉贝尔选择脱下淑女的长裙，换上便于行动的劲装。作为“太妹”和“大姐头”的米拉贝尔诞生了——礼貌的微笑无法拯救巴诺姆村，但强大的力量，或许可以。","taskDesc":"","unlockFav":15,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"maxHp":500}},{"title":"独角兔的血脉","desc":"　　米拉贝尔发来信件，邀请你一同来调查农田袭击事件。","taskDesc":"　　魔人体内的魔物血脉并非一成不变，而是随着时间逐步退化。但是极其偶然地，一些魔人身上也会出现被称为“隔世大返祖”的奇妙现象，让血脉中流传的强大力量于突兀之间回归。米拉贝尔就通过返祖觉醒了“独角兔”的血脉。这种传说中的魔物拥有与娇小身形毫不相符的究极怪力，以及和可爱外表截然相反的凶暴性情，某种程度上，这些特征，在米拉贝尔身上体现得可以说是淋漓尽致。","unlockFav":20,"type":1,"reward":{"id":"heroArchives02","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":2000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_050_2","mailType":2,"title":"有个很奇怪的事情……","content":"[myName]：\n　　有个很坏的消息，村子附近的农田经常有岩蟾蜍出没，我们每次都要出动很多人手才能将它们击退。很奇怪，农田所处的地方很偏僻，附近也没有岩蟾蜍的巢穴，为什么一直会有岩蟾蜍过来袭击农田？\n　　我们搜了好几遍，实在是找不到原因……能请你过来看看情况吗？我会亲自来营地接你的。\n\n米拉贝尔","hasAttachment":false,"reward":{"id":"heroArchives02","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":2000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":1,"chance":1}]},"taskTypeId":"fav_hero_050_2","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_050_2","taskName":"调查岩山","dialogs":[{"id":"fav_hero_050_2_0","name":"米拉贝尔-营地对话【那边情况如何？】"},{"id":"fav_hero_050_2_1","name":"米拉贝尔-调查岩山-进入战役"}],"stats":{}},{"title":"战锤与淑女","desc":"　　为了与“淑女”的自己划清界限，米拉贝尔特意选择了“战锤”这种看上去狂野而暴力的武器。这柄武器不仅是她强大力量的证明，更是她反抗“淑女”命运、决心亲手开创未来的象征。当她挥舞战锤时，她不再是那个需要被保护的工头女儿，而是能够独当一面、守护他人的战士。而幸运的是，这柄朴实刚健的武器，也与米拉贝尔的怪力相得益彰。","taskDesc":"","unlockFav":25,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"crit":5}},{"title":"语言练习","desc":"　　米拉贝尔发来信件，告知上回调查农田袭击事件的调查情况，并表示想要来你的营地坐坐。","taskDesc":"　　从“请”和“谢谢”到满嘴粗话，对米拉贝尔而言是一项艰苦的“学习”。她曾躲在村外，偷偷听那些来往的武装行商和佣兵们交谈，将那些粗鲁的词汇和腔调记在心里。夜深人静时，她会对着水面的倒影练习，努力让自己的语气听起来更具威慑力。“你这混账！”——当米拉贝尔第一次将如此“粗野”的词语脱口而出，少女感到的并不是羞愧，而是一种巨大的解脱感，这让米拉贝尔确信，自己和这种说话方式，非常合得来！","unlockFav":30,"type":1,"reward":{"id":"heroArchives03","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":3000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_050_3","mailType":2,"title":"关于上次的调查……","content":"[myName]：\n　　上次把晶石粉末都清理完后，种植区变得安稳了许多，现在大家终于可以安心种田了。\n　　我们仍在调查幕后黑手，但目前线索还是太少了，只知道村子里肯定有人配合他们行动，村子内部再次出现了叛徒。现在我们有了一些线索，但距离找到真正的证据还有一段时间，如果有进展一定会通知你的。\n　　连续工作了好几天，感觉有些累了，所以我决定给自己放个假，这几天来你的营地歇息一下。\n　　一会儿见！\n\n米拉贝尔","hasAttachment":false,"reward":{"id":"heroArchives03","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":3000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":1,"chance":1}]},"taskTypeId":"fav_hero_050_3","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_050_3","taskName":"陷入困境的调查","dialogs":[{"id":"fav_hero_050_3_0","name":"米拉贝尔-营地对话【调查辛苦了。】"},{"id":"fav_hero_050_3_1","name":"米拉贝尔-陷入困境的调查-进入战役"}],"stats":{}},{"title":"双面领袖","desc":"　　靠着强大的实力，还有秘密身份带来的噱头，米拉贝尔轻而易举地拉拢了一批有志青年，重建了在“大兽潮”中覆灭的“巴诺姆村自卫团”，为了不让父亲担心，米拉贝尔向包括父亲在内的所有普通村民隐瞒了自己作为自卫团领袖的身份。她要求团员们绝对保密，并巧妙地让皮塔和卡夫扮演明面上的首领。这种双重生活虽然辛苦，但对米拉贝尔而言，只要能保护村子，同时又不破坏父亲心中“乖女儿”的形象，一切都是值得的。","taskDesc":"","unlockFav":35,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"critDam":20}},{"title":"无用的技艺","desc":"　　米拉贝尔发来信件，想要拜访你的营地，告诉你巴诺姆村农田被袭击的真相。","taskDesc":"　　虽然已经决心与身为乖乖女的自己作别，但米拉贝尔发现，在担当“大姐头”的时候，一些“淑女”的才艺，似乎也不是全无用武之地。当米拉贝尔第一次用针线为伙伴缝合伤口的时候，她无比感激父亲让自己学习刺绣的经历。或许自己并不应该舍弃身为乖乖女的过去，将一切坦然接受下来，可能会是更好的办法……","unlockFav":40,"type":1,"reward":{"id":"heroArchives04","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":4000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_050_4","mailType":2,"title":"抓住幕后黑手了","content":"[myName]：\n　　农田的事情已经真相大白了，果然村子里面出了叛徒。\n　　事情大致是这样的，农场主会在收获前偷偷把大部分成熟的萝卜收下，然后让荒野客诱导岩蟾蜍袭击农场。这样就会造成村子的萝卜短缺，然后他再与荒野客配合，将萝卜高价卖出。不过我们临时加强防御，导致他们没法清理掉晶石粉末，所以造成岩蟾蜍一直袭击农场的现象，我们是趁后来他们来清理晶石粉末的时候逮住了他们。\n　　唉……这一趟事下来让我很心烦，等到了营地再和你说吧。\n\n米拉贝尔","hasAttachment":false,"reward":{"id":"heroArchives04","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":4000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":2,"chance":1}]},"taskTypeId":"fav_hero_050_4","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_050_4","taskName":"袭击的真相","dialogs":[{"id":"fav_hero_050_4_0","name":"米拉贝尔-营地对话【恭喜任务完成了。】"},{"id":"fav_hero_050_4_1","name":"米拉贝尔-袭击的真相-进入战役"}],"stats":{}},{"title":"卸下伪装","desc":"　　人不可能永远维持两幅面孔，米拉贝尔也意识到，自己不可能永远躲藏在“乖乖女”和“太妹”的面具之后。想要真正领导并团结整个村子，她必须以“米拉贝尔”的身份真正地站出来，成为引领众人的旗帜。虽然携大胜之势强势夺得了村子的领导地位，但那多少是因为兵贵神速，打了大家一个措手不及。要真正站稳脚跟，米拉贝尔需要做的还有很多、很多，为此，她已经决定要放下矜持，向身边的伙伴们索取可以获得的一切帮助。","taskDesc":"","unlockFav":45,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"phyDef":500,"magicDef":500}},{"title":"与驿站的关系","desc":"　　米拉贝尔发来信件，邀请你上山加入她的庆功宴。","taskDesc":"　　随着索利德山的异变彻底解决，巴诺姆村与驿站之间，已经到了不得不加深往来的时候。虽然村子里反感外来者的思潮还未平息，但米拉贝尔已经决心带领村子重新融入驿站的商业体系。这可能会需要一些强硬的手段，也可能不被同胞理解，但米拉贝尔相信，为了更美好的未来，这是必要的选择。当然，[myName]和菲莉娜等朋友的存在，也是米拉贝尔倾向驿站的重要原因。为了巴诺姆村的发展，米拉贝尔已经做好了准备。","unlockFav":50,"type":1,"reward":{"id":"heroArchives05","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":5000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1},{"id":"item_20004","name":"契约书","img":"/images/Common_ItemIcon/item_20004.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_050_5","mailType":2,"title":"萝卜成熟时","content":"[myName]：\n　　好久不见，你最近还好吗？\n　　还记得上次的约定吗？等萝卜田成熟的时候，我想再请你吃顿烤萝卜。现在已经到了收获之日，我也收下了很多萝卜，你愿意过来履行约定，尝尝我亲手烤的萝卜吗？\n　　不管愿不愿意，反正我现在争吵你的营地赶啦，我要接你到巴诺姆村一起吃萝卜～\n\n米拉贝尔","hasAttachment":false,"reward":{"id":"heroArchives05","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":5000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":2,"chance":1},{"id":"item_20004","typeId":"item_20004","name":"契约书","img":"/images/Common_ItemIcon/item_20004.webp","quality":5,"count":1,"chance":1}]},"taskTypeId":"fav_hero_050_5","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_050_5","taskName":"山中的宴会","dialogs":[{"id":"fav_hero_050_5_0","name":"米拉贝尔-营地对话【我来赴约了。】"},{"id":"fav_hero_050_5_1","name":"米拉贝尔-山中的宴会-进入战役"}],"stats":{}}],"behavior":{"chat":[{"dialog":"yd_050_01","min":0,"max":14},{"dialog":"yd_050_02","min":0,"max":14},{"dialog":"yd_050_03","min":0,"max":14},{"dialog":"yd_050_04","min":15,"max":29},{"dialog":"yd_050_05","min":15,"max":29},{"dialog":"yd_050_06","min":15,"max":29},{"dialog":"yd_050_07","min":30,"max":50},{"dialog":"yd_050_08","min":30,"max":50},{"dialog":"yd_050_09","min":30,"max":50}],"heroEvent":[{"day":1,"title":"对我们的营地感觉如何？","dialog":"sj_050_01"},{"day":3,"title":"在这里住得还舒服吗？","dialog":"sj_050_02"},{"day":7,"title":"有没有想在这里做的事？","dialog":"sj_050_03"}],"touch":[{"text":"你……你怎么和菲莉娜一样，毛手毛脚的！也、也不是讨厌啦……","vocal":"motou_050_1","face":"emo_amazed","min":0,"max":14},{"text":"村里的孩子从小就知道别人的耳朵不能摸……你怎么还