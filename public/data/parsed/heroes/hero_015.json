on/item_00001.webp","quality":5,"count":1000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":50,"chance":1}]},"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{}},{"title":"契约信息","desc":"姓名：芭杜尔\n所属：三枝议会\n出身：杜尔家族，黑森林\n技能：德鲁伊法术，炼金术\n住址：金弦之厅橡树冠1区302号树屋\n武器：赫尔温·杜尔，巨木之枝\n兴趣：制药，种田\n契约附语：不在金弦之厅的这段时间，就让我们好好相处吧。","taskDesc":"","unlockFav":0,"type":0,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{}},{"title":"伙伴简介","desc":"　　芭杜尔是一位鹿人德鲁伊兼旅行药师。她在求生者草原的某处开辟了一片药圃，种植着各种草药。然而，在之后的重逢中，你们发现这似乎只是芭杜尔的隐藏身份，而她真正的身份，则大大出乎了你们的意料：她竟是黑森林金弦之厅的领袖之一，三枝议会的树冠守望者。\n　　芭杜尔总给人沉稳的印象，周围人都评价她理性务实，甚至显得有些不近人情。但若与她拉近些距离，她内心中坚定的意志和热情之火定会令你深受感染。","taskDesc":"","unlockFav":0,"type":0,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{}},{"title":"奇怪的药师","desc":"　　很多人都知道，在求生者草原一带偶尔会出现一名奇怪的旅行药师，她有着长长的鹿角，穿着奇异的服装，性情古怪，神出鬼没。虽然经常找不到她的人，但对于很多荒野客来说，一个愿意接诊的药师已经是他们没有选择之下的最后指望。而芭杜尔的医术也完全对得起他们的期待，久而久之，关于荒野药师的传闻就这样流传了开来。","taskDesc":"","unlockFav":5,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"phyAtk":200,"magicAtk":200}},{"title":"利刃与药膏","desc":"　　芭杜尔发来了信件，想要来参观你的营地。","taskDesc":"　　从研习医学的第一天起，芭杜尔就被告知，真正的治愈并非一味的抚慰和缓解，而是要直面病痛的根源。很多时候，对于患者来说，切除病灶的利刃要比缓慢生效的药膏有效得多——即使过程会带来痛苦。这种务实甚至略显冷酷的哲学深深影响了芭杜尔，在之后的人生中，逐渐成为了她的行事准则。","unlockFav":10,"type":1,"reward":{"id":"heroArchives01","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":1000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1}]},"mail":{"id":"mail_fav_hero_015_1","mailType":2,"title":"希望你能欢迎我","content":"[myName]：你好！\n　　最近金弦之厅的内务总算告一段落，我也终于有了一些自己的时间。\n　　听说你们的营地近来发展不错，我准备趁此机会前去拜访一番，希望你能欢迎。\n\n你的朋友，\n芭杜尔","hasAttachment":false,"reward":{"id":"heroArchives01","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":1000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1}]},"taskTypeId":"fav_hero_015_1","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_015_1","taskName":"希望你能欢迎我……","dialogs":[{"id":"fav_hero_015_1_0","name":"芭杜尔-芭杜尔，你来了？"},{"id":"fav_hero_015_1_1","name":"芭杜尔-希望你能欢迎我……-进入战役"}],"stats":{}},{"title":"森林之友","desc":"　　芭杜尔与森林的联系超乎寻常。她在最危险的密林中行走，却如在自家后院般闲庭信步，凶猛的野兽在她面前会收敛爪牙，仿佛她是森林本身的一部分。对她而言，森林并非单纯的资源产地，而是一个有意志、有情绪的生命共同体。这份深刻的共鸣，使她能解读自然的低语，并借用其力量来施展奇迹。","taskDesc":"","unlockFav":15,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"maxHp":500}},{"title":"远方的田地","desc":"　　芭杜尔再次发来了信件，决定接受你的邀请。","taskDesc":"　　芭杜尔并不讨厌权力，也不会逃避责任，但若允许她在整理会议记录和打理药圃之间选择，她大概会暂且撇下自己的责任，选择奔向远方的田地。\n　　她对土地、植物和季节变化有一种近乎朴素的信任，仿佛只要种子还能发芽，许多沉重的事情就还没有糟到尽头。","unlockFav":20,"type":1,"reward":{"id":"heroArchives02","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":2000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_015_2","mailType":2,"title":"想给我看什么呢","content":"[myName]：你好！\n　　我收到了你的来信。你说有重要的东西要展示给我看，邀请我与你同行……因为措辞非常模棱两可，我大概能猜到，你应该是在隐瞒什么。\n　　不过，接到你的邀请确实是非常稀奇的体验。正好近期工作平顺，无甚要紧，我会抽出时间的。\n　　请做好准备，我做完手头的事情就会立刻动身前来。\n\n你的朋友，\n芭杜尔","hasAttachment":false,"reward":{"id":"heroArchives02","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":2000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":1,"chance":1}]},"taskTypeId":"fav_hero_015_2","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_015_2","taskName":"想给我看什么呢？","dialogs":[{"id":"fav_hero_015_2_0","name":"芭杜尔-我们出发吧！"},{"id":"fav_hero_015_2_1","name":"芭杜尔-想给我看什么呢？-进入战役"}],"stats":{}},{"title":"守望着的花圃","desc":"　　对于芭杜尔来说，树冠守望者既是一个尊贵的身份，也是一个沉重的负担。繁重的工作和复杂的人员管理令她焦头烂额，而她释放压力的方法，便是照料自己的药圃。\n　　照料花花草草，看着这些花草成长为成熟的药草，能给烦躁的芭杜尔带来一丝治愈。这些田里的植物不仅是可用的药材，也是她在失去一切以后，唯一能提供温暖的避风港。","taskDesc":"","unlockFav":25,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"crit":5}},{"title":"德鲁伊的花朵","desc":"　　收到了芭杜尔发来的信件。她非常感激你为她打理的药圃。","taskDesc":"　　芭杜尔很会判断植物长势，分析植物构成。但她不太会判断该如何称赞一朵花，简单来说就是理性过度却缺乏感性。\n　　她能准确说出药性、花期、土壤和日照，却常常在真正需要表达喜爱时变得过分认真。她的浪漫感并不轻盈，甚至有些古板，可那种古板里偏偏藏着一种源自内心的诚恳……","unlockFav":30,"type":1,"reward":{"id":"heroArchives03","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":3000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_015_3","mailType":2,"title":"为了报答你","content":"[myName]：你好！\n　　药圃的事情，真的多谢了。自那之后，我抽空重新补种了不少药草，到现在终于恢复旧观。\n　　最近天气转暖，花期将近，正是赏花好时节。为了报答你之前的帮忙，我想邀请你到药圃来共赏花景，希望你能拨冗赏光。\n\n你的朋友，\n芭杜尔","hasAttachment":false,"reward":{"id":"heroArchives03","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":3000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":1,"chance":1}]},"taskTypeId":"fav_hero_015_3","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_015_3","taskName":"为了报答你……","dialogs":[{"id":"fav_hero_015_3_0","name":"芭杜尔-我们去赏花吧！"},{"id":"fav_hero_015_3_1","name":"芭杜尔-为了报答你……-进入战役"}],"stats":{}},{"title":"鹿之心","desc":"　　身为树冠守望者，芭杜尔平日里能镇住护林人，也能在危机中迅速做出判断，却未必能从容接住一句带着好意的玩笑，这种生人勿进的感觉是许多人无法靠近她的原因之一。\n　　她不是迟钝，而是太习惯把自己放在可靠的位置上。不过一旦有人绕过那些身份，用直白的语言赞许她，她反而会害羞得踉踉跄跄，不知所措。这便是这位鹿女孩最真实的内心。","taskDesc":"","unlockFav":35,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"critDam":20}},{"title":"像自己的花朵","desc":"　　芭杜尔发来了信件，想要送你一些花种。","taskDesc":"　　若由芭杜尔来布置花圃，她多半不会选择最艳丽的品种。她偏爱那些不争抢视线、却能安稳生长的植物。它们或许不适合摆在宴会中央受人称赞，却适合在清晨被露水打湿，在傍晚被风轻轻吹动。\n　　这样平凡、美丽、脆弱的花，多少也像芭杜尔自己。","unlockFav":40,"type":1,"reward":{"id":"heroArchives04","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":4000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_015_4","mailType":2,"title":"如果你喜欢的话","content":"[myName]：你好！\n　　上次赏花毕竟仓促，也不知你是否尽兴。\n　　我注意到你对园艺似乎有些兴趣，正好我手上有不少花种，可以分给你一些。\n　　如果你喜欢的话，那就再好不过了。\n\n你的朋友，\n芭杜尔","hasAttachment":false,"reward":{"id":"heroArchives04","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":4000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":2,"chance":1}]},"taskTypeId":"fav_hero_015_4","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_015_4","taskName":"如果你喜欢的话……","dialogs":[{"id":"fav_hero_015_4_0","name":"芭杜尔-其实你不用这么急的。"},{"id":"fav_hero_015_4_1","name":"芭杜尔-如果你喜欢的话……-进入战役"}],"stats":{}},{"title":"名为信任的花礼","desc":"　　芭杜尔送礼时并不擅长把话说得漂亮，只会说些非常实际的东西。比如她会先说明花种的习性，再提醒播种时机，甚至忍不住补充几句养护上的注意事项。\n　　可只要对方真心喜欢，她就会明显放松下来。她相信植物交给懂得珍惜它们的人，便能活得很好。或许她对重要的人，也是这样表达信任的，这种行为不仅是在表达认同，也是信任对方的标志。","taskDesc":"","unlockFav":45,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"phyDef":500,"magicDef":500}},{"title":"半片药圃的情感","desc":"　　芭杜尔发来了信件，想要托付给你重要的东西。","taskDesc":"　　芭杜尔不是会轻易托付私人物品的人。对她来说，药圃不是单纯的财产，更像一处只有她自己知道入口的安静角落。那里保存着她不必当领袖、不必做判断、不必维持冷静的片刻。\n　　经过一系列事情之后，芭杜尔学会了另一种保留方式。那便是将自己心中最珍贵之物分给可信任的人一半。对芭杜尔来说，她交出去的不仅是草药，而是自己内心最脆弱而最真实的一面。","unlockFav":50,"type":1,"reward":{"id":"heroArchives05","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":5000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1},{"id":"item_20004","name":"契约书","img":"/images/Common_ItemIcon/item_20004.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_015_5","mailType":2,"title":"想托付给你的东西","content":"[myName]：你好！\n　　空闲的时光虽好，可惜终有尽时。\n　　随着狩猎季将近，黑森林的事情又要多起来了。\n　　在开始繁忙的工作之前，我有重要的东西想要托付给你。\n　　希望你能抽出时间，再多陪我一次吧。\n\n你的朋友，\n芭杜尔","hasAttachment":false,"reward":{"id":"heroArchives05","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":5000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":2,"chance":0.5},{"id":"item_20004","typeId":"item_20004","name":"契约书","img":"/images/Common_ItemIcon/item_20004.webp","quality":5,"count":1,"chance":0.5}]},"taskTypeId":"fav_hero_015_5","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_015_5","taskName":"想托付给你的东西……","dialogs":[{"id":"fav_hero_015_5_0","name":"芭杜尔-接下来又要辛苦你了。"},{"id":"fav_hero_015_5_1","name":"芭杜尔-想托付给你的东西……-进入战役"}],"stats":{}}],"behavior":{"chat":[{"dialog":"yd_015_01","min":0,"max":14},{"dialog":"yd_015_02","min":0,"max":14},{"dialog":"yd_015_03","min":0,"max":14},{"dialog":"yd_015_04","min":15,"max":29},{"dialog":"yd_015_05","min":15,"max":29},{"dialog":"yd_015_06","min":15,"max":29},{"dialog":"yd_015_07","min":30,"max":50},{"dialog":"yd_015_08","min":30,"max":50},{"dialog":"yd_015_09","min":30,"max":50}],"heroEvent":[{"day":1,"title":"对我们的营地感觉如何？","dialog":"sj_015_01"},{"day":3,"title":"在这里住得还舒服吗？","dialog":"sj_015_02"},{"day":7,"title":"在思考事情？","dialog":"sj_015_03"}],"touch":[{"text":"摸头啊……只要你不怕我头上的木刺和树叶扎手，我倒不是特别介意。","vocal":"motou_015_1","face":"emo_dot","min":0,"max":14},{"text":"唔……又失败了。是配方出问题了吗……还是心态呢……","vocal":"motou_015_2","face":"emo_dot","min":0,"max":14},{"text":"受伤了？怎么这么不小心。别动，让我来包扎你的伤口。","vocal":"motou_015_3","face":"emo_dot","min":0,"max":14},{"text":"我这几天一直在制药，身上的味道可不好闻……你不介意就好。","vocal":"motou_015_4","face":"emo_dot","min":15,"max":29},{"text":"我带了一些黑森林的特产松茸过来。我来下厨，一起尝尝吧。","vocal":"motou_015_5","face":"emo_love","min":15,"max":29},{"text":"让我好好休息？是在特意关心我吗……嗯，你的好意我收下了。","vocal":"motou_015_6","face":"emo_dot","min":15,"max":29},{"text":"能告诉我附近哪里有成色不错的老树皮吗？那个，嗯……要是有空的话，我们一起去，怎么样？","vocal":"motou_015_7","face":"emo_dot","min":30,"max":50},{"text":"洗发水？看我头发有些乱，就做出了这个？噗，你们工匠都是这样用制药台的吗……嗯，谢谢你。","vocal":"motou_015_8","face":"emo_love2","min":30,"max":50},{"text":"今晚有空吗？我在不远的地方有一个药圃，里面还挺美的。有兴趣一起去看看吗？","vocal":"motou_015_9","face":"emo_love","min":30,"max":50}],"walk":[{"text":"你还好吗？","vocal":"luguo_015_1","face":"emo_dot","min":0,"max":14},{"text":"要一起制药吗？","vocal":"luguo_015_2","face":"emo_dot","min":0,"max":14},{"text":"你身上有药材的味道呢。","vocal":"luguo_015_3","face":"emo_dot","min":15,"max":50},{"text":"还是这么忙碌啊。","vocal":"luguo_015_4","face":"emo_love","min":15,"max":50}],"ziyanziyu":[{"text":"小溪静静流淌，树木悠然歌唱……真是静谧的营地。","vocal":"ziyan_015_1","face":"emo_dot","min":0,"max":14},{"text":"嗯……这个配方的成色不错。去药圃再采取一些药材来好了。","vocal":"ziyan_015_2","face":"emo_shock","min":0,"max":14},{"text":"呜——咳、咳咳……这药水气味好呛……呼，呼……刚刚没人看见吧……","vocal":"ziyan_015_3","face":"emo_dot","min":15,"max":50},{"text":"真想让艾薇也来这歇息一番啊。我们有多久没有说话了呢……","vocal":"ziyan_015_4","face":"emo_love","min":15,"max":50}],"explore":{"start":["是要去探险了，对吧？","治疗的工作就交给我吧。"],"fight":["树冠守望者不会退缩！","尝尝森林之怒！","自然的力量会击败你们！"],"win":["自然而然的胜利。","我们赢了。继续前进吧。","各位，没有受伤吧？"],"exploreTalk":["森林会告诉我们收获所在之处。","很久没有来到森林之外旅行了。算是忙里偷闲吧？","不知道妹妹的情况怎样……不然给她带点礼物回去吧？"],"loopEnd":["嗯……这些东西似乎可以收作药材。","看来有不少战利品。要全部带走吗？"],"readyGoHome":["日落西山。自然和我们都需要休息了。","是时候回去了。不知道营地有没有想念我呢。"],"over":["真是丰收的一天。下次出门是什么时候？","好好休息吧。森林说让我们做个好梦。"],"roomFinishMember":["附近有没有合适的药材呢。","给妹妹带点礼物回去吧。","啊，有朵可爱的小花……"],"roomFinishLeader":["森林将会传唱我们的战果。","有谁需要治疗吗？","护林人的胜利，就是大自然的胜利。"],"getGift":["礼物？我们之间倒也不用……唔，多谢你的好意。","送我的礼物吗……十分感谢。愿森林护佑你的善意。"],"gacha":["我是芭杜尔。我将与你同行，治愈所有伤口，击败一切敌人。"]}},"itemFavor":[{"id":"item_27003","points":60,"name":"秋日马卡龙","quality":2,"img":"/images/Common_ItemIcon/item_27003.webp"},{"id":"item_27004","points":85,"name":"白沙蒙布朗","quality":3,"img":"/images/Common_ItemIcon/item_27004.webp"},{"id":"item_27005","points":120,"name":"深渊荟萃巴菲","quality":4,"img":"/images/Common_ItemIcon/item_27005.webp"}]}