askTypeId":"","taskName":"","dialogs":[],"stats":{}},{"title":"伙伴简介","desc":"　　身形高挑，性格慵懒的水栖属魔人少女，驿站旅店侍者队中的一员。\n　　毕生夙愿不过是每天按时准点下班，却总被不可抗力拖入无休止的三班倒，弄得她整日都是一副苦大仇深、愁云惨雾的模样。\n　　偶尔也兼任契约者，擅长挥舞大斧与魔物战斗，气势惊人。","taskDesc":"","unlockFav":0,"type":0,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{}},{"title":"顶梁柱","desc":"　　烹饪、扫除、待客样样全能的茜塔，是旅店公认的顶梁柱。她默默扛起大小事务，那份可靠感让同伴们无比安心，也让她成了后辈们依赖的对象。","taskDesc":"","unlockFav":5,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"phyAtk":200,"magicAtk":200}},{"title":"节能打工者","desc":"　　茜塔发来了信件，邀请你来驿站旅店吃一顿饭。","taskDesc":"　　茜塔极其厌恶加班加点，永远只做分内的工作是她一生的愿望。虽然茜塔不喜欢主动接活，但正式委托给她的工作一定能出色地完成。","unlockFav":10,"type":1,"reward":{"id":"heroArchives01","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":1000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1}]},"mail":{"id":"mail_fav_hero_005_1","mailType":2,"title":"好想回营地过夜……","content":"[myName]：\n　　我这几天是没法回营地睡了。\n　　虽说最近客人不算特别多，但旅店里的麻烦事还是一堆接一堆。不过，总归比之前轻松。你那边还好吗？\n　　说起来，店里最近出了新的烤肉，我尝过，很不错。你要是有空，不妨顺路来试试味道，我请客。\n　　晚点也没关系，反正我全天都在值班。\n\n茜塔","hasAttachment":false,"reward":{"id":"heroArchives01","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":1000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1}]},"taskTypeId":"fav_hero_005_1","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_005_1","taskName":"忙碌的侍者","dialogs":[{"id":"fav_hero_005_1_0","name":"茜塔-营地对话【（那就去驿站逛逛吧。）】"},{"id":"fav_hero_005_1_1","name":"茜塔-忙碌的侍者-进入战役"}],"stats":{}},{"title":"外冷内热","desc":"　　经常有熟客评价茜塔“看起来不近人情，实则内心火热且期待变化”，每逢此时茜塔都会坚决地表达反对意见，并会用头发往他们脸上喷水以表达不满。","taskDesc":"","unlockFav":15,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"maxHp":500}},{"title":"燥热的水魔人","desc":"　　茜塔发来了信件，表示要来你的营地休息。","taskDesc":"　　作为一个水魔人，秋日荒野这种干燥的环境让茜塔长期处于缺水状态，也让她的性格烦躁了许多。","unlockFav":20,"type":1,"reward":{"id":"heroArchives02","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":2000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_005_2","mailType":2,"title":"可以到营地休息了！","content":"[myName]：\n　　这几天我一直在加班，晚上只能住在驿站的临时宿舍了。为了那可怜的加班费，每天都在忍受燥热和鼾声，好久没有睡过一次好觉了。\n　　好在最近终于空闲下来了，今晚就可以回来休息。只要一下班，我就会往你的营地跑过来，毕竟你们好不容易给我准备了一间屋子，我得花更多时间去享受不是？\n\n茜塔","hasAttachment":false,"reward":{"id":"heroArchives02","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":2000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":1,"chance":1}]},"taskTypeId":"fav_hero_005_2","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_005_2","taskName":"侍者的休息时间","dialogs":[{"id":"fav_hero_005_2_0","name":"茜塔-营地对话【（在营地里等待茜塔到来。）】"},{"id":"fav_hero_005_2_1","name":"茜塔-侍者的休息时间-进入战役"}],"stats":{}},{"title":"宝贵的休息时间","desc":"　　由于长期高强度的工作，茜塔在休息时间基本都会躺下睡觉，有时候一睡便是一整天，地震也未必能把她叫醒。","taskDesc":"","unlockFav":25,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"crit":5}},{"title":"高效的调解者","desc":"　　茜塔发来了信件，表示自己没法来你的营地了，你决定去驿站看看她。","taskDesc":"　　虽然看起来不近人情，但茜塔很少和人发生正面冲突。即便遇到无理取闹的客人，她也总会以劝说的方式调解矛盾。对她来说，比起打斗，用语言解决问题更有效率。","unlockFav":30,"type":1,"reward":{"id":"heroArchives03","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":3000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_005_3","mailType":2,"title":"又忙起来了……","content":"[myName]：\n　　很抱歉，本来想邀请你一起去做契约任务的，但旅店临时遇到些麻烦，我必须留下来帮忙。所以……我们只好下次再见面了。\n　　虽然很想见你，可每次计划见面时都被意外打断，或许一直埋在驿站干活就是我的宿命吧。下次有机会再见……\n\n茜塔","hasAttachment":false,"reward":{"id":"heroArchives03","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":3000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":1,"chance":1}]},"taskTypeId":"fav_hero_005_3","getTaskText":"接受","image":""},"taskTypeId":"fav_hero_005_3","taskName":"侍者的“宿命”","dialogs":[{"id":"fav_hero_005_3_0","name":"茜塔-营地对话【（出发去看看茜塔。）】"},{"id":"fav_hero_005_3_1","name":"茜塔-侍者的“宿命”-进入战役"}],"stats":{}},{"title":"贴心的前辈","desc":"　　虽然对待工作很冷漠，但茜塔对后辈确实非常热情。每当有侍女向茜塔请教问题的时候，茜塔总会耐心教导，态度甚至比对待自己的工作还要认真。","taskDesc":"","unlockFav":35,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"critDam":20}},{"title":"破旧的义足","desc":"　　茜塔发来了信件，她听说你为她准备了礼物，马不停蹄地想要拜访你。","taskDesc":"　　在外人看来，撑着两根木棍走路的茜塔看起来很吓人，但那其实只是她的义足罢了。据说这是茜塔自己用破木头打造的，为的就是能起身战斗，不拖大家的后腿。","unlockFav":40,"type":1,"reward":{"id":"heroArchives04","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":4000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_005_4","mailType":2,"title":"听说你给我准备了礼物！","content":"[myName]：\n　　前阵子收到了你的信了，这让我很惊喜。\n　　你在信里说已经给我准备好了礼物，还邀请我再去营地一趟。在看到这个消息后，我就立刻请假，准备往你的营地里跑了，艾尔莎也拦不住我。\n　　那么……我很快就会到你的营地，很期待你给我准备的礼物。\n\n茜塔","hasAttachment":false,"reward":{"id":"heroArchives04","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":4000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":2,"chance":1}]},"taskTypeId":"fav_hero_005_4","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_005_4","taskName":"新的义足","dialogs":[{"id":"fav_hero_005_4_0","name":"茜塔-营地对话【这次来的很快呢。】"},{"id":"fav_hero_005_4_1","name":"茜塔-新的义足-进入战役"}],"stats":{}},{"title":"逐渐恢复的双腿","desc":"　　虽然失去了双腿，但这种所谓的“残障”对水栖属来说并不算什么。他们的恢复能力都很强，再有个五六年，新的脚就会长出来了。","taskDesc":"","unlockFav":45,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"phyDef":500,"magicDef":500}},{"title":"沼泽遗孤","desc":"　　茜塔发来了信件，表示想要来你的营地，和你一起度过难得的假期。","taskDesc":"　　在兽潮发生时，茜塔被魔物咬断了腿，只能在原地静待撕碎的命运。危急关头她被前来支援的契约者们救下并送往驿站保护，随后便一直在酒馆中工作谋生。","unlockFav":50,"type":1,"reward":{"id":"heroArchives05","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":5000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1},{"id":"item_20004","name":"契约书","img":"/images/Common_ItemIcon/item_20004.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_005_5","mailType":2,"title":"请假成功了。","content":"[myName]：\n　　这段时间一直用你送的义足工作，比之前舒服多了。\n　　告诉你一个好消息，因为之前抵御地窖蜘蛛入侵有功，艾尔莎给我批了一天的带薪假期，我打算趁着这天假期来找你。那个……我不是还没习惯这个义足嘛，所以需要多走走，我来找你在营地附近散散步可以吗？\n\n茜塔","hasAttachment":false,"reward":{"id":"heroArchives05","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIco