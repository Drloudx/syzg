/item_00002.webp","quality":5,"count":50,"chance":1}]},"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{}},{"title":"契约信息","desc":"姓名：阿尔克丝\n所属：无\n出身：无（批注：求生者草原）\n技能：熊抱、千吨大力拳\n住址：居无定所\n武器：\n“叛族者之爪”\n拳套\n兴趣：一个人呆着\n契约附语：我叫阿尔克丝，就这样。","taskDesc":"","unlockFav":0,"type":0,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{}},{"title":"伙伴简介","desc":"　　世上总有数不清的旅行者，他们踏过巍峨的高山，走过泥泞的沼泽，历尽千辛万苦，只为亲眼一睹自己未曾踏足的世界，而阿尔克丝便是其中之一。\n　　人们总能在各种地方看见阿尔克丝背着她的大背包，闲庭信步地向前走着。虽然她极少与外界沟通，但她走过的地方总会流传着熊人旅行者的传说。","taskDesc":"","unlockFav":0,"type":0,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{}},{"title":"孤独的旅行家","desc":"　　无论去哪里，阿尔克丝总是独自行动。曾有许多人向她提供帮助，但都被她拒绝了。\n　　哪怕身受重伤，阿尔克丝也只会独自在暗处舔舐伤口，不接受任何人的帮助。这位孤独的旅行家喜欢将自己的一切封存在内心之中，等待着有缘人将其揭开……","taskDesc":"","unlockFav":5,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"phyAtk":200,"magicAtk":200}},{"title":"草原的活地图","desc":"　　阿尔克丝发来了信件，想要来你的营地休整。","taskDesc":"　　阿尔克丝能从泥土的湿度判断附近是否有水，从折断的草茎辨认兽群去向，甚至还能根据地图推测出没有标注的洞穴和背风坡。求生者草原上哪里适合扎营、哪里容易遭遇魔物，她往往看一眼周围便能说出大概。\n　　她不认为这是什么值得夸耀的本领，只会说自己走得够多，自然就懂了。","unlockFav":10,"type":1,"reward":{"id":"heroArchives01","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":1000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1}]},"mail":{"id":"mail_fav_hero_030_1","mailType":2,"title":"想来你的营地休整一下","content":"[myName]：\n　　你好，我快回到求生者草原了，想要来你的营地借宿一天。\n　　原本我打算直接在野外休息，但想着你在这里有一个营地，所以特意绕过来拜访一下，顺便也在这里休息。请放心，借宿钱我会付的。\n\n阿尔克丝","hasAttachment":false,"reward":{"id":"heroArchives01","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":1000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1}]},"taskTypeId":"fav_hero_030_1","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_030_1","taskName":"旅行者的中转站","dialogs":[{"id":"fav_hero_030_1_0","name":"阿尔克丝好感1-引入"},{"id":"fav_hero_030_1_1","name":"阿尔克丝好感1-战役"}],"stats":{}},{"title":"无可奉告","desc":"　　面对有关过去的问题，阿尔克丝总会用同一句话挡回去：“无可奉告。”\n　　她并非完全不愿相信别人，只是不愿让任何人替她决定哪些秘密可以被说出口。有人愿意停在界线之外，不追问、不替她猜测，只在她回头时依然站在那里——这才是她能够接受的亲近方式。","taskDesc":"","unlockFav":15,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"maxHp":500}},{"title":"沉默的谢礼","desc":"　　阿尔克丝发来了信件，似乎在向你请求帮助。","taskDesc":"　　阿尔克丝不喜欢欠别人东西，收到食物，她会用情报或劳动补回去；受了保护，她会在对方需要时挡下一次。她很少把谢意挂在嘴边，通常在别人开口之前就把账结清，然后恢复那副“到此为止”的表情。\n　　对阿尔克丝来说，回礼不是亲近的邀请，而是把关系放回一个双方都舒服的位置。正因如此，她偶尔主动留下的东西，反而比一句郑重的感谢更值得在意。","unlockFav":20,"type":1,"reward":{"id":"heroArchives02","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":2000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_030_2","mailType":2,"title":"求救","content":"[myName]：\n　　我最近的身体有些不受控制，倘若你收到这封信，就证明我已经失去了意识。在我失去意识之后，会有一只恐兽来到你的营地，你只要跟着它走就能找到我。\n　　拜托你，救救我。\n\n阿尔克丝","hasAttachment":false,"reward":{"id":"heroArchives02","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":2000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":1,"chance":1}]},"taskTypeId":"fav_hero_030_2","getTaskText":"接受","image":""},"taskTypeId":"fav_hero_030_2","taskName":"发狂的阿尔克丝","dialogs":[{"id":"fav_hero_030_2_0","name":"阿尔克丝好感2-引入"},{"id":"fav_hero_030_2_1","name":"阿尔克丝好感2-战役"}],"stats":{}},{"title":"黑焰之躯","desc":"　　高浓度的融合魔力会让阿尔克丝立刻感到不适，严重时甚至会让她失去意识。而阿尔克丝体内一直潜藏着强大的魔力。\n　　在酣战之时，她身上的魔力便会被激活，爆发出黑色的魔力火焰，这股火焰既能赋予她力大无穷的力量，也会给她带来丧失理智的风险。","taskDesc":"","unlockFav":25,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"crit":5}},{"title":"行囊里的生活","desc":"　　阿尔克丝发来了信件，想要邀请你一起去旅行。","taskDesc":"　　阿尔克丝的背包看着像要把人压垮，里面装有食物、水、火种、绳子和替换用的皮料等等，每一样都有用处。\n　　阿尔克丝不喜欢借东西，更不喜欢别人替她整理行囊——那等于把自己的退路交到别人手里。她会为了找到一块能晒干衣服的平地绕路，却不会为了参加一场热闹停下来。","unlockFav":30,"type":1,"reward":{"id":"heroArchives03","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":3000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_030_3","mailType":2,"title":"一起去旅行吗？","content":"[myName]：\n　　听说你最近时间宽裕，我想趁此机会邀请你一同去旅行，以报答你上次的救命之恩。\n　　以旅行为报答有些奇怪，可我也想不出什么好的方法，还请你能同意。放心，我会留一分惊喜给你……应该算是惊喜吧。\n\n阿尔克丝","hasAttachment":false,"reward":{"id":"heroArchives03","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":3000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":1,"chance":1}]},"taskTypeId":"fav_hero_030_3","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_030_3","taskName":"小熊的露营记","dialogs":[{"id":"fav_hero_030_3_0","name":"阿尔克丝好感3-引入"},{"id":"fav_hero_030_3_1","name":"阿尔克丝好感3-战役"}],"stats":{}},{"title":"可掌握的自然","desc":"　　阿尔克丝喜欢旅行的一点，在于大自然的规则可以掌握。水会留下痕迹，成熟的果实会散发气味，风雨到来之前也总有征兆。\n　　而人却要比自然复杂得多。承诺可能改变，善意可能附带条件，群体也可能把造成的不幸推到某一个人身上。种种经历让她明白，比起和人打交道，还是把心思放在旅行和远方的世界更好。","taskDesc":"","unlockFav":35,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"critDam":20}},{"title":"有限的善意","desc":"　　阿尔克丝发来了信件，邀请你一起去她的“故居”瞧瞧。","taskDesc":"　　阿尔克丝从不把自己说成乐于助人的好人。可在不耽误行程的前提下，她会为迷路者指出水源，也会给缺少绷带的伤员留下一小包药草。而且她偏爱帮助那些仍在设法自救的人，因为那意味着对方不会把全部希望压到她身上。\n　　做完这些事后，她通常只说“刚好顺手”或“省得之后更麻烦”。阿尔克丝不擅长承认自己的关心，更不希望善意变成一份长期义务。","unlockFav":40,"type":1,"reward":{"id":"heroArchives04","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":4000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_030_4","mailType":2,"title":"发现村子的废墟","content":"[myName]：\n　　前几日在求生者草原附近歇息，在远处发现了一座被烧毁的村庄。经过观察，我想那是我以前曾居住过的村子。\n　　虽然不知为什么变成了废墟，但我还想要去调查一下，你可以来陪我吗（划掉），我的意思是，你可以与我一同搜刮这个村子吗？\n\n阿尔克丝","hasAttachment":false,"reward":{"id":"heroArchives04","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":4000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":2,"chance":1}]},"taskTypeId":"fav_hero_030_4","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_030_4","taskName":"被摧毁的村庄","dialogs":[{"id":"fav_hero_030_4_0","name":"阿尔克丝好感4-引入"},{"id":"fav_hero_030_4_1","name":"阿尔克丝好感4-战役"}],"stats":{}},{"title":"被放逐的熊","desc":"　　曾经，阿尔克丝是个很优秀的孩子，深受同村人的喜爱。\n　　直到有一天，一群狂暴化的角猪袭击了阿尔克丝所在的村落。为了保护大家，阿尔克丝激发了体内封禁的力量，以暂时失去意识为代价击退了角猪，同时她还在这个状态下伤害了不少村民。\n　　被嫌弃的阿尔克丝因此被逐出村子，从此变得沉默寡言。这便是这位旅行者难以提及的过往……","taskDesc":"","unlockFav":45,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"phyDef":500,"magicDef":500}},{"title":"熊孩子的安眠曲","desc":"　　阿尔克丝发来了信件，表示想来你的营地睡一觉。","taskDesc":"　　在小时候，阿尔克丝总会在妈妈轻哼的安眠曲下进入梦乡。待到醒来再次看见妈妈时，便是她最幸福的时刻。\n　　长大开始独自旅行以后，阿尔克丝总会遇到各种各样的烦心事，当她无法解决时便会轻声哼起这首安眠曲，以此平复自己的情绪。每天能在安眠曲下睡去，并在醒来时看见自己所爱之人陪伴在身旁，这便是这位“熊孩子”最渴望的生活。","unlockFav":50,"type":1,"reward":{"id":"heroArchives05","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":5000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1},{"id":"item_20004","name":"契约书","img":"/images/Common_ItemIcon/item_20004.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_030_5","mailType":2,"title":"旅行前的冬眠","content":"[myName]：\n　　像我这样的魔人有一个特性，那就是每年临近冬季之时，我都需要睡整整一周，就像很多魔物需要冬眠一样。\n　　我想要来你的营地睡觉可以吗？那里安全可靠，还会给我一种……安心的感觉。在睡醒之后，我便会再次踏上旅行的道路。\n\n阿尔克丝","hasAttachment":false,"reward":{"id":"heroArchives05","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":5000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":2,"chance":1},{"id":"item_20004","typeId":"item_20004","name":"契约书","img":"/images/Common_ItemIcon/item_20004.webp","quality":5,"count":1,"chance":1}]},"taskTypeId":"fav_hero_030_5","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_030_5","taskName":"爱睡觉的熊孩子","dialogs":[{"id":"fav_hero_030_5_0","name":"阿尔克丝好感5-引入"},{"id":"fav_hero_030_5_1","name":"阿尔克丝好感5-战役"}],"stats":{}}],"behavior":{"chat":[{"dialog":"yd_030_01","min":0,"max":14},{"dialog":"yd_030_02","min":0,"max":14},{"dialog":"yd_030_03","min":0,"max":14},{"dialog":"yd_030_04","min":15,"max":29},{"dialog":"yd_030_05","min":15,"max":29},{"dialog":"yd_030_06","min":15,"max":29},{"dialog":"yd_030_07","min":30,"max":50},{"dialog":"yd_030_08","min":30,"max":50},{"dialog":"yd_030_09","min":30,"max":50}],"heroEvent":[],"touch":[{"text":"唔……唉，算了。","vocal":"motou_030_1","face":"emo_dot","min":0,"max":14},{"text":"我想……一个人呆着……","vocal":"motou_030_2","face":"emo_dot","min":0,"max":14},{"text":"可以放我走了吗？……","vocal":"motou_030_3","face":"emo_dot","min":0,"max":14},{"text":"你想要我手上的蜂蜜……？","vocal":"motou_030_4","face":"emo_dot","min":15,"max":29},{"text":"蜂蜜味道不错。你要来尝尝吗？","vocal":"motou_030_5","face":"emo_dot","min":15,"max":29},{"text":"我不喜欢和其他人沟通……不过……你是例外。","vocal":"motou_030_6","face":"emo_dot","min":15,"max":29},{"text":"呜……请不要在我犯困的时候这样摸……","vocal":"motou_030_7","face":"emo_dot","min":30,"max":50},{"text":"我打算去远一点的地方看看。要和我一起来吗？","vocal":"motou_030_8","face":"emo_dot","min":30,"max":50},{"text":"我一直想说，你摸头的力度有些太轻了。不如，就在我这儿多练习一下吧……","vocal":"motou_030_9","face":"emo_love","min":30,"max":50}],"walk":[{"text":"你好……","vocal":"luguo_030_1","face":"emo_dot","min":0,"max":14},{"text":"嗯……","vocal":"luguo_030_2","face":"emo_dot","min":0,"max":14},{"text":"啊，吓我一跳……骗你的。","vocal":"luguo_030_3","face":"emo_dot","min":15,"max":50},{"text":"天气真好……干脆睡一觉吧……","vocal":"luguo_030_4","face":"emo_dot","min":15,"max":50}],"ziyanziyu":[{"text":"心情不错，体内的魔力也很稳定……应该不会有问题。","vocal":"ziyan_030_1","face":"emo_dot","min":0,"max":14},{"text":"接下来……去那个地方走一趟吧。说不定会有意外的发现。","vocal":"ziyan_030_2","face":"emo_dot","min":0,"max":14},{"text":"远足前……和大家打声招呼吧。要不要去邀请那个人一起呢……","vocal":"ziyan_030_3","face":"emo_dot","min":15,"max":50},{"text":"唔……蜂蜜好像买多了。不如分给大家一起吃吧……可我又不太擅长和人说话……呜。","vocal":"ziyan_030_4","face":"emo_love","min":15,"max":50}],"explore":{"start":["探索吗？这个我擅长……","很轻松的任务，不需要沟通就能完成。"],"fight":["有敌人……该战斗了！","这些家伙，一两拳就打倒了。","杂碎们……别挡着我！"],"win":["继续前进。","哼……麻烦解决了。","很轻松的胜利。"],"exploreTalk":["嗯……我没事。","请将更多精力放在探索上，不必与我搭话。","这东西不错，放进背包里吧。"],"loopEnd":["看来这次收获不错。","不错……努力没有白费。"],"readyGoHome":["好，探索到此为止。","该抬起行囊，踏上归家之路了。"],"over":["结束了，旅行过后总能感受到不一样的惬意。","庆祝就不必找我了，我想一个人休息。"],"roomFinishMember":["观察一下四周，留意是否有敌人埋伏在角落。","好……问题应该解决了吧。","哼，几拳就能解决的事情。"],"roomFinishLeader":["问题解决了，我先走了。","倘若没有别的事，就继续前进。","没意思，就没有更厉害的挑战吗？"],"getGift":["啊？没想到能收到你的礼物，谢谢你……","这是给我的吗？谢谢……我会给你回礼的。"],"gacha":["我是阿尔克丝，接下来要和我一起去旅行吗？\n你好……阿尔克丝向你报到。没其他事的话，我就先走了。"]}},"itemFavor":[{"id":"item_27009","points":60,"name":"手工木制史莱姆","quality":2,"img":"/images/Common_ItemIcon/item_27009.webp"},{"id":"item_27010","points":85,"name":"先时迷宠造像","quality":3,"img":"/images/Common_ItemIcon/item_27010.webp"},{"id":"item_27011","points":120,"name":"魔神封印之壶","quality":4,"img":"/images/Common_ItemIcon/item_27011.webp"}]}