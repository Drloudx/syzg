:["phyAtk"],"typeLabels":["物理"],"elements":["water"],"elementLabels":["水"],"scaling":["phyAtk"],"scalingLabels":["物理攻击"],"multiplier":1,"segments":[{"damageType":"phyAtk","elementType":"water","scaling":"phyAtk","multiplier":1,"baseDamage":0}],"crit":"yes"},"bonuses":{"applies":["phyAtk","physicalDamage","physicalPenetration","waterDamage","normalDamage","normalAndSkillDamage"],"excludes":["skillDamage"]},"features":["多段"],"effects":[],"outcomes":["damage"],"outcomeLabels":["伤害"],"effectScalings":["phyAtk"],"effectScalingLabels":["物理攻击"],"conditions":["反击有30%概率触发，造成100%水属性普通攻击伤害并可暴击；触发后有4秒冷却。"],"notes":[],"sourceRefs":[]}}]}],"jobTraits":[{"id":"heroJob1Buff1","name":"援护打击","des":"当生命值高于 {25%} 时，会跳向并撞击 {5} 格内正在攻击我方弱势单位的敌人，造成 {100%} 物理攻击加成的物理伤害，同时将其设为当前攻击目标，并立即刷新 <【挑衅】> 的冷却时间，该效果有 {12} 秒冷却时间。","values":{"status":[{"label":"生效时机","value":"友方受到普通攻击时"}],"groups":[{"title":"伤害","items":[{"label":"伤害倍率","value":"100% 物理攻击"}]},{"title":"时间与层数","items":[{"label":"触发冷却","value":"12 秒"},{"label":"生命值判定阈值","value":"25%"}]}],"nested":[],"linked":[]}},{"id":"heroJob1Buff2","name":"挑衅","des":"普攻命中敌人时<嘲讽>目标 {1} 秒，并在 {3} 秒内获得 {15%} 的免伤效果，该效果有 {12} 秒冷却。","values":{"status":[{"label":"生效时机","value":"普通攻击时追加伤害"}],"groups":[{"title":"时间与层数","items":[{"label":"触发冷却","value":"12 秒"}]}],"nested":[],"linked":[{"id":"2100","name":"嘲讽","note":"","known":true},{"id":"job1Buff1AddBuff","name":"免伤","note":"","known":true}]}}],"archives":[{"title":"欢迎来到我们的营地！","desc":"埃迪蒂：你好，小工匠，我是来自魔爪湖的治安队队长埃迪蒂，擅长剑术和管理……\n埃迪蒂：你说不用那么正经？好吧，考虑到我是第一次在营地里和你见面，所以我就打算正经一点……\n埃迪蒂：不过我还是得正经地夸赞一下，你的营地布局合理且颇为美观，这让我非常佩服。\n埃迪蒂：这个送给你，就当成是我给你的礼物吧。\n埃迪蒂：既然已经成为了彼此依靠的伙伴，我会守护你直至最后一刻。","taskDesc":"","unlockFav":0,"type":4,"reward":{"id":"new_hero_first","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":1000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":50,"chance":1}]},"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{}},{"title":"契约信息","desc":"姓名：埃迪蒂\n所属：大市集治安队\n出身：四指村，魔爪湖\n技能：水之剑术\n住址：大市集东部住宅区2区12栋041\n武器：狂澜\n兴趣：自省，自知，自律，读小说\n契约附语：若看见任何无序之事，请立刻告知于我。","taskDesc":"","unlockFav":0,"type":0,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{}},{"title":"伙伴简介","desc":"　　对于在魔爪湖讨生活的人们来说，大市集的治安队队长埃迪蒂，一向是作为商会会长的左右手而广为人知。\n　　作为一名秩序的维护者，她总是表现得高效、冷酷、不近人情，震慑着每一个混迹于大市集的潜在危险分子。","taskDesc":"","unlockFav":0,"type":0,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{}},{"title":"恪守规则","desc":"　　然而，只要真正去了解埃迪蒂，便会发现她并非表面那般冷漠。她心底始终燃烧着守护正义的炽热火焰，而在她看来，正义之路的起点便是对规则的恪守，这便是构建公正世界的坚实基石。","taskDesc":"","unlockFav":5,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"phyAtk":200,"magicAtk":200}},{"title":"执剑英姿","desc":"　　埃迪蒂发来了信件。她说自己似乎陷入了瓶颈，想要来营地向你请求突破的方法。你决定帮她一把。","taskDesc":"　　若要选出一件能代表埃迪蒂的物件，那她手中的银剑必是不二之选。事实上，埃迪蒂对剑的钟爱之情也溢于言表。在治安队的训练场上，常能见到她挥舞她的宝贝银剑，剑光闪烁间，尽显她的飒爽英姿。","unlockFav":10,"type":1,"reward":{"id":"heroArchives01","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":1000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1}]},"mail":{"id":"mail_fav_hero_041_1","mailType":2,"title":"我的瓶颈期","content":"你好，[myName]：\n　　早已听说身为工匠的你实力非凡，想必你非常了解变强的方法。\n　　最近一段时间，我感觉自己的实力没有明显的进展。我采取了许多方法，却收效甚微。\n　　我想可能是我的理解能力有限，导致自己无法再度突破……但还有许多危险环伺在魔爪湖周围。\n　　我不能止步不前。我想到营地来拜访你，希望你能为我指点一二，拜托了！\n\n大市集的治安队长，\n埃迪蒂","hasAttachment":false,"reward":{"id":"heroArchives01","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":1000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1}]},"taskTypeId":"fav_hero_041_1","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_041_1","taskName":"遇到了瓶颈","dialogs":[{"id":"fav_hero_041_1_0","name":"埃迪蒂-遇到了瓶颈-营地对话"},{"id":"fav_hero_041_1_1","name":"埃迪蒂-遇到了瓶颈"}],"stats":{}},{"title":"自律非凡","desc":"　　出身贫寒的埃迪蒂自律非凡。\n　　　　她绝非对欲望无感：巡逻于大市集，鲜香烤肉、香甜糕点的气味，她同样能感知得到；然而她并不以为那是一种诱惑，更习惯回到宿舍，端起她的粗茶淡饭。","taskDesc":"","unlockFav":15,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"maxHp":500}},{"title":"受欢迎的队长","desc":"　　埃迪蒂再次发来了信件，邀请你一同去大市集，来指导她如何“休息”。","taskDesc":"　　虽说埃迪蒂平日里总是摆出一副冷酷的样子，但在大市集的街坊邻里眼中，她更像是一位和善的守护者。\n　　　　当埃迪蒂巡逻路过商铺时，店家们常常会热情地欢迎她，但她总是以工作为由婉言谢绝。一次，一群孩子包围了埃迪蒂，吵闹着非要埃迪蒂讲个故事不可。面对孩子们的热情，她最终无法拒绝，只得陪他们度过了一个愉快的午休。","unlockFav":20,"type":1,"reward":{"id":"heroArchives02","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":2000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_041_2","mailType":2,"title":"休息时间","content":"你好，[myName]：\n　　最近的工作没有之前那么繁重了，我终于可以抽出一天的空来休息。\n　　但正如我之前所说，我并不知道自己休息的时候该做什么……\n　　说来惭愧，我曾尝试去观察下属们的休息时间——但他们一下班就回家去了。\n　　我希望你能来大市集一趟，指导我如何像普通人一样“休息”。我会来营地接你的，拜托了。\n\n大市集的治安队长，\n埃迪蒂","hasAttachment":false,"reward":{"id":"heroArchives02","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":2000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":1,"chance":1}]},"taskTypeId":"fav_hero_041_2","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_041_2","taskName":"休息时间","dialogs":[{"id":"fav_hero_041_2_0","name":"埃迪蒂-休息时间-营地对话"},{"id":"fav_hero_041_2_1","name":"埃迪蒂-休息时间"}],"stats":{}},{"title":"贫民出身","desc":"　　很少有人知道，这位实力高强的治安队长，数年前还是一位贫民街出身的普通女孩。为了给重病的挚友筹集诊金，当时仅十二岁的她，常握着一把铁剑走出村子，像一名契约者般完成附近集镇发布的众多委托。她在磨砺中飞速成长，大兽潮来临前，她早已成为湖区闻名的小小剑客。","taskDesc":"","unlockFav":25,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"crit":5}},{"title":"剑侠之梦","desc":"　　收到了埃迪蒂发来的信件。她邀请你一同去贫民街一趟。这似乎和她小时候的事有关。","taskDesc":"　　《湖风剑侠志》是一本风靡魔爪湖的侠客小说，它影响了魔爪湖的许多孩子，年幼的埃迪蒂便是其中之一。正是这部小说让埃迪蒂梦想成为一名追求正义的剑客。\n　　　　多年过去以后，虽然埃迪蒂早已遗忘小说的具体情节，大兽潮也摧毁了她的过往，但这份追求正义的剑侠之梦却保留了下来，并一直在她的内心熊熊燃烧。","unlockFav":30,"type":1,"reward":{"id":"heroArchives03","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":3000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_041_3","mailType":2,"title":"我想和你去个地方","content":"你好，[myName]：\n　　许久未见，甚是想念。\n　　自从上次见面过后，我就一直在思考如何能让自己得到真正的“休息”。\n　　你说的停下脚步看看四周这句话有些启发了我，我有一个新的想法。\n　　我有一个请求，可以一起去贫民街一趟吗？\n　　我知道这个要求有些过分，但是我想了许久，还是希望能去那里。\n　　万分感谢！\n\n你的朋友，\n埃迪蒂","hasAttachment":false,"reward":{"id":"heroArchives03","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":3000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":1,"chance":1}]},"taskTypeId":"fav_hero_041_3","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_041_3","taskName":"剑侠之梦","dialogs":[{"id":"fav_hero_041_3_0","name":"埃迪蒂-剑侠之梦-营地对话"},{"id":"fav_hero_041_3_1","name":"埃迪蒂-剑侠之梦"}],"stats":{}},{"title":"笨拙的努力","desc":"　　埃迪蒂能取得如今这般瞩目的成就，并非仰仗习得了什么惊世骇俗的高超剑术，纯粹是靠着她那股子看似“笨拙”、实则坚毅无比的努力。\n　　　　她的天赋固然重要，但更关键的是她那坚定的意志与关怀他人的赤诚之心。正是这股力量，让她在困境中破茧成蝶，从贫民街的弱女子蜕变为守护一方的强者。","taskDesc":"","unlockFav":35,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"critDam":20}},{"title":"恶徒的噩梦","desc":"　　埃迪蒂发来了信件。再次邀请你一同去大市集一趟。赶快前去赴约吧。","taskDesc":"　　“她是幽灵，她是恶鬼。她在魔爪湖中徘徊，她会将所有罪恶摧毁。”\n　　　　最初是某个崇拜埃迪蒂的孩童编的小曲，不久便迅速传遍了魔爪湖，并衍生出了很多稀奇古怪的版本。但有一点人尽皆知：那个嫉恶如仇的治安队长早已成为令魔爪湖所有恶徒胆寒的“魔鬼”。","unlockFav":40,"type":1,"reward":{"id":"heroArchives04","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":4000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_041_4","mailType":2,"title":"再来见个面吧","content":"你好，[myName]：\n　　我最近又开始训练了。不过放心吧，我还是给自己留了一些休息的时间。\n　　但我觉得，还有些事情尚未明了。\n　　假期也近了，我想再请你一同去大市集一趟。\n　　那边开了一家新的餐馆，我想我们可以在那里好好消磨一些时光。\n\n你的朋友，\n埃迪蒂","hasAttachment":false,"reward":{"id":"heroArchives04","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":4000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":2,"chance":1}]},"taskTypeId":"fav_hero_041_4","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_041_4","taskName":"难解的误会","dialogs":[{"id":"fav_hero_041_4_0","name":"埃迪蒂-难解的误会-营地对话"},{"id":"fav_hero_041_4_1","name":"埃迪蒂-难解的误会\t"},{"id":"fav_hero_041_4_2","name":"埃迪蒂-难解的误会-2"}],"stats":{}},{"title":"朴实之剑","desc":"　　想当年，贫穷的她没钱拜师学艺，所能依靠的唯有自学。拔剑、挥斩、招架、刺击，这些最为基础的剑招，便是她日复一日刻苦练习的全部内容，她的剑术也仅仅由这些质朴无华的剑势组合而成。可埃迪蒂从不觉得这有何不妥，在她心中，始终笃定地认为：“剑不就只是这样而已吗？”凭借着这份质朴的坚持，她硬是闯出了属于自己的一片天地。","taskDesc":"","unlockFav":45,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"phyDef":500,"magicDef":500}},{"title":"不变的信念","desc":"　　成功突破的埃迪蒂发来了信件，希望能到你的营地做客。快同她聊聊吧。","taskDesc":"　　埃迪蒂心里清楚，世界远不像孩童哼唱的歌谣那般安宁平和。倘若哪天大兽潮的灾祸再度袭来，没人能保证深渊能再一次度过劫难。然而，就像她曾说过的那样，岁月流转，诸多事物都已改变。她的实力今非昔比，性格也有所蜕变，可那份守护家园的坚定信念，却从未有过一丝动摇。\n　　　　哪怕有朝一日，她又变回了当初那个在四指镇柔弱无助的小女孩，她也定会毫不犹豫地握紧手中的铁剑，勇敢无畏地向任何胆敢侵犯家园的恶人发起挑战。","unlockFav":50,"type":1,"reward":{"id":"heroArchives05","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":5000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1},{"id":"item_20004","name":"契约书","img":"/images/Common_ItemIcon/item_20004.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_041_5","mailType":2,"title":"突破完成了","content":"　　[myName]……\n　　自从得到你的帮助以后，我不仅突破了瓶颈，还更加明确了自己日后前进的方向。\n　　这一切离不开你的陪伴。如果没有你，我可能现在还在练功房里埋头苦练呢。\n　　我想……无论如何都要正式地感谢你。所以还希望能再一次拜访你的营地。\n　　拜托了。\n　　非常感谢你。\n\n你的朋友，\n埃迪蒂","hasAttachment":false,"reward":{"id":"heroArchives05","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":5000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":2,"chance":0.5},{"id":"item_20004","typeId":"item_20004","name":"契约书","img":"/images/Common_ItemIcon/item_20004.webp","quality":5,"count":1,"chance":0.5}]},"taskTypeId":"fav_hero_041_5","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_041_5","taskName":"篝火前的誓言","dialogs":[{"id":"fav_hero_041_5_0","name":"埃迪蒂-篝火前的誓言-营地对话"},{"id":"fav_hero_041_5_1","name":"埃迪蒂-篝火前的誓言"}],"stats":{}}],"behavior":{"chat":[{"dialog":"yd_041_01","min":0,"max":14},{"dialog":"yd_041_02","min":0,"max":14},{"dialog":"yd_041_03","min":0,"max":14},{"dialog":"yd_041_04","min":15,"max":29},{"dialog":"yd_041_05","min":15,"max":29},{"dialog":"yd_041_06","min":15,"max":29},{"dialog":"yd_041_07","min":30,"max":50},{"dialog":"yd_041_08","min":30,"max":50},{"dialog":"yd_041_09","min":30,"max":50}],"heroEvent":[{"day":1,"title":"对我们的营地感觉如何？","dialog":"sj_041_01"},{"day":3,"title":"在这里住得还舒服吗？","dialog":"sj_041_02"},{"day":7,"title":"（向有些躁动的埃迪蒂问好。）","dialog":"sj_041_03"}],"touch":[{"text":"不必担心，恶人无法在这里伤害大家，我会保护好这里的。","vocal":"motou_041_1","face":"emo_dot","min":0,"max":14},{"text":"锋利的宝剑不常保养便会损坏，优秀的战士不常训练便会怠惰。","vocal":"motou_041_2","face":"emo_dot","min":0,"max":14},{"text":"我希望我能继续保持强大，这样才有实力伸张正义。","vocal":"motou_041_3","face":"emo_dot","min":0,"max":14},{"text":"你问我有什么特别爱好？其实……我私底下一直对剑术感兴趣，这也算是我除工作外唯一的兴趣吧。","vocal":"motou_041_4","face":"emo_dot","min":15,"max":29},{"text":"无论遇到多么艰难的抉择，我都会遵循本心，为维护世间的正义而努力。","vocal":"motou_041_5","face":"emo_dot","min":15,"max":29},{"text":"呃……手里的这条鱼好像还没烤熟，我再起火烤一遍吧。","vocal":"motou_041_6","face":"emo_dot","min":15,"max":29},{"text":"那个……要来陪我一起练剑吗？我正好缺少一个强大的训练对手。","vocal":"motou_041_7","face":"emo_shock","min":30,"max":50},{"text":"只要在你的身旁，我就有种安心的感觉，或许是因为你我都拥有同一个理想……请让我与你一同战斗吧！","vocal":"motou_041_8","face":"emo_love","min":30,"max":50},{"text":"咳咳……我手上有几条买来的烤鱼，你要来试试吗？好吧，这是我自己烤的……","vocal":"motou_041_9","face":"emo_love","min":30,"max":50}],"walk":[{"text":"保持警惕，切勿松懈。","vocal":"luguo_041_1","face":"emo_dot","min":0,"max":14},{"text":"你还好吗？","vocal":"luguo_041_2","face":"emo_dot","min":0,"max":14},{"text":"打算去哪里？需要我来帮忙吗？","vocal":"luguo_041_3","face":"emo_dot","min":15,"max":50},{"text":"我随时等候着你的差遣。","vocal":"luguo_041_4","face":"emo_dot","min":15,"max":50}],"ziyanziyu":[{"text":"嗯……今天的任务完成了。","vocal":"ziyan_041_1","face":"emo_dot","min":0,"max":14},{"text":"我会坚守正义的道路，至死方休。","vocal":"ziyan_041_2","face":"emo_dot","min":0,"max":14},{"text":"我的利剑，会为世间一切正义事业而挥舞。","vocal":"ziyan_041_3","face":"emo_dot","min":15,"max":50},{"text":"有时间吗？来和我一起练剑怎么样？","vocal":"ziyan_041_4","face":"emo_dot","min":15,"max":50}],"explore":{"start":["还等什么？探索开始了。","跟上我的脚步！"],"fight":["呵，一口气解决吧！","休想阻拦我！","干掉它们。"],"win":["一个不剩！","继续前行！","漂亮的一仗。"],"explore