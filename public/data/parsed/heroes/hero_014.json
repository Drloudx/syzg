el":4},{"key":"starSkill4","id":"01408","icon":"skill_01408","name":"山狐技巧","levelData":[{"level":1,"name":"山狐技巧","des":"皮塔施展山狐族的残忍绝技，{普通攻击} 能对敌人附加 {5} 秒的 {流血} 效果，使其每秒受到 {15%物理攻击} 加成的物理伤害。","cost":30}],"maxLevel":1}],"talentSkills":[{"id":"01404","icon":"skill_01404","name":"精准创伤","levelData":[{"level":1,"name":"精准创伤","des":"皮塔向 {流血} 敌人的伤口发动追击，对陷入 {流血} 状态的敌人额外造成 {30%物理攻击} 加成的物理伤害。","mechanics":{"reviewStatus":"verified","damage":{"form":"none","formLabel":"无直接伤害","types":[],"typeLabels":[],"elements":[],"elementLabels":[],"scaling":[],"scalingLabels":[],"multiplier":0,"segments":[],"crit":"na"},"bonuses":{"applies":[],"excludes":[]},"features":[],"effects":[],"outcomes":["statBuff"],"outcomeLabels":["属性增益"],"effectScalings":["phyAtk"],"effectScalingLabels":["物理攻击"],"conditions":["对处于【流血】状态的敌人进行普通攻击时，该次普攻对流血标签伤害加成提高30%，不单独造成额外一段伤害。"],"notes":[],"sourceRefs":[]}}]}],"jobTraits":[{"id":"job-5-1","name":"连攻","des":"连续普通攻击若干次后，会施展一次特殊的连段普攻，额外造成 {100%} 物理攻击力加成的总伤害。","values":null},{"id":"heroJob5Buff","name":"迅闪","des":"战斗状态下，受到敌人普通攻击时会闪避并躲避该次攻击，并使以自身为目标的敌人 {60%} 概率丢失目标，同时下一次普通攻击可立即触发 <【连攻】> ，该效果有 {6} 秒冷却时间。","values":{"status":[],"groups":[{"title":"时间与层数","items":[{"label":"触发冷却","value":"6 秒"}]}],"nested":[],"linked":[]}}],"archives":[{"title":"欢迎来到我们的营地！","desc":"皮塔：哟！小工匠老大，之前一直没碰到你，现在终于和你搭话啦！\n皮塔：看看这营地的布置，隐蔽性一流，陷阱位也留得地道。不愧是老大，以后我在这儿混啦！\n皮塔：有什么需要打探的情报，或者说需要有人出手解决的麻烦，尽管交给我就好。\n皮塔：来，这是我特意从巴诺姆村搜罗来的好东西，就当是我的入伙费啦。\n皮塔：别客气，老大！以后咱们就是一条绳上的蚱蜢，你的敌人就是我皮塔的敌人！","taskDesc":"","unlockFav":0,"type":4,"reward":{"id":"new_hero_first","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":1000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":50,"chance":1}]},"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{}},{"title":"契约信息","desc":"姓名：皮塔\n所属：巴诺姆自卫团\n出身：索利德山\n技能：任何你能想到的游荡者技能\n住址：巴诺姆村，索利德山地\n武器：游荡者双刃\n兴趣：捣蛋，恶作剧，跟着大姐头和老大混\n契约附语：大姐头不在，你就是我的老大！我们接下来要去对付谁？","taskDesc":"","unlockFav":0,"type":0,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{}},{"title":"伙伴简介","desc":"　　皮塔是巴诺姆村自卫团的成员，目前在村中负责护卫工作。仅从外表看，瘦弱的皮塔总透着人畜无害的气质；但熟悉他的人都清楚，他完全配得上山狐族狡猾的本性——那副无害的模样不过是他精心伪装的表象罢了。","taskDesc":"","unlockFav":0,"type":0,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{}},{"title":"战利品收集者","desc":"　　皮塔喜欢收集各种各样的战利品，无论是金光闪闪的耳环，还是木制的雕像，都会被他放入收纳皮包当中。\n　　这个习惯部分源自山狐的习惯，更多是源于皮塔的虚荣。皮塔毫不掩饰自己那爱慕虚荣的想法，并将战利品当成是自己荣耀的证明。","taskDesc":"","unlockFav":5,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"phyAtk":200,"magicAtk":200}},{"title":"喜爱分享的大哥","desc":"　　皮塔发来信件，说村子里似乎进了贼，想向你求助。","taskDesc":"　　皮塔乐于将战场上的战利品据为己有，但也乐于将这些战利品分享给自己的下属，甚至愿意舍身帮助手下拿到想要的东西。比如皮塔一个下属喜欢的水晶被哈比叼走了，皮塔会连续跑一座山把那个水晶抢回来送给手下。\n　　虽然这种行为通常被认为是收买人心，但皮塔的行为显然更像是大哥照顾小弟，是一种不求任何回报的付出。","unlockFav":10,"type":1,"reward":{"id":"heroArchives01","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":1000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1}]},"mail":{"id":"mail_fav_hero_014_1","mailType":2,"title":"请你帮个忙","content":"[myName]：\n　　嘿嘿，我的好伙伴，你近日身体可好，可有空余时间？\n　　听说你是个超厉害的工匠，那你一定能打造各种各样的设备，我这里有个大活儿想要请你帮忙，那就是打造一个防护用的陷阱。\n　　具体内容和价钱可以慢慢聊嘛，正好我也想来你的营地做客，你一定会欢迎我的吧？\n\n皮塔","hasAttachment":false,"reward":{"id":"heroArchives01","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":1000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1}]},"taskTypeId":"fav_hero_014_1","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_014_1","taskName":"请你帮个忙","dialogs":[{"id":"fav_hero_014_1_0","name":"皮塔-营地对话【欢迎来到营地。】"},{"id":"fav_hero_014_1_1","name":"皮塔-请你帮个忙-进入战役"}],"stats":{}},{"title":"聪慧与狡诈","desc":"　　“皮塔可聪明了！呃，到底有多聪明？反正他给自卫团的大家出了不少主意！”\n　　阴险狡猾是皮塔的代名词，尽管他瘦小的身形不适合硬碰硬的战斗，他却总能利用敏捷和聪慧填充力量上的不足，通过高超的计谋击败强大的对手。","taskDesc":"","unlockFav":15,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"maxHp":500}},{"title":"巴诺姆村的狐影","desc":"　　皮塔发来了邮件，准备抓住那些小贼。","taskDesc":"　　皮塔既是巴诺姆自卫团中受人尊重的领导，也是行走在村中各条小巷角落的混混头子。\n\n　　为了避免村里的各种帮派、混混走向极端，皮塔总会在各处奔波，划好各个帮派的地盘，定下斗争的规则。直到现在巴诺姆村的每个地下组织都有皮塔的影子。","unlockFav":20,"type":1,"reward":{"id":"heroArchives02","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":2000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_014_2","mailType":2,"title":"抓住那些小贼","content":"[myName]：\n　　嘿！我有个好消息要告诉你，我大概找到那群小贼的行踪了！\n　　前几天护卫报告，在墙上发现了奇怪的记号，我一看就知道那是踩点人做的记号。他们会根据记号判断屋子的情况，等到下手的时候就根据记号行事。他们非常专业，不过可瞒不过我这个老狐狸。\n　　不过他们有多少人手我还不太清楚，可以请你来一起帮我抓住那些小贼吗？拜托啦！\n\n皮塔","hasAttachment":false,"reward":{"id":"heroArchives02","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":2000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":1,"chance":1}]},"taskTypeId":"fav_hero_014_2","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_014_2","taskName":"抓住那些老伙伴","dialogs":[{"id":"fav_hero_014_2_0","name":"皮塔-营地对话【要准备去蹲守小贼了吗？】"},{"id":"fav_hero_014_2_1","name":"皮塔-抓住那些老伙伴-进入战役"}],"stats":{}},{"title":"大哥说得对！","desc":"　　得益于皮塔高超的才能以及大方的性格，他在村中的声望非常高，哪怕在小混混的心目中也不例外。\n　　许多喜欢打架、打劫的混混都声称：“我们学的是皮塔大哥！”这让皮塔感觉很头疼，虽然这些人的目的都是为了劫富济贫、行侠仗义，但大部分人的做法只会给大家带来麻烦，而这一切的源头，都被归结到皮塔这个大哥身上。","taskDesc":"","unlockFav":25,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"crit":5}},{"title":"与小弟同行之日","desc":"　　皮塔发来了邮件，想要和你商量捉小偷的计划。","taskDesc":"　　尽管崇拜者总会给自己带来麻烦，但只要能够听话，皮塔还是很乐意带一带这些小弟的。\n\n　　在自卫团例行保护车队外出时，皮塔会带上一两个小弟加入，这既是为了锻炼小弟，也是为了缓解自卫团的压力，在面对其他任务时他也会采取这样的做法。这也使得无论在何处看见皮塔，总能在他身旁看见一两个紧跟他的小弟。","unlockFav":30,"type":1,"reward":{"id":"heroArchives03","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":3000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_014_3","mailType":2,"title":"激情的灰霾岁月","content":"[myName]：\n　　哎呀，在调查了几天以后，依旧没有那几个小崽子的消息。或许他们知道面对的人是我，所以才格外谨慎，几天下来连个毛都没露出来。\n　　眼下我的脑子是想不出来对付他们的办法了，可以来向你请教请教吗？虽然我对我的智谋很有信心，但比起你还是差太多了，所以我想来拜访你的营地，希望你能提一些逮住那群小崽子的建议。\n\n皮塔","hasAttachment":false,"reward":{"id":"heroArchives03","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":3000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":1,"chance":1}]},"taskTypeId":"fav_hero_014_3","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_014_3","taskName":"激情的灰霾岁月","dialogs":[{"id":"fav_hero_014_3_0","name":"皮塔-营地对话【欢迎再次光临营地，皮塔。】"},{"id":"fav_hero_014_3_1","name":"皮塔-激情的灰霾岁月-进入战役"}],"stats":{}},{"title":"励志的混混头子","desc":"　　在刚来到巴诺姆村，正式加入自卫团之前，皮塔也是在村子各个角落里流浪的混混。\n　　为了在恶劣的环境中生存下来，皮塔总会带着伙伴通过承接委托的方式获得生存资源。在那段时间，他们小心扩张地盘，招收小弟壮大势力。宝贵的是，无论要做多么疯狂的事情，皮塔和他的伙伴也总是保持底线。这也是他留给大家的印象。\n　　在巴诺姆村恢复秩序以前，皮塔便已经成为有着一些名声的混混头子，在遇到麻烦的时候都可以找他解决。","taskDesc":"","unlockFav":35,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"critDam":20}},{"title":"被揍来的智囊","desc":"　　再见面，小工匠发现小弟已经跟在皮塔身后，原来他被皮塔狠狠教训之后，被迫加入了自卫团。皮塔感叹果然还是棍棒好使，对于他们这样的人来说，只有这样才能让他们走上正路。对于米拉贝尔当年的“劝说”，皮塔非常感激。","taskDesc":"　　在巴诺姆村恢复秩序后，皮塔曾与米拉贝尔发生过多次冲突。在皮塔被米拉贝尔揍了一顿后，他便自愿进入米拉贝尔的麾下，成为了巴诺姆自卫团的一员。\n\n　　在自卫团中，皮塔是当之无愧的智囊。在他的帮助下，巴诺姆自卫团增添了许多新鲜的战法，这些战法减少了自卫团在许多行动上的损失。据皮塔所说，这些主意是他在村子多年瞎混所学到的，现在终于派上用场了。\n\n　　面对这个聪慧的智囊，米拉贝尔常常为自己当初的选择而沾沾自喜。她总喜欢戏称这个智囊是她“用锤子揍出来的。”","unlockFav":40,"type":1,"reward":{"id":"heroArchives04","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":4000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_014_4","mailType":2,"title":"改过自新的旧友","content":"[myName]：\n　　嗯……距离上次见面已经好一阵子了吧，我最近忙着去筹备计划，所以没有来联系你，你可别往心里去呀。\n　　这次我想来你的营地做做客，顺便给你一个惊喜，希望你能喜欢。\n\n皮塔","hasAttachment":false,"reward":{"id":"heroArchives04","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":4000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":2,"chance":1}]},"taskTypeId":"fav_hero_014_4","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_014_4","taskName":"改过自新的旧友","dialogs":[{"id":"fav_hero_014_4_0","name":"皮塔-营地对话【欢迎光临……】"},{"id":"fav_hero_014_4_1","name":"皮塔-改过自新的旧友-进入战役"}],"stats":{}},{"title":"自卫团的救赎","desc":"　　在加入自卫团后，皮塔的理想发生了重大改变。他从一个为生存努力的混混，变为一位为村子复兴而努力的自卫团成员。这层身份转变一直让皮塔非常自豪，他认为这是对他人生的一场救赎。\n　　“毕竟一个为改变世界而努力的人，听起来怎么也比混混要帅，不是吗？”","taskDesc":"","unlockFav":45,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"phyDef":500,"magicDef":500}},{"title":"狐狸大哥哥","desc":"　　一段时间过去后，皮塔带着小弟来营地。小工匠本来还担心小弟会不会不服气，但小弟已经成为了米拉贝尔的超级迷弟。皮塔感谢小工匠的帮助，让小弟迷途知返。他会一直记得小工匠的恩情，就像记得米拉贝尔的恩义一样。","taskDesc":"　　皮塔会经常和巴诺姆村的孩子们一起玩耍，他尤其喜欢用一些小伎俩换取孩子们的崇拜。\n\n　　比如每当向山下人学会魔术后，皮塔就迫不及待地在孩子面前表演魔术。当听见孩子们的赞扬时，皮塔也会激动地哈哈大笑。比起击倒敌人后获得的掌声，皮塔还是更喜欢孩子们天真的赞许。\n\n　　或许他内心所追求的，便是成为能为所有人解决问题的狐狸大哥哥。","unlockFav":50,"type":1,"reward":{"id":"heroArchives05","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":5000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1},{"id":"item_20004","name":"契约书","img":"/images/Common_ItemIcon/item_20004.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_014_5","mailType":2,"title":"来吃一餐饭吧","content":"[myName]：\n　　嘿！瞧我这记性，差点忘了请你吃饭这回事呢。刚想起这件事我就立马给你写信了，希望还不算晚。\n　　要不要来巴诺姆村一趟？这里刚好正在举办美食活动，我可以给你开个小灶，让咱们两个能在一个比较安静的地方享用一餐。\n　　希望你能同意邀请，我会亲自来营地接你的。\n\n皮塔","hasAttachment":false,"reward":{"id":"heroArchives05","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":5000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":2,"chance":0.5},{"id":"item_20004","typeId":"item_20004","name":"契约书","img":"/images/Common_ItemIcon/item_20004.webp","quality":5,"count":1,"chance":0.5}]},"taskTypeId":"fav_hero_014_5","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_014_5","taskName":"信任的火焰","dialogs":[{"id":"fav_hero_014_5_0","name":"皮塔-营地对话【我来赴约了。】"},{"id":"fav_hero_014_5_1","name":"皮塔-信任的火焰-进入战役"}],"stats":{}}],"behavior":{"chat":[{"dialog":"yd_014_01","min":0,"max":14},{"dialog":"yd_014_02","min":0,"max":14},{"dialog":"yd_014_03","min":0,"max":14},{"dialog":"yd_014_04","min":15,"max":29},{"dialog":"yd_014_05","min":15,"max":29},{"dialog":"yd_014_06","min":15,"max":29},{"dialog":"yd_014_07","min":30,"max":50},{"dialog":"yd_014_08","min":30,"max":50},{"dialog":"yd_014_09","min":30,"max":50}],"heroEvent":[{"day":1,"title":"对我们的营地感觉如何？","dialog":"sj_014_01"},{"day":3,"title":"在这里住得还舒服吗？","dialog":"sj_014_02"},{"day":7,"title":"在东张西望什么？","dialog":"sj_014_03"}],"touch":[{"text":"怎么啦，有什么契约需要我吗，老大？","vocal":"motou_014_1","face":"emo_dot","min":0,"max":14},{"text":"感觉我们有不少共通点呢。比如？呃……很会埋陷阱之类的？","vocal":"motou_014_2","face":"emo_dot","min":0,"max":14},{"text":"只要能让我变强，你就尽管差使我吧，老大！","vocal":"motou_014_3","face":"emo_dot","min":0,"max":14},{"text":"我们去找点东西打吧，叫上卡夫一起，怎么样啊～！","vocal":"motou_014_4","face":"emo_love","min":15,"max":29},{"text":"险山峻岩里呆久了，到这青山绿水里还真不习惯……当然，我可不讨厌这儿！","vocal":"motou_014_5","face":"emo_love","min":15,"max":29},{"text":"打架要想赢，可不全靠肌肉和武器，更得靠脑筋。嘿嘿，咱们这点很相似呢，老大！","vocal":"motou_014_6","face":"emo_love","min":15,"max":29},{"text":"我之前也有过迷茫，是大姐头带我重新走上正道。我很感谢她，当然还有愿意相信我的你，老大！","vocal":"motou_014_7","face":"emo_love2","min":30,"max":50},{"text":"有烦恼的事吗？只用告诉我去哪里干掉几个就好，我会帮你处理的。放心，绝对……利索。","vocal":"motou_014_8","face":"emo_love2","min":30,"max":50},{"text":"让曾是小偷的我负责营地的警卫吗……呵，我不会辜负你的信任，老大！","vocal":"motou_014_9","face":"emo_love2","min":30,"max":50}],"walk":[{"text":"一直呆着好闲啊，手都痒了。","vocal":"luguo_014_1","face":"emo_amazed","min":0,"max":14},{"text":"有接到什么好差事吗？","vocal":"luguo_014_2","face":"emo_amazed","min":0,"max":14},{"text":"唷，该去找点乐子啦！","vocal":"luguo_014_3","face":"emo_amazed","min":15,"max":50},{"text":"有事记得叫我啊，我不挑的！","vocal":"luguo_014_4","face":"emo_amazed","min":15,"max":50}],"ziyanziyu":[{"text":"悄无声息接近……从阴影中到来。","vocal":"ziyan_014_1","face":"emo_dot","min":0,"max":14},{"text":"在道上混，可要眼观四面，耳听八方。","vocal":"ziyan_014_2","face":"emo_dot","min":0,"max":14},{"text":"这里还真是和平呢……不过，还是要随时保持警惕。","vocal":"ziyan_014_3","face":"emo_dot","min":15,"max":50},{"text":"呼啊～好闲……不知道伙伴在忙些什么呢～？","vocal":"ziyan_014_4","face":"emo_dot","min":15,"max":50}],"explore":{"start":["探索开始了哦～","都跟紧点，丢了我可不管。"],"fight":["前方发现敌人，准备战斗！","你们负责牵制，我来偷袭！","准备好了吗，我要上咯！"],"win":["嘻嘻嘻，有我在，肯定没法输！","赶快搜刮那些家伙们身上有没有咱们要的东西。","我的计策不错吧！"],"exploreTalk":["嘻～我闻到宝箱的味道了。","我已经知道去哪儿能找到我们想要的东西了。","要说我最熟悉的地方，当然是山野啦。到时候就由我来带路。"],"loopEnd":["收获还挺丰盛嘛，放心交给我，一个也不会落下。","金钱的味道，真令人兴奋！"],"readyGoHome":["哦？不继续探索了吗，说不定前方还有值钱的玩意儿呢！","收工收工，我的尾巴都累蔫了。"],"over":["还是闲下来舒服。","哎，我也喜欢你们这营地的氛围，轻松又自在！"],"roomFinishMember":["快刀斩乱麻！","嘻，真是轻松。","这种程度连卡夫都能轻松应付。"],"roomFinishLeader":["来点更激烈的战斗，让我享受享受！","我的计策不错吧！","大家跟紧点哦，走丢了我可不管！"],"getGift":["哇呀，送我的礼物？多谢、多谢！","礼物？给我的吗？哇，这可得好好珍藏了！谢谢！"],"gacha":["巴诺姆村自卫团副团长，皮塔！从今往后，我的利刃供你差遣。\n可别让它们变钝啦，老大！"]}},"itemFavor":[{"id":"item_27006","points":60,"name":"水风铃花环","quality":2,"img":"/images/Common_ItemIcon/item_27006.webp"},{"id":"item_27007","points":85,"name":"灼热翡翠项坠","quality":3,"img":"/images/Common_ItemIcon/item_27007.webp"},{"id":"item_27008","points":120,"name":"魔爪氪金手镯","quality":4,"img":"/images/Common_ItemIcon/item_27008.webp"}]}