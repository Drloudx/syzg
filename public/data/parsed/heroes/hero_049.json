ents":[],"crit":"na"},"bonuses":{"applies":[],"excludes":[]},"features":["普攻命中附加减速"],"effects":["移动速度降低20%"],"outcomes":["statDebuff"],"outcomeLabels":["属性削弱"],"effectScalings":[],"effectScalingLabels":[],"conditions":[],"notes":[],"sourceRefs":[]}}]}],"jobTraits":[{"id":"heroJob4Buff","name":"猎人标记","des":"对同一目标的连续普通攻击，会获得可叠加的攻速加成，每层可提升 {5%} 的攻击速度，最高可叠加到 {6} 层，切换目标时丢失一半层数。","values":{"status":[{"label":"生效时机","value":"普通攻击造成伤害时"}],"groups":[],"nested":[],"linked":[{"id":"heroJob4BuffAddBuff","name":"猎人标记","note":"","known":true}]}}],"archives":[{"title":"欢迎来到我们的营地！","desc":"菲莉娜：嗨！小工匠，这是我第一次在营地里和你打招呼！\n菲莉娜：当契约者多年，我自认已经见过许多建立在野外的营地，但像你这种规模大且功能齐全的营地，我还是第一次看见。\n菲莉娜：果然和你在一起就能开拓眼界，加入你的营地，对我来说也是一种全新的冒险。\n菲莉娜：对了……在背包里装着呢……给！这是我从山上带下来的礼物，希望你能喜欢。\n菲莉娜：今后的路还长着……如果遇到什么解决不了的麻烦，尽管依靠我这个契约者前辈吧！","taskDesc":"","unlockFav":0,"type":4,"reward":{"id":"new_hero_first","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":1000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":50,"chance":1}]},"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{}},{"title":"契约信息","desc":"姓名：菲莉娜\n所属：驿站契约者\n出身：索利德山\n技能：箭术，猎术，登山术\n住址：巴诺姆村北部营地\n武器：大地之怒\n兴趣：社交，做契约任务\n契约附语：驿站那边也请你多给我些面子啦！","taskDesc":"","unlockFav":0,"type":0,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{}},{"title":"伙伴简介","desc":"　　菲莉娜继承了传说中的魔物“金鹿”的血脉，头顶的巨角与龙尾般粗壮的鹿尾，正是其血脉和力量的证明。\n　　这份血统赋予了菲莉娜两种常人难以想象的神奇馈赠：远超常人的体能，使她能够拉开二十人方能拉动的强弓，而号令大地的魔力，则让她在险峰之间如履平地，为她赢得了“傲崖的金鹿”这一美名。","taskDesc":"","unlockFav":0,"type":0,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{}},{"title":"流离的命运","desc":"　　由于在故乡，魔物血脉被视为不祥之兆，菲莉娜自幼就受到左邻右舍的嫌弃和迫害。为了保护女儿，菲莉娜的父母不得不带着年仅六岁的她逃出村子，昏头转向之中落入了危机四伏的深渊。如果没有奇遇，菲莉娜一家恐怕最多三天就会成为魔物的腹中美餐；万幸，驿站前代领袖哈萨琳及时发现了她们。这次邂逅，也成了菲莉娜就职契约者的契机。","taskDesc":"","unlockFav":5,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"phyAtk":200,"magicAtk":200}},{"title":"山民之友","desc":"　　菲莉娜发来了信件。她说有件事需要你的帮忙。","taskDesc":"　　似乎是出于某种天生的亲和力，驿站的来往者似乎都成为了菲莉娜的熟人。菲莉娜本人对此并无自觉，她只是乐于向陷入困境者伸出援手。这份热忱也让她深得驿站的器重。\n　　“她是为数不多受到巴诺姆民众仰赖的外来者。”某位山民说道，“当年矿山危机，她二话不说就帮了我们住民许多忙。这份情谊实在难以忘怀。”","unlockFav":10,"type":1,"reward":{"id":"heroArchives01","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":1000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1}]},"mail":{"id":"mail_fav_hero_049_1","mailType":2,"title":"难以启齿的请求","content":"[myName]：久疏问候！\n　　自索利德山一别，我们已经有一段时间没见了。\n　　请原谅我这么久都没有上门拜访，实在是现实状况让我难以成行。\n　　虽然大的威胁已经消除，但索利德山战力缺乏的问题始终没有改变，这也让我计划中的休假，变得遥遥无期。但最近，由于某种缘故，我不得不上门请求你的帮助。我知道因为公事上门多少有些扫兴，但我思来想去，能够帮到我的，也只有你了。\n　　但愿你不要因此认为我是一个无事不登门的势利之徒。为表歉意，我会带着山地的新鲜猎获作为伴手礼，希望你会喜欢。\n\n诚惶诚恐的，\n菲莉娜","hasAttachment":false,"reward":{"id":"heroArchives01","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":1000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1}]},"taskTypeId":"fav_hero_049_1","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_049_1","taskName":"难以启齿的请求","dialogs":[{"id":"fav_hero_049_1_0","name":"菲莉娜-你还真的带了猎物来啊！"},{"id":"fav_hero_049_1_1","name":"菲莉娜-难以启齿的请求-进入战役"}],"stats":{}},{"title":"大地的弓弦","desc":"　　菲莉娜并未接受过任何魔法方面的教导，她所掌握的全部战技，都是凭借她自己的艰苦训练和灵光一闪，独自摸索出来的。透过金鹿血脉之力，菲莉娜能将土属性的力量灌注到箭矢之中，化作宛如流星坠落，足以震撼大地的魔箭。菲莉娜曾被嘱托向其他契约者传授这门技艺，但到最后也没有人能够学会她一招半式。","taskDesc":"","unlockFav":15,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"maxHp":500}},{"title":"哈萨琳之箭","desc":"　　菲莉娜再次发来了信件，想要结束这场追猎。","taskDesc":"　　作为被哈萨琳拯救的其中一人，菲莉娜就如同其他追随者一样，对哈萨琳有着十二分的孺慕和憧憬。也正因此，菲莉娜比一般人更加无法容忍“哈萨琳之手”，这个自称哈萨琳的继承者，却毫无底线的组织。因为在她心中，哈萨琳的名誉，比自己的生命更加重要。","unlockFav":20,"type":1,"reward":{"id":"heroArchives02","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":2000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_049_2","mailType":2,"title":"狩猎即将开始","content":"[myName]：你好！\n　　最近这段时间，我都在野外排查猎物的活动区域。\n　　虽然这是一个非常狡猾的敌人，但在细心搜索之下，我还是成功抓到了一些蛛丝马迹。\n　　现在我基本可以肯定，那家伙的猎场基本就在索利德山东部，接下来只等你的陷阱做好，我们就可以开始这次狩猎了。\n　　不知道你那边准备得怎么样？\n　　一想到这场长达十几年的追逐即将结束，就连我……居然都开始有些迫不及待起来了。\n\n你的朋友，\n菲莉娜","hasAttachment":false,"reward":{"id":"heroArchives02","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":2000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":100,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":1,"chance":1}]},"taskTypeId":"fav_hero_049_2","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_049_2","taskName":"狩猎即将开始","dialogs":[{"id":"fav_hero_049_2_0","name":"菲莉娜-你要的陷阱做好了！"},{"id":"fav_hero_049_2_1","name":"菲莉娜-狩猎即将开始-进入战役"}],"stats":{}},{"title":"精英猎手","desc":"　　即使撇开自身的强大力量，菲莉娜在猎人方面的造诣也非同小可。沃夫加曾经应哈萨琳之请教导菲莉娜一些野外生存的技巧，但没过两个月，沃夫加就宣布，菲莉娜已经青出于蓝。虽然菲莉娜总是说，自己还有很多东西要向沃夫加老师学习，但皮塔对此显然有不同的看法。“那就是菲莉娜大姐的可怕之处！”这位狐人斥候如是说，“那种把你吞食一空之后还不满足的贪婪，没有什么比这更加可怕了！”","taskDesc":"","unlockFav":25,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"crit":5}},{"title":"面子的力量","desc":"　　收到了菲莉娜发来的信件。她想接你去陷阱处看看。","taskDesc":"　　菲莉娜从不吝于为人付出，这让她积累了广泛的人脉。遇到任何问题，菲莉娜都能找到合适的人选来解决，这种状况也反过来使得人们更乐意于帮助菲莉娜，小小地赚一个人情。久而久之，菲莉娜的“面子”就变得非常有用，有时候遇到闹事的人或者恶党，只要让他们“卖一个面子”就能让他们知难而退。但世上总有看不清形势的蠢辈，这种时候菲莉娜就会用实力让他们变得心甘情愿起来。","unlockFav":30,"type":1,"reward":{"id":"heroArchives03","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":3000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_049_3","mailType":2,"title":"棘手的问题","content":"[myName]：你好！\n　　很抱歉这么快又来打扰你，但我现在遇到了一个非常棘手的问题。\n　　你能抽时间到陷阱这里来看看吗？我会尽快过去接你的，还请做好准备！\n\n菲莉娜","hasAttachment":false,"reward":{"id":"heroArchives03","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":3000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":1,"chance":1}]},"taskTypeId":"fav_hero_049_3","getTaskText":"赴约","image":""},"taskTypeId":"fav_hero_049_3","taskName":"棘手的问题","dialogs":[{"id":"fav_hero_049_3_0","name":"菲莉娜-情况怎么样了？"},{"id":"fav_hero_049_3_1","name":"菲莉娜-棘手的问题-进入战役"}],"stats":{}},{"title":"独行之伤：其一","desc":"　　在大家的印象里，菲莉娜一直都是一个十分爽朗亲切的人，但很少有人注意到，菲莉娜其实一直都在独来独往，从来不会组成固定的小队，大多数时候都是孤身一人。因为不想悲剧重演，那就干脆一人独行……这种心理大概决不能说是正确的。但对菲莉娜来说，这已经是她能作出的最好的选择。如果想要跨越这道伤痕，那恐怕，必须等到大仇得报的那一日……","taskDesc":"","unlockFav":35,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"critDam":20}},{"title":"独行之伤：其二","desc":"　　菲莉娜发来了信件，想要解决掉这场恩怨狩猎。但来访营地的人却是皮塔……","taskDesc":"　　除了心中隐含的恐惧，还有另一个原因促使菲莉娜一直离群索居，那就是通过坚持孤独，来换取精神上的坚强。菲莉娜坚信，为了取得复仇的胜利，自己必须永远保持在最佳状态，而坚强的精神和灵魂，则是维持状态的重要保证。没有人能够证明，这个观点究竟是对是错，不过菲莉娜显然说服了自己，一直坚持了下来。这当然也带来了一些问题，比如让她习惯于一个人应对危险……不过幸运的是，从今往后，她应该会记得这个教训，不再冲动行事了。","unlockFav":40,"type":1,"reward":{"id":"heroArchives04","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":4000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"chance":1}]},"mail":{"id":"mail_fav_hero_049_4","mailType":2,"title":"我有预感……！","content":"[myName]：你好！\n　　如我所料，那东西果然是个难缠的对手。\n　　自从上次吃了亏之后，那东西就转移到了新的巢穴，以至于整个行动都得从侦查开始从头再来。\n　　不过那东西终究还是小看了我！在经过了半个月的艰苦搜寻之后，我终于找到了那东西的新家，并在它的必经之路上装上了经你改良过的便携式魔法陷阱。\n　　我有预感，这次的战斗将会是最后一次，而且时间就在这两天！\n　　从现在开始，我会全身心地投入到最后的备战之中，在解决掉这场恩怨之前，我都不会再给你去信了。不过不要担心，这一次一定是我的胜利！我会带着成功的消息去找你的！\n\n你的朋友，\n菲莉娜","hasAttachment":false,"reward":{"id":"heroArchives04","items":[{"id":"money","typeId":"item_00001","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":4000,"chance":1},{"id":"ke","typeId":"item_00002","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","typeId":"item_20023","name":"特别招待券","img":"/images/Common_ItemIcon/item_20023.webp","quality":5,"count":2,"chance":1}]},"taskTypeId":"fav_hero_049_4","getTaskText":"接受","image":""},"taskTypeId":"fav_hero_049_4","taskName":"我有预感……！","dialogs":[{"id":"fav_hero_049_4_0","name":"菲莉娜-嗯？皮塔，你怎么来了？"},{"id":"fav_hero_049_4_1","name":"菲莉娜-我有预感……！-进入战役"}],"stats":{}},{"title":"蹩脚的独居","desc":"　　很难相信，一位一流的猎人，居然会住在这样一个环境之中。“那里简直没有一丝一毫的生活气息。”前来照顾菲莉娜养伤的小工匠如是评价。比起如何幸福地生活，菲莉娜将更多的精力放在了训练和工作之上。但在大仇得报的现在，或许菲莉娜终于可以尝试一些不一样的生活方式……比如，从收拾好自己的小木屋开始。","taskDesc":"","unlockFav":45,"type":3,"reward":null,"mail":null,"taskTypeId":"","taskName":"","dialogs":[],"stats":{"phyDef":500,"magicDef":500}},{"title":"今后的打算","desc":"　　菲莉娜发来了信件，希望你能原谅她的鲁莽。","taskDesc":"　　问及今后的打算，菲莉娜似乎并没有考虑得太多。当心中的重担终于移开，少女才发现，自己的人生早已原地踏步了太久太久。但说到底，似乎也无需过多担忧——虽然没有了目标，但菲莉娜还有这么长时间以来认识的众多朋友。生活还在继续，友人都在身边，那么只需前进便是！在二十四岁的当口，菲莉娜精简行装，终于再次踏上了人生的旅途。","unlockFav":50,"type":1,"reward":{"id":"heroArchives05","items":[{"id":"money","name":"银币","img":"/images/Common_ItemIcon/item_00001.webp","quality":5,"count":5000,"chance":1},{"id":"ke","name":"氪金","img":"/images/Common_ItemIcon/item_00002.webp","quality":5,"count":200,"chance":1},{"id":"item_20023","name":"特别招待券","img":