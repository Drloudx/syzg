"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":80,"bright":0.6,"transTime":300,"y":-204,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara004_1","addImg":"chara004_1_face_chara004_1c","scaleY":1},"key":"moveLayer"},{"para":{"layer":"chara3","img":"chara025_1_face_chara025_1g"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara3","noOut":false,"x":510,"bright":1,"transTime":300,"y":-272,"scaleX":1,"noIn":false,"mirrow":true,"img":"chara025_1","addImg":"chara025_1_face_chara025_1g","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"嘉莉缇","text":"[show]我也没想到能走到这一步啊，这些年下来森林改变了许多。现在的黑森林已经完全不是我们小时候的样子了。[l][cm]"},"key":"text"},{"para":{"tag":"tag_10"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"layer":"chara1","img":"chara004_1_face_chara004_1a"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":80,"bright":1,"transTime":300,"y":-204,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara004_1","addImg":"chara004_1_face_chara004_1a","scaleY":1},"key":"moveLayer"},{"para":{"alpha":1,"trans":true,"layer":"chara3","noOut":false,"x":510,"bright":0.6,"transTime":300,"y":-272,"scaleX":1,"noIn":false,"mirrow":true,"img":"chara025_1","addImg":"chara025_1_face_chara025_1g","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"艾尔莎","text":"[show]或许吧……不过那和我的关系已经不大了。[l][cm]"},"key":"text"},{"para":{"tag":"tag_11"},"key":"tag"},{"para":{"alpha":0,"trans":true,"layer":"chara1","noOut":false,"x":80,"bright":1,"transTime":300,"y":-204,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara004_1","addImg":"chara004_1_face_chara004_1a","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"alpha":0,"trans":true,"layer":"chara1","noOut":false,"x":50,"bright":1,"y":-180,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2","addImg