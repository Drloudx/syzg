_1a","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"艾尔莎","text":"[show]那可不是拐走哦，我是认同驿站的理念才选择离开的。[l][cm]"},"key":"text"},{"para":{"tag":"tag_20"},"key":"tag"},{"para":{"layer":"chara1","img":"chara004_1_face_chara004_1d"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"艾尔莎","text":"[show]而且和哈萨琳菲尔德蕾打交道，也总好过面对那群为了权力喋喋不休的三枝元老会的成员。[l][cm]"},"key":"text"},{"para":{"tag":"tag_21"},"key":"tag"},{"para":{"layer":"chara1","img":"chara004_1_face_chara004_1f"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"艾尔莎","text":"[show]他们在议会上争吵，只为了自己的利益……小队经常因为他们的争执而得不到物资。那群坐在高椅上的家伙根本不明白，他们浪费的每一秒钟，对我们来说都是无比珍贵的。[l][cm]"},"key":"text"},{"para":{"tag":"tag_22"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":80,"bright":0.6,"transTime":300,"y":-204,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara004_1","addImg":"chara004_1_face_chara004_1f","scaleY":1},"key":"moveLayer"},{"para":{"layer":"chara3","img":"chara025_1_face_chara025_1e"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara3","noOut":false,"x":510,"bright":1,"transTime":300,"y":-272,"scaleX":1,"noIn":false,"mirrow":true,"img":"chara025_1","addImg":"chara025_1_face_chara025_1e","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"嘉莉缇","text":"[show]那是前代的事情了……当时的元老会确实存在很多问题，不过这一切都在\"灾变之宴\"后改变了。[l][cm]"},"key":"text"},{"para":{"tag":"tag_23"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"layer":"chara1","img":"chara004_1_face_chara004_1d"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":80,"bright":1,"transTime":300,"y":-204,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara004_1","addImg":"chara004_1_face_chara004_1d","scaleY":1},"key":"moveLayer"},{"para":{"alpha":1,"trans":true,"layer":"chara3","noOut":false,"x":510,"bright":0.6,"transTime":300,"