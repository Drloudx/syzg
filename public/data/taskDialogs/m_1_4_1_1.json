{"exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":0,"scaleX":1,"trans":true,"layer":"chara3","noOut":false,"noIn":false,"bright":1,"scaleY":1,"x":730,"mirrow":false,"y":-210,"img":"chara006_0","addImg":""},"key":"setLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara3","noOut":false,"noIn":false,"bright":1,"transTime":300,"scaleY":1,"x":730,"mirrow":false,"y":-210,"img":"chara006_0","addImg":""},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"比绍","text":"[show]啊，鄙人还想着你们怎么在这呢，原来是收复风车平野的英雄啊。[l][cm]"},"key":"text"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"nameSide":"left","charaName":"比绍","text":"[show]至于鄙人嘛，来这里只是因为生意罢了。[r]之前因为什么异变激化，订的农产品一直运不到驿站来，让我很是头疼。[l][cm]"},"key":"text"},{"para":{"tag":"tag_4"},"key":"tag"},{"para":{"nameSide":"left","charaName":"比绍","text":"[show]如今道路被你们契约者打通，鄙人想着货物差不多能顺利运送了吧，[r]就勉为其难，亲自过来看看他们装货的情况。[l][cm]"},"key":"text"},{"para":{"tag":"tag_20"},"key":"tag"},{"para":{"nameSide":"left","charaName":"比绍","text":"[show]结果就如你们所见，粮食被糟蹋，农夫也都受了伤。就算你们一路凯歌高奏，这货鄙人看也是收不成了。[l][cm]"},"key":"text"},{"para":{"tag":"tag_5"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"alpha":0,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"noIn":false,"bright":1,"scaleY":1,"x":50,"mirrow":false,"y":-180,"img":"chara002_2","addImg":"chara002_2_face_chara002_2d"},"key":"setLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"noIn":false,"bright":1,"transTime":300,"scaleY":1,"x":50,"mirrow":false,"y":-180,"img":"chara002_2","addImg":"chara002_2_face_chara002_2d"},"key":"moveLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara3","noOut":false,"noIn":false,"bright":0.6,"transTime":300,"scaleY":1,"x":730,"mirrow":false,"y":-210,"img":"chara006_0","addImg":""},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]这家伙的口气真让人讨厌啊。人家遭了这么大的罪，你少挣几个子儿又怎样了！[l][cm]"},"key":"text"},{"para":{"tag":"tag_6"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"noIn":false,"bright":0.6,"transTime":300,"scaleY":1,"x":50,"mirrow":false,"y":-180,"img":"chara002_2","addImg":"chara002_2_face_chara002_2d"},"key":"moveLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara3","noOut":false,"noIn":false,"bright":1,"transTime":300,"scaleY":1,"x":730,"mirrow":false,"y":-210,"img":"chara006_0","addImg":""},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"比绍","text":"[show]鄙人少挣几个子儿倒也没事，但减产是明摆着的事。供不应求，物价飞涨，住民的怨气你们契约者又能排解多少？[l][cm]"},"key":"text"},{"para":{"tag":"tag_8"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"layer":"chara1","img":"chara002_2_face_chara002_2e"},"key":"setLayerFace"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"noIn":false,"bright":1,"transTime":300,"scaleY":1,"x":50,"mirrow":false,"y":-180,"img":"chara002_2","addImg":"chara002_2_face_chara002_2e"},"key":"moveLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara3","noOut":false,"noIn":false,"bright":0.6,"transTime":300,"scaleY":1,"x":730,"mirrow":false,"y":-210,"img":"chara006_0","addImg":""},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]唔……！[l][cm]"},"key":"text"},{"para":{"tag":"tag_21"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"noIn":false,"bright":0.6,"transTime":300,"scaleY":1,"x":50,"mirrow":false,"y":-180,"img":"chara002_2","addImg":"chara002_2_face_chara002_2e"},"key":"moveLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara3","noOut":false,"noIn":false,"bright":1,"transTime":300,"scaleY":1,"x":730,"mirrow":false,"y":-210,"img":"chara006_0","addImg":""},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"比绍","text":"[show]嗯……我倒是有个想法。你们现在有什么闲工夫吗？要不要来谈谈……合作？[l][cm]"},"key":"text"},{"para":{"tag":"tag_22"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"layer":"chara1","img":"chara002_2_face_chara002_2h"},"key":"setLayerFace"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"noIn":false,"bright":1,"transTime":300,"scaleY":1,"x":50,"mirrow":false,"y":-180,"img":"chara002_2","addImg":"chara002_2_face_chara002_2h"},"key":"moveLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara3","noOut":false,"noIn":false,"bright":0.6,"transTime":300,"scaleY":1,"x":730,"mirrow":false,"y":-210,"img":"chara006_0","addImg":""},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]时间倒是有一点，你就说说看吧。但该给的报酬可不能少！[l][cm]"},"key":"text"},{"para":{"tag":"tag_9"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"noIn":false,"bright":0.6,"transTime":300,"scaleY":1,"x":50,"mirrow":false,"y":-180,"img":"chara002_2","addImg":"chara002_2_face_chara002_2h"},"key":"moveLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara3","noOut":false,"noIn":false,"bright":1,"transTime":300,"scaleY":1,"x":730,"mirrow":false,"y":-210,"img":"chara006_0","addImg":""},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"比绍","text":"[show]和刚才说的一样，鄙人的供应链快被异变彻底搞垮了。不光是这座农庄，不少商道也被魔物洗劫，鄙人有太多货物没法拿到手了。[l][cm]"},"key":"text"},{"para":{"tag":"tag_10"},"key":"tag"},{"para":{"nameSide":"left","charaName":"比绍","text":"[show]我听说你们的营地设备齐全。不如我们合作，一起把贸易链条重新搭造起来，也多少为这秋日荒野解一解燃眉之急。[l][cm]"},"key":"text"},{"para":{"tag":"tag_11"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"layer":"chara1","img":"chara002_2_face_chara002_2g"},"key":"setLayerFace"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"noIn":false,"bright":1,"