{"script":"s_4_12_3_y","des":"向托格拉哆提交1个黑森林松茸和1个岩盐。","exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"alpha":0,"scaleX":1.5,"trans":true,"layer":"bg","addImg":"","img":"bgblack","mirrow":false,"noIn":false,"noOut":false,"y":-125,"bright":1,"x":-500,"scaleY":1.5},"key":"setLayer"},{"para":{"alpha":0.4,"scaleX":1.5,"trans":true,"layer":"bg","addImg":"","img":"bgblack","mirrow":false,"noIn":false,"noOut":false,"y":-125,"bright":1,"x":-500,"transTime":300,"scaleY":1.5},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"tag":"tag_7"},"key":"tag"},{"para":{"nameSide":"left","charaName":"托格拉哆","text":"[show]……呼……[l][cm]"},"key":"text"},{"para":{"tag":"tag_9"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":0,"scaleX":1,"trans":true,"layer":"chara3","addImg":"chara048_1_face_chara048_1i","img":"chara048_1","mirrow":true,"noIn":false,"noOut":false,"y":-352,"bright":1,"x":640,"scaleY":1},"key":"setLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara3","addImg":"chara048_1_face_chara048_1i","img":"chara048_1","mirrow":true,"noIn":false,"noOut":false,"y":-352,"bright":1,"x":640,"transTime":300,"scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"萨拉","text":"[show]呀？你们回来了！哦哦，这是刚才托格拉哆说的松茸干的材料吧。先放那边吧，等他醒了，我再去把菜做出来。[l][cm]"},"key":"text"},{"para":{"tag":"tag_10"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"alpha":0,"scaleX":1,"trans":true,"layer":"chara1","addImg":"chara002_2_face_chara002_2h","img":"chara002_2","mirrow":false,"noIn":false,"noOut":false,"y":-180,"bright":1,"x":50,"scaleY":1},"key":"setLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara1","addImg":"chara002_2_face_chara002_2h","img":"chara002_2","mirrow":false,"noIn":false,"noOut":false,"y":-180,"bright":1,"x":50,"transTime":300,"scaleY":1},"key":"moveLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara3","addImg":"chara048_1_face_chara048_1i","img":"chara048_1","mirrow":true,"noIn":false,"noOut":false,"y":-352,"bright":0.6,"x":640,"transTime":300,"scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]额……这位托格拉哆怎么了？[l][cm]"},"key":"text"},{"para":{"tag":"tag_11"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara1","addImg":"chara002_2_face_chara002_2h","img":"chara002_2","mirrow":false,"noIn":false,"noOut":false,"y":-180,"bright":0.6,"x":50,"transTime":300,"scaleY":1},"key":"moveLayer"},{"para":{"img":"chara048_1_face_chara048_1a","layer":"chara3"},"key":"setLayerFace"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara3","addImg":"chara048_1_face_chara048_1a","img":"chara048_1","mirrow":true,"noIn":false,"noOut":false,"y":-352,"bright":1,"x":640,"transTime":300,"scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"萨拉","text":"[show]喝多了，睡着了。不过根据他的说法，他们蕈人很快就能醒来继续“喝喝”，所以我现在只要暂时等等就好。[l][cm]"},"key":"text"},{"para":{"tag":"tag_12"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara1","addImg":"chara002_2_face_chara002_2h","img":"chara002_2","mirrow":false,"noIn":false,"noOut":false,"y":-180,"bright":1,"x":50,"transTime":300,"scaleY":1},"key":"moveLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara3","addImg":"chara048_1_face_chara048_1a","img":"chara048_1","mirrow":true,"noIn":false,"noOut":false,"y":-352,"bright":0.6,"x":640,"transTime":300,"scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]这家伙醒了就喝，喝了就倒，醒来之后继续喝，这也太折磨自己了吧。[l][cm]"},"key":"text"},{"para":{"tag":"tag_13"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara1","addImg":"chara002_2_face_chara002_2h","img":"chara002_2","mirrow":false,"noIn":false,"noOut":false,"y":-180,"bright":0.6,"x":50,"transTime":300,"scaleY":1},"key":"moveLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara3","addImg":"chara048_1_face_chara048_1a","img":"chara048_1","mirrow":true,"noIn":false,"noOut":false,"y":-352,"bright":1,"x":640,"transTime":300,"scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"萨拉","text":"[show]这对蕈人来说不算什么。他们的身体似乎也习惯这样了。而且对于他来说，不断处于酩酊的状态，才更加能够逃避“折磨”吧。[l]"},"key":"text"},{"para":{"tag":"tag_14"},"key":"tag"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara3","addImg":"chara048_1_face_chara048_1a","img":"chara048_1","mirrow":true,"noIn":false,"noOut":false,"y":-352,"bright":0.6,"x":640,"transTime":300,"scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"text":"逃避折磨的意思是……","tag":"tag_15"}]},"key":"option"},{"para":{"tag":"tag_15"},"key":"tag"},{"para":{"img":"chara048_1_face_chara048_1i","layer":"chara3"},"key":"setLayerFace"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara3","addImg":"chara048_1_face_chara048_1i","img":"chara048_1","mirrow":true,"noIn":false,"noOut":false,"y":-352,"bright":1,"x":640,"transTime":300,"scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"萨拉","text":"[show][cm]刚刚在“喝喝”的同时，我和他聊了关于我的旅行见闻，他也告诉了我许多森林和庄园里的故事。[l][cm]"},"key":"text"},{"para":{"tag":"tag_16"},"key":"tag"},{"para":{"img":"chara048_1_face_chara048_1a","layer":"chara3"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"萨拉","text":"[show]异变之前庄园的氛围比现在欢乐很多，那时候的蕈人快乐地生活在这片土地上，本地产的蕈酵酿也经常能卖到外地。那时候的一切都很幸福。[l][cm]"},"key":"text"},{"para":{"tag":"tag_17"},"key":"tag"},{"para":{"img":"chara048_1_face_chara048_1f","layer":"chara3"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"萨拉","text":"[show]可惜异变发生之后，一切都改变了。庄园的快乐氛围也随之毁灭，托格拉哆也在那场灾难中失去了很多朋友，蕈酵酿也自此逐渐走向萧条。[l][cm]"},"key":"text"},{"para":{"tag":"tag_18"},"key":"tag"},{"para":{"img":"chara048_1_face_chara048_1a","layer":"chara3"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"萨拉","text":"[show]很多蕈人在异变前，只是把喝喝作为享受的一种方式，而异变后他们痛饮更多是为了逃避现实自我麻痹……相同的行为达到的效果是天差地别的。[l][cm]"},"key":"text"},{"para":{"tag":"tag_19"},"key":"tag"},{"para":{"img":"chara048_1_face_chara048_1g","layer":"chara3"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"萨拉","text":"[show]现在的托格拉哆的表现并非他的本性，他的暴躁、他对外界排斥的种种反应也是只是为了逃避现实罢了。[l]"},"key":"text"},{"para":{"tag":"tag_20"},"key":"tag"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara3","addImg":"chara048_1_face_chara048_1g","img":"chara048_1","mirrow":true,"noIn":false,"noOut":false,"y":-352,"bright":0.6,"x":640,"transTime":300,"scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"text":"原来还有这样的故事……","tag":"tag_21"}]},"key":"option"},{"para":{"tag":"tag_21"},"key":"tag"},{"para":{"img":"chara048_1_face_chara048_1a","layer":"chara3"},"key":"setLayerFace"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara3","addImg":"chara048_1_face_chara048_1a","img":"chara048_1","mirrow":true,"noIn":false,"noOut":false,"y":-352,"bright":1,"x":640,"transTime":300,"scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"萨拉","text":"[show][cm]他其实还是个害怕寂寞的蕈人，他倒下前还和我说，让我留在庄园，他想和我多喝几坛，多讲讲过去的故事。[l][cm]"},"key":"text"},{"para":{"tag":"tag_22"},"key":"tag"},{"para":{"img":"chara048_1_face_chara048_1i","layer":"chara3"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"萨拉","text":"[show]但我是一个旅行者，我没法同意他的要求，我总会离开这里，前往更遥远的地方。不过在这之前，我愿意和他留下美好的回忆。[l][cm]"},"key":"text"},{"para":{"tag":"tag_23"},"key":"tag"},{"para":{"img":"chara048_1_face_chara048_1b","layer":"chara3"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"萨拉","text":"[show]对了，你们能在帮个忙吗？我想给他弄点我的拿手绝酿。不过我手头上没有小麦，可以拜托你们带 3 份小麦过来吗？[l][cm]"},"key":"text"},{"para":{"tag":"tag_24"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"img":"chara002_2_face_chara002_2a","layer":"chara1"},"key":"setLayerFace"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara1","addImg":"chara002_2_face_chara002_2a","img":"chara002_2","mirrow":false,"noIn":false,"noOut":false,"y":-180,"bright":1,"x":50,"transTime":300,"scaleY":1},"key":"moveLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara3","addImg":"chara048_1_face_chara048_1b","img":"chara048_1","mirrow":true,"noIn":false,"noOut":false,"y":-352,"bright":0.6,"x":640,"transTime":300,"scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]三份小麦是吧……这倒没问题，不过你们要注意身体啊，怎么说喝太多也是不好的。[l][cm]"},"key":"text"},{"para":{"tag":"tag_25"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara1","addImg":"chara002_2_face_chara002_2a","img":"chara002_2","mirrow":false,"noIn":false,"noOut":false,"y":-180,"bright":0.6,"x":50,"transTime":300,"scaleY":1},"key":"moveLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara3","addImg":"chara048_1_face_chara048_1b","img":"chara048_1","mirrow":true,"noIn":false,"noOut":false,"y":-352,"bright":1,"x":640,"transTime":300,"scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"萨拉","text":"[show]哈哈没问题啦，我们会有分寸的。[l][cm]"},"key":"text"},{"para":{"tag":"tag_26"},"key":"tag"},{"para":{"img":"chara048_1_face_chara048_1a","layer":"chara3"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"萨拉","text":"[show]那么……就拜托你们了。[l][cm][hide]"},"key":"text"},{"para":{"tag":"tag_27"},"key":"tag"},{"para":{"alpha":0,"scaleX":1,"trans":true,"layer":"chara1","addImg":"chara002_2_face_chara002_2a","img":"chara002_2","mirrow":false,"noIn":false,"noOut":false,"y":-180,"bright":0.6,"x":50,"transTime":300,"scaleY":1},"key":"moveLayer"},{"para":{"alpha":0,"scaleX":1,"trans":true,"layer":"chara3","addImg":"chara048_1_face_chara048_1a","img":"chara048_1","mirrow":true,"noIn":false,"noOut":fa