e,"noIn":false,"x":67,"y":-215,"transTime":0,"scaleX":1,"timeBak":300,"mirrow":false,"trans":false,"img":"chara001_0"},"key":"moveLayer"},{"para":{"charaName":"米托拉","text":"[show]我也睡不着啊。[l][cm]","nameSide":"right"},"key":"text"},{"para":{"tag":"tag_5"},"key":"tag"},{"para":{"charaName":"米托拉","text":"[show]这几天发生的事情，实在是太多太多了……[l][cm]","nameSide":"right"},"key":"text"},{"para":{"tag":"tag_6"},"key":"tag"},{"para":{"charaName":"米托拉","text":"[show]从我发现你到现在，还不到一个月吧，[r][l]但这一个月发生的事情，已经比之前几年加起来都要多得多。[l][cm]","nameSide":"right"},"key":"text"},{"para":{"tag":"tag_7"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"alpha":1,"bright":0.6,"scaleY":0.9,"layer":"chara3","nonStandBright":false,"noOut":false,"noIn":false,"x":700,"y":-264.80000000000007,"transTime":0,"scaleX":0.9,"timeBak":300,"mirrow":false,"trans":false,"img":"chara002_2"},"key":"moveLayer"},{"para":{"alpha":1,"bright":1,"scaleY":1,"layer":"chara1","nonStandBright":false,"noOut":false,"noIn":false,"x":67,"y":-215,"transTime":0,"scaleX":1,"timeBak":300,"mirrow":false,"trans":false,"img":"chara001_0"},"key":"moveLayer"},{"para":{"charaName":"希尔","text":"[show]我也是。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_8"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"bright":1,"scaleY":0.9,"layer":"chara3","nonStandBright":false,"noOut":false,"noIn":false,"x":700,"y":-264.80000000000007,"transTime":0,"scaleX":0.9,"timeBak":300,"mirrow":false,"trans":false,"img":"chara002_2"},"key":"moveLayer"},{"para":{"alpha":1,"bright":0.6,"scaleY":1,"layer":"chara1","nonStandBright":false,"noOut":false,"noIn":false,"x":67,"y":-215,"transTime":0,"scaleX":1,"timeBak":300,"mirrow":false,"trans":false,"img":"chara001_0"},"key":"moveLayer"},{"para":{"charaName":"米托拉","text":"[show]对吧？所以我开始有些相信了，我们的相遇，说不定真的是那什么“命运的邂逅”呢！[l][cm]","nameSide":"right"},"key":"text"},{"para":{"tag":"tag_9"},"key":"tag"},{"para":{"charaName":"米托拉","text":"[show]在遇到你之前，我因为没有记忆，一直都是浑浑噩噩、得过且过。[r]别说一个月以后的事情，就连大后天的事情都没有考虑过。[l][cm]","nameSide":"right"},"key":"text"},{"para":{"tag":"tag_10"},"key":"tag"},{"para":{"charaName":"米托拉","text":"[show]但是现在，我知道了过去的线索，知道了找回记忆的方法……[r][l]不止是一个月以后的事，我甚至开始期待遥远的未来了。[l][cm]","nameSide":"right"},"key":"text"},{"para":{"tag":"tag_11"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"alpha":1,"bright":0.6,"scaleY":0.9,"layer":"chara3","nonStandBright":false,"noOut":false,"noIn":false,"x":700,"y":-264.80000000000007,"transTime":0,"scaleX":0.9,"timeBak":300,"mirrow":false,"trans":false,"img":"chara002_2"},"key":"moveLayer"},{"para":{"alpha":1,"bright":1,"scaleY":1,"layer":"chara1","nonStandBright":false,"noOut":false,"noIn":false,"x":67,"y":-215,"transTime":0,"scaleX":1,"timeBak":300,"mirrow":false,"trans":false,"img":"chara001_0"},"key":"moveLayer"},{"para":{"charaName":"希尔","text":"[show]有目标是好事，我觉得这是好的变化哦。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_12"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"bright":1,"scaleY":0.9,"layer":"chara3","nonStandBright":false,"noOut":false,"noIn":false,"x":700,"y":-264.80000000000007,"transTime":0,"scaleX":0.9,"timeBak":300,"mirrow":false,"trans":false,"img":"chara002_2"},"key":"moveLayer"},{"para":{"alpha":1,"bright":0.6,"scaleY":1,"layer":"chara1","nonStandBright":false,"noOut":false,"noIn":false,"x":67,"y":-215,"transTime":0,"scaleX":1,"timeBak":300,"mirrow":false,"trans":false,"img":"chara001_0"},"key":"moveLayer"},{"para":{"charaName":"米托拉","text":"[show]那你呢？发生了这么多事，你有什么感想吗？[l][cm]","nameSide":"right"},"key":"text"},{"para":{"tag":"tag_13"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"alpha":1,"bright":0.6,"scaleY":0.9,"layer":"chara3","nonStandBright":false,"noOut":false,"noIn":false,"x":700,"y":-264.80000000000007,"transTime":0,"scaleX":0.9,"timeBak":300,"mirrow":false,"trans":false,"img":"chara002_2"},"key":"moveLayer"},{"para":{"alpha":1,"bright":1,"scaleY":1,"layer":"chara1","nonStandBright":false,"noOut":false,"noIn":false,"x":67,"y":-215,"transTime":0,"scaleX":1,"timeBak":300,"mirrow":false,"trans":false,"img":"chara001_0"},"key":"moveLayer"},{"para":{"charaName":"希尔","text":"[show]我吗……相比起米托拉，我反而是……开始想要注意眼前了吧。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_14"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"bright":1,"scaleY":0.9,"layer":"chara3","nonStandBright":false,"noOut":false,"noIn":false,"x":700,"y":-264.80000000000007,"transTime":0,"scaleX":0.9,"timeBak":300,"mirrow":false,"trans":false,"img":"chara002_2"},"key":"moveLayer"},{"para":{"alpha":1,"bright":0.6,"scaleY":1,"layer":"chara1","nonStandBright":false,"noOut":false,"noIn":false,"x":67,"y":-215,"transTime":0,"scaleX":1,"timeBak":300,"mirrow":false,"trans":false,"img":"chara001_0"},"key":"moveLayer"},{"para":{"charaName":"米托拉","text":"[show]诶？[l][cm]","nameSide":"right"},"key":"text"},{"para":{"tag":"tag_15"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"alpha":1,"bright":0.6,"scaleY":0.9,"layer":"chara3","nonStandBright":false,"noOut":false,"noIn":false,"x":700,"y":-264.80000000000007,"transTime":0,"scaleX":0.9,"timeBak":300,"mirrow":false,"trans":false,"img":"chara002_2"},"key":"moveLayer"},{"para":{"alpha":1,"bright":1,"scaleY":1,"layer":"chara1","nonStandBright":false,"noOut":false,"noIn":false,"x":67,"y":-215,"transTime":0,"scaleX":1,"timeBak":300,"mirrow":false,"trans":false,"img":"chara001_0"},"key":"moveLayer"},{"para":{"charaName":"希尔","text":"[show]我啊，一直以来都被教导，要成为一名厉害的工匠，为了复兴家族的伟大目标而奋斗。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_16"},"key":"tag"},{"para":{"charaName":"希尔","text":"[show]这样十几年如一日，不知不觉就变得只会盯着遥远的目标了。[r]为了那个目标，没有什么是不可以放弃、不可以牺牲的。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_17"},"key":"tag"},{"para":{"charaName":"希尔","text":"[show]尤其是在父亲失踪之后，我更是几乎不管不顾地抛弃了财产、名声、友人……[r]以及在圣都的一切，到处探索遗迹以至于被圣教革籍乃至通缉……[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_18"},"key":"tag"},{"para":{"charaName":"希尔","text":"[show]就连刚到这里的时候，[r]我也只是想着帮米托拉搭好营地报答了恩情，就要立刻上路前往下一段旅途。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_19"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"bright":1,"scaleY":0.9,"layer":"chara3","nonStandBright":false,"noOut":false,"noIn":false,"x":700,"y":-264.80000000000007,"transTime":0,"scaleX":0.9,"timeBak":300,"mirrow":false,"trans":false,"img":"chara002_2"},"key":"moveLayer"},{"para":{"alpha":1,"bright":0.6,"scaleY":1,"layer":"chara1","nonStandBright":false,"noOut":false,"noIn":false,"x":67,"y":-215,"transTime":0,"scaleX":1,"timeBak":300,"mirrow":false,"trans":false,"img":"chara001_0"},"key":"moveLayer"},{"para":{"charaName":"米托拉","text":"[show]原来那时候希尔是这么想的啊，完全看不出来！[r][l]我完全以为你是准备一直抱我的大腿过活的！[l][cm]","nameSide":"right"},"key":"text"},{"para":{"tag":"tag_20"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"alpha":1,"bright":0.6,"scaleY":0.9,"layer":"chara3","nonStandBright":false,"noOut":false,"noIn":false,"x":700,"y":-264.80000000000007,"transTime":0,"scaleX":0.9,"timeBak":300,"mirrow":false,"trans":false,"img":"chara002_2"},"key":"moveLayer"},{"para":{"alpha":1,"bright":1,"scaleY":1,"layer":"chara1","nonStandBright":false,"noOut":false,"noIn":false,"x":67,"y":-215,"transTime":0,"scaleX":1,"timeBak":300,"mirrow":false,"trans":false,"img":"chara001_0"},"key":"moveLayer"},{"para":{"charaName":"希尔","text":"[show]哈哈……大概是因为一直被通缉，所以多少学会了隐藏自己的想法吧……[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_21"},"key":"tag"},{"para":{"charaName":"希尔","text":"[show]总之，之前的我就是这样一个，从来不顾眼前的人。[r][l]或许就是因为这样，我才会被骑士团追击坠崖，来到这里。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_22"},"key":"tag"},{"para":{"charaName":"希尔","text":"[show]不过现在，在和米托拉一起冒险了一段时间以后，我的想法改变了。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_23"},"key":"tag"},{"para":{"charaName":"希尔","text":"[show]米托拉的记忆，我父亲的踪迹，神匠器……[r]这么多的线索都交汇在这个深渊之中，或许正是命运在让我留在这里吧……[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_24"},"key":"tag"},{"para":{"charaName":"希尔","text":"[show]我想，或许是时候停下来，认真地展开一段新生活了。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_25"},"key":"tag"},{"para":{"charaName":"希尔","text":"[show]不管是为了继续探索遗迹也好，还是为了离开深渊也好，[r]我都不能再一直盯着远方，必须老老实实地在这里扎下根来。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_26"},"key":"tag"},{"para":{"charaName":"希尔","text":"[show]所以我想和米托拉一起，把我们的营地好好经营起来，让它成为一个真正的家园。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_27"},"key":"tag"},{"para":{"charaName":"希尔","text":"[show]我也想成为一名正式的契约者，借着各种冒险的契机，探索这个深渊的每一寸土地。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_28"},"key":"tag"},{"para":{"charaName":"希尔","text":"[show]米托拉……能够请你继续当我的伙伴，一起继续冒险吗？[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_29"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"bright":1,"scaleY":0.9,"layer":"chara3","noOut":false,"noIn":false,"x":650,"y":-264.80000000000007,"transTime":500,"scaleX":0.9,"mirrow":false,"trans":true,"img":"chara002_2"},"key":"moveLayer"},{"para":{"alpha":1,"bright":0.6,"scaleY":1,"layer":"chara1","nonStandBright":false,"noOut":false,"noIn":false,"x":67,"y":-215,"transTime":0,"scaleX":1,"timeBak":500,"mirrow":false,"trans":false,"img":"chara001_0"},"key":"moveLayer"},{"para":{"time":500},"key":"wait"},{"para":{"charaName":"米托拉","text":"[show]…","nameSide":"right"},"key":"text"},{"para":{"tag":"tag_31"},"key":"tag"},{"para":{"alpha":1,"bright":1,"scaleY":0.9,"layer":"chara3","noOut":false,"noIn":false,"x":700,"y":-264.80000000000007,"transTime":500,"scaleX":0.9,"mirrow":false,"trans":true,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":500},"key":"wait"},{"para":{"charaName":"米托拉","text":"[show]…","nameSide":"right"},"key":"text"},{"para":{"tag":"tag_30"},"key":"tag"},{"para":{"layer":"chara3","y":30,"d":0.8,"x":0},"key":"shake"},{"para":{"alpha":1,"bright":1,"scaleY":0.9,"layer":"chara3","nonStandBright":false,"noOut":false,"noIn":false,"x":700,"y":-264.80000000000007,"transTime":0,"scal