eLayer","para":{"alpha":1,"scaleX":1,"mirrow":false,"layer":"chara3","img":"chara055_1","addImg":"chara055_1_face_chara055_1b","x":640,"scaleY":1,"trans":true,"noOut":false,"y":-290,"noIn":false,"bright":0.6,"transTime":300}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"nameSide":"left","text":"[show]哼哼～这对我们来说没什么难的啦！[l][cm]","charaName":"米托拉"}},{"key":"tag","para":{"tag":"tag_5"}},{"key":"top","para":{"layer":"chara3"}},{"key":"moveLayer","para":{"alpha":1,"scaleX":1,"mirrow":false,"layer":"chara1","img":"chara002_2","addImg":"chara002_2_face_chara002_2f","x":50,"scaleY":1,"trans":true,"noOut":false,"y":-180,"noIn":false,"bright":0.6,"transTime":300}},{"key":"setLayerFace","para":{"img":"chara055_1_face_chara055_1i","layer":"chara3"}},{"key":"moveLayer","para":{"alpha":1,"scaleX":1,"mirrow":false,"layer":"chara3","img":"chara055_1","addImg":"chara055_1_face_chara055_1i","x":640,"scaleY":1,"trans":true,"noOut":false,"y":-290,"noIn":false,"bright":1,"transTime":300}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"nameSide":"left","text":"[show]我这次来是想告知你们——我们准备重新举办契约者挑战赛了。[r]而且，我个人很期待你们的参加。[l]","charaName":"迦南"}},{"key":"tag","para":{"tag":"tag_6"}},{"key":"option","para":{"options":[{"text":"契约者……","tag":"tag_7"},{"text":"……挑战赛？","tag":"tag_7"}]}},{"key":"tag","para":{"tag":"tag_7"}},{"key":"setLayerFace","para":{"img":"chara055_1_face_chara055_1b","layer":"chara3"}},{"key":"text","para":{"nameSide":"left","text":"[cm][show]嗯，契约者挑战赛是哈萨琳大人创立的一项传统活动。[r]活动中，契约者需要互相结成小队，在竞技场上彼此切磋较量，直到决出最强的小队。[l][cm]","charaName":"迦南"}},{"key":"tag","para":{"tag":"tag_8"}},{"key":"event","para":{"eventData":"{\r  \"action\": \"bubble\",\r  \"para\": {\r    \"bubbles\": {\r      \"chara002_2\": \"08\"\r    }\r  }\r}","event":"GAoEvent"}},{"key":"top","para":{"layer":"chara1"}},{"key":"setLayerFace","para":{"img":"chara002_2_face_chara002_2k","layer":"chara1"}},{"key":"moveLayer","para":{"alpha":1,"scaleX":1,"mirrow":false,"layer":"chara1","img":"chara002_2","addImg":"chara002_2_face_chara002_2k","x":50,"scaleY":1,"trans":true,"noOut":false,"y":-180,"noIn":false,"bright":1,"transTime":300}},{"key":"moveLayer","para":{"alpha":1,"scaleX":1,"mirrow":false,"layer":"chara3","img":"chara055_1","addImg":"chara055_1_face_chara055_1b","x":640,"scaleY":1,"trans":true,"noOut":false,"y":-290,"noIn":false,"bright":0.6,"transTime":300}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"nameSide":"left","text":"[show]契约者之间相互切磋的比赛？也就是说我们可以和别的契约者对决了？[l][cm]","charaName":"米托拉"}},{"key":"moveLayer","para":{"scaleY":1,"scaleX":1,"layer":"chara3","y":-50,"alpha":1,"relativePos":true,"bright":1,"transTime":180,"x":0}},{"key":"wait","para":{"time":200,"type":""}},{"key":"moveLayer","para":{"scaleY":1,"scaleX":1,"layer":"chara3","y":50,"alpha":1,"relativePos":true,"bright":1,"transTime":180,"x":0}},{"key":"tag","para":{"tag":"tag_9"}},{"key":"top","para":{"layer":"chara3"}},{"key":"moveLayer","para":{"alpha":1,"scaleX":1,"mirrow":false,"layer":"chara1","img":"chara002_2","addImg":"chara002_2_face_chara002_2k","x":50,"scaleY":1,"trans":true,"noOut":false,"y":-180,"noIn":false,"bright":0.6,"transTime":300}},{"key":"setLayerFace","para":{"img":"chara055_1_face_chara055_1c","layer":"chara3"}},{"key":"moveLayer","para":{"alpha":1,"scaleX":1,"mirrow":false,"layer":"chara3","img":"chara055_1","addImg":"chara055_1_face_chara055_1c","x":640,"scaleY":1,"trans":true,"noOut":false,"y":-290,"noIn":false,"bright":1,"transTime":300}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"nameSide":"left","text":"[show]没错！每个赛季的冠军小队都可以获得丰厚的奖励。[l][cm]","charaName":"迦南"}},{"key":"tag","para":{"tag":"tag_10"}},{"key":"setLayerFace","para":{"img":"chara055_1_face_chara055_1a","layer":"chara3"}},{"key":"text","para":{"nameSide":"left","text":"[show]这项活动不光受契约者们自己欢迎，还吸引了好多观众。[r]在大兽潮爆发之前，挑战赛一直是深渊住民们最爱的活动之一呢。[l][cm]","charaName":"迦南"}},{"key":"tag","para":{"tag":"tag_11"}},{"key":"setLayerFace","para":{"img":"chara055_1_face_chara055_1b","layer":"chara3"}},{"key":"text","para":{"nameSide":"left","text":"[show]每个赛季，周边所有聚落的契约者勇士们都会热切地参加竞争。[r]不瞒你们说，我也有幸得过几届冠军……[l]","charaName":"迦南"}},{"key":"tag","para":{"tag":"tag_12"}},{"key":"option","para":{"options":[{"text":"不愧是迦南前辈！","tag":"tag_13"},{"text":"真了不起！","tag":"tag_13"}]}},{"key":"tag","para":{"tag":"tag_13"}},{"key":"event","para":{"eventData":"{\r  \"action\": \"bubble\",\r  \"para\": {\r    \"bubbles\": {\r      \"chara055_1\": \"05\"\r    }\r  }\r}","event":"GAoEvent"}},{"key":"setLayerFace","para":{"img":"chara055_1_face_chara055_1c","layer":"chara3"}},{"key":"text","para":{"nameSide":"left","text":"[cm][show]谢谢夸奖～这么说的话，你们应该能明白这是一场意义多重大的活动了吧？[l][cm]","charaName":"迦南"}},{"key":"tag","para":{"tag":"tag_14"}},{"key":"setLayerFace","para":{"img":"chara055_1_face_chara055_1a","layer":"chara3"}},{"key":"text","para":{"nameSide":"left","text":"[show]大兽潮后，联盟分崩离析，挑战赛也偃旗息鼓了五年之久。[r]多亏了你们的活跃，魔物的问题总算得到解决，越来越多的契约者也重新回到了驿站。[l][cm]","charaName":"迦南"}},{"key":"tag","para":{"tag":"tag_15"}},{"key":"setLayerFace","para":{"img":"chara055_1_face_chara055_1c","layer":"chara3"}},{"key":"text","para":{"nameSide":"left","text":"[show]我跟菲尔提了建议，是时候重新开办挑战赛了。她虽然还有些犹豫，但我觉得只要你们能加入，肯定能把气氛炒热！[l][cm]","charaName":"迦南"}},{"key":"tag","para":{"tag":"tag_16"}},{"key":"setLayerFace","para":{"img":"chara055_1_face_chara055_1b","layer":"chara3"}},{"key":"text","para":{"nameSide":"left","text":"[show]毕竟现在好多人看到你们这对新人势头正猛，都想向你们发起挑战呢！[l][cm]","charaName":"迦南"}},{"key":"tag","para":{"tag":"tag_17"}},{"key":"top","para":{"layer":"chara1"}},{"key":"setLayerFace","para":{"img":"chara002_2_face_chara002_2l","layer":"chara1"}},{"key":"moveLayer","para":{"alpha":1,"scaleX":1,"mirrow":false,"layer":"chara1","img":"chara002_2","addImg":"chara002_2_face_chara002_2l","x":50,"scaleY":1,"trans":true,"noOut":false,"y":-180,"noIn":false,"bright":1,"transTime":300}},{"key":"moveLayer","para":{"alpha":1,"scaleX":1,"mirrow":false,"layer":"chara3","img":"chara055_1","addImg":"chara055_1_face_chara055_1b","x":640,"scaleY":1,"trans":true,"noOut":false,"y":-290,"noIn":false,"bright":0.6,"transTime":300}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"nameSide":"left","text":"[show]哈？居然敢向我们发起挑战？那正好顺了他们的意，把他们打得落花流水！对吧{myName}？[l]","charaName":"米托拉"}},{"key":"tag","para":{"tag":"tag_18"}},{"key":"option","para":{"options":[{"text":"没错！","tag":"tag_19"},{"text":"把他们全部打败！","tag":"tag_19"}]}},{"key":"tag","para":{"tag":"tag_19"}},{"key":"top","para":{"layer":"chara3"}},{"key":"moveLayer","para":{"alpha":1,"scaleX":1,"mirrow":false,"layer":"chara1","img":"chara002_2","addImg":"chara002_2_face_chara002_2l","x":50,"scaleY":1,"trans":true,"noOut":false,"y":-180,"noIn":false,"bright":0.6,"transTime":300}},{"key":"setLayerFace","para":{"img":"chara055_1_face_chara055_1c","layer":"chara3"}},{"key":"moveLayer","para":{"alpha":1,"scaleX":1,"mirrow":false,"layer":"chara3","img":"chara055_1","addImg":"chara055_1_face_chara055_1c","x":640,"scaleY":1,"trans":true,"noOut":false,"y":-290,"noIn":false,"bright":1,"transTime":300}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"nameSide":"left","text":"[cm][show]嗯！要的就是你们这股气势！不如就趁现在这个势头，我来教你们怎么参加挑战赛，怎么样？[l][cm]","charaName":"迦南"}},{"key":"tag","para":{"tag":"tag_20"}},{"key":"top","para":{"layer":"chara1"}},{"key":"setLayerFace","para":{"img":"chara002_2_face_chara002_2a","layer":"chara1"}},{"key":"moveLayer","para":{"alpha":1,"scaleX":1,"mirrow":false,"layer":"chara1","img":"chara002_2","addImg":"chara002_2_face_chara002_2a","x":50,"scaleY":1,"trans":true,"noOut":false,"y":-180,"noIn":false,"bright":1,"transTime":300}},{"key":"moveLayer","para":{"alpha":1,"scaleX":1,"mirrow":false,"layer":"chara3","img":"chara055_1","addImg":"chara055_1_face_chara055_1c","x":640,"scaleY":1,"trans":true,"noOut":false,"y":-290,"noIn":false,"bright":0.6,"transTime":300}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"nameSide":"left","text":"[show]快说快说！我们早就迫不及待啦～[l][cm][hide]","charaName":"米托拉"}},{"key":"tag","para":{"tag":"tag_21"}},{"key":"moveLayer","para":{