,"trans":true,"img":"chara010_1"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"希尔","text":"[show]唯一通道？没有其它的路了吗？比如说翻过山脊之类的……？[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_11"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"bright":0.6,"scaleY":1,"layer":"chara1","noOut":false,"noIn":false,"x":67,"y":-215,"transTime":300,"scaleX":1,"mirrow":false,"trans":true,"img":"chara001_0"},"key":"moveLayer"},{"para":{"alpha":1,"bright":1,"scaleY":1,"layer":"chara3","noOut":false,"noIn":false,"x":663,"y":-146,"transTime":300,"scaleX":1,"mirrow":true,"trans":true,"img":"chara010_1"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"莉拉","text":"[show]那是不可能的。[l]深渊的周围是连绵不绝，没有一丝缝隙的万丈峭壁，以人力根本无法翻越。[r]即使拥有飞行能力的鸟类魔人，也会被高空中的元素魔物们阻拦。[l][cm]","nameSide":"right"},"key":"text"},{"para":{"tag":"tag_12"},"key":"tag"},{"para":{"charaName":"莉拉","text":"[show]或许对于外界的人来说，从山顶失足坠落还有亿万分之一的几率活着进入深渊。[r]但内侧的人想要出去，那就是唯一的隘口。[l][cm]","nameSide":"right"},"key":"text"},{"para":{"tag":"tag_13"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"alpha":1,"bright":1,"scaleY":1,"layer":"chara1","noOut":false,"noIn":false,"x":67,"y":-215,"transTime":300,"scaleX":1,"mirrow":false,"trans":true,"img":"chara001_0"},"key":"moveLayer"},{"para":{"alpha":1,"bright":0.6,"scaleY":1,"layer":"chara3","noOut":false,"noIn":false,"x":663,"y":-146,"transTime":300,"scaleX":1,"mirrow":true,"trans":true,"img":"chara010_1"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"希尔","text":"[show]原来是这样……那……这个兽潮是持续多久了？还是说一直都是这样？[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_14"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"bright":0.6,"scaleY":1,"layer":"chara1","noOut":false,"noIn":false,"x":67,"y":-215,"transTime":300,"scaleX":1,"mirrow":false,"trans":true,"img":"chara001_0"},"key":"moveLayer"},{"para":{"alpha":1,"bright":1,"scaleY":1,"layer":"chara3","noOut":fal