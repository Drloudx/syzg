xt"},{"para":{"tag":"tag_33"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":0.6,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1c","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"tag":"tag_34","text":"没想到你真的是来免费送药的……"}]},"key":"option"},{"para":{"tag":"tag_34"},"key":"tag"},{"para":{"layer":"chara2","img":"chara043_1_face_chara043_1f"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":1,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1f","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]喂喂喂，你把我当成什么人了啊……[l][cm]"},"key":"text"},{"para":{"tag":"tag_35"},"key":"tag"},{"para":{"layer":"chara2","img":"chara043_1_face_chara043_1a"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]说到底，做生意只是我最顺手爱用的工具罢了，除了能换点炼药材料，余下也就混口饭吃。能赚到钱当然更好，那说明我本事大嘛！[l][cm]"},"key":"text"},{"para":{"tag":"tag_36"},"key":"tag"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]苦难对于所有人都是平等的。交易也好，买卖也罢，说得再天花乱坠，终究是给那些钱包鼓鼓的人准备的。光靠做生意，是没法给所有人带来笑容的。[l][cm]"},"key":"text"},{"para":{"tag":"tag_37"},"key":"tag"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]我想让钱袋鼓鼓的人和钱袋瘪瘪的人，都能平等地幸福起来。不然你以为我为啥总在喊穷啊？[l]"},"key":"text"},{"para":{"tag":"tag_38"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":0.6,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1a","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"tag":"tag_39","text":"阿娜洛洁……"}]},"key":"option"},{"para":{"tag":"tag_39"},"key":"tag"},{"para":{"layer":"chara2","img":"chara043_1_face_chara043_1b"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":1,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1b","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[cm][show]嘿嘿，{myName}竟然对这件事感到意外。看来想了解我，你还得多下点功夫呢！[l][cm]"},"key":"text"},{"para":{"tag":"tag_40"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":0.6,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1b","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"","text":"[show]（一阵脚步声传来。）[l][cm]"},"key":"text"},{"para":{"tag":"tag_41"},"key":"tag"},{"para":{"nameSide":"left","charaName":"村庄卫兵1","text":"[show]那个……真不好意思。我来晚了。刚才……刚才是我小人之心了。[l][cm]"},"key":"text"},{"para":{"tag":"tag_42"},"key":"tag"},{"para":{"nameSide":"left","charaName":"村庄卫兵1","text":"[show]其实……刚刚我在给兄弟用药的时候，就知道是真货了。但这边围着的村民越来越多……我这脸上臊得慌，就没敢过来赔不是……[l][cm]"},"key":"text"},{"para":{"tag":"tag_43"},"key":"tag"},{"para":{"nameSide":"left","charaName":"村庄卫兵1","text":"[show]我代替我的兄弟谢谢你们。村子的大家也都非常感激你们。阿娜洛洁小姐，下次再来的时候提前告诉一声，我们备好热乎饭菜招待你！[l][cm]"},"key":"text"},{"para":{"tag":"tag_44"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":1,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1b","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]嘿，这有什么！[l][cm]"},"key":"text"},{"para":{"tag":"tag_45"},"key":"tag"},{"para":{"layer":"chara2","img":"chara043_1_face_chara043_1a"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]好啦，时间差不多了，我们该回去了。[l]"},"key":"text"},{"para":{"tag":"tag_46"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":0.6,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1a","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"tag":"tag_47","text":"（牵着恐兽，准备离开。）"}]},"key":"option"},{"para":{"tag":"tag_47"},"key":"tag"},{"para":{"nameSide":"left","charaName":"村子的人们","text":"[cm][show]谢谢——！谢谢你们的生命药水，再见！[l][cm]"},"key":"text"},{"para":{"tag":"tag_48"},"key":"tag"},{"para":{"layer":"chara2","img":"chara043_1_face_chara043_1b"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":1,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1b","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]嘿嘿……大家要好好保重身体哦！我们有缘再见！[l][cm]"},"key":"text"},{"para":{"tag":"tag_49"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":0.6,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1b","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"","text":"[show]（望着村民们阳光下挥手告别的笑脸，心里热乎乎的。）[l][cm][hide]"},"key":"text"},{"para":{"tag":"tag_50"},"key":"tag"},{"para":{"alpha":0,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":0.6,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1b","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"alpha":0,"trans":true,"layer":"bg","noOut":false,"x":-500,"bright":1,"transTime":300,"y":-125,"scaleX":1.5,"noIn":false,"mirrow":false,"img":"bgblack","addImg":"","scaleY":1.5},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"","text":"[hide]"},"key