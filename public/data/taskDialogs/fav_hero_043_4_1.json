":0.6,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1d","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"村庄卫兵1","text":"[show]真不要钱啊……唔，但说是生命药水，我也没法试啊……[l][cm]"},"key":"text"},{"para":{"tag":"tag_11"},"key":"tag"},{"para":{"nameSide":"left","charaName":"村庄卫兵2","text":"[show]对了，之前我们有个兄弟不是被魔物打伤了吗？你去给他用用，见没见效一看便知。[l][cm]"},"key":"text"},{"para":{"tag":"tag_12"},"key":"tag"},{"para":{"nameSide":"left","charaName":"村庄卫兵1","text":"[show]嗯，有道理，我这就去。你、你们几个就先在这村口呆一会，不许乱动！要是这药有问题，我一定把你们撵到驿站去报告菲尔德蕾！[l][cm]"},"key":"text"},{"para":{"tag":"tag_13"},"key":"tag"},{"para":{"layer":"chara2","img":"chara043_1_face_chara043_1b"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":1,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1b","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]不——客——气！如果亲人伙伴也有需要的话，欢迎再过来拿，我们这里还有很多哦。[l][cm]"},"key":"text"},{"para":{"tag":"tag_14"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":0.6,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1b","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"","text":"[show]（卫兵一步三回头地回到村子里去了。紧接着，陆续有人从村中出来。）[l][cm]"},"key":"text"},{"para":{"tag":"tag_15"},"key":"tag"},{"para":{"nameSide":"left","charaName":"农妇","text":"[show]你……你们刚刚说这里免费发药水？真的吗？[l][cm]"},"key":"text"},{"para":{"tag":"tag_16"},"key":"tag"},{"para":{"layer":"chara2","img":"chara043_1_face_chara043_1a"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":1,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"ch