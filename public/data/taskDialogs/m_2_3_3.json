{"script":"m_2_3_3","exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"charaName":"“双刃”费萨","text":"[show]是大姐头领回来的外来者啊，我听皮塔说起过你们。有什么事吗？[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"charaName":"“双刃”费萨","text":"[show]关于我们自卫团吗……[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"charaName":"“双刃”费萨","text":"[show]我们自卫团也算是很有历史的组织了。从巴诺姆村建成开始，自卫团就一直保护着村子。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_4"},"key":"tag"},{"para":{"noOut":false,"mirrow":false,"alpha":0,"scaleX":1.5,"addImg":"","trans":true,"noIn":false,"layer":"bg","x":-500,"y":-125,"bright":1,"scaleY":1.5,"img":"bgblack"},"key":"setLayer"},{"para":{"noOut":false,"mirrow":false,"alpha":0.4,"scaleX":1.5,"addImg":"","trans":true,"noIn":false,"layer":"bg","x":-500,"transTime":300,"y":-125,"bright":1,"scaleY":1.5,"img":"bgblack"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"noOut":false,"mirrow":false,"alpha":0,"scaleX":1,"addImg":"chara002_2_face_chara002_2c","trans":true,"noIn":false,"layer":"chara2","x":360,"y":-180,"bright":1,"scaleY":1,"img":"chara002_2"},"key":"setLayer"},{"para":{"noOut":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2c","trans":true,"noIn":false,"layer":"chara2","x":360,"transTime":300,"y":-180,"bright":1,"scaleY":1,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米托拉","text":"[show]居然有那么久啊。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_5"},"key":"tag"},{"para":{"noOut":false,"mirrow":false,"alpha":0,"scaleX":1,"addImg":"chara002_2_face_chara002_2c","trans":true,"noIn":false,"layer":"chara2","x":360,"transTime":300,"y":-180,"bright":1,"scaleY":1,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"noOut":false,"mirrow":false,"alpha":0,"scaleX":1.5,"addImg":"","trans":true,"noIn":false,"layer":"bg","x":-500,"transTim