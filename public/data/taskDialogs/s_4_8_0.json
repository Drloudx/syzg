{"script":"s_4_8_0","exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"nameSide":"left","charaName":"阿纳伊尔","text":"[show]两位是契约者吧，我有个委托想要拜托你们。[l][cm]"},"key":"text"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"","layer":"bg","x":-500,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"setLayer"},{"para":{"noIn":false,"mirrow":false,"alpha":0.4,"addImg":"","layer":"bg","x":-500,"transTime":300,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"chara002_2_face_chara002_2a","layer":"chara2","x":340,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"setLayer"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2a","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]老先生想委托什么尽管说！如果能帮上忙我们一定帮！[l][cm]"},"key":"text"},{"para":{"tag":"tag_4"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2a","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿纳伊尔","text":"[show]我的儿子赫里奥夫前阵子狩猎魔花打破了之前猎场的最好成绩，我们想给他庆祝一番。再加上他的生日也快到了，所以我决定按照正规布宴的方式举办一场宴会。[l][cm]"},"key":"text"},{"para":{"tag":"tag_5"},"key":"tag"},{"para":{"nameSide":"left","charaName":"阿纳伊尔","text":"[show]不过我们猎场的伙伴都是粗人，对于举办宴会这些事情完全不懂。所以我们必须要找外援。[l][cm]"},"key":"text"},{"para":{"tag":"tag_6"},"key":"tag"},{"para":{"nameSide":"left","charaName":"阿纳伊尔","text":"[show]可惜我们最近的工作繁忙抽不开身，所以我想拜托你们去请教一下专业的布宴者。[l][cm]"},"key":"text"},{"para":{"tag":"tag_7"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2e","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2e","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]原来如此，不过去找谁比较好呢？[l][cm]"},"key":"text"},{"para":{"tag":"tag_8"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2e","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿纳伊尔","text":"[show]这个我已经想好了，你们只要去金弦之厅住民区找一位叫梅尔科卡的人就好。虽然她已经退休了，但也是一位经验丰富的布宴者，她应该有时间告知你们。[l][cm]"},"key":"text"},{"para":{"tag":"tag_9"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2b","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2b","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]好，交给我们吧。[l][cm]"},"key":"text"},{"para":{"tag":"tag_10"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2b","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿纳伊尔","text":"[show]嗯，我也该去进行日常的装备保养任务了，拜托你们了。[l][cm][hide]"},"key":"text"},{"para":{"tag":"tag_11"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"chara002_2_face_chara002_2b","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"","layer":"bg","x":-500,"transTime":300,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"","text":"[hide]"},"key":"text"},{"para":{"end":true},"key":"end"}],"des":"布宴者的礼物-接取步骤"}