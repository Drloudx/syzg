irrow":false}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"nameSide":"left","text":"[show]不会到现在还有着“啊我亲爱的米托拉姐姐真的不吃活人，我一定会没事儿的”～之类的想法吧？[l][cm]","charaName":"【米托拉】"}},{"key":"tag","para":{"tag":"tag_52"}},{"key":"text","para":{"nameSide":"left","text":"[show]我虽然确实和之前的谁谁订过什么契约，[r]确实说过什么“米托拉绝对不会吃活人”之类的怪话……[l][cm]","charaName":"【米托拉】"}},{"key":"tag","para":{"tag":"tag_53"}},{"key":"text","para":{"nameSide":"left","text":"[show]但把活人变成死人的本事，我好歹还是挺精通的。[l][cm]","charaName":"【米托拉】"}},{"key":"tag","para":{"tag":"tag_54"}},{"key":"text","para":{"nameSide":"left","text":"[show]做好心理准备了吧？[r][l]那就请你脱光光衣服，躺回我营地的残骸边上，我就一边祭奠我失去的营地，盐巴和肉，一边给你来刀痛快的——[l]","charaName":"【米托拉】"}},{"key":"option","para":{"options":[{"tag":"tag_55","text":"现在不全是残骸了。"},{"tag":"tag_55","text":"请和我一起回营地看看。"}]}},{"key":"tag","para":{"tag":"tag_55"}},{"key":"setLayer","para":{"trans":true,"scaleY":0.4,"layer":"fore","noIn":false,"noOut":false,"alpha":0,"img":"emoticon05","x":737,"y":580.2,"bright":1,"scaleX":0.4,"mirrow":false}},{"key":"moveLayer","para":{"trans":true,"transTime":300,"scaleY":0.4,"layer":"fore","noIn":false,"noOut":false,"alpha":0,"img":"emoticon05","x":737,"y":580.2,"bright":1,"scaleX":0.4,"mirrow":false}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"nameSide":"left","text":"[cm]","charaName":""}},{"key":"tag","para":{"tag":"tag_88"}},{"key":"moveLayer","para":{"trans":true,"transTime":300,"scaleY":1,"layer":"fore","noIn":false,"noOut":false,"alpha":1,"img":"emoticon05","x":747,"y":584,"bright":1,"scaleX":1,"mirrow":false}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"nameSide":"left","text":"[cm][show]……？什么？[l][hide][cm]","charaName":"【米托拉】"}},{"key":"tag","para":{"tag":"tag_56"}},{"key":"moveLayer","para":{"trans":true,"transTime":300,"scaleY":1,"layer":"chara2","noIn":false,"noOut":false,"alpha":0,"img":"chara002_0","x":444,"y":-289,"bright":1,"scaleX":1,"mirrow":false}},{"key":"moveLayer","para":{"trans":true,"transTime":300,"scaleY":1,"layer":"fore","noI