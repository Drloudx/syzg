{"script":"s_4_6_6","exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"nameSide":"left","charaName":"哈尔贝塔","text":"[show]那朵魔花真的被消灭了吗！感谢两位！不过……你们好像有点不太开心的样子？[l][cm]"},"key":"text"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"","layer":"bg","x":-500,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"setLayer"},{"para":{"noIn":false,"mirrow":false,"alpha":0.4,"addImg":"","layer":"bg","x":-500,"transTime":300,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"chara002_2_face_chara002_2e","layer":"chara2","x":340,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"setLayer"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2e","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]啊……也不是不开心啦，只是没达到最初的目标而已。[l]"},"key":"text"},{"para":{"tag":"tag_4"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2e","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"text":"（告知约伦德药草的事情。）","tag":"tag_5"}]},"key":"option"},{"para":{"tag":"tag_5"},"key":"tag"},{"para":{"nameSide":"left","charaName":"哈尔贝塔","text":"[show][cm]原来如此，辛普拉长子袭击猎场的时候，确实还吞噬了我们不少物资。不过大部分都是食物箱，吞噬的药草并不多，所以我没注意到。[l][cm]"},"key":"text"},{"para":{"tag":"tag_6"},"key":"tag"},{"para":{"nameSide":"left","charaName":"哈尔贝塔","text":"[show]这么看来，估计是运货的人错把约伦德先生的药草当成了援助西部猎场的物资，所以才误把他的药箱送了过来……结果，却被魔花给吃掉了。[l][cm]"},"key":"text"},{"para":{"tag":"tag_7"},"key":"tag"},{"para":{"nameSide":"left","charaName":"哈尔贝塔","text":"[show]不过眼下也没办法了，要不……把这个送给你们，当做我个人的谢礼吧。[l][cm]"},"key":"text"},{"para":{"tag":"tag_8"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2g","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2g","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]好臭……这袋子里面装的是……[l][cm]"},"key":"text"},{"para":{"tag":"tag_9"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2g","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"哈尔贝塔","text":"[show]这些都是之前讨伐的魔花身上收集到的脏器。希望这个可以补偿你们。[l][cm]"},"key":"text"},{"para":{"tag":"tag_10"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2c","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2c","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]啊？这些能有什么用啊？我、我不是很想……呃，好、好吧……我们收下了。[l][cm]"},"key":"text"},{"para":{"tag":"tag_11"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2h","layer":"chara2"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]虽然还是不知道有什么用，但今天都收了这么多没用的东西了，再收一个又有何妨呢……[l]"},"key":"text"},{"para":{"tag":"tag_12"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2h","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"text":"至少不是空手而归。","tag":"tag_13"}]},"key":"option"},{"para":{"tag":"tag_13"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2k","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2k","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show][cm]感觉也没区别啊……不过药没了也确实没办法，只能拿着这些魔花脏器回去找约伦德了……[l][cm][hide]"},"key":"text"},{"para":{"tag":"tag_14"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"chara002_2_face_chara002_2k","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"","layer":"bg","x":-500,"transTime":300,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"","text":"[hide]"},"key":"text"},{"para":{"end":true},"key":"end"}],"des":"我们把附近的魔花干掉了……"}