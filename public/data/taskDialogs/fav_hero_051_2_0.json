      "key": "text"
    },
    {
      "para": {
        "options": [
          {
            "tag": "tag_8",
            "text": "那对周边安全的影响太糟糕了！"
          },
          {
            "tag": "tag_8",
            "text": "附近的荒野客不会高兴的。"
