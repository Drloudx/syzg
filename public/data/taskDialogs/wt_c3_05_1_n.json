{"script":"wt_c3_05_1_n","exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"nameSide":"left","charaName":"水占师阿拉迪尔","text":"[show]抱歉……这些魔水凝晶还不够。[l][cm]"},"key":"text"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"nameSide":"left","charaName":"水占师阿拉迪尔","text":"[show]时间紧迫，请快一点吧，万一魔物在这时候发动袭击，我们将难以应对。[l][cm]"},"key":"text"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"end":true},"key":"end"}],"des":"保卫村庄"}