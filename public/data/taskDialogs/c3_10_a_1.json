      "key": "text"
    },
    {
      "para": {
        "options": [
          {
            "tag": "tag_3",
            "text": "这些蛇怪，或许和劳伦斯有关。"
          }
        ]
      },
      "key": "option"
    },
    {
      "para": {
        "nameSide": "left",
