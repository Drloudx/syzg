    {
      "para": {
        "nameSide": "left",
        "charaName": "",
        "text": "[show]向露比特介绍了你的想法——[l][cm]"
      },
      "key": "text"
    },
    {
      "para": {
        "nameSide": "left",
        "charaName": "露比特",
        "text": "[show]嗯嗯！[l][cm]"
