":false,"alpha":0,"addImg":"chara002_2_face_chara002_2a","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"","layer":"bg","x":-500,"transTime":300,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"赫里奥夫","text":"[show][cm]……父亲，既然你的朋友来了，那我就不打扰了。[l][cm]"},"key":"text"},{"para":{"tag":"tag_7"},"key":"tag"},{"para":{"nameSide":"left","charaName":"阿纳伊尔","text":"[show]嗯……忙碌了一天，好好休息一下吧。[l][cm]"},"key":"text"},{"para":{"tag":"tag_8"},"key":"tag"},{"para":{"nameSide":"left","charaName":"阿纳伊尔","text":"[show]欢迎回来，两位应该知道布宴的大致过程了吧。[l][cm]"},"key":"text"},{"para":{"tag":"tag_9"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"","layer":"bg","x":-500,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"setLayer"},{"para":{"noIn":false,"mirrow":false,"alpha":0.4,"addImg":"","layer":"bg","x":-500,"transTime":300,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"tag":"tag_10"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"chara002_2_face_chara002_2d","layer":"chara2","x":340,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"setLayer"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2d","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]算是知道了吧，布宴什么的比我们想象中要复杂得多……[l][cm]"},"key":"text"},{"para":{"tag":"tag_11"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"chara002_2_face_chara002_2d","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"","layer":"bg","x":-500,"transTime":300,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿纳伊尔","text":"[show]复……复杂？不就是搞一些什么礼仪吗？[l]"},"key":"text"},{"para":{"tag":"tag_12"},"key":"tag"},{"para":{"options":[{"text":"（将布宴的步骤告知阿纳伊尔。）","tag":"tag_13"}]},"key":"option"},{"para":{"tag":"tag_13"},"key":"tag"},{"para":{"nameSide":"left","charaName":"阿纳伊尔","text":"[show][cm]比我想象中还要复杂啊……不过我们也不是专业的布宴者，只能学点皮毛了。[l][cm]"},"key":"text"},{"para":{"tag":"tag_14"},"key":"tag"},{"para":{"nameSide":"left","charaName":"阿纳伊尔","text":"[show]非常抱歉给两位添麻烦了，让你们付出了更多的劳动。我会增加相应的报酬的。[l][cm]"},"key":"text"},{"para":{"tag":"tag_15"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"","layer":"bg","x":-500,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"setLayer"},{"para":{"noIn":false,"mirrow":false,"alpha":0.4,"addImg":"","layer":"bg","x":-500,"transTime":300,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"tag":"tag_16"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"chara002_2_face_chara002_2q","layer":"chara2","x":340,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"setLayer"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2q","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]没事我不用啦，反正我什么也没学到，真正多学的还是我旁边这位{myName}。[l]"},"key":"text"},{"para":{"tag":"tag_17"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2q","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"text":"报酬什么的都是小事。","tag":"tag_18"},{"text":"不过我还有个疑问。","tag":"tag_18"}]},"key":"option"},{"para":{"tag":"tag_18"},"key":"tag"},{"para":{"nameSide":"left","charaName":"阿纳伊尔","text":"[cm][show]有什么问题吗？请说吧。[l]"},"key":"text"},{"para":{"tag":"tag_19"},"key":"tag"},{"para":{"options":[{"text":"（询问灾变之宴和赫里奥夫的事情。）","tag":"tag_42"}]},"key":"option"},{"para":{"tag":"tag_42"},"key":"tag"},{"para":{"nameSide":"left","charaName":"","text":"[cm]"},"key":"text"},{"para":{"tag":"tag_20"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"chara002_2_face_chara002_2q","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"","layer":"bg","x":-500,"transTime":300,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿纳伊尔","text":"[show][cm]嗯……梅尔科卡居然跟你们说了这些事情啊。没关系，这也不是什么秘密，告诉你们也无妨。[l][cm]"},"key":"text"},{"para":{"tag":"tag_21"},"key":"tag"},{"para":{"nameSide":"left","charaName":"阿纳伊尔","text":"[show]你们可能也注意到了，我是鹿人，而赫里奥夫是木精灵。木精灵并没有我们鹿人那种将孩子交给其他家族抚养的传统，我们原本是很难产生交集的。[l][cm]"},"key":"text"},{"para":{"tag":"tag_22"},"key":"tag"},{"para":{"nameSide":"left","charaName":"阿纳伊尔","text":"[show]但灾变之宴毁灭了一切，赫里奥夫的亲生父母牺牲在那场灾难中。他的护林人父亲在死前把赫里奥夫托付给了我。[l][cm]"},"key":"text"},{"para":{"tag":"tag_23"},"key":"tag"},{"para":{"nameSide":"left","charaName":"阿纳伊尔","text":"[show]我自此承担起了抚养赫里奥夫的使命。失去双亲的他从小就非常努力，他希望继承父母的遗志……也希望回报我。[l][cm]"},"key":"text"},{"para":{"tag":"tag_24"},"key":"tag"},{"para":{"nameSide":"left","charaName":"阿纳伊尔","text":"[show]我虽然对他的懂事感到很欣慰，但我还是认为他承担了太多不属于他这个年纪所要承担的东西了。[l][cm]"},"key":"text"},{"para":{"tag":"tag_25"},"key":"tag"},{"para":{"nameSide":"left","charaName":"阿纳伊尔","text":"[show]他基本不进行任何的社交，总是一个劲地锻炼自己，而且尤其讨厌参加任何形式的宴会。这或许和他父母在宴会上死去的过往有关。[l][cm]"},"key":"text"},{"para":{"tag":"tag_26"},"key":"tag"},{"para":{"nameSide":"left","charaName":"阿纳伊尔","text":"[show]但我希望他明白，不要一直沉浸再过去。失去的便已经失去了，现在该做的是享受当下所拥有的。这也是我为他举办宴会的初衷。[l][cm]"},"key":"text"},{"para":{"tag":"tag_27"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"","layer":"bg","x":-500,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"setLayer"},{"para":{"noIn":false,"mirrow":false,"alpha":0.4,"addImg":"","layer":"bg","x":-500,"transTime":300,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"tag":"tag_28"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"chara002_2_face_chara002_2d","layer":"chara2","x":340,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"setLayer"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2d","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]没想到还有这样的故事……[l]"},"key":"text"},{"para":{"tag":"tag_29"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2d","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"text":"要走出来或许并不容易。","tag":"tag_30"}]},"key":"option"},{"para":{"tag":"tag_30"},"key":"tag"},{"para":{"nameSide":"left","charaName":"阿纳伊尔","text":"[show][cm]是的，不过我还是希望尽我所能让他走出阴影。我已经将他抚养长大，现在我希望让他的心境也有所成长。[l][cm]"},"key":"text"},{"para":{"tag":"tag_31"},"key":"tag"},{"para":{"nameSide":"left","charaName":"阿纳伊尔","text":"[show]毕竟……日后要经历的悲伤与苦难可能还有很多。如果停滞不前，只会让自己更加痛苦。[l][cm]"},"key":"text"},{"para":{"tag":"tag_32"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2e","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2e","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]停滞不前会让自己更加痛苦……确实是这个道理啊……[l][cm]"},"key":"text"},{"para":{"tag":"tag_33"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2e","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿纳伊尔","text":"[show]好了，两位也辛苦了。我现在也该开始准备了，今晚我就给赫里奥夫一个惊喜。[l][cm]"},"key":"text"},{"para":{"tag":"tag_34"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2a","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2a","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]材料都在这里了，接下来复习一下宴会的礼仪应该就可以了。[l][cm]"},"key":"text"},{"para":{"tag":"tag_35"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2a","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿纳伊尔","text":"[show]没错，两位要不要也参加。这次的宴会我们还准备了很多额外的食物。[l][cm]"},"key":"text"},{"para":{"tag":"tag_36"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2o","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2o","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]要要要！那个……有肉吗？[l][cm]"},"key":"text"},{"para":{"tag":"tag_37"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2o","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿纳伊尔","text":"[show]咱们猎场最不缺的就是肉，只要你们愿意参加，保证你们能吃个满！[l][cm]"},"key":"text"},{"para":{"tag":"tag_38"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2b","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2b","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]好！就这么说定了，我今晚要吃三大盘！[l][cm]"},"key":"text"},{"para":{"tag":"tag_39"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2b","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿纳伊尔","text":"[show]那请进来休息吧，我们这就开始准备！[l][cm]"},"key":"text"},{"para":{"tag":"tag_40"},"key":"tag"},{"para":{"nameSide":"left","charaName":"","text":"[show]（之后的当晚，这对父子在宴席上以热泪相拥，米托拉也感动得大吃了一顿。）[l][cm][hide]"},"key":"text"},{"para":{"tag":"tag_43"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"chara002_2_face_chara002_2b","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"","layer":"bg","x":-500,"transTime":300,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"","text":"[hide]"},"key":"text"},{"para":{"end":true},"key":"end"}],"des":"东西都准备好了。"}