e},"key":"moveLayer"},{"para":{"transTime":300,"alpha":0,"scaleX":1,"trans":true,"noOut":false,"addImg":"chara041_1_face_chara041_1e","noIn":false,"x":588,"img":"chara041_1","scaleY":1,"bright":1,"layer":"chara3","y":-325,"mirrow":false},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"transTime":300,"alpha":0,"scaleX":1.5,"trans":true,"noOut":false,"addImg":"","noIn":false,"x":-500,"img":"bgblack","scaleY":1.5,"bright":1,"layer":"bg","y":-125,"mirrow":false},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"text":"[show]好的！埃迪蒂小姐辛苦了——！[l][cm]","charaName":"奥希娅尔","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_15"},"key":"tag"},{"para":{"text":"[show]呼……非常感谢你们，那个……你们没有打开来看吧？[l][cm]","charaName":"奥希娅尔","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_16"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"alpha":0,"scaleX":1.5,"trans":true,"noOut":false,"addImg":"","noIn":false,"x":-500,"img":"bgblack","scaleY":1.5,"bright":1,"layer":"bg","y":-125,"mirrow":false},"key":"setLayer"},{"para":{"transTime":300,"alpha":0.4,"scaleX":1.5,"trans":true,"noOut":false,"addImg":"","noIn":false,"x":-500,"img":"bgblack","scaleY":1.5,"bright":1,"layer":"bg","y":-125,"mirrow":false},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"alpha":0,"scaleX":1,"trans":true,"noOut":false,"addImg":"chara002_2_face_chara002_2a","noIn":false,"x":340,"img":"chara002_2","scaleY":1,"bright":1,"layer":"chara2","y":-180,"mirrow":false},"key":"setLayer"},{"para":{"transTime":300,"alpha":1,"scaleX":1,"trans":true,"noOut":false,"addImg":"chara002_2_face_chara002_2a","noIn":false,"x":340,"img":"chara002_2","scaleY":1,"bright":1,"layer":"chara2","y":-180,"mirrow":false},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"text":"[show]我们从阿拉迪尔那边拿到笔记本之后就直接来这边了，一页都没打开过啦，当然阿拉迪尔也说没看过。[l][cm]","charaName":"米托拉","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_17"},"key":"tag"},{"para":{"transTime":300,"alpha":0,"scaleX":1,"trans":true,"noOut":false,"addImg":"chara002_2_face_chara002_2a","noIn":false,"x":340,"img":"chara002_2","scaleY":1,"bright":1,"layer":"chara2","y":-180,"mirrow":false},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"transTime":300,"alpha":0,"scaleX":1.5,"trans":true,"noOut":false,"addImg":"","noIn":false,"x":-500,"img":"bgblack","scaleY":1.5,"bright":1,"layer":"bg","y":-125,"mirrow":false},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"text":"[show]嗯，你们能遵守约定真的太好了。[l]","charaName":"奥希娅尔","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_18"},"key":"tag"},{"para":{"options":[{"text":"所以里面到底是……","tag":"tag_19"}]},"key":"option"},{"para":{"tag":"tag_19"},"key":"tag"},{"para":{"text":"[cm][show]也没什么啦，我有画画的爱好，同时也崇拜着埃迪蒂小姐，所以笔记里面的内容，都是我画的埃迪蒂小姐……[l][cm]","charaName":"奥希娅尔","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_20"},"key":"tag"},{"para":{"text":"[show]咳咳……笔记本的事就说到这吧。这是契约费，谢谢你们帮助我解决了烦恼。[l]","charaName":"奥希娅尔","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_21"},"key":"tag"},{"para":{"options":[{"text":"没想到大英雄也有这种小烦恼啊。","tag":"tag_22"}]},"key":"option"},{"para":{"tag":"tag_22"},"key":"tag"},{"para":{"text":"[cm][show]大英雄就过誉啦。不过不管怎么说，大市集的每个人……包括治安官，都有着自己的烦恼呢，哪怕是英雄也一样。[l][cm]","charaName":"奥希娅尔","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_23"},"key":"tag"},{"para":{"text":"[show]我想埃迪蒂小姐也是一样的吧……不过大家依然在努力建设一个秩序、繁荣的大市集。每次一想到这点，哪怕再烦恼的我也会充满力量，刚刚对付那几个强盗靠的就是这股力量。[l][cm]","charaName":"奥希娅尔","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_24"},"key":"tag"},{"para":{"text":"[show]当然啦，你们能帮我解决掉烦恼那就更好了，再次感谢你们！[l][cm][hide]","charaName":"奥希娅尔","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"end":true},"key":"end"}],"des":"回到大市集，与治安队员奥希娅尔聊聊。"}