e_chara002_2c","scaleY":1,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]唉？还有这种事？[l][cm]"},"key":"text"},{"para":{"tag":"tag_8"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"scaleX":1,"layer":"chara1","img":"chara002_2","mirrow":false,"transTime":300,"x":50,"trans":true,"y":-180,"noOut":false,"addImg":"chara002_2_face_chara002_2c","scaleY":1,"noIn":false,"bright":0.6},"key":"moveLayer"},{"para":{"alpha":1,"scaleX":1,"layer":"chara3","img":"chara049_1","mirrow":false,"transTime":300,"x":337.75,"trans":true,"y":-340,"noOut":false,"addImg":"chara049_1_face_chara049_1d","scaleY":1,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"菲莉娜","text":"[show]唔……罗伯特大叔说得没错，我也记不清那个人是什么样了。[l][cm]"},"key":"text"},{"para":{"tag":"tag_9"},"key":"tag"},{"para":{"nameSide":"left","charaName":"菲莉娜","text":"[show]我猜那可能是某种魔法，或者类似的技术，能够隐藏身份……[l][cm]"},"key":"text"},{"para":{"tag":"tag_10"},"key":"tag"},{"para":{"nameSide":"left","charaName":"菲莉娜","text":"[show]平时这当然很可疑，但对危难时刻向我们伸出援手的朋友，我们倒也不必那么较真。[l][cm]"},"key":"text"},{"para":{"tag":"tag_11"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"alpha":1,"scaleX":1,"layer":"chara1","img":"chara002_2","mirrow":false,"transTime":300,"x":50,"trans":true,"y":-180,"noOut":false,"addImg":"chara002_2_face_chara002_2c","scaleY":1,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"alpha":1,"scaleX":1,"layer":"chara3","img":"chara049_1","mirrow":false,"transTime":300,"x":337.75,"trans":true,"y":-340,"noOut":false,"addImg":"chara049_1_face_chara049_1d","scaleY":1,"noIn":false,"bright":0.6},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]这、这样啊……[l][cm]"},"key":"text"},{"para":{"tag":"tag_12"},"key":"tag"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]那，菲莉娜还记得她是怎么做到的吗？一个人跑到山顶，到底是怎么阻止魔物，让它们调转矛头的呢？[l][cm]"},"key":"text"},{"para":{"tag":"tag_13"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"scaleX":1,"layer":"chara1","img":"chara002_2","mirrow":false,"transTime":300,"x":50,"trans":true,"y":-180,"noOut":false,"addImg":"chara002_2_face_chara002_2c","scaleY":1,"noIn":false,"bright":0.6},"key":"moveLayer"},{"para":{"alpha":1,"scaleX":1,"layer":"chara3","img":"chara049_1","mirrow":false,"transTime":300,"x":337.75,"trans":true,"y":-340,"noOut":false,"addImg":"chara049_1_face_chara049_1d","scaleY":1,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"菲莉娜","text":"[show]很抱歉，这我也不知道。等我布好防线，准备去山上看看情况的时候，魔物潮就已经从山洞里涌出来了，我们被迫应战。[l][cm]"},"key":"text"},{"para":{"tag":"tag_14"},"key":"tag"},{"para":{"img":"chara049_1_face_chara049_1a","layer":"chara3"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"菲莉娜","text":"[show]虽然不知道那位英雄究竟做了什么，但她所言不虚。本来能一次摧毁巴诺姆村的魔物潮，被我们分波堵截在山洞附近，给我们争取到许多重整防御的时间。[l][cm]"},"key":"text"},{"para":{"tag":"tag_15"},"key":"tag"},{"para":{"nameSide":"left","charaName":"菲莉娜","text":"[show]可以说就是多亏了她的承诺，让巴诺姆村挺过了大兽潮。[l][cm]"},"key":"text"},{"para":{"tag":"tag_16"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"alpha":1,"scaleX":1,"layer":"chara3","img":"chara049_1","mirrow":false,"transTime":300,"x":337.75,"trans":true,"y":-340,"noOut":false,"addImg":"chara049_1_face_chara049_1a","scaleY":1,"noIn":false,"bright":0.6},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"“工头”罗伯特","text":"[show]是啊，那可真是不容易。现在想来，真的多亏了那位勇士。[l][cm]"},"key":"text"},{"para":{"tag":"tag_17"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2q","layer":"chara1"},"key":"setLayerFace"},{"para":{"alpha":1,"scaleX":1,"layer":"chara1","img":"chara002_2","mirrow":false,"transTime":300,"x":50,"trans":true,"y":-180,"noOut":false,"addImg":"chara002_2_face_chara002_2q","scaleY":1,"noIn":false,"bright":1},"key":"moveLa