{"exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"alpha":0,"trans":true,"layer":"bg","noOut":false,"x":-500,"bright":1,"y":-125,"scaleX":1.5,"noIn":false,"mirrow":false,"img":"bgblack","addImg":"","scaleY":1.5},"key":"setLayer"},{"para":{"alpha":0.4,"trans":true,"layer":"bg","noOut":false,"x":-500,"bright":1,"transTime":300,"y":-125,"scaleX":1.5,"noIn":false,"mirrow":false,"img":"bgblack","addImg":"","scaleY":1.5},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"nameSide":"left","charaName":"博物学教授本诺","text":"[show]哦，各位是想问魔宠的事吧！那你们可就问对人了，就让我本诺博士替你们解答吧！[l][cm]"},"key":"text"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"alpha":0,"trans":true,"layer":"chara3","noOut":false,"x":510,"bright":0.6,"y":-416,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara053_1","addImg":"chara053_1_face_chara053_1c","scaleY":1},"key":"setLayer"},{"para":{"alpha":1,"trans":true,"layer":"chara3","noOut":false,"x":510,"bright":0.6,"transTime":300,"y":-416,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara053_1","addImg":"chara053_1_face_chara053_1c","scaleY":1},"key":"moveLayer"},{"para":{"alpha":0,"trans":true,"layer":"chara1","noOut":false,"x":50,"bright":1,"y":-180,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2","addImg":"chara002_2_face_chara002_2h","scaleY":1},"key":"setLayer"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":50,"bright":1,"transTime":300,"y":-180,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2","addImg":"chara002_2_face_chara002_2h","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]……什么博士？你不是大书院的教授吗？[l][cm]"},"key":"text"},{"para":{"tag":"tag_4"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":50,"bright":0.6,"transTime":300,"y":-180,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2","addImg":"chara002_2_face_chara002_2h","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"tag":"tag_5"},"key":"tag"},{"para":{"nameSide":"left","charaName":"本诺博士","text":"[show]初次见面！欢迎你们进入魔宠对决的世界！我的名字是本诺。大家都称我为魔宠博士！[l][cm]"},"key":"text"},{"para":{"tag":"tag_6"},"key":"tag"},{"para":{"layer":"chara1","img":"chara002_2_face_chara002_2e"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":50,"bright":1,"transTime":300,"y":-180,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2","addImg":"chara002_2_face_chara002_2e","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]啊？我们好像也不是初次见面了吧……而且魔宠对决这玩意有这么流行吗……[l][cm]"},"key":"text"},{"para":{"tag":"tag_7"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":50,"bright":0.6,"transTime":300,"y":-180,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2","addImg":"chara002_2_face_chara002_2e","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"本诺博士","text":"[show]这个世界里，存在着许多名为魔宠的生物……人们与魔宠一同玩耍、互相帮助……有时候，我们也与它们一起战斗……后略！这就是魔宠对决！[l][cm]"},"key":"text"},{"para":{"tag":"tag_8"},"key":"tag"},{"para":{"layer":"chara1","img":"chara002_2_face_chara002_2h"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":50,"bright":1,"transTime":300,"y":-180,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2","addImg":"chara002_2_face_chara002_2h","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]你在讲什么东西我好像完全没懂啊！[l][cm]"},"key":"text"},{"para":{"tag":"tag_9"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":50,"bright":0.6,"transTime":300,"y":-180,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2","addImg":"chara002_2_face_chara002_2h","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"博物学教授本诺","text":"[show]唔……总之，魔宠对决，就是指拥有魔宠的人——我们称之为魔宠主——可以向对方发起挑战，失败者将失去身上一半的银币，这样的赌上尊严的决斗活动！[l][cm]"},"key":"text"},{"para":{"tag":"tag_10"},"key":"tag"},{"para":{"layer":"chara1","img":"chara002_2_face_chara002_2q"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":50,"bright":1,"transTime":300,"y":-180,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2","addImg":"chara002_2_face_chara002_2q","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]所以这到底是什么奇怪的规则啊……[l][cm]"},"key":"text"},{"para":{"tag":"tag_11"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":50,"bright":0.6,"transTime":300,"y":-180,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2","addImg":"chara002_2_face_chara002_2q","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"博物学教授本诺","text":"[show]而且还有非常关键的一点：只有经过我们的“魔宠图鉴”权威认证的魔物才能被称为魔宠，也只有魔宠才有资格参与对决。你们看，这就是魔宠图鉴！[l][cm]"},"key":"text"},{"para":{"tag":"tag_12"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"trans":true,"layer":"chara3","noOut":false,"x":510,"bright":1,"transTime":300,"y":-416,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara053_1","addImg":"chara053_1_face_chara053_1c","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"艾薇杜尔","text":"[show]这就是魔宠图鉴……和奥格小姐手上的卷轴一模一样呢。[l][cm]"},"key":"text"},{"para":{"tag":"tag_13"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara3","noOut":false,"x":510,"bright":0.6,"transTime":300,"y":-416,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara053_1","addImg":"chara053_1_face_chara053_1c","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"博物学教授本诺","text":"[show]没错，这就我发明的魔法图鉴。它会将你遇到和驯服的魔宠信息都登记上去，每隔一段时间就可以来我这里更新一次。[l][cm]"},"key":"text"},{"para":{"tag":"tag_14"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"layer":"chara1","img":"chara002_2_face_chara002_2h"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":50,"bright":1,"transTime":300,"y":-180,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2","addImg":"chara002_2_face_chara002_2h","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]说到这个我就想问问你了，为什么你的图鉴里连我们家姆姆的信息都没有啊？它明明是很常见的魔物，到你这里居然不算数！[l][cm]"},"key":"text"},{"para":{"tag":"tag_15"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":50,"bright":0.6,"transTime":300,"y":-180,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2","addImg":"chara002_2_face_chara002_2h","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"博物学教授本诺","text":"[show]哈！你家的嫩绿史莱姆在我们这根本就没有栖息地吧！霜烬平原的魔宠图鉴怎么可能登记其他地区的魔宠！[l][cm]"},"key":"text"},{"para":{"tag":"tag_16"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":50,"bright":1,"transTime":300,"y":-180,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2","addImg":"chara002_2_face_chara002_2h","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]你这个图鉴也太烂了吧？[l][cm]"},"key":"text"},{"para":{"tag":"tag_17"},"key":"tag"},{"para":{"alpha":0,"trans":true,"layer":"chara3","noOut":false,"x":510,"bright":0.6,"transTime":300,"y":-416,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara053_1","addImg":"chara053_1_face_chara053_1c","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":0,"trans":true,"layer":"chara3","noOut":false,"x":300,"bright":1,"y":-138,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara064_1","addImg":"chara064_1_face_chara064_1a","scaleY":1},"key":"setLayer"},{"para":{"alpha":1,"trans":true,"layer":"chara3","noOut":false,"x":300,"bright":1,"transTime":300,"y":-138,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara064_1","addImg":"chara064_1_face_chara064_1a","scaleY":1},"key":"moveLayer"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":50,"bright":0.6,"transTime":300,"y":-180,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2","addImg":"chara002_2_face_chara002_2h","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"伽拉忒亚","text":"[show]本诺博士，我们还是快进入主题吧！米托拉他们刚才因为没有魔宠而输掉了对决，您能给他们一些魔宠，让她们去找奥格小姐复仇吗？[l][cm]"},"key":"text"},{"para":{"tag":"tag_18"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara3","noOut":false,"x":300,"bright":0.6,"transTime":300,"y":-138,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara064_1","addImg":"chara064_1_face_chara064_1a","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"博物学教授本诺","text":"[show]哈哈，原来如此，你们是因为对决失败才来找我的啊。[l][cm]"},"key":"text"},{"para":{"tag":"tag_19"},"key":"tag"},{"para":{"nameSide":"left","charaName":"博物学教授本诺","text":"[show]不过……我们大部分的魔宠也都是从供应商那购买的，自己驯养出来的数量并算不多。目前的情况是……我这里的魔宠已经全部售罄了。[l][cm]"},"key":"text"},{"para":{"tag":"tag_20"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"layer":"chara1","img":"chara002_2_face_chara002_2q"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":50,"bright":1,"transTime":300,"y":-180,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2","addImg":"chara002_2_face_chara002_2q","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]从供应商那购买的……驯养魔物？我怎么有不好的预感……[l]"},"key":"text"},{"para":{"tag":"tag_21"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":50,"bright":0.6,"transTime":300,"y":-180,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2","addImg":"chara002_2_face_chara002_2q","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"tag":"tag_22","text":"你们的那位供应商，莫非是……"}]},"key":"option"},{"para":{"tag":"tag_22"},"key":"tag"},{"para":{"nameSide":"left","charaName":"博物学教授本诺","text":"[cm][show]嗯，没错，就是那位魔物驯养家露比。你们在街上看到的魔宠，十只里就有八只是她们家提供的。[l][cm]"},"key":"text"},{"para":{"tag":"tag_23"},"key":"tag"},{"para":{"layer":"chara1","img":"chara002_2_face_chara002_2h"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":50,"bright":1,"transTime":300,"y":-180,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2","addImg":"chara002_2_face_chara002_2h","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]果然是她……[l][cm]"},"key":"text"},{"para":{"tag":"tag_24"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":50,"bright":0.6,"transTime":300,"y":-180,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2","addImg":"chara002_2_face_chara002_2h","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"博物学教授本诺","text":"[show]不过也不是完全没办法。我手上还有几只魔宠可以借给你们，不过你们得帮我个忙。[l][cm]"},"key":"text"},{"para":{"tag":"tag_25"},"key":"tag"},{"para":{"nameSide":"left","charaName":"博物学教授本诺","text":"[show]刚刚你们说图鉴登记不全，这点我也认同。我也确实需要更多魔物的资料。我想把这张原型图鉴借给你们，你们来帮我收集魔物的信息，这样可以吗？[l][cm]"},"key":"text"},{"para":{"tag":"tag_26"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"layer":"chara3","img":"chara064_1_face_chara064_1f"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara3","noOut":false,"x":300,"bright":1,"transTime":300,"y":-138,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara064_1","addImg":"chara064_1_face_chara064_1f","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"伽拉忒亚","text":"[show]收集图鉴的信息？我们该怎么做呢？[l][cm]"},"key":"text"},{"para":{"tag":"tag_27"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara3","noOut":false,"x":300,"bright":0.6,"transTime":300,"y":-138,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara064_1","addImg":"chara064_1_face_chara064_1f","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"博物学教授本诺","text":"[show]嗯，对你们契约者来说是很简单的活计。你们只需要找到魔物，想办法让它们无力化后，扫描它们身上的魔力即可。[l][cm]"},"key":"text"},{"para":{"tag":"tag_28"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"layer":"chara1","img":"chara002_2_face_chara002_2e"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":50,"bright":1,"transTime":300,"y":-180,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2","addImg":"chara002_2_face_chara002_2e","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]……也就是说，只要把这些魔物打倒，用魔法卷轴扫描一下就行，对吧？[l][cm]"},"key":"text"},{"para":{"tag":"tag_29"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":50,"bright":0.6,"transTime":300,"y":-180,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2","addImg":"chara002_2_face_chara002_2e","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"博物学教授本诺","text":"[show]没错。目前需要收集信息的魔物包括冰棱妖精、雪鼠芙洛波以及熔火元素。每种各扫描三只即可。怎么样，这个任务你们接吗？[l][cm]"},"key":"text"},{"para":{"tag":"tag_30"},"key":"tag"},{"para":{"layer":"chara1","img":"chara002_2_face_chara002_2a"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":50,"bright":1,"transTime":300,"y":-180,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2","addImg":"chara002_2_face_chara002_2a","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]没问题，交给我们吧。只要在我们回来之后把最强的魔宠交给我们，拿回我的钱就行。[l][cm]"},"key":"text"},{"para":{"tag":"tag_31"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":50,"bright":0.6,"transTime":300,"y":-180,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2","addImg":"chara002_2_face_chara002_2a","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"博物学教授本诺","text":"[show]当然没问题，交给你们的魔宠一定能打败奥格。这是给你们的图鉴，拿好了。那三种魔物，你们去沉星冰湖、温泉村和火龙山径这三处应该就能找到它们。[l][cm]"},"key":"text"},{"para":{"tag":"tag_32"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"layer":"chara3","img":"chara064_1_face_chara064_1b"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara3","noOut":false,"x":300,"bright":1,"transTime":300,"y":-138,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara064_1","addImg":"chara064_1_face_chara064_1b","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"伽拉忒亚","text":"[show]看起来很好玩的样子，我可以和你们一起去吗～？[l][cm]"},"key":"text"},{"para":{"tag":"tag_33"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"alpha":1,"trans":true,"layer":"chara3","noOut":false,"x":300,"bright":0.6,"transTime":300,"y":-138,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara064_1","addImg":"chara064_1_face_chara064_1b","scaleY":1},"key":"moveLayer"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":50,"bright":1,"transTime":300,"y":-180,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2","addImg":"chara002_2_face_chara002_2a","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]好啊好啊，欢迎加入！我们先去找冰棱妖精吧。[l][cm]"},"key":"text"},{"para":{"tag":"tag_34"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara1","noOut":false,"x":50,"bright":0.6,"transTime":300,"y":-180,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2","addImg":"chara002_2_face_chara002_2a","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"博物学教授本诺","text":"[show]哦哦，我就在这里等候你们的消息！去吧，魔宠对决者们！你们可能就是未来的冠军！[l][cm][hide]"},"key":"text"},{"para":{"tag":"tag_35"},"key":"tag"},{"para":{"alpha":0,"trans":true,"layer":"chara3","noOut":false,"x":300,"bright":0.6,"transTime":300,"y":-138,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara064_1","addImg":"chara064_1_face_chara064_1b","scaleY":1},"key":"moveLayer"},{"para":{"alpha":0,"trans":true,"layer":"chara1","noOut":false,"x":50,"bright":0.6,"transTime":300,"y":-180,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2","addImg":"chara002_2_face_chara002_2a","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"alpha":0,"trans":true,"layer":"bg","noOut":false,"x":-500,"bright":1,"transTime":300,"y":-125,"scaleX":1.5,"noIn":false,"mirrow":false,"img":"bgblack","addImg":"","scaleY":1.5},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"nameSide":"left","charaName":"","text":"[hide]"},"key":"text"},{"para":{"end":true},"key":"end"}],"des":"","script":"s_5_1_1"}