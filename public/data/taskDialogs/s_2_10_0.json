ayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米托拉","text":"[show]土豆？[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_10"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"noOut":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2c","trans":true,"noIn":false,"layer":"chara1","x":50,"transTime":300,"y":-180,"bright":0.6,"scaleY":1,"img":"chara002_2"},"key":"moveLayer"},{"para":{"img":"chara050_1_face_chara050_1c","layer":"chara3"},"key":"setLayerFace"},{"para":{"noOut":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara050_1_face_chara050_1c","trans":true,"noIn":false,"layer":"chara3","x":500,"transTime":300,"y":-172,"bright":1,"scaleY":1,"img":"chara050_1"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米拉贝尔","text":"[show]嗯。其实我们巴诺姆村……在大兽潮之前，大家都是吃胡萝卜的。但大兽潮之后，不少农夫发现土壤种出的萝卜又小又瘪，大家为了填饱肚子，只能改种土豆了。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_11"},"key":"tag"},{"para":{"charaName":"米拉贝尔","text":"[show]但一直吃这些谁能受到了啊？早上炖土豆，中午煮土豆，晚上土豆炒土豆……我们就这么吃了五年……[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_12"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"noOut":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2c","trans":true,"noIn":false,"layer":"chara1","x":50,"transTime":300,"y":-180,"bright":1,"scaleY":1,"img":"chara002_2"},"key":"moveLayer"},{"para":{"noOut":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara050_1_face_chara050_1c","trans":true,"noIn":false,"layer":"chara3","x":500,"transTime":300,"y":-172,"bright":0.6,"scaleY":1,"img":"chara050_1"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米托拉","text":"[show]原来如此，一直吃同一样东西……好像确实会让人疯掉。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_13"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"noOut":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2c","trans":true,