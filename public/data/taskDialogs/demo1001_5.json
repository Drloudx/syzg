      }
    },
    {
      "key": "text",
      "para": {
        "charaName": "【角布林巡逻队长】",
        "text": "（倒下的声音）[l][hide][cm]",
        "nameSide": "right"
      }
    },
    {
      "key": "text",
      "para": {
        "charaName": "【米托拉】",
        "text": "[cm][show]呼……呼……呼……[r]唔嗯嗯嗯……唔咕咕咕……嘎吱嘎吱、咕哝咕哝……[l]",
        "nameSide": "left"
      }
    },
    {
      "key": "option",
      "para": {
        "options": [
          {
            "text": "米……米托拉小姐？",
            "tag": "tag_yes"
          },
          {
            "text": "我们……安全了……对吧？",
            "tag": "tag_yes"
          }
        ]
      }
    },
    {
      "key": "text",
      "para": {
        "charaName": "【米托拉】",
        "text": "[cm][show]滚开！[l]",
        "nameSide": "left"
      }
    },
    {
      "key": "text",
      "para": {
        "charaName": "【米托拉】",
        "text": "[show]不对你给我滚过来！[r][l]",
        "nameSide": "left"
      }
    },
    {
      "key": "text",
      "para": {
        "charaName": "【米托拉】",
        "text": "[show]把我刚给你喝的水、吃的饼都给我吐出来！[l][cm]",
        "nameSide": "left"
      }
    },
    {
      "key": "text",
      "para": {
        "charaName": "【米托拉】",
        "text": "[show]然后赶快去死一死！死完了给我在这儿躺好！我保证把你剐得干干净净，不留一点皮一点毛！[l][hide][cm]",
        "nameSide": "left"
      }
    },
    {
      "key": "text",
      "para": {
        "charaName": "【米托拉】",
        "text": "[cm][show]我的营地！",
        "nameSide": "left"
      }
    },
    {
      "key": "text",
      "para": {
        "charaName": "【米托拉】",
        "text": "——我的干粮！我的麦饼、我的面包、我的盐巴、我的肉——！[r]",
        "nameSide": "left"
      }
    },
    {
      "key": "text",
      "para": {
        "charaName": "【米托拉】",
        "text": "我要吃了你、我一定要吃了你——我操！它们把我生火的木头都给啃光了！[l][hide][cm]",
        "nameSide": "left"
      }
    },
    {
      "key": "text",
      "para": {
        "charaName": "【米托拉】",
        "text": "[cm][show]你给我等着，我今天一定要吃了你——！[l][hide][cm]",
        "nameSide": "left"
      }
    },
    {
      "key": "option",
      "para": {
        "options": [
          {
            "tag": "tag_16",
            "text": "米托拉小姐——！"
          }
        ]
      }
    },
    {
      "key": "text",
      "para": {
        "charaName": "",
        "text": "[show]……[l][hide][cm]",
        "nameSide": "left"
      }
    },
    {
      "key": "option",
      "para": {
        "options": [
          {
            "tag": "tag_44",
            "text": "我是不是应该……和她说声对不起？"
          }
        ]
      }
    }
  ],
  "script": "demo1001_5"
