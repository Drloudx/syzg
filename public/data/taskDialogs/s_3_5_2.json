{"script":"s_3_5_2","exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"charaName":"木匠耶沙米尔","text":"[show]年轻人，你们找我？[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"noOut":false,"mirrow":false,"alpha":0,"scaleX":1.5,"addImg":"","trans":true,"noIn":false,"layer":"bg","x":-500,"y":-125,"bright":1,"scaleY":1.5,"img":"bgblack"},"key":"setLayer"},{"para":{"noOut":false,"mirrow":false,"alpha":0.4,"scaleX":1.5,"addImg":"","trans":true,"noIn":false,"layer":"bg","x":-500,"transTime":300,"y":-125,"bright":1,"scaleY":1.5,"img":"bgblack"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"noOut":false,"mirrow":false,"alpha":0,"scaleX":1,"addImg":"chara002_2_face_chara002_2a","trans":true,"noIn":false,"layer":"chara2","x":340,"y":-180,"bright":1,"scaleY":1,"img":"chara002_2"},"key":"setLayer"},{"para":{"noOut":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2a","trans":true,"noIn":false,"layer":"chara2","x":340,"transTime":300,"y":-180,"bright":1,"scaleY":1,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米托拉","text":"[show]我们听说你是这一带最厉害的木匠！[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_4"},"key":"tag"},{"para":{"noOut":false,"mirrow":false,"alpha":0,"scaleX":1,"addImg":"chara002_2_face_chara002_2a","trans":true,"noIn":false,"layer":"chara2","x":340,"transTime":300,"y":-180,"bright":1,"scaleY":1,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"noOut":false,"mirrow":false,"alpha":0,"scaleX":1.5,"addImg":"","trans":true,"noIn":false,"layer":"bg","x":-500,"transTime":300,"y":-125,"bright":1,"scaleY":1.5,"img":"bgblack"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"木匠耶沙米尔","text":"[show]哈哈哈，过奖了，我只不过是一个普通的木匠罢了。说吧，有什么事吗？[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_5"},"key":"tag"},{"para":{"charaName":"木匠耶沙米尔","text":"[show]你们要打造的东西是……装花的车子？我不太懂你们的意思，可以简单说一下你们想要干什么吗？[l]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_6"},"key":"tag"},{"para":{"options":[{"text":"（把大致情况告知耶沙米尔。）","tag":"tag_7"}]},"key":"option"},{"para":{"tag":"tag_7"},"key":"tag"},{"para":{"charaName":"木匠耶沙米尔","text":"[cm][show]原来如此……米罗尼娅的花店是嘛。我也经常去光顾呢，每次到大市集，我都会多走几条街，从那个可爱的小姑娘手上买几朵花回来。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_8"},"key":"tag"},{"para":{"noOut":false,"mirrow":false,"alpha":0,"scaleX":1.5,"addImg":"","trans":true,"noIn":false,"layer":"bg","x":-500,"y":-125,"bright":1,"scaleY":1.5,"img":"bgblack"},"key":"setLayer"},{"para":{"noOut":false,"mirrow":false,"alpha":0.4,"scaleX":1.5,"addImg":"","trans":true,"noIn":false,"layer":"bg","x":-500,"transTime":300,"y":-125,"bright":1,"scaleY":1.5,"img":"bgblack"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"noOut":false,"mirrow":false,"alpha":0,"scaleX":1,"addImg":"chara002_2_face_chara002_2c","trans":true,"noIn":false,"layer":"chara2","x":340,"y":-180,"bright":1,"scaleY":1,"img":"chara002_2"},"key":"setLayer"},{"para":{"noOut":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2c","trans":true,"noIn":false,"layer":"chara2","x":340,"transTime":300,"y":-180,"bright":1,"scaleY":1,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米托拉","text":"[show]唉？没想到你也是那家花店的客人啊？[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_9"},"key":"tag"},{"para":{"noOut":false,"mirrow":false,"alpha":0,"scaleX":1,"addImg":"chara002_2_face_chara002_2c","trans":true,"noIn":false,"layer":"chara2","x":340,"transTime":300,"y":-180,"bright":1,"scaleY":1,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"noOut":false,"mirrow":false,"alpha":0,"scaleX":1.5,"addImg":"","trans":true,"noIn":false,"layer":"bg","x":-500,"transTime":300,"y":-125,"bright":1,"scaleY":1.5,"img":"bgblack"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"木匠耶沙米尔","text":"[show]哈哈哈……每次看到那姑娘的笑容就有种被治愈的感觉，所以我总是忍不住上去帮帮她的生意。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_10"},"key":"tag"},{"para":{"charaName":"木匠耶沙米尔","text":"[show]把这次也算上吧，我把图纸给你们，你们就拿着这个回去制作就好了。过程并不难，不过你们还需要[color=f1401c]3个木板[colorEnd]和[color=f1401c]1个石砖[colorEnd]。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_11"},"key":"tag"},{"para":{"noOut":false,"mirrow":false,"alpha":0,"scaleX":1.5,"addImg":"","trans":true,"noIn":false,"layer":"bg","x":-500,"y":-125,"bright":1,"scaleY":1.5,"img":"bgblack"},"key":"setLayer"},{"para":{"noOut":false,"mirrow":false,"alpha":0.4,"scaleX":1.5,"addImg":"","trans":true,"noIn":false,"layer":"bg","x":-500,"transTime":300,"y":-125,"bright":1,"scaleY":1.5,"img":"bgblack"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"noOut":false,"mirrow":false,"alpha":0,"scaleX":1,"addImg":"chara002_2_face_chara002_2b","trans":true,"noIn":false,"layer":"chara2","x":340,"y":-180,"bright":1,"scaleY":1,"img":"chara002_2"},"key":"setLayer"},{"para":{"noOut":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2b","trans":true,"noIn":false,"layer":"chara2","x":340,"transTime":300,"y":-180,"bright":1,"scaleY":1,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米托拉","text":"[show]好的！非常感谢！[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_12"},"key":"tag"},{"para":{"noOut":false,"mirrow":false,"alpha":0,"scaleX":1,"addImg":"chara002_2_face_chara002_2b","trans":true,"noIn":false,"layer":"chara2","x":340,"transTime":300,"y":-180,"bright":1,"scaleY":1,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"noOut":false,"mirrow":false,"alpha":0,"scaleX":1.5,"addImg":"","trans":true,"noIn":false,"layer":"bg","x":-500,"transTime":300,"y":-125,"bright":1,"scaleY":1.5,"img":"bgblack"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"木匠耶沙米尔","text":"[show]哈哈，只是尽了些绵薄之力罢了，那家花店的生意还得靠你们去拯救呢。希望我下次去大市集的时候，还能见到那姑娘的笑容。[l][cm][hide]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"end":true},"key":"end"}],"des":"前往尾指村，询问木工耶沙米尔【c3_area1_5】制作花车的方法。"}