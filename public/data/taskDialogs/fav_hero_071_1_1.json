          },
          {
            "text": "这怎么能行！",
            "tag": "tag_16"
          }
        ]
      },
      "key": "option"
    },
    {
      "para": {
        "charaName": "洛莉安",
        "text": "[cm][show]呵呵，别紧张，你就当是余寄存在这里的也行。[l][cm]",
        "nameSide": "left"
      },
      "key": "text"
    },
    {
      "para": {
        "charaName": "洛莉安",
