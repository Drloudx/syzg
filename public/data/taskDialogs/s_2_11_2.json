ra049_1","mirrow":false,"layer":"chara3","trans":true,"scaleX":1,"noOut":false,"y":-340,"x":337.75,"scaleY":1,"noIn":false,"bright":0.6,"addImg":"chara049_1_face_chara049_1e"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"“铁箭”莱米","text":"[show]哎嘿嘿！能得到菲莉娜前辈的感谢，这辈子值了！[l]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_13"},"key":"tag"},{"para":{"options":[{"tag":"tag_14","text":"也不是很复杂的东西。"},{"tag":"tag_14","text":"只要菲莉娜喜欢就好。"}]},"key":"option"},{"para":{"tag":"tag_14"},"key":"tag"},{"para":{"layer":"chara3","img":"chara049_1_face_chara049_1a"},"key":"setLayerFace"},{"para":{"transTime":300,"alpha":1,"img":"chara049_1","mirrow":false,"layer":"chara3","trans":true,"scaleX":1,"noOut":false,"y":-340,"x":337.75,"scaleY":1,"noIn":false,"bright":1,"addImg":"chara049_1_face_chara049_1a"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"菲莉娜","text":"[cm][show]这个吊床……让我想起了以前的日子呢……[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_15"},"key":"tag"},{"para":{"charaName":"菲莉娜","text":"[show]那时候我还小，父亲也还在我的身旁，我跟着他在荒野中奔跑，学习野外生存的技巧。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_16"},"key":"tag"},{"para":{"charaName":"菲莉娜","text":"[show]那时候的我还真的很天真呢，经常到处追着蝴蝶，或是下水摸鱼什么的。爸爸批评过我很多次都改不了。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_17"},"key":"tag"},{"para":{"charaName":"菲莉娜","text":"[show]不过我最深刻的记忆，还是爸爸给我做的一个小吊床。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_18"},"key":"tag"},{"para":{"charaName":"菲莉娜","text":"[show]每天艰苦的打猎结束后，我就躺在吊床上休息。爸爸会在我身旁轻轻摇着吊床，我就在这种安心感中进入梦乡……[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_19"},"key":"tag"},{"para":{"charaName":"菲莉娜","text":"[show]虽然每天都过得非常幸苦，但我觉得当时很幸福。至今……我都很怀念那段日子。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_20"},"key":"tag"},{"para":{"layer":"chara3","img":"chara049_1_face_chara049_1b"},"key":"setLayerFace"},{"para":{"charaName":"菲莉娜","text":"[show]后来……爸爸被魔物袭击，受重伤去世了。在我身旁摇床的人永远不会回来了，而我也慢慢长大，再也没有睡过这样的吊床啦。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_21"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"layer":"chara1","img":"chara002_2_face_chara002_2e"},"key":"setLayerFace"},{"para":{"transTime":300,"alpha":1,"img":"chara002_2","mirrow":false,"layer":"chara1","trans":true,"scaleX":1,"noOut":false,"y":-180,"x":50,"scaleY":1,"noIn":false,"bright":1,"addImg":"chara002_2_face_chara002_2e"},"key":"moveLayer"},{"para":{"transTime":300,"alpha":1,"img":"chara049_1","mirrow":false,"layer":"chara3","trans":true,"scaleX":1,"noOut":false,"y":-340,"x":337.75,"scaleY":1,"noIn":false,"bright":0.6,"addImg":"chara049_1_face_chara049_1b"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米托拉","text":"[show]菲莉娜……[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_22"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"transTime":300,"alpha":1,"img":"chara002_2","mirrow":false,"layer":"chara1","trans":true,"scaleX":1,"noOut":false,"y":-180,"x":50,"scaleY":1,"noIn":false,"bright":0.6,"addImg":"chara002_2_face_chara002_2e"},"key":"moveLayer"},{"para":{"layer":"chara3","img":"chara049_1_face_chara049_1a"},"key":"setLayerFace"},{"para":{"transTime":300,"alpha":1,"img":"chara049_1","mirrow":false,"layer":"chara3","trans":true,"scaleX":1,"noOut":false,"y":-340,"x":337.75,"scaleY":1,"noIn":false,"bright":1,"addImg":"chara049_1_face_chara049_1a"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"菲莉娜","text":"[show]啊，不小心说了有些沉重的事情呢。我没事的，毕竟做这么多年契约者，还见证了大兽潮，早经历过太多生离死别了。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_23"},"key":"tag"},{"para":{"charaName":"菲莉娜","text":"[show]我遗忘了很多童年的记忆，但那种在摇晃中睡着的感觉，我一直都还记得。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_24"},"key":"tag"},{"para":{"layer":"chara3","img":"chara049_1_face_chara049_1e"},"key":"setLayerFace"},{"para":{"charaName":"菲莉娜","text":"[show]非常感谢你们，让我再次看见了那段幸福的过往。[l][cm]","nameSide":"left"},"key":"text"},{"pa