{"script":"Main_2_01_2_y","exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"alpha":0,"scaleX":1,"layer":"chara1","img":"chara001_0","x":67,"mirrow":false,"scaleY":1,"trans":true,"bright":0,"y":-230,"noIn":false,"noOut":false},"key":"setLayer"},{"para":{"alpha":0,"scaleX":1,"transTime":300,"layer":"chara1","img":"chara001_0","x":67,"mirrow":false,"scaleY":1,"trans":true,"bright":0,"y":-230,"noIn":false,"noOut":false},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"alpha":1,"scaleX":1,"transTime":300,"layer":"chara1","img":"chara001_0","x":67,"mirrow":false,"scaleY":1,"trans":true,"bright":1,"y":-215,"noIn":false,"noOut":false},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"希尔","nameSide":"left","text":"[show]呼……[l]这样一来，仓库姑且算是恢复到能用的状态了。[l][cm]"},"key":"text"},{"para":{"tag":"tag_4"},"key":"tag"},{"para":{"charaName":"希尔","nameSide":"left","text":"[show]米托拉，那些魔物的入侵路径，你有什么头绪了吗？[l][cm]"},"key":"text"},{"para":{"tag":"tag_5"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"scaleX":1,"transTime":300,"layer":"chara1","img":"chara001_0","x":67,"mirrow":false,"scaleY":1,"trans":true,"bright":0.6,"y":-215,"noIn":false,"noOut":false},"key":"moveLayer"},{"para":{"alpha":0,"scaleX":0.9,"layer":"chara3","img":"chara002_2","x":700,"mirrow":false,"scaleY":0.9,"trans":true,"bright":1,"y":-264.80000000000007,"noIn":false,"noOut":false},"key":"setLayer"},{"para":{"alpha":1,"scaleX":0.9,"transTime":300,"layer":"chara3","img":"chara002_2","x":700,"mirrow":false,"scaleY":0.9,"trans":true,"bright":1,"y":-264.80000000000007,"noIn":false,"noOut":false},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米托拉","nameSide":"right","text":"[show]说来你可能不信……那些家伙既不是从栅栏上面跳进来的，也不是从地下钻出来的。[l][cm]"},"key":"text"},{"para":{"tag":"tag_6"},"key":"tag"},{"para":{"charaName":"米托拉","nameSide":"right","text":"[show]它们是直接在仓库墙上打洞进去的！[l][cm]"},"key":"text"},{"para":{"tag":"tag_7"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"alpha":1,"scaleX":1,"transTime":300,"layer":"chara1","img":"chara001_0","x":67,"mirrow":false,"scaleY":1,"trans":true,"bright":1,"y":-215,"noIn":false,"noOut":false},"key":"moveLayer"},{"para":{"alpha":1,"scaleX":0.9,"transTime":300,"layer":"chara3","img":"chara002_2","x":700,"mirrow":false,"scaleY":0.9,"trans":true,"bright":0.6,"y":-264.80000000000007,"noIn":false,"noOut":false},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"希尔","nameSide":"left","text":"[show]在墙上打洞？这……这不可能吧？[l][cm]"},"key":"text"},{"para":{"tag":"tag_8"},"key":"tag"},{"para":{"charaName":"希尔","nameSide":"left","text":"[show]要说在篱笆上打洞也就罢了。仓库的墙壁我可是扎扎实实地用石料垒起来的啊！[l][cm]"},"key":"text"},{"para":{"tag":"tag_9"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"scaleX":1,"transTime":300,"layer":"chara1","img":"chara001_0","x":67,"mirrow":false,"scaleY":1,"trans":true,"bright":0.6,"y":-215,"noIn":false,"noOut":false},"key":"moveLayer"},{"para":{"alpha":1,"scaleX":0.9,"transTime":300,"layer":"chara3","img":"chara002_2","x":700,"mirrow":false,"scaleY":0.9,"trans":true,"bright":1,"y":-264.80000000000007,"noIn":false,"noOut":false},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米托拉","nameSide":"right","text":"[show]这就是我的疏漏了。我忘了你是来自大城市，不了解野外的情况。[l][cm]"},"key":"text"},{"para":{"tag":"tag_10"},"key":"tag"},{"para":{"charaName":"米托拉","nameSide":"right","text":"[show]或许在城市里，只要使用石料，就已经足够坚固了。[r][l]但在深渊里，面对各种牙尖爪利的魔物，石料和木料并没有什么区别。[l][cm]"},"key":"text"},{"para":{"tag":"tag_11"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"alpha":1,"scaleX":1,"transTime":300,"layer":"chara1","img":"chara001_0","x":77,"mirrow":false,"scaleY":1,"trans":true,"bright":1,"y":-215,"noIn":false,"noOut":false},"key":"moveLayer"},{"para":{"alpha":1,"scaleX":0.9,"transTime":300,"layer":"chara3","img":"chara002_2","x":700,"mirrow":false,"scaleY":0.9,"trans":true,"bright":0.6,"y":-264.80000000000007,"noIn":false,"noOut":false},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"希尔","nameSide":"left","text":"[show]等等！我记得驿站也都是用石材建造的房屋，他们就不会遇到这个问题吗？[l][cm]"},"key":"text"},{"para":{"tag":"tag_12"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"scaleX":1,"transTime":300,"layer":"chara1","img":"chara001_0","x":67,"mirrow":false,"scaleY":1,"trans":true,"bright":0.6,"y":-215,"noIn":false,"noOut":false},"key":"moveLayer"},{"para":{"alpha":1,"scaleX":0.9,"transTime":300,"layer":"chara3","img":"chara002_2","x":700,"mirrow":false,"scaleY":0.9,"trans":true,"bright":1,"y":-264.80000000000007,"noIn":false,"noOut":false},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米托拉","nameSide":"right","text":"[show]这个问题我刚好知道答案——[l]之前艾尔莎和我说过，[r][l]驿站的房子是用比一般石材更坚固的特殊石料搭建的。[l][cm]"},"key":"text"},{"para":{"tag":"tag_13"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"alpha":1,"scaleX":1,"transTime":300,"layer":"chara1","img":"chara001_0","x":67,"mirrow":false,"scaleY":1,"trans":true,"bright":1,"y":-215,"noIn":false,"noOut":false},"key":"moveLayer"},{"para":{"alpha":1,"scaleX":0.9,"transTime":300,"layer":"chara3","img":"chara002_2","x":700,"mirrow":false,"scaleY":0.9,"trans":true,"bright":0.6,"y":-264.80000000000007,"noIn":false,"noOut":false},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"希尔","nameSide":"left","text":"[show]原来如此……[r][l]也就是说，只要我们也使用哪种特殊的石料，就不用担心会再遇到今天这样的窘境了吧！[l][cm]"},"key":"text"},{"para":{"tag":"tag_14"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"scaleX":1,"transTime":300,"layer":"chara1","img":"chara001_0","x":67,"mirrow":false,"scaleY":1,"trans":true,"bright":0.6,"y":-215,"noIn":false,"noOut":false},"key":"moveLayer"},{"para":{"alpha":1,"scaleX":0.9,"transTime":300,"layer":"chara3","img":"chara002_2","x":700,"mirrow":false,"scaleY":0.9,"trans":true,"bright":1,"y":-264.80000000000007,"noIn":false,"noOut":false},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米托拉","nameSide":"right","text":"[show]嗯……[wait=300]大概……[wait=300]是这样吧？[l][cm]"},"key":"text"},{"para":{"tag":"tag_15"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"alpha":1,"scaleX":1,"transTime":300,"layer":"chara1","img":"chara001_0","x":67,"mirrow":false,"scaleY":1,"trans":true,"bright":1,"y":-215,"noIn":false,"noOut":false},"key":"moveLayer"},{"para":{"alpha":1,"scaleX":0.9,"transTime":300,"layer":"chara3","img":"chara002_2","x":700,"mirrow":false,"scaleY":0.9,"trans":true,"bright":0.6,"y":-264.80000000000007,"noIn":false,"noOut":false},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"希尔","nameSide":"left","text":"[show]那事情就好办了！[l]米托拉，我们一起去一趟驿站吧！[l][cm]"},"key":"text"},{"para":{"tag":"tag_16"},"key":"tag"},{"para":{"charaName":"希尔","nameSide":"left","text":"[show]这里是我们的家园，为了安全起见，哪怕多花点钱，也一定要拿下这至关重要的材料！[l][cm]"},"key":"text"},{"para":{"tag":"tag_17"},"key":"tag"},{"para":{"alpha":0,"scaleX":1,"transTime":300,"layer":"chara1","img":"chara001_0","x":67,"mirrow":false,"scaleY":1,"trans":true,"bright":1,"y":-215,"noIn":false,"noOut":false},"key":"moveLayer"},{"para":{"alpha":0,"scaleX":0.9,"transTime":300,"layer":"chara3","img":"chara002_2","x":700,"mirrow":false,"scaleY":0.9,"trans":true,"bright":0.6,"y":-264.80000000000007,"noIn":false,"noOut":false},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"end":true},"key":"end"}],"des":"收集石材(0/x)，足够时。"}