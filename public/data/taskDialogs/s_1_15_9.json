    },
    {
      "para": {
        "charaName": "米托拉",
        "text": "[show]不过……咳咳！等到了需要的时候，我们肯定不会客气的！[l][cm]",
        "nameSide": "left"
      },
      "key": "text"
    },
    {
      "para": {
        "charaName": "米托拉",
