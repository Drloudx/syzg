{"script":"wt_c3_07_1_n","exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"nameSide":"left","charaName":"文员拉比尔","text":"[show]嗯……你手上并没有我想要的魔力丸呢。[l][cm]"},"key":"text"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"nameSide":"left","charaName":"文员拉比尔","text":"[show]拜托了，可以在晚上之前带给我吗？我需要魔力丸来摆脱我的困意。[l][cm]"},"key":"text"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"end":true},"key":"end"}],"des":"提神醒脑魔力丸"}