{"script":"wt_c3_08_1_n","exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"nameSide":"left","charaName":"贫民凯索尔","text":"[show]呜……你手上还没有湖风烤肉啊……[l][cm]"},"key":"text"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"nameSide":"left","charaName":"贫民凯索尔","text":"[show]请……请尽快弄一份过来吧，哪怕是脏了点、凉了点，我都是能接受了。[l][cm]"},"key":"text"},{"para":{"tag":"tag_4"},"key":"tag"},{"para":{"nameSide":"left","charaName":"贫民凯索尔","text":"[show]拜托你了，我就在这里等着你。[l][cm]"},"key":"text"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"end":true},"key":"end"}],"des":"美味的湖风料理"}