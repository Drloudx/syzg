alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":0.6,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1a","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"荒野客","text":"[show]就这么简单就能拿到钱？行——行行！我们答应！[l][cm]"},"key":"text"},{"para":{"tag":"tag_29"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":1,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1a","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]来，筐拿着，我们立刻开始——！[l][cm]"},"key":"text"},{"para":{"tag":"tag_30"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":0.6,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1a","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"","text":"[show]（凶神恶煞的荒野客竟被阿娜洛洁三言两语劝来采药，效率顿时翻了几番。）[l][cm]"},"key":"text"},{"para":{"tag":"tag_31"},"key":"tag"},{"para":{"nameSide":"left","charaName":"","text":"[show]（不到几个小时，附近新长的药草都被秃噜完了……）[l][cm]"},"key":"text"},{"para":{"tag":"tag_32"},"key":"tag"},{"para":{"nameSide":"left","charaName":"荒野客","text":"[show]哦哦……真、真的掏钱给我们了……还挺多的。[l][cm]"},"key":"text"},{"para":{"tag":"tag_33"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":1,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1a","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]我阿娜洛洁童叟无欺，说话算话。而且，多劳多得嘛。你们想想，这是不是比拼上性命弄来的钱安全多了？[l][cm]"},"key":"text"},{"para":{"tag":"tag_34"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":0.6,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1a","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"荒野客","text":"[show]呃——可、可能是吧——多谢，老板。[l][cm]"},"key":"text"},{"para":{"tag":"tag_35"},"key":"tag"},{"para":{"nameSide":"left","charaName":"","text":"[show]（两个荒野客拿到了钱，乖乖地离开了。整整四大筐的药草像是堆成了小山。）[l][cm]"},"key":"text"},{"para":{"tag":"tag_36"},"key":"tag"},{"para":{"layer":"chara2","img":"chara043_1_face_chara043_1b"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":1,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1b","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]嘿嘿……花点小钱就弄来这么多药草，咱这回可赚大喽！[l]"},"key":"text"},{"para":{"tag":"tag_37"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":0.6,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1b","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"tag":"tag_38","text":"真没想到还能这么干。"}]},"key":"option"},{"para":{"tag":"tag_38"},"key":"tag"},{"para":{"layer":"chara2","img":"chara043_1_face_chara043_1a"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":1,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1a","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[cm][show]别看这俩家伙挺笨的，我刚故意把弓弩亮了点边儿出来，我看到他们腿肚子都哆嗦了。八成是头回出来劫道的生瓜蛋子。[l][cm]"},"key":"text"},{"para":{"tag":"tag_39"},"key":"tag"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]然