t":0.6,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1a","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"","text":"[show]（跟着阿娜洛洁在附近采了一大圈药草……）[l][cm]"},"key":"text"},{"para":{"tag":"tag_12"},"key":"tag"},{"para":{"layer":"chara2","img":"chara043_1_face_chara043_1c"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":1,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1c","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]呼……这里的药草比我想象中还要多啊。光靠咱俩的手脚还是太慢了，这样根本就采不完啊。[l][cm]"},"key":"text"},{"para":{"tag":"tag_13"},"key":"tag"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]得想个办法提升一下效率才行……[l][cm]"},"key":"text"},{"para":{"tag":"tag_14"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":0.6,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1c","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"荒野客","text":"[show]别动——！打劫——！[l][cm]"},"key":"text"},{"para":{"tag":"tag_15"},"key":"tag"},{"para":{"nameSide":"left","charaName":"","text":"[show]（阿娜洛洁正琢磨着，两个荒野客猛地从草丛里蹿了出来。）[l][cm]"},"key":"text"},{"para":{"tag":"tag_16"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":1,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1c","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]哦哟？这是什么情况？[l][cm]"},"key":"text"},{"para":{"tag":"tag_17"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":0.6,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1c","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"荒野客","text":"[show]少啰嗦！钱交出来，饶你们不死！[l]"},"key":"text"},{"para":{"tag":"tag_18"},"key":"tag"},{"para":{"options":[{"tag":"tag_19","text":"（抄起锤子准备迎战。）"}]},"key":"option"},{"para":{"tag":"tag_19"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":1,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1c","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[cm][show]等等，{myName}！让我跟他们唠唠！[l][cm]"},"key":"text"},{"para":{"tag":"tag_20"},"key":"tag"},{"para":{"layer":"chara2","img":"chara043_1_face_chara043_1a"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]嘿嘿嘿嘿。两位兄弟这么热的天出来混，不就挣个钱嘛？[l][cm]"},"key":"text"},{"para":{"tag":"tag_21"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":0.6,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1a","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"荒野客","text":"[show]废话！咱们哥俩已经在这蹲好几天了，不捞笔大的岂不是亏本！快把钱交出来！[l][cm]"},"key":"text"},{"para":{"tag":"tag_22"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":1,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1a","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]别急眼哪，打打杀杀多伤和气啊。咱们要不要合作合作？[l][cm]"},"key":"text"},{"para":{"tag":"tag_23"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara2","n