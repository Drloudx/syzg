mg":"chara002_2_face_chara002_2c"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"“萝卜”阿里特","text":"[show]是这样的，之前我实在受不了每天吃土豆，所以一直在找一套美食的配方。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_10"},"key":"tag"},{"para":{"charaName":"“萝卜”阿里特","text":"[show]后来我经过不断寻访，终于在一个神秘的旅行厨师身上拿到了配方！[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_11"},"key":"tag"},{"para":{"charaName":"“萝卜”阿里特","text":"[show]那个配方被印在一张金纸上，那张纸真的闪着光哦。我想连写着配方的纸都这么豪华，里面的配方一定不会差的！[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_12"},"key":"tag"},{"para":{"charaName":"“萝卜”阿里特","text":"[show]可就在我要把配方带回去好好研究的时候，一群哈比突然袭击了我。那些家伙喜欢闪光的东西，所以我的配方就被它们偷走了。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_13"},"key":"tag"},{"para":{"transTime":300,"alpha":1,"img":"chara002_2","mirrow":false,"layer":"chara2","trans":true,"scaleX":1,"noOut":false,"y":-180,"x":340,"scaleY":1,"noIn":false,"bright":1,"addImg":"chara002_2_face_chara002_2c"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米托拉","text":"[show]也就是说……那配方现在就在哈比巢穴里吗？[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_14"},"key":"tag"},{"para":{"transTime":300,"alpha":1,"img":"chara002_2","mirrow":false,"layer":"chara2","trans":true,"scaleX":1,"noOut":false,"y":-180,"x":340,"scaleY":1,"noIn":false,"bright":0.6,"addImg":"chara002_2_face_chara002_2c"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"“萝卜”阿里特","text":"[show]应该在吧，只要那群家伙别嘴馋把配方吃掉……等等，你们不会想要去它们的巢穴里找吧？那地方可是很危险的！[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_15"},"key":"tag"},{"para":{"layer":"chara2","img":"chara002_2_face_chara002_2a"},"key":"setLayerFace"},{"para":{"transTime":300,"alpha":1,"img":"chara002_2","mirrow":false,"layer":"chara2","trans":true,"scaleX":1,"noOut":false,"y":-180,"x":340,"scaleY":1,"noIn":false,"bright":1,"addImg":"chara002_2_face_chara002_2a"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米托拉","text":"[show]嘻嘻，这你就放心吧，那些哈比不是我们的对手。[l]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_16"},"key":"tag"},{"para":{"transTime":300,"alpha":1,"img":"chara002_2","mirrow":false,"layer":"chara2","trans":true,"scaleX":1,"noOut":false,"y":-180,"x":340,"scaleY":1,"noIn":false,"bright":0.6,"addImg":"chara002_2_face_chara002_2a"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"tag":"tag_17","text":"如果我们能带回来的话。"},{"tag":"tag_17","text":"可以拿去交给费萨吗？"}]},"key":"option"},{"para":{"tag":"tag_17"},"key":"tag"},{"para":{"charaName":"“萝卜”阿里特","text":"[cm][show]这个当然没问题，原本我都不抱希望了。只要你们能找到，那个配方就归你们了。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_18"},"key":"tag"},{"para":{"transTime":300,"alpha":1,"img":"chara002_2","mirrow":false,"layer":"chara2","trans":true,"scaleX":1,"noOut":false,"y":-180,"x":340,"scaleY":1,"noIn":false,"bright":1,"addImg":"chara002_2_face_chara002_2a"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米托拉","text":"[show]好，那{myName}……我们去巢穴那边看看吧。[l][cm][hide]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_19"},"key":"tag"},{"para":{"transTime":300,"alpha":0,"img":"chara002_2","mirrow":false,"layer":"chara2","trans":true,"scaleX":1,"noOut":false,"y":-180,"x":340,"scaleY":1,"noIn":false,"bright":1,"addImg":"chara002_2_face_chara002_2a"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"","text":"[hide]","nameSide":"left"},"key":"text"},{"para":{"end":true},"key":"end"}],"script":"s_2_10_1","des":"（询问关于配方的事情。）"}