_1a","alpha":1,"noIn":false,"scaleX":1,"layer":"chara3","img":"chara043_1","transTime":300,"x":570,"y":-119,"bright":1,"mirrow":true,"trans":true,"noOut":false,"scaleY":1}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"nameSide":"left","text":"[show]没想到你能闻出来啊，没错，这就是金铃草研磨后的粉末。这些粉末提神效果依然不错，而且副作用也很小。[l][cm]","charaName":"阿娜洛洁"}},{"key":"tag","para":{"tag":"tag_12"}},{"key":"moveLayer","para":{"addImg":"chara043_1_face_chara043_1a","alpha":1,"noIn":false,"scaleX":1,"layer":"chara3","img":"chara043_1","transTime":300,"x":570,"y":-119,"bright":0.6,"mirrow":true,"trans":true,"noOut":false,"scaleY":1}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"nameSide":"left","text":"[show]金铃粉？这东西要怎么卖啊？[l][cm]","charaName":"货殖系学生缪夏"}},{"key":"tag","para":{"tag":"tag_13"}},{"key":"setLayerFace","para":{"img":"chara043_1_face_chara043_1c","layer":"chara3"}},{"key":"moveLayer","para":{"addImg":"chara043_1_face_chara043_1c","alpha":1,"noIn":false,"scaleX":1,"layer":"chara3","img":"chara043_1","transTime":300,"x":570,"y":-119,"bright":1,"mirrow":true,"trans":true,"noOut":false,"scaleY":1}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"nameSide":"left","text":"[show]大书院里升学压力挺大的吧，这里的学生都需要提神醒脑、集中注意力的方法。[l][cm]","charaName":"阿娜洛洁"}},{"key":"tag","para":{"tag":"tag_14"}},{"key":"setLayerFace","para":{"img":"chara043_1_face_chara043_1a","layer":"chara3"}},{"key":"text","para":{"nameSide":"left","text":"[show]而金铃草恰好有这样的效果，不过直接拿出来卖肯定赚不了多少，我刚来的时候也正为这事头疼。[l][cm]","charaName":"阿娜洛洁"}},{"key":"tag","para":{"tag":"tag_15"}},{"key":"setLayerFace","para":{"img":"chara043_1_face_chara043_1b","layer":"chara3"}},{"key":"text","para":{"nameSide":"left","text":"[show]不过嘛，既然你手上有果饮，那我可要狠狠赚一笔加工费了。来，拿一杯果饮出来，只要我稍作加工，就能让你大赚一笔。[l][cm]","charaName":"阿娜洛洁"}},{"key":"tag","para":{"tag":"tag_16"}},{"key":"text","para":{"nameSide":"left","text":"[show]（阿娜洛洁将一些粉末倒入果饮之中，然后抿了几口。）[l][cm]","charaName":""}},{"key":"tag","para":{"tag":"tag_17"}},{"key":"text","para":{"nameSide":"left","text":"[show]嗯……这个味道不错。我们把金铃粉加进这些饮料里，告诉客人这饮料有\"提神醒脑\"的功效，这样就能卖得好了。[l][cm]","charaName":"阿娜洛洁"}},{"key":"tag","para":{"tag":"tag_18"}},{"key":"moveLayer","para":{"addImg":"chara043_1_face_chara043_1b","alpha":1,"noIn":false,"scaleX":1,"layer":"chara3","img":"chara043_1","transTime":300,"x":570,"y":-119,"bright":0.6,"mirrow":true,"trans":true,"noOut":false,"scaleY":1}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"nameSide":"left","text":"[show]好像……确实有道理！[l][cm]","charaName":"货殖系学生缪夏"}},{"key":"tag","para":{"tag":"tag_19"}},{"key":"setLayerFace","para":{"img":"chara043_1_face_chara043_1a","layer":"chara3"}},{"key":"moveLayer","para":{"addImg":"chara043_1_face_chara043_1a","alpha":1,"noIn":false,"scaleX":1,"layer":"chara3","img":"chara043_1","transTime":300,"x":570,"y":-119,"bright":1,"mirrow":true,"trans":true,"noOut":false,"scaleY":1}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"nameSide":"left","text":"[show]管他有没有道理，拿来卖就好了——快来看咯快来看咯，同学们！今天刚进的新果饮！[l][cm]","charaName":"阿娜洛洁"}},{"key":"tag","para":{"tag":"tag_20"}},{"key":"setLayerFace","para":{"img":"chara043_1_face_chara043_1b","layer":"chara3"}},{"key":"text","para":{"nameSide":"left","text":"[show]一瓶提神醒脑，两瓶精神抖擞，三瓶高分到手！[l][cm]","charaName":"阿娜洛洁"}},{"key":"tag","para":{"tag":"tag_21"}},{"key":"moveLayer","para":{"addImg":"chara043_1_face_chara043_1b","alpha":1,"noIn":false,"scaleX":1,"layer":"chara3","img":"chara043_1","transTime":300,"x":570,"y":-119,"bright":0.6,"mirrow":true,"trans":true,"noOut":false,"scaleY":1}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"nameSide":"left","text":"[show]咦？提神醒脑？真的有用吗？[l][cm]","charaName":"学生A"}},{"key":"tag","para":{"tag":"tag_22"}},{"key":"setLayerFace","para":{"img":"chara043_1_face_chara043_1a","layer":"chara3"}},{"key":"moveLayer","para":{"addImg":"chara043_1_face_chara043_1a","alpha":1,"noIn":false,"scaleX":1,"layer":"chara3","img":"chara043_1","transTime":300,"x":570,"y":-119,"bright":1,"mirrow":true,"trans":true,"noOut":false,"scaleY":1}},{