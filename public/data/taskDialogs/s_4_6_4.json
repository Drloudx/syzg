{"script":"s_4_6_4","exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"nameSide":"left","charaName":"哈尔贝塔","text":"[show]旅人们，你们好。蘑菇杖……我们现在好像不需要这个东西。有什么其他我可以帮上忙的吗？[l]"},"key":"text"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"options":[{"text":"（询问关于约伦德药草的线索。）","tag":"tag_3"}]},"key":"option"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"nameSide":"left","charaName":"哈尔贝塔","text":"[show][cm]约伦德先生？金弦之厅的炼药师吗？很遗憾，这边和他没有任何接触，更不知道所谓的药草……[l][cm]"},"key":"text"},{"para":{"tag":"tag_4"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"","layer":"bg","x":-500,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"setLayer"},{"para":{"noIn":false,"mirrow":false,"alpha":0.4,"addImg":"","layer":"bg","x":-500,"transTime":300,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"tag":"tag_5"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"chara002_2_face_chara002_2h","layer":"chara2","x":340,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"setLayer"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2h","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]得，一天的活白干了。那个占卜什么的果然不靠谱！[l][cm]"},"key":"text"},{"para":{"tag":"tag_6"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2h","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"哈尔贝塔","text":"[show]说起来……你们也是契约者吧？我这边正好遇到了