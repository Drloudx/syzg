":"tag_12"}},{"key":"setLayerFace","para":{"img":"chara038_1_face_chara038_1c","layer":"chara2"}},{"key":"moveLayer","para":{"transTime":180,"noIn":false,"bright":1,"layer":"chara2","alpha":1,"x":360,"img":"chara038_1","y":-408,"mirrow":false,"scaleX":1,"trans":true,"noOut":false,"scaleY":1,"addImg":"chara038_1_face_chara038_1c"}},{"key":"wait","para":{"time":180}},{"key":"tag","para":{"tag":"tag_3"}},{"key":"event","para":{"eventData":"{\r  \"para\": {\r    \"bubbles\": {\r      \"chara038_1\": \"04\"\r    }\r  },\r  \"action\": \"bubble\"\r}","event":"GAoEvent"}},{"key":"moveLayer","para":{"transTime":300,"noIn":false,"bright":1,"layer":"chara2","alpha":1,"x":360,"img":"chara038_1","y":-418,"mirrow":false,"scaleX":1,"trans":true,"noOut":false,"scaleY":1,"addImg":"chara038_1_face_chara038_1c"}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"charaName":"瓦菲诺","nameSide":"left","text":"[show]咦？是你们啊？是那个笨蛋恶魔老妈派你们过来的吧？[l][cm]"}},{"key":"tag","para":{"tag":"tag_4"}},{"key":"setLayerFace","para":{"img":"chara038_1_face_chara038_1d","layer":"chara2"}},{"key":"moveLayer","para":{"transTime":300,"noIn":false,"bright":1,"layer":"chara2","alpha":1,"x":360,"img":"chara038_1","y":-438,"mirrow":false,"scaleX":1,"trans":true,"noOut":false,"scaleY":1,"addImg":"chara038_1_face_chara038_1d"}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"charaName":"瓦菲诺","nameSide":"left","text":"[show]哼，问我是怎么猜出来的，我们都是老朋友了，她想什么我当然能看出来。[l][cm]"}},{"key":"tag","para":{"tag":"tag_5"}},{"key":"setLayerFace","para":{"img":"chara038_1_face_chara038_1c","layer":"chara2"}},{"key":"moveLayer","para":{"transTime":300,"noIn":false,"bright":1,"layer":"chara2","alpha":1,"x":360,"img":"chara038_1","y":-418,"mirrow":false,"scaleX":1,"trans":true,"noOut":false,"scaleY":1,"addImg":"chara038_1_face_chara038_1c"}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"charaName":"瓦菲诺","nameSide":"left","text":"[show]现在确实有很严重的问题困扰着我，既然你们是来帮忙的，看看你们能不能出个好主意了。[l][cm]"}},{"key":"tag","para":{"tag":"tag_6"}},{"key":"text","para":{"charaName":"瓦菲诺","nameSide":"left","text":"[show]我们调查遗迹的进度还是很缓慢。一个很关键的问题就是，遗迹里还是有很多魔物干扰着我们的研究员。[l][cm]"}},{"key":"tag","para":{"tag":"tag_7"}},{"key":"setLayerFace","para":{"img":"chara038_1_face_chara038_1d","layer":"chara2"}},{"key":"text","para":{"charaName":"瓦菲诺","nameSide":"left","text":"[show]这些魔物一时间也很难驱散，它们已经严重干扰到我们的研究进度了。[l][cm]"}},{"key":"tag","para":{"tag":"tag_8"}},{"key":"setLayerFace","para":{"img":"chara038_1_face_chara038_1c","layer":"chara2"}},{"key":"text","para":{"charaName":"瓦菲诺","nameSide":"left","text":"[show]我一直想不出什么好办法……看看你们有没有什么头绪？[l][cm]"}},{"key":"tag","para":{"tag":"tag_9"}},{"key":"text","para":{"charaName":"瓦菲诺","nameSide":"left","text":"[show]你说……想用遗迹里的小型守护单元做点什么装置来解决？不愧是工匠的思考方式。那具体要怎么做呢？[l][cm]"}},{"key":"tag","para":{"tag":"tag_13"}},{"key":"setLayerFace","para":{"img":"chara038_1_face_chara038_1a","layer":"chara2"}},{"para":{"relativePos":true,"y":-50,"bright":1,"scaleX":1,"layer":"chara2","transTime":180,"alpha":1,"scaleY":1,"x":0},"key":"moveLayer"},{"para":{"time":200,"type":""},"key":"wait"},{"para":{"relativePos":true,"y":50,"bright":1,"scaleX":1,"layer":"chara2","transTime":180,"alpha":1,"scaleY":1,"x":0},"key":"moveLayer"},{"key":"tag","para":{"tag":"tag_10"}},{"key":"text","para":{"charaName":"瓦菲诺","nameSide":"left","text":"[show]原来如此。那不然你先把装置带过来看看吧，我看看能不能解决问题。[l][cm][hide]"}},{"key":"tag","para":{"tag":"tag_2"}},{"key":"moveLayer","para":{"transTime":300,"noIn":false,"bright":1,"layer":"chara2","alpha":0,"x":360,"img":"chara038_1","y":-418,"mirrow":false,"scaleX":1,"trans":true,"noOut":false,"scaleY":1,"addImg":"chara038_1_face_chara038_1a"}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"charaName":"","nameSide":"left","text":"[hide]"}},{"key":"end","para":{"end":true}}]}