{"script":"s_2_5_0","exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"noOut":false,"mirrow":false,"alpha":0,"scaleX":1,"addImg":"chara002_2_face_chara002_2c","trans":true,"noIn":false,"layer":"chara2","x":340,"y":-180,"bright":1,"scaleY":1,"img":"chara002_2"},"key":"setLayer"},{"para":{"noOut":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2c","trans":true,"noIn":false,"layer":"chara2","x":340,"transTime":300,"y":-180,"bright":1,"scaleY":1,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米托拉","text":"[show]唔，刚进村子就感觉到你的视线……怎么了，米卡埃尔，有什么事吗？[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_5"},"key":"tag"},{"para":{"noOut":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2c","trans":true,"noIn":false,"layer":"chara2","x":340,"transTime":300,"y":-180,"bright":0.6,"scaleY":1,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米卡埃尔","text":"[show]（眼神似乎缓和了不少。）[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_6"},"key":"tag"},{"para":{"charaName":"米卡埃尔","text":"[show]你们……是村长的熟人，可以信任。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_7"},"key":"tag"},{"para":{"charaName":"米卡埃尔","text":"[show]最近村子里……好像出现了[color=f1401c]窃贼[colorEnd]。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_8"},"key":"tag"},{"para":{"noOut":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2c","trans":true,"noIn":false,"layer":"chara2","x":340,"transTime":300,"y":-180,"bright":1,"scaleY":1,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米托拉","text":"[show]唉，窃贼？有人在巴诺姆村里偷东西？[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_9"},"key":"tag"},{"para":{"noOut":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2c","trans":true,"noIn":false,"layer":"chara2","x":340,"transTime":300,"y":-180,"bright":0.6,"scaleY":1,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米卡埃尔","text":"[show]正是……所以我才监视着进入村子里的每一个人……[l]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_10"},"key":"tag"},{"para":{"options":[{"text":"可以详细说说怎么回事吗？","tag":"tag_11"}]},"key":"option"},{"para":{"tag":"tag_11"},"key":"tag"},{"para":{"charaName":"米卡埃尔","text":"[cm][show]出现了很多失窃报告。很多东西入夜前还在……到了第二天就消失了。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_12"},"key":"tag"},{"para":{"charaName":"米卡埃尔","text":"[show]大部分村民都在忙采石场复工的事。大家早上很忙，晚上都睡得很沉。所以……窃贼应该在深夜下手。但我们的巡逻人手有限……[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_13"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2d","layer":"chara2"},"key":"setLayerFace"},{"para":{"noOut":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2d","trans":true,"noIn":false,"layer":"chara2","x":340,"transTime":300,"y":-180,"bright":1,"scaleY":1,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米托拉","text":"[show]居然还有这种人，也太过分了！明明是应该全力复兴村子的时刻！[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_14"},"key":"tag"},{"para":{"noOut":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2d","trans":true,"noIn":false,"layer":"chara2","x":340,"transTime":300,"y":-180,"bright":0.6,"scaleY":1,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米卡埃尔","text":"[show]但是这个问题……我没办法。眼睛是看不穿人心的。我只能在站岗的时候……找找可疑的人或行为。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_15"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2a","layer":"chara2"},"key":"setLayerFace"},{"para":{"noOut":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2a","trans":true,"noIn":false,"layer":"chara2","x":340,"transTime":300,"y":-180,"bright":1,"scaleY":1,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米托拉","text":"[show]要不……问问米拉贝尔吧。她应该有办法的。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_16"},"key":"tag"},{"para":{"noOut":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2a","trans":true,"noIn":false,"layer":"chara2","x":340,"transTime":300,"y":-180,"bright":0.6,"scaleY":1,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米卡埃尔","text":"[show]那就……拜托你们了。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_17"},"key":"tag"},{"para":{"charaName":"米卡埃尔","text":"[show]（米卡埃尔不再看着你们，继续紧盯着村口。）[l][cm][hide]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_18"},"key":"tag"},{"para":{"noOut":false,"mirrow":false,"alpha":0,"scaleX":1,"addImg":"chara002_2_face_chara002_2a","trans":true,"noIn":false,"layer":"chara2","x":340,"transTime":300,"y":-180,"bright":0.6,"scaleY":1,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"","text":"[hide]","nameSide":"left"},"key":"text"},{"para":{"end":true},"key":"end"}],"des":"（……感受到紧迫的视线。）"}