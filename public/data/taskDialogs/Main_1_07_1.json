,"noIn":false,"x":663,"y":-146,"transTime":300,"scaleX":1,"mirrow":true,"trans":true,"img":"chara010_1"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米托拉","text":"[show]没问题！我们正好还有契约金要找菲尔德雷结算呢！就干脆一次解决吧。[l][cm][hide]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_67"},"key":"tag"},{"para":{"alpha":0,"bright":1,"scaleY":0.9,"layer":"chara1","noOut":false,"noIn":false,"x":50,"y":-264.80000000000007,"transTime":300,"scaleX":0.9,"mirrow":false,"trans":true,"img":"chara002_2"},"key":"moveLayer"},{"para":{"alpha":0,"bright":0.6,"scaleY":1,"layer":"chara3","noOut":false,"noIn":false,"x":663,"y":-146,"transTime":300,"scaleX":1,"mirrow":true,"trans":true,"img":"chara010_1"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"time":600,"type":"time"},"key":"wait"},{"para":{"tag":"tag_51"},"key":"tag"},{"para":{"alpha":0,"bright":1,"scaleY":1.5,"layer":"bg","noOut":false,"noIn":false,"x":-331.5,"y":-187.5,"scaleX":1.5,"mirrow":false,"trans":false,"img":"bgblack"},"key":"setLayer"},{"para":{"alpha":1,"bright":1,"scaleY":1.5,"layer":"bg","nonStandBright":false,"noOut":false,"noIn":false,"x":-331.5,"y":-187.5,"transTime":0,"scaleX":1.5,"timeBak":900,"mirrow":false,"trans":false,"img":"bgblack"},"key":"moveLayer"},{"para":{"tag":"tag_52"},"key":"tag"},{"para":{"charaName":"少女的声音","text":"[show]观星高地的神匠器，似乎被启动了。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_53"},"key":"tag"},{"para":{"charaName":"粗犷的声音","text":"[show]遗迹被攻破了吗？除了那个男人之外，居然还有别人能够绕过古代魔法的封锁？是谁？[l][cm]","nameSide":"right"},"key":"text"},{"para":{"tag":"tag_54"},"key":"tag"},{"para":{"charaName":"少女的声音","text":"[show]是莉拉。不过她用的是正攻法。[r]不知道她用什么，从菲尔德蕾手里换到了古代魔法卷轴，成功打开了遗迹的封锁。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_55"},"key":"tag"},{"para":{"charaName":"苍老的声音","text":"[show]嚯？就是那个哈萨琳留下的宝贝卷轴吗？[r]唯一的“钥匙”居然用在这种地方，看来莉拉那老怪物也到此为止了。[l][cm]","nameSide":"right"},"key":"text"},{"para":{"tag":"tag_56"},"key":"tag"},{"para":{"charaName":"少女的声音","text":"[show]不能大意。除了观星高地之外，其余遗迹的隐蔽魔法可是早就失效了。[r]万一那家伙再从哪里找到另外的“钥匙”，对我们的计划还是会有风险！[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_57"},"key":"tag"},{"para":{"charaName":"苍老的声音","text":"[show]那怎么办？派人去做掉她吗？[l][cm]","nameSide":"right"},"key":"text"},{"para":{"tag":"tag_58"},"key":"tag"},{"para":{"charaName":"少女的声音","text":"[show]你忘了那家伙的真实身份了吗？那可不是自称的“魔人”那么简单啊！[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_59"},"key":"tag"},{"para":{"charaName":"威严的女声","text":"[show][size=%150][color=ff0000]安静！[colorEnd][sizeEnd][l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_60"},"key":"tag"},{"para":{"charaName":"众人","text":"[show]……[l][cm]","nameSide":"right"},"key":"text"},{"para":{"tag":"tag_61"},"key":"tag"},{"para":{"charaName":"威严的女声","text":"[show]莉拉的事情不用在意，早在计划开始之初，我们就已经考虑过，计划被人妨碍的可能。[r]那么，谁来回答我，当时我们决定的应对方案是什么？[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_62"},"key":"tag"},{"para":{"charaName":"粗犷的声音","text":"[show]是加速。只要计划进行得足够快，就没有人能够阻止我们！[l][cm]","nameSide":"right"},"key":"text"},{"para":{"tag":"tag_63"},"key":"tag"},{"para":{"charaName":"威严的女声","text":"[show]正是如此。不管那个麻烦的女人究竟有没有察觉到什么，[r]在计划已经进入尾声的现在，我们的宏愿已经无人能够阻挡！[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_64"},"key":"tag"},{"para":{"charaName":"威严的女声","text":"[show]各位不要被无聊的事情分散了心力，尽快把手上的事情完成！[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_65"},"key":"tag"},{"para":{"charaName":"威严的女声","text":"[show]“为了完成光荣的反抗！”[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_66"},"key":"tag"},{"para":{"charaName":"众人","text":"[show]“为了完成光荣的反抗！”[l][cm][hide]","nameSide":"right"},"key":"text"},{"para":{"tag":"tag_26"},"key":"tag"},{"para":{"alpha":0,"bright":1,"scaleY":1.5,"layer":"bg","nonStandBright":false,"noOut":false,"noIn":false,"x":-331.5,"y":-187.5,"transTime":0,"scaleX":1.5,"timeBak":300,"mirrow":false,"trans":false,"img":"bgblack"},"key":"moveLayer"},{"para":{"end":true},"key":"end"}]}