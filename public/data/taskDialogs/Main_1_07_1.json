{"script":"Main_1_07_1","des":"调查结束","exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":0,"bright":1,"scaleY":1,"layer":"chara3","noOut":false,"noIn":false,"x":663,"y":-146,"scaleX":1,"mirrow":true,"trans":true,"img":"chara010_1"},"key":"setLayer"},{"para":{"alpha":1,"bright":1,"scaleY":1,"layer":"chara3","noOut":false,"noIn":false,"x":663,"y":-146,"transTime":300,"scaleX":1,"mirrow":true,"trans":true,"img":"chara010_1"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"莉拉","text":"[show]哦？你们回来了！[l][cm]","nameSide":"right"},"key":"text"},{"para":{"tag":"tag_4"},"key":"tag"},{"para":{"charaName":"莉拉","text":"[show]遗迹里究竟发生了什么事？大概十分钟前，外涌的魔物潮突然停下了。[l][cm]","nameSide":"right"},"key":"text"},{"para":{"tag":"tag_27"},"key":"tag"},{"para":{"charaName":"莉拉","text":"[show]我派人进去看了一下，发现那些魔物的攻击性大幅降低了，似乎摆脱了狂暴化的影响……[r]这件事，该不会是你们做的吧？[l][cm]","nameSide":"right"},"key":"text"},{"para":{"tag":"tag_28"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"alpha":0,"bright":1,"scaleY":1,"layer":"chara1","noOut":false,"noIn":false,"x":67,"y":-215,"scaleX":1,"mirrow":false,"trans":true,"img":"chara001_0"},"key":"setLayer"},{"para":{"alpha":1,"bright":1,"scaleY":1,"layer":"chara1","noOut":false,"noIn":false,"x":67,"y":-215,"transTime":300,"scaleX":1,"mirrow":false,"trans":true,"img":"chara001_0"},"key":"moveLayer"},{"para":{"alpha":1,"bright":0.6,"scaleY":1,"layer":"chara3","noOut":false,"noIn":false,"x":663,"y":-146,"transTime":300,"scaleX":1,"mirrow":true,"trans":true,"img":"chara010_1"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"希尔","text":"[show]这个……如果是十分钟之前的话……我能想到的就只有那件事了……请听我详细说明……[r][l]……[r][l]……[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_29"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"bright":0.6,"scaleY":1,"layer":"chara1","noOut":false,"n