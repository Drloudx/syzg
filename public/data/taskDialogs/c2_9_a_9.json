        "nameSide": "left"
      },
      "key": "text"
    },
    {
      "para": {
        "charaName": "米拉贝尔",
        "text": "[show]没什么，不用担心我。我只是觉得……[l][cm]",
        "nameSide": "left"
      },
      "key": "text"
    },
    {
      "para": {
        "charaName": "米拉贝尔",
        "text": "[show]不……没什么。[l][cm]",
        "nameSide": "left"
      },
      "key": "text"
    },
    {
      "para": {
        "charaName": "皮塔",
        "text": "[show]呃……好吧……[l][cm]",
