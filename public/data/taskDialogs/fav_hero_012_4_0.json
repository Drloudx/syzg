      "para": {
        "nameSide": "left",
        "text": "[show]这是我收集到的木材，坚韧且有一定的柔软度，是许多猎人打造弓的首选，你就用这个打造新武器就好。[l][cm]",
        "charaName": "沃夫加"
      }
    },
    {
      "key": "text",
      "para": {
        "nameSide": "left",
