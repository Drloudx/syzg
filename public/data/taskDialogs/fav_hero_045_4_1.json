      "key": "option"
    },
    {
      "para": {
        "nameSide": "left",
        "charaName": "艾尔菲帕",
        "text": "[cm][show]特意出来接我？谢谢你，{myName}……不过，这糟糕天气可不是我弄出来的……[l][cm]"
