      "key": "text"
    },
    {
      "para": {
        "nameSide": "left",
        "charaName": "塞弗德里克",
        "text": "[show]好了，废话就不多说了。我到街面上帮你们引开治安队员，趁此机会，你们赶快进去！[l][cm]"
