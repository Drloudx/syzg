ra043_1c"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":1,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1c","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[cm][show]啊，呃……不小心就说出口了……没事，没事，就一点点小事啦——[l]"},"key":"text"},{"para":{"tag":"tag_12"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":0.6,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1c","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"tag":"tag_13","text":"阿娜洛洁——！"}]},"key":"option"},{"para":{"tag":"tag_13"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":1,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1c","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[cm][show]唔——你、你突然靠人家这么近做什么嘛！我说就是了，我说……！[l][cm]"},"key":"text"},{"para":{"tag":"tag_14"},"key":"tag"},{"para":{"layer":"chara2","img":"chara043_1_face_chara043_1f"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]就是……就是我搭的临时小营地，里面的制药台被一群荒野客给……毁掉了。[l][cm]"},"key":"text"},{"para":{"tag":"tag_15"},"key":"tag"},{"para":{"layer":"chara2","img":"chara043_1_face_chara043_1d"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]之前我们不是给村子送过药嘛。那些荒野客之前和村子做过生意，觉得我占了他们的商机，还跟踪了我，找到了我营地的位置。[l][cm]"},"key":"text"},{"para":{"tag":"tag_16"},"key":"tag"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]他们告诉乡亲们，要替他们伸张正义，要找到我诓骗大家的证据，要教训我这个“奸商”……就趁我不在，摸进了我的营地。[l]"},"key":"text"},{"para":{"tag":"tag_17"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":0.6,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1d","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"tag":"tag_18","text":"那些可恶的混蛋！"}]},"key":"option"},{"para":{"tag":"tag_18"},"key":"tag"},{"para":{"layer":"chara2","img":"chara043_1_face_chara043_1c"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":1,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1c","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[cm][show]哎呀，你别气、你别气啦。也没啥好生气的。[l][cm]"},"key":"text"},{"para":{"tag":"tag_19"},"key":"tag"},{"para":{"layer":"chara2","img":"chara043_1_face_chara043_1f"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]我钱本来就没多少，也不会藏在营地里。他们翻个底朝天也没摸出半个子儿，恼羞成怒就把我的炼药台砸得稀巴烂。[l][cm]"},"key":"text"},{"para":{"tag":"tag_20"},"key":"tag"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]主要是……那些家伙还留了张字条，把我从头骂到了脚。威胁我再敢发药，再敢在村子附近出现，就见一次砸一次……[l][cm]"},"key":"text"},{"para":{"tag":"tag_21"},"key":"tag"},{"para":{"layer":"chara2","img":"chara043_1_face_chara043_1d"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]还说……还说我肯定有不可告人的秘密……说他已经告诉了乡亲我在药里惨了东西……绝对没有人会再相信我了……[l]"},"key":"text"},{"para":{"tag":"tag_22"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":0.6,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1d","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"tag":"tag_23","text":"这也太过分了……"}]},"key":"option"},{"para":{"tag":"tag_23"},"key":"tag"},{"para":{"layer":"chara2","img":"chara043_1_face_chara043_1f"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":1,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1f","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[cm][show]……[l][cm]"},"key":"text"},{"para":{"tag":"tag_24"},"key":"tag"},{"para":{"layer":"chara2","img":"chara043_1_face_chara043_1c"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]你说……在旁人眼里，我是不是真就是个满脑子算计的奸商啊？[l][cm]"},"key":"text"},{"para":{"tag":"tag_25"},"key":"tag"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]这么一想，我散出去的钱也有好多，可也没几个人记得住吧？大家能记住的，永远只是我在市场上那副笑脸迎人，讨价还价的模样……[l][cm]"},"key":"text"},{"para":{"tag":"tag_26"},"key":"tag"},{"para":{"layer":"chara2","img":"chara043_1_face_chara043_1f"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"阿娜洛洁","text":"[show]兴许……我这辈子都甩不掉这身骂名了吧。[l]"},"key":"text"},{"para":{"tag":"tag_27"},"key":"tag"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":0.6,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_chara043_1f","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"tag":"tag_28","text":"不是这样的，阿娜洛洁！"}]},"key":"option"},{"para":{"tag":"tag_28"},"key":"tag"},{"para":{"options":[{"tag":"tag_29","text":"经商和做荒野客一样，都会树敌无数。"},{"tag":"tag_29","text":"既然有利益纠纷，被误会也是必然的。"}]},"key":"option"},{"para":{"tag":"tag_29"},"key":"tag"},{"para":{"options":[{"tag":"tag_30","text":"但是，就算所有人都把你当坏人……"},{"tag":"tag_30","text":"我也依然会信任你，阿娜洛洁！"}]},"key":"option"},{"para":{"tag":"tag_30"},"key":"tag"},{"para":{"layer":"chara2","img":"chara043_1_face_chara043_1c"},"key":"setLayerFace"},{"para":{"alpha":1,"trans":true,"layer":"chara2","noOut":false,"x":350,"bright":1,"transTime":300,"y":-119,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara043_1","addImg":"chara043_1_face_