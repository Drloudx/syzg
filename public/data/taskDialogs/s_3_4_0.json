{"exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":0,"scaleX":1,"trans":true,"layer":"chara3","noOut":false,"noIn":false,"bright":1,"scaleY":1,"x":700,"mirrow":false,"y":-210,"img":"chara006_0","addImg":""},"key":"setLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara3","noOut":false,"noIn":false,"bright":1,"transTime":300,"scaleY":1,"x":700,"mirrow":false,"y":-210,"img":"chara006_0","addImg":""},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"比绍","text":"[show]噢，是你们啊，好久不见英雄们。鄙人来这里自然是为了做生意了。[l][cm]"},"key":"text"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"nameSide":"left","charaName":"比绍","text":"[show]毕竟前任会长落马的传闻已经闹得沸沸扬扬了。水商商会在本地的势力遭受了巨大的打击，现在正是我们入局的好时机。[l][cm]"},"key":"text"},{"para":{"tag":"tag_4"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"alpha":0,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"noIn":false,"bright":1,"scaleY":1,"x":50,"mirrow":false,"y":-180,"img":"chara002_2","addImg":"chara002_2_face_chara002_2h"},"key":"setLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"noIn":false,"bright":1,"transTime":300,"scaleY":1,"x":50,"mirrow":false,"y":-180,"img":"chara002_2","addImg":"chara002_2_face_chara002_2h"},"key":"moveLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara3","noOut":false,"noIn":false,"bright":0.6,"transTime":300,"scaleY":1,"x":700,"mirrow":false,"y":-210,"img":"chara006_0","addImg":""},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]入局？你早就等着这个时候了？[l][cm]"},"key":"text"},{"para":{"tag":"tag_5"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"noIn":false,"bright":0.6,"transTime":300,"scaleY":1,"x":50,"mirrow":false,"y":-180,"img":"chara002_2","addImg":"chara002_2_face_chara002_2h"},"key":"moveLayer"},{"para":{"alp