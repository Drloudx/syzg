{"script":"s_3_11_2","des":"神秘人【请问……】","exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"nameSide":"left","charaName":"神秘的陌生人","text":"[show]嗯？你们有什么事情吗？[l]"},"key":"text"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"options":[{"text":"（交出彩券。）","tag":"tag_4"}]},"key":"option"},{"para":{"tag":"tag_4"},"key":"tag"},{"para":{"nameSide":"left","charaName":"神秘的陌生人","text":"[cm][show]原来如此……唔，竟然是两个人……也罢了。喂，就你们来了吗？没有其他人吧？[l][cm]"},"key":"text"},{"para":{"tag":"tag_5"},"key":"tag"},{"para":{"alpha":0,"scaleX":1.5,"layer":"bg","img":"bgblack","mirrow":false,"x":-500,"trans":true,"y":-125,"noOut":false,"addImg":"","scaleY":1.5,"noIn":false,"bright":1},"key":"setLayer"},{"para":{"alpha":0.4,"scaleX":1.5,"layer":"bg","img":"bgblack","mirrow":false,"transTime":300,"x":-500,"trans":true,"y":-125,"noOut":false,"addImg":"","scaleY":1.5,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"alpha":0,"scaleX":1,"layer":"chara2","img":"chara002_2","mirrow":false,"x":340,"trans":true,"y":-180,"noOut":false,"addImg":"chara002_2_face_chara002_2o","scaleY":1,"noIn":false,"bright":1},"key":"setLayer"},{"para":{"alpha":1,"scaleX":1,"layer":"chara2","img":"chara002_2","mirrow":false,"transTime":300,"x":340,"trans":true,"y":-180,"noOut":false,"addImg":"chara002_2_face_chara002_2o","scaleY":1,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]没有没有～快把奖金给我们吧！[l][cm]"},"key":"text"},{"para":{"tag":"tag_6"},"key":"tag"},{"para":{"alpha":0,"scaleX":1,"layer":"chara2","img":"chara002_2","mirrow":false,"transTime":300,"x":340,"trans":true,"y":-180,"noOut":false,"addImg":"chara002_2_face_chara002_2o","scaleY":1,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"alpha":0,"scaleX":1.5,"layer":"bg","img":"bgblack","mirrow":false,"transTime":300,"x":-500,"trans":true,"y":-125,"noOut":false,"addImg":"","scaleY":1.5,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"神秘的陌生人","text":"[show]没有是吧……那就……小的们！都出来吧！[l][cm]"},"key":"text"},{"para":{"tag":"tag_7"},"key":"tag"},{"para":{"alpha":0,"scaleX":1.5,"layer":"bg","img":"bgblack","mirrow":false,"x":-500,"trans":true,"y":-125,"noOut":false,"addImg":"","scaleY":1.5,"noIn":false,"bright":1},"key":"setLayer"},{"para":{"alpha":0.4,"scaleX":1.5,"layer":"bg","img":"bgblack","mirrow":false,"transTime":300,"x":-500,"trans":true,"y":-125,"noOut":false,"addImg":"","scaleY":1.5,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"alpha":0,"scaleX":1,"layer":"chara2","img":"chara002_2","mirrow":false,"x":340,"trans":true,"y":-180,"noOut":false,"addImg":"chara002_2_face_chara002_2b","scaleY":1,"noIn":false,"bright":1},"key":"setLayer"},{"para":{"alpha":1,"scaleX":1,"layer":"chara2","img":"chara002_2","mirrow":false,"transTime":300,"x":340,"trans":true,"y":-180,"noOut":false,"addImg":"chara002_2_face_chara002_2b","scaleY":1,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]哎呀呀～你们这是想干什么～[l][cm]"},"key":"text"},{"para":{"tag":"tag_8"},"key":"tag"},{"para":{"alpha":0,"scaleX":1,"layer":"chara2","img":"chara002_2","mirrow":false,"transTime":300,"x":340,"trans":true,"y":-180,"noOut":false,"addImg":"chara002_2_face_chara002_2b","scaleY":1,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"alpha":0,"scaleX":1.5,"layer":"bg","img":"bgblack","mirrow":false,"transTime":300,"x":-500,"trans":true,"y":-125,"noOut":false,"addImg":"","scaleY":1.5,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"神秘的陌生人","text":"[show]恭喜你们啊，居然连这么简单的骗局能中招！[l]"},"key":"text"},{"para":{"tag":"tag_9"},"key":"tag"},{"para":{"options":[{"text":"好可怕呀～！","tag":"tag_10"},{"text":"你们到底是谁呀～？","tag":"tag_10"}]},"key":"option"},{"para":{"tag":"tag_10"},"key":"tag"},{"para":{"nameSide":"left","charaName":"神秘的陌生人","text":"[cm][show]哼！反正你们很快就要和魔爪湖说再见了，告诉你们也无妨！[l][cm]"},"key":"text"},{"para":{"tag":"tag_11"},"key":"tag"},{"para":{"nameSide":"left","charaName":"人贩子首领","text":"[show]我们原本是图洛德的人，专门给他干绑票的。之前我们一直替他绑架贫民街的人，每次帮他绑一个人过来我们就能拿到很多银币。[l][cm]"},"key":"text"},{"para":{"tag":"tag_12"},"key":"tag"},{"para":{"nameSide":"left","charaName":"人贩子首领","text":"[show]可惜这家伙居然被揭穿了，我们失去了原本的生意来源。不过我们现在找到了一个新的赚钱路子，那就是把人卖到白沙荒原去。[l][cm]"},"key":"text"},{"para":{"tag":"tag_13"},"key":"tag"},{"para":{"nameSide":"left","charaName":"人贩子首领","text":"[show]所以你们听懂了吗？你们现在最好的选择，就是老老实实跟我们走，然后在白沙荒原继续渡过你们那愚蠢的人生——哈哈哈哈哈！[l][cm]"},"key":"text"},{"para":{"tag":"tag_14"},"key":"tag"},{"para":{"alpha":0,"scaleX":1.5,"layer":"bg","img":"bgblack","mirrow":false,"x":-500,"trans":true,"y":-125,"noOut":false,"addImg":"","scaleY":1.5,"noIn":false,"bright":1},"key":"setLayer"},{"para":{"alpha":0.4,"scaleX":1.5,"layer":"bg","img":"bgblack","mirrow":false,"transTime":300,"x":-500,"trans":true,"y":-125,"noOut":false,"addImg":"","scaleY":1.5,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"alpha":0,"scaleX":1,"layer":"chara2","img":"chara002_2","mirrow":false,"x":340,"trans":true,"y":-180,"noOut":false,"addImg":"chara002_2_face_chara002_2j","scaleY":1,"noIn":false,"bright":1},"key":"setLayer"},{"para":{"alpha":1,"scaleX":1,"layer":"chara2","img":"chara002_2","mirrow":false,"transTime":300,"x":340,"trans":true,"y":-180,"noOut":false,"addImg":"chara002_2_face_chara002_2j","scaleY":1,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]唔，可恶，我不想演了！做这种坏事还能理直气壮的，你们这群不可饶恕的家伙！[l][cm]"},"key":"text"},{"para":{"tag":"tag_15"},"key":"tag"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]告诉你们一件事吧，你们挑错对手了，你们之前的金主图洛德……就是被我们击败的！你们这些狗腿子也乖乖束手就擒吧！[l][cm]"},"key":"text"},{"para":{"tag":"tag_16"},"key":"tag"},{"para":{"alpha":0,"scaleX":1,"layer":"chara2","img":"chara002_2","mirrow":false,"transTime":300,"x":340,"trans":true,"y":-180,"noOut":false,"addImg":"chara002_2_face_chara002_2j","scaleY":1,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"alpha":0,"scaleX":1.5,"layer":"bg","img":"bgblack","mirrow":false,"transTime":300,"x":-500,"trans":true,"y":-125,"noOut":false,"addImg":"","scaleY":1.5,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"人贩子首领","text":"[show]什……什么？只是这些毛头小子的虚张声势罢了！大家上，见识我们的厉害！[l][cm]"},"key":"text"},{"para":{"tag":"tag_17"},"key":"tag"},{"para":{"alpha":0,"scaleX":1.5,"layer":"bg","img":"bgblack","mirrow":false,"x":-500,"trans":true,"y":-125,"noOut":false,"addImg":"","scaleY":1.5,"noIn":false,"bright":1},"key":"setLayer"},{"para":{"alpha":0.4,"scaleX":1.5,"layer":"bg","img":"bgblack","mirrow":false,"transTime":300,"x":-500,"trans":true,"y":-125,"noOut":false,"addImg":"","scaleY":1.5,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"alpha":0,"scaleX":1,"layer":"chara2","img":"chara002_2","mirrow":false,"x":340,"trans":true,"y":-180,"noOut":false,"addImg":"chara002_2_face_chara002_2j","scaleY":1,"noIn":false,"bright":1},"key":"setLayer"},{"para":{"alpha":1,"scaleX":1,"layer":"chara2","img":"chara002_2","mirrow":false,"transTime":300,"x":340,"trans":true,"y":-180,"noOut":false,"addImg":"chara002_2_face_chara002_2j","scaleY":1,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]{myName}！把他们全打趴下！[l][cm][hide]"},"key":"text"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"alpha":0,"scaleX":1,"layer":"chara2","img":"chara002_2","mirrow":false,"transTime":300,"x":340,"trans":true,"y":-180,"noOut":false,"addImg":"chara002_2_face_chara002_2j","scaleY":1,"noIn":false,"bright":1},"key":"moveLayer"},{"para":