{"des":"熔火中的调研-研究员斯纳尔互动","script":"s_5_10_1","exps":[{"key":"tag","para":{"tag":"tag_1"}},{"key":"top","para":{"layer":"chara2"}},{"key":"text","para":{"nameSide":"left","text":"[show]太好了，大家都平安回来了，营救行动非常成功，多谢几位出手相助！[l][cm]","charaName":"研究员斯纳尔"}},{"key":"tag","para":{"tag":"tag_2"}},{"key":"setLayer","para":{"addImg":"","alpha":0,"noIn":false,"scaleX":1.5,"layer":"bg","img":"bgblack","x":-500,"y":-125,"bright":1,"mirrow":false,"trans":true,"noOut":false,"scaleY":1.5}},{"key":"moveLayer","para":{"addImg":"","alpha":0.4,"noIn":false,"scaleX":1.5,"layer":"bg","img":"bgblack","transTime":300,"x":-500,"y":-125,"bright":1,"mirrow":false,"trans":true,"noOut":false,"scaleY":1.5}},{"key":"wait","para":{"time":300}},{"key":"tag","para":{"tag":"tag_3"}},{"key":"top","para":{"layer":"chara1"}},{"key":"setLayer","para":{"addImg":"chara002_2_face_chara002_2a","alpha":0,"noIn":false,"scaleX":1,"layer":"chara1","img":"chara002_2","x":50,"y":-180,"bright":1,"mirrow":false,"trans":true,"noOut":false,"scaleY":1}},{"key":"moveLayer","para":{"addImg":"chara002_2_face_chara002_2a","alpha":1,"noIn":false,"scaleX":1,"layer":"chara1","img":"chara002_2","transTime":300,"x":50,"y":-180,"bright":1,"mirrow":false,"trans":true,"noOut":false,"scaleY":1}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"nameSide":"left","text":"[show]小意思啦，那你们接下来打算怎么办？是继续探索还是回去搬点救兵？[l][cm]","charaName":"米托拉"}},{"key":"tag","para":{"tag":"tag_4"}},{"key":"moveLayer","para":{"addImg":"chara002_2_face_chara002_2a","alpha":1,"noIn":false,"scaleX":1,"layer":"chara1","img":"chara002_2","transTime":300,"x":50,"y":-180,"bright":0.6,"mirrow":false,"trans":true,"noOut":false,"scaleY":1}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"nameSide":"left","text":"[show]我们目前也没有想好，设备都搬过来了，直接回去肯定不行。但要留下继续调查也确实很麻烦，这里的混乱程度远超我们想象，眼下的安保力量肯定不够。[l][cm]","charaName":"研究员斯纳尔"}},{"key":"tag","para":{"tag":"tag_5"}},{"key":"top","para":{"layer":"chara3"}},{"key":"setLayer","para":{"addImg":"chara053_1_face_chara053_1e","al