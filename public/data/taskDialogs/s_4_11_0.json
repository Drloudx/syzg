{"script":"s_4_11_0","exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"nameSide":"left","charaName":"索洛罗哆","text":"[show]你……你们好，我……我是……索……索洛……[l]"},"key":"text"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"options":[{"text":"索洛罗哆？","tag":"tag_3"}]},"key":"option"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"nameSide":"left","charaName":"索洛罗哆","text":"[show][cm]没错……你……你们怎么知道的噗……[l][cm]"},"key":"text"},{"para":{"tag":"tag_4"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"","layer":"bg","x":-500,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"setLayer"},{"para":{"noIn":false,"mirrow":false,"alpha":0.4,"addImg":"","layer":"bg","x":-500,"transTime":300,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"tag":"tag_5"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"chara002_2_face_chara002_2a","layer":"chara2","x":340,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"setLayer"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2a","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]你不是戴着储存场的工牌嘛，上面写了你的名字。有什么事的话直接说就好啦。[l][cm]"},"key":"text"},{"para":{"tag":"tag_6"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2a","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"索洛罗哆","text":"[show]对、对不起的噗……我的确有点事情想拜托两位契约者的噗……[l][cm]"},"key":"text"},{"para":{"tag":"tag_7"},"key":"tag"},{"para":{"nameSide":"left","charaName":"索洛罗哆","text":"[show]我……我有一个朋友，叫维……维罗莎，她是金弦之厅的厨师噗……[l][cm]"},"key":"text"},{"para":{"tag":"tag_8"},"key":"tag"},{"para":{"nameSide":"left","charaName":"索洛罗哆","text":"[show]她……她从小就没有嗅觉，作为厨师的下手……这个缺点一直令她很……很困扰噗。[l][cm]"},"key":"text"},{"para":{"tag":"tag_9"},"key":"tag"},{"para":{"nameSide":"left","charaName":"索洛罗哆","text":"[show]我……我想治好她的鼻子噗！[l][cm]"},"key":"text"},{"para":{"tag":"tag_10"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2d","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2d","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]失去了嗅觉的厨师啊。还真是奇怪的组合呢……嗯……唔。嗅嗅……[l][cm]"},"key":"text"},{"para":{"tag":"tag_11"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2k","layer":"chara2"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]（{myName}……那个，你有没有闻到……呃，有种奇怪的味道？）[l]"},"key":"text"},{"para":{"tag":"tag_12"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2k","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"text":"（我也觉得有点儿……）","tag":"tag_13"}]},"key":"option"},{"para":{"tag":"tag_13"},"key":"tag"},{"para":{"nameSide":"left","charaName":"索洛罗哆","text":"[show][cm]你、你们是闻到臭味了吗？对……对不起，这是我的问题噗……对不起……[l][cm]"},"key":"text"},{"para":{"tag":"tag_14"},"key":"tag"},{"para":{"nameSide":"left","charaName":"索洛罗哆","text":"[show]我……我从小就无法控制住自己身上散发的臭味……虽、虽然蕈人不会介意……但、但其他森林住民一直很嫌弃我噗……[l][cm]"},"key":"text"},{"para":{"tag":"tag_15"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2d","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2d","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]原来如此……难怪你选择一个人在储存场工作吗……[l][cm]"},"key":"text"},{"para":{"tag":"tag_16"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2d","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"索洛罗哆","text":"[show]对……对不起！我……我就不该存在在这个世界上，我要是消失就……就好了噗……[l][cm]"},"key":"text"},{"para":{"tag":"tag_17"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2c","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2c","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]我、我没有那个意思啦，这也不是你的错！相比那些魔花，你这点味道根本不算什么！[l][cm]"},"key":"text"},{"para":{"tag":"tag_18"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2c","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"索洛罗哆","text":"[show]谢、谢谢你……不、不过在我消失之前……我……我我我我、我还是希望能治好维罗莎的病噗！[l][cm]"},"key":"text"},{"para":{"tag":"tag_19"},"key":"tag"},{"para":{"nameSide":"left","charaName":"索洛罗哆","text":"[show]维罗莎是唯一、唯一不会嫌弃我的金弦鹿人的噗。从小我们就是最好的朋友的噗。我一定要治好她的鼻子，来报答她噗……[l][cm]"},"key":"text"},{"para":{"tag":"tag_20"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2k","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2k","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]唔……不过……要是你真的治好了她的鼻子，那岂不是她也会闻到你身上的味道？[l][cm]"},"key":"text"},{"para":{"tag":"tag_21"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2k","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"索洛罗哆","text":"[show]这点我也想过了噗。就算她……她可能也会嫌弃我……但、但为了她好，我也不在乎噗！[l]"},"key":"text"},{"para":{"tag":"tag_22"},"key":"tag"},{"para":{"options":[{"text":"我明白了。","tag":"tag_23"},{"text":"我会帮你。","tag":"tag_23"}]},"key":"option"},{"para":{"tag":"tag_23"},"key":"tag"},{"para":{"nameSide":"left","charaName":"索洛罗哆","text":"[show][cm]谢、谢谢的噗！万分感谢的噗！[l][cm]"},"key":"text"},{"para":{"tag":"tag_24"},"key":"tag"},{"para":{"nameSide":"left","charaName":"索洛罗哆","text":"[show]可我……我不会医术，也不会制药……所以我想要拜托你们……和我一起找到药方……把要弄出来之后送给维罗莎噗。[l]"},"key":"text"},{"para":{"tag":"tag_25"},"key":"tag"},{"para":{"options":[{"text":"你知道配方吗？","tag":"tag_26"}]},"key":"option"},{"para":{"tag":"tag_26"},"key":"tag"},{"para":{"nameSide":"left","charaName":"索洛罗哆","text":"[show][cm]我……我不知道。但、但是我们的老前辈奥德吉哆应该知道噗，他学过很多医术的噗。去……去去去找他问问好了噗……[l][cm]"},"key":"text"},{"para":{"tag":"tag_27"},"key":"tag"},{"para":{"nameSide":"left","charaName":"索洛罗哆","text":"[show]他……他可能有点健忘，所以还希望你们能理解一下的噗。报、报酬我也准备好了噗……[l][cm]"},"key":"text"},{"para":{"tag":"tag_28"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2a","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2a","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]嗯。我们这就去找奥德吉哆，问问药方吧。[l][cm][hide]"},"key":"text"},{"para":{"tag":"tag_29"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"chara002_2_face_chara002_2a","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"","layer":"bg","x":-500,"transTime":300,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"","text":"[hide]"},"key":"text"},{"para":{"end":true},"key":"end"}],"des":"被嫌弃的蕈人的半生-接取步骤"}