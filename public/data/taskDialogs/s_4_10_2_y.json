00},"key":"wait"},{"para":{"charaName":"护林人哈尔贝娜","text":"[show]唔，那些好像是其他人堆起来的垃圾……算了，一下也找不到什么能当靶子的东西，就拿它们开练吧……噢，记得要偷偷地丢。[l]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_6"},"key":"tag"},{"para":{"options":[{"text":"（扔出燃烧炼金炸弹。）","tag":"tag_7"}]},"key":"option"},{"para":{"tag":"tag_7"},"key":"tag"},{"para":{"charaName":"","text":"[show][cm]（轰隆——！乒里乓啷——！）[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_8"},"key":"tag"},{"para":{"charaName":"周围的护林人","text":"[show]喂、吓死人啦！你们干什么呢！呜哇，垃圾堆烧起来了？快、快灭火！[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_9"},"key":"tag"},{"para":{"noOut":false,"mirrow":false,"alpha":0,"scaleX":1.5,"addImg":"","trans":true,"noIn":false,"layer":"bg","x":-500,"y":-125,"bright":1,"scaleY":1.5,"img":"bgblack"},"key":"setLayer"},{"para":{"noOut":false,"mirrow":false,"alpha":0.4,"scaleX":1.5,"addImg":"","trans":true,"noIn":false,"layer":"bg","x":-500,"transTime":300,"y":-125,"bright":1,"scaleY":1.5,"img":"bgblack"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"tag":"tag_10"},"key":"tag"},{"para":{"noOut":false,"mirrow":false,"alpha":0,"scaleX":1,"addImg":"chara002_2_face_chara002_2i","trans":true,"noIn":false,"layer":"chara2","x":340,"y":-180,"bright":1,"scaleY":1,"img":"chara002_2"},"key":"setLayer"},{"para":{"noOut":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2i","trans":true,"noIn":false,"layer":"chara2","x":340,"transTime":300,"y":-180,"bright":1,"scaleY":1,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米托拉","text":"[show]喵呜！吓……吓死我了！这炸弹的威力这么大的吗？[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_11"},"key":"tag"},{"para":{"noOut":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2i","trans":true,"noIn":false,"layer":"chara2","x":340,"transTime":300,"y":-180,"bright":0.6,"scaleY":1,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"周围的护林人","