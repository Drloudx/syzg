    {
      "para": {
        "charaName": "米托拉",
        "text": "[show]之前在路上碰到都是顺手宰掉的，但和德莉认识了之后，再干掉它们就会稍微有点负罪感呢！[l]",
        "nameSide": "left"
      },
      "key": "text"
    },
    {
      "para": {
        "options": [
          {
