      "key": "text"
    },
    {
      "para": {
        "nameSide": "left",
        "charaName": "菲莉娜",
        "text": "[show]我还在这里完好无损，而那东西已经和所有元素魔物的末路一样，爆发四散、片点无存了！[l]"
