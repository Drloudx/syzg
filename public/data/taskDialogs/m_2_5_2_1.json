{"script":"m_2_5_2_1","exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"nameSide":"left","charaName":"“工头”罗伯特","text":"[show]是你们！你们回来了！等、等等……米拉贝尔呢？我的米拉贝尔怎么不在？难道她——难道她已经——[l][cm]"},"key":"text"},{"para":{"tag":"tag_4"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"scaleX":1.5,"addImg":"","layer":"bg","noOut":false,"x":-500,"scaleY":1.5,"trans":true,"bright":1,"y":-125,"img":"bgblack"},"key":"setLayer"},{"para":{"noIn":false,"mirrow":false,"alpha":0.4,"scaleX":1.5,"addImg":"","layer":"bg","noOut":false,"x":-500,"transTime":300,"scaleY":1.5,"trans":true,"bright":1,"y":-125,"img":"bgblack"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"scaleX":1,"addImg":"chara002_2_face_chara002_2p","layer":"chara2","noOut":false,"x":360,"scaleY":1,"trans":true,"bright":1,"y":-180,"img":"chara002_2"},"key":"setLayer"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2p","layer":"chara2","noOut":false,"x":360,"transTime":300,"scaleY":1,"trans":true,"bright":1,"y":-180,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"layer":"chara2","y":0,"d":0.8,"x":10},"key":"shake"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]别别别别激动啊大叔！米拉贝尔没事！她好好的！[l][cm]"},"key":"text"},{"para":{"tag":"tag_6"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2p","layer":"chara2","noOut":false,"x":360,"transTime":300,"scaleY":1,"trans":true,"bright":0.6,"y":-180,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"“工头”罗伯特","text":"[show]啊，原、原来如此……那还好，还好……谢天谢地……[l][cm]"},"key":"text"},{"para":{"tag":"tag_7"},"key":"tag"},{"para":{"nameSide":"left","charaName":"“工头”罗伯特","text":"[show]但……但她人呢？既然没事，为什么不来见爸爸……[l][cm]"},"key":"text"},{"para":{"tag":"tag_8"},"key":"tag"},{"para":{"eventData":"{\r  \"action\": \"bubble\",\r  \"para\": {\r    \"bubbles\": {\r      \"chara002_2\": \"07\"\r    }\r  }\r}","event":"GAoEvent"},"key":"event"},{"para":{"img":"chara002_2_face_chara002_2b","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2b","layer":"chara2","noOut":false,"x":360,"transTime":300,"scaleY":1,"trans":true,"bright":1,"y":-180,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]呃，那个，就是……对，她不是受了惊吓嘛！然后就有点……气喘、脱力、四肢颤抖、头脑发昏……[l][cm]"},"key":"text"},{"para":{"tag":"tag_10"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2b","layer":"chara2","noOut":false,"x":360,"transTime":300,"scaleY":1,"trans":true,"bright":0.6,"y":-180,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"“工头”罗伯特","text":"[show]那不是很严重吗！我的米拉贝尔——！[l][cm]"},"key":"text"},{"para":{"tag":"tag_33"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2i","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2i","layer":"chara2","noOut":false,"x":360,"transTime":300,"scaleY":1,"trans":true,"bright":1,"y":-180,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"tag":"tag_11"},"key":"tag"},{"para":{"layer":"chara2","y":0,"d":0.8,"x":10},"key":"shake"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]没、没没没没有啦！我说太过了！就总之，她在菲莉娜的小屋里休息呢！[l][cm]"},"key":"text"},{"para":{"tag":"tag_13"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2i","layer":"chara2","noOut":false,"x":360,"transTime":300,"scaleY":1,"trans":true,"bright":0.6,"y":-180,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"“工头”罗伯特","text":"[show]啊……是这样啊……在菲莉娜的小屋的话，我多少也放下心来了……[l][cm]"},"key":"text"},{"para":{"tag":"tag_14"},"key":"tag"},{"para":{"nameSide":"left","charaName":"“工头”罗伯特","text":"[show]她平日就经常去那边玩……有菲莉娜在，应该没什么问题……[l][cm]"},"key":"text"},{"para":{"tag":"tag_15"},"key":"tag"},{"para":{"nameSide":"left","charaName":"“工头”罗伯特","text":"[show]对、对了！到底是怎么回事，到底是谁把我的米拉贝尔绑走？[l][cm]"},"key":"text"},{"para":{"tag":"tag_16"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2h","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2h","layer":"chara2","noOut":false,"x":360,"transTime":300,"scaleY":1,"trans":true,"bright":1,"y":-180,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]现在才开始问到重点吗……[l]"},"key":"text"},{"para":{"options":[{"text":"（将刚刚的事情简要告诉工头。）","tag":"tag_17"}]},"key":"option"},{"para":{"tag":"tag_17"},"key":"tag"},{"para":{"nameSide":"left","charaName":"","text":"[cm]"},"key":"text"},{"para":{"tag":"tag_18"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2h","layer":"chara2","noOut":false,"x":360,"transTime":300,"scaleY":1,"trans":true,"bright":0.6,"y":-180,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"“工头”罗伯特","text":"[show]原来是马可吗……呜……那家伙……我们几个工友，一直拿他当家人兄弟……[l][cm]"},"key":"text"},{"para":{"tag":"tag_19"},"key":"tag"},{"para":{"nameSide":"left","charaName":"“工头”罗伯特","text":"[show]没想到居然做出这种事……可恶……[l][cm]"},"key":"text"},{"para":{"tag":"tag_20"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2e","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2e","layer":"chara2","noOut":false,"x":360,"transTime":300,"scaleY":1,"trans":true,"bright":1,"y":-180,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]总之，你们村子的问题可能比你们想的还要严重。[l][cm]"},"key":"text"},{"para":{"tag":"tag_21"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2e","layer":"chara2","noOut":false,"x":360,"transTime":300,"scaleY":1,"trans":true,"bright":0.6,"y":-180,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"“工头”罗伯特","text":"[show]是啊……[l]"},"key":"text"},{"para":{"options":[{"text":"其他工友的情况怎么样？","tag":"tag_24"}]},"key":"option"},{"para":{"tag":"tag_24"},"key":"tag"},{"para":{"nameSide":"left","charaName":"“工头”罗伯特","text":"[show][cm]刚刚从后山回来的时候，大家的情绪还是像炸药桶一样，感觉随时会炸……[l][cm]"},"key":"text"},{"para":{"tag":"tag_22"},"key":"tag"},{"para":{"nameSide":"left","charaName":"“工头”罗伯特","text":"[show]但是……看到事情发酵到这种程度……大家的情绪也暂且是稳定下来了。[l][cm]"},"key":"text"},{"para":{"tag":"tag_23"},"key":"tag"},{"para":{"nameSide":"left","charaName":"“工头”罗伯特","text":"[show]不管是想要马上恢复生产的也好，想要先保证安全的也好，工人毕竟是工人，都是重集体、重感情的……[l][cm]"},"key":"text"},{"para":{"tag":"tag_25"},"key":"tag"},{"para":{"nameSide":"left","charaName":"“工头”罗伯特","text":"[show]现在村里的人，多半也都是看着米拉贝尔长大的叔伯兄长。听到她出事，大家终究还是冷静了下来……我也终于能够靠我这张老脸，拉着大家坐下来好好谈谈……[l][cm]"},"key":"text"},{"para":{"tag":"tag_26"},"key":"tag"},{"para":{"nameSide":"left","charaName":"“工头”罗伯特","text":"[show]虽然多半谈不出什么结果，顶多只能让下一次内讧晚来几天罢了。我都有点不知道该怎么办了……[l][cm]"},"key":"text"},{"para":{"tag":"tag_27"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2d","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2d","layer":"chara2","noOut":false,"x":360,"transTime":300,"scaleY":1,"trans":true,"bright":1,"y":-180,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]这样啊……[l][cm]"},"key":"text"},{"para":{"tag":"tag_28"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2d","layer":"chara2","noOut":false,"x":360,"transTime":300,"scaleY":1,"trans":true,"bright":0.6,"y":-180,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"“工头”罗伯特","text":"[show]唉，我和你们说这些干嘛！你们救了米拉贝尔，就是我，还有我们巴诺姆村的恩人。[l][cm]"},"key":"text"},{"para":{"tag":"tag_29"},"key":"tag"},{"para":{"nameSide":"left","charaName":"“工头”罗伯特","text":"[show]两位先休息两天，等我忙完了这波，报酬一定全额奉上。[l][cm]"},"key":"text"},{"para":{"tag":"tag_30"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2b","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2b","layer":"chara2","noOut":false,"x":360,"transTime":300,"scaleY":1,"trans":true,"bright":1,"y":-180,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]嗷，那我们先走啦。[l][cm]"},"key":"text"},{"para":{"tag":"tag_31"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2e","layer":"chara2"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]（这样就算报告完了吧。之后就从东北方出村，去后山和米拉贝尔碰头吧。）[l][cm]"},"key":"text"},{"para":{"tag":"tag_32"},"key":"tag"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]（……唉，人和人之间的关系真麻烦啊。为什么就不能像我俩这样轻松呢……）[l][cm][hide]"},"key":"text"},{"para":{"tag":"tag_5"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"scaleX":1,"addImg":"chara002_2_face_chara002_2e","layer":"chara2","noOut":false,"x":360,"transTime":300,"scaleY":1,"trans":true,"bright":1,"y":-180,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"scaleX":1.5,"addImg":"","layer":"bg","noOut":false,"x":-500,"transTime":300,"scaleY":1.5,"trans":true,"bright":1,"y":-125,"img":"bgblack"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"time":300,"type":"time"},"key":"wait"},{"para":{"end":true},"key":"end"}],"des":"决意的彼端-回到巴诺姆村的工头小屋，和“工头”罗伯特聊聊。"}