{"script":"s_0_4_0","exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"alpha":0,"bright":1,"layer":"chara2","img":"chara012_1","mirrow":false,"x":277.5,"trans":true,"y":-419,"noOut":false,"scaleX":1,"addImg":"chara012_1_face_chara012_1b","noIn":false,"scaleY":1},"key":"setLayer"},{"para":{"alpha":1,"bright":1,"layer":"chara2","img":"chara012_1","mirrow":false,"transTime":300,"x":277.5,"trans":true,"y":-419,"noOut":false,"scaleX":1,"addImg":"chara012_1_face_chara012_1b","noIn":false,"scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"猎人沃夫加","text":"[show]对了，看你们实力不凡的样子，我有个任务想要交给你们。[l][cm]"},"key":"text"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"nameSide":"left","charaName":"猎人沃夫加","text":"[show]有不少角猪从我的猎场逃到了这附近。把它们赶回猎场看起来是不可能了，我决定处理掉它们，把肉都处理掉。但我一个人有些力有不逮。[l][cm]"},"key":"text"},{"para":{"tag":"tag_4"},"key":"tag"},{"para":{"img":"chara012_1_face_chara012_1c","layer":"chara2"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"猎人沃夫加","text":"[show]能请你们帮忙狩猎几只角猪吗？切记不要掉以轻心了，这些被荒野驯养出来的魔物，可谓是诡计多端。[l][cm]"},"key":"text"},{"para":{"tag":"tag_5"},"key":"tag"},{"para":{"nameSide":"left","charaName":"猎人沃夫加","text":"[show]猎物们不会让你们轻易看穿破绽的……你必须想办法更加了解它们。[l][cm]"},"key":"text"},{"para":{"tag":"tag_6"},"key":"tag"},{"para":{"img":"chara012_1_face_chara012_1a","layer":"chara2"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"猎人沃夫加","text":"[show]必须追踪它们、学习它们、成为它们、埋伏它们，最终才有可能狩猎它们。[l][cm]"},"key":"text"},{"para":{"tag":"tag_7"},"key":"tag"},{"para":{"img":"chara012_1_face_chara012_1b","layer":"chara2"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"猎人沃夫加","text":"[show]理论很简单，但实践起来可就难了。麻烦你们了，猎人！[l][cm][hide]"},"key":"text"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"alpha":0,"bright":1,"layer":"chara2","img":"chara012_1","mirrow":false,"transTime":300,"x":277.5,"trans":true,"y":-419,"noOut":false,"scaleX":1,"addImg":"chara012_1_face_chara012_1b","noIn":false,"scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"","text":"[hide]"},"key":"text"},{"para":{"end":true},"key":"end"}],"des":"荒野客与猎人 接取步骤\t"}