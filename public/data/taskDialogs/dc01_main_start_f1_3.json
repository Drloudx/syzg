      "key": "option"
    },
    {
      "para": {
        "nameSide": "left",
        "charaName": "米托拉",
        "text": "[show][cm]什么——？[l][cm]"
      },
      "key": "text"
    },
    {
      "para": {
        "nameSide": "left",
        "charaName": "米托拉",
        "text": "[show]啊啊啊啊！是那些角布林的脚印！[l][cm]"
      },
      "key": "text"
    },
    {
      "para": {
        "nameSide": "left",
        "charaName": "米托拉",
        "text": "[show]不、不会吧……难道说，那些蟊贼趁我不在，跑到我的营地里——[l][cm]"
      },
      "key": "text"
    },
    {
      "para": {
        "nameSide": "left",
        "charaName": "米托拉",
        "text": "[show]快点，{myName}！要出大事了！[l][cm]"
      },
      "key": "text"
    }
  ]
