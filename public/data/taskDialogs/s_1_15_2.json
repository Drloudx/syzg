300,"alpha":1,"scaleY":1,"layer":"chara2","trans":true,"addImg":"chara002_2_face_chara002_2e","noOut":false,"y":-180,"bright":0.6,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"侍者杰米","text":"[show]没办法，人是要生活的嘛……哈哈……[l]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_9"},"key":"tag"},{"para":{"options":[{"tag":"tag_10","text":"那关于奇怪的视线，你有什么头绪吗？"},{"tag":"tag_10","text":"视线出现的时间和地点，有什么规律吗？"}]},"key":"option"},{"para":{"tag":"tag_10"},"key":"tag"},{"para":{"charaName":"侍者杰米","text":"[cm][show]这个……我就没什么头绪了。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_11"},"key":"tag"},{"para":{"charaName":"侍者杰米","text":"[show]要说的话，大概就是在室外工作的时候偶尔会有那种感觉吧？[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_12"},"key":"tag"},{"para":{"charaName":"侍者杰米","text":"[show]这也挺正常的，毕竟旅店里来往的都是契约者，那么多高手在，就算有跟踪狂也会吓得不敢轻举妄动了。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_23"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2q","layer":"chara2"},"key":"setLayerFace"},{"para":{"x":340,"transTime":300,"alpha":1,"scaleY":1,"layer":"chara2","trans":true,"addImg":"chara002_2_face_chara002_2q","noOut":false,"y":-180,"bright":1,"scaleX":1,"noIn":false,"mirrow":false,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"transTime":270,"alpha":1,"bright":1,"scaleX":1,"layer":"chara2","y":-50,"relativePos":true,"scaleY":1,"x":0},"key":"moveLayer"},{"para":{"time":320,"type":""},"key":"wait"},{"para":{"transTime":270,"alpha":1,"bright":1,"scaleX":1,"layer":"chara2","y":50,"relativePos":true,"scaleY":1,"x":0},"key":"moveLayer"},{"para":{"tag":"tag_13"},"key":"tag"},{"para":{"charaName":"米托拉","text":"[show]呃……那不就是完全没有线索吗？[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_14"},"key":"tag"},{"para":{"x":340,"transTime":300,"alpha":1,"scaleY":1,"layer":"chara2","trans":true,"addImg":"chara002_2_face_chara002_2q","noOut":false,"y":-180,"bright