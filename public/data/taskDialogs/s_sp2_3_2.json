    },
    {
      "para": {
        "nameSide": "left",
        "text": "[show]我看看……嗯……[l][cm]",
        "charaName": "米托拉"
      },
      "key": "text"
    },
    {
      "para": {
        "nameSide": "left",
        "text": "[show]德莉说她想到了一个好办法，让我们赶紧去和她会合！[l]",
