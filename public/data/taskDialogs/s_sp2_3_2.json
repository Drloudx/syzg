      },
      "key": "text"
    },
    {
      "para": {
        "options": [
          {
            "tag": "tag_9",
            "text": "不能放着德莉一个人。"
          },
          {
            "tag": "tag_9",
            "text": "你不是说好要帮她的吗？"
          }
        ]
      },
      "key": "option"
    },
    {
      "para": {
        "nameSide": "left",
        "text": "[cm][show]唔……也对！既然这样，那我们就赶快过去吧！[l][cm]",
