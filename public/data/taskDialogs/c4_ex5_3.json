      "key": "text"
    },
    {
      "para": {
        "nameSide": "left",
        "charaName": "护林人A",
        "text": "[show]什么！如此大胆——！列队！阻止他们！[l][cm]"
      },
      "key": "text"
    },
    {
      "para": {
        "nameSide": "left",
        "charaName": "护林人B",
        "text": "[show]守护树冠守望者！保卫金弦之厅！[l][cm]"
