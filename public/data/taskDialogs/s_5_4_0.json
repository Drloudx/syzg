{"des":"冰原猎人的烦恼-接取步骤","script":"s_5_4_0","exps":[{"key":"tag","para":{"tag":"tag_1"}},{"key":"top","para":{"layer":"chara2"}},{"key":"text","para":{"nameSide":"left","text":"[show]刚搭好的帐篷！刚点起的篝火！毁了！全都毁了！[l][cm]","charaName":"冰原猎人达霍格斯"}},{"key":"tag","para":{"tag":"tag_2"}},{"key":"text","para":{"nameSide":"left","text":"[show]那些狡猾的畜生，非要把营地掀个底朝天才肯罢休吗？等老子抓到你们，非把你们的皮全扒下来不可！[l][cm]","charaName":"冰原猎人达霍格斯"}},{"key":"tag","para":{"tag":"tag_3"}},{"key":"setLayer","para":{"addImg":"","alpha":0,"noIn":false,"scaleX":1.5,"layer":"bg","img":"bgblack","x":-500,"y":-125,"bright":1,"mirrow":false,"trans":true,"noOut":false,"scaleY":1.5}},{"key":"moveLayer","para":{"addImg":"","alpha":0.4,"noIn":false,"scaleX":1.5,"layer":"bg","img":"bgblack","transTime":300,"x":-500,"y":-125,"bright":1,"mirrow":false,"trans":true,"noOut":false,"scaleY":1.5}},{"key":"wait","para":{"time":300}},{"key":"tag","para":{"tag":"tag_4"}},{"key":"top","para":{"layer":"chara1"}},{"key":"setLayer","para":{"addImg":"chara002_2_face_chara002_2c","alpha":0,"noIn":false,"scaleX":1,"layer":"chara1","img":"chara002_2","x":50,"y":-180,"bright":1,"mirrow":false,"trans":true,"noOut":false,"scaleY":1}},{"key":"moveLayer","para":{"addImg":"chara002_2_face_chara002_2c","alpha":1,"noIn":false,"scaleX":1,"layer":"chara1","img":"chara002_2","transTime":300,"x":50,"y":-180,"bright":1,"mirrow":false,"trans":true,"noOut":false,"scaleY":1}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"nameSide":"left","text":"[show]哇……他看起来遇到了不小的麻烦……[l][cm]","charaName":"米托拉"}},{"key":"tag","para":{"tag":"tag_5"}},{"key":"top","para":{"layer":"chara3"}},{"key":"moveLayer","para":{"addImg":"chara002_2_face_chara002_2c","alpha":1,"noIn":false,"scaleX":1,"layer":"chara1","img":"chara002_2","transTime":300,"x":50,"y":-180,"bright":0.6,"mirrow":false,"trans":true,"noOut":false,"scaleY":1}},{"key":"setLayer","para":{"addImg":"chara053_1_face_chara053_1c","alpha":0,"noIn":false,"scaleX":1,"layer":"chara3","img":"chara053_1","x":510,"y":-4