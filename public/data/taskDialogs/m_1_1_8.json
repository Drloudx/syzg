":"tag_26"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2c","layer":"chara2"},"key":"setLayerFace"},{"para":{"noOut":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2c","trans":true,"noIn":false,"layer":"chara2","x":340,"transTime":300,"y":-180,"bright":1,"scaleY":1,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米托拉","text":"[show]嗯嗯嗯？你听到什么声音没有？是不是茜塔又跑回来了？[l]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_27"},"key":"tag"},{"para":{"noOut":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2c","trans":true,"noIn":false,"layer":"chara2","x":340,"transTime":300,"y":-180,"bright":0.6,"scaleY":1,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"text":"这么尖锐的嗓音，肯定不是茜塔。","tag":"tag_28"},{"text":"听上去好像是之前的那个……行商人。","tag":"tag_28"}]},"key":"option"},{"para":{"tag":"tag_28"},"key":"tag"},{"para":{"tag":"tag_24"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2e","layer":"chara2"},"key":"setLayerFace"},{"para":{"noOut":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2e","trans":true,"noIn":false,"layer":"chara2","x":340,"transTime":300,"y":-180,"bright":1,"scaleY":1,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米托拉","text":"[show][cm]哈？就是那个叫……露比的家伙？她真的找过来了？我还以为她不会过来呢，或者说还需要很长的时间才能找到这里——[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_31"},"key":"tag"},{"para":{"noOut":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2e","trans":true,"noIn":false,"layer":"chara2","x":50,"transTime":300,"y":-180,"bright":0.6,"scaleY":1,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"tag":"tag_30"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"noOut":false,"mirrow":false,"alpha":0,"scaleX":1,"addImg":"","trans":true,"noIn":false,"layer":"chara3","x":705,"y