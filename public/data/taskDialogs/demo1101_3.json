{"des":"demo1101_3","exps":[{"key":"tag","para":{"tag":"tag_1"}},{"key":"top","para":{"layer":"chara2"}},{"key":"setLayer","para":{"scaleX":1,"scaleY":1,"layer":"bg","mirrow":false,"trans":false,"x":0,"noOut":false,"y":18,"noIn":false,"bright":1,"img":"bgblack","alpha":0}},{"key":"moveLayer","para":{"scaleX":1,"scaleY":1,"nonStandBright":false,"layer":"bg","mirrow":false,"trans":false,"x":0,"noOut":false,"y":18,"timeBak":300,"noIn":false,"transTime":0,"bright":1,"img":"bgblack","alpha":0}},{"key":"setLayer","para":{"scaleX":1,"scaleY":1,"layer":"chara2","mirrow":false,"trans":true,"x":-95,"noOut":true,"y":-229,"noIn":false,"bright":1,"img":"npc_911_04","alpha":0}},{"key":"moveLayer","para":{"scaleX":1,"scaleY":1,"layer":"chara2","mirrow":false,"trans":true,"x":-95,"noOut":true,"y":-229,"noIn":false,"transTime":300,"bright":1,"img":"npc_911_04","alpha":1}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"charaName":"【樵夫萨契】","text":"[show]哦……这就是你收集来的木材吗？[l][cm]","nameSide":"left"}},{"key":"tag","para":{"tag":"tag_5"}},{"key":"moveLayer","para":{"scaleX":1,"scaleY":1,"nonStandBright":false,"layer":"chara2","mirrow":false,"trans":false,"x":-95,"noOut":false,"y":-229,"timeBak":300,"noIn":false,"transTime":0,"bright":1,"img":"npc_911_04","alpha":1}},{"key":"text","para":{"charaName":"【樵夫萨契】","text":"[show]这些，这些，还有这些……嗯，不错啊。[r]这在深渊杨里也算是良材了。你不是随意采集，而是挑拣过的，对吧？[l][cm]","nameSide":"left"}},{"key":"tag","para":{"tag":"tag_6"}},{"key":"text","para":{"charaName":"【樵夫萨契】","text":"[show]特意为了烧柴火选用较为干枯的边材，为制造斧柄选用新鲜而紧致的芯材……[r]你还挺有心的，小工匠。可惜，我不会支付约定条款之外的报酬。[l][cm]","nameSide":"left"}},{"key":"tag","para":{"tag":"tag_7"}},{"key":"text","para":{"charaName":"【樵夫萨契】","text":"[show]啊，没有嘲讽你的意思，只是感觉有点……意外。[r]这边的工匠整天粗制滥造，吃拿卡要，请他们做点事，像欠过他们几辈子钱一样。[r]我早做好这些材料没一份能用的准备了。[l][cm]","nameSide":"left"}},{"key":"tag","para":{"tag":"tag_8"}},{"key":"text","para":{"charaName":"【樵夫萨契】","text":"[show]要帮我组装斧头？哈哈，这也没写在契约书上。[r]不用你操心了，小兄弟。这点程度的粗活，不劳你们工匠灵巧的双手。[l][cm]","nameSide":"left"}},{"key":"tag","para":{"tag":"tag_9"}},{"key":"moveLayer","para":{"scaleX":1,"scaleY":1,"nonStandBright":false,"layer":"chara2","mirrow":false,"trans":true,"x":-95,"noOut":false,"y":-229,"timeBak":300,"noIn":true,"transTime":0,"bright":1,"img":"npc_911_04","alpha":1}},{"key":"text","para":{"charaName":"【樵夫萨契】","text":"[show]这是约好的报酬。[r]告诉我你的名字，下次的委托，我会指定你来做。[l][hide][cm]","nameSide":"left"}},{"key":"tag","para":{"tag":"tag_2"}},{"key":"moveLayer","para":{"scaleX":1,"scaleY":1,"layer":"chara2","mirrow":false,"trans":true,"x":-95,"noOut":false,"y":-229,"noIn":true,"transTime":300,"bright":1,"img":"npc_911_04","alpha":0}},{"key":"wait","para":{"time":300}},{"key":"moveLayer","para":{"scaleX":1,"scaleY":1,"nonStandBright":false,"layer":"bg","mirrow":false,"trans":false,"x":0,"noOut":false,"y":18,"timeBak":300,"noIn":false,"transTime":0,"bright":1,"img":"bgblack","alpha":0}},{"key":"text","para":{"charaName":"","text":"[hide]","nameSide":"left"}},{"key":"end","para":{"end":true}}],"script":"demo1101_3"}