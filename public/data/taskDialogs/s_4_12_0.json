{"script":"s_4_12_0","exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"nameSide":"left","charaName":"威格迪哆","text":"[show]你们！就是你们噗！老子是庄园的护卫，想请两位帮忙的噗！[l][cm]"},"key":"text"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"","layer":"bg","x":-500,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"setLayer"},{"para":{"noIn":false,"mirrow":false,"alpha":0.4,"addImg":"","layer":"bg","x":-500,"transTime":300,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"chara002_2_face_chara002_2d","layer":"chara2","x":340,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"setLayer"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2d","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]你这家伙怎么求人帮忙还这么嚣张啊。找我们是有什么事？[l][cm]"},"key":"text"},{"para":{"tag":"tag_4"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2d","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"威格迪哆","text":"[show]对不起的噗，老子从小说话就是这样的噗……说正事的噗，虽然目前还没有看见敌人，但是村外出现了可疑分子噗！[l][cm]"},"key":"text"},{"para":{"tag":"tag_5"},"key":"tag"},{"para":{"nameSide":"left","charaName":"威格迪哆","text":"[show]刚开始老子还想要驱逐那个家伙，但是看在那家伙老实听话的份上就没动手，不过那家伙还是太可疑了噗！[l]"},"key":"text"},{"para":{"tag":"tag_6"},"key":"tag"},{"para":{"options":[{"text":"太可疑了是指……","tag":"tag_7"}]},"key":"option"},{"para":{"tag":"tag_7"},"key":"tag"},{"para":{"nameSide":"left","charaName":"威格迪哆","text":"[show][cm]那家伙居然说自己远道而来，只是想要“喝一杯”的噗！世界上哪有这么奇怪的人噗！[l][cm]"},"key":"text"},{"para":{"tag":"tag_8"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2h","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2h","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]想喝一杯不是挺正常的吗？布拉格乌尔庄园的特色产品不就是蕈酵酿吗？[l][cm]"},"key":"text"},{"para":{"tag":"tag_9"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2h","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"威格迪哆","text":"[show]现在的黑森林这么封闭和危险，一个异族不远万里来到我们这个庄园只是为了喝一杯，怎么想都很奇怪吧噗！[l][cm]"},"key":"text"},{"para":{"tag":"tag_10"},"key":"tag"},{"para":{"nameSide":"left","charaName":"威格迪哆","text":"[show]不过咱们也不能就这么放松警惕了，所以我想拜托你们去问问话，确认一下那家伙的身份和想法噗。[l][cm]"},"key":"text"},{"para":{"tag":"tag_11"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2a","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2a","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]只是问问话那倒很简单，交给我们吧。[l][cm]"},"key":"text"},{"para":{"tag":"tag_12"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2a","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"威格迪哆","text":"[show]那就拜托了，她现在就在庄园外围，直接往那边去就好噗。[l][cm][hide]"},"key":"text"},{"para":{"tag":"tag_13"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"chara002_2_face_chara002_2a","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"","layer":"bg","x":-500,"transTime":300,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"","text":"[hide]"},"key":"text"},{"para":{"end":true},"key":"end"}],"des":"慕名而来的酒客-接取步骤"}