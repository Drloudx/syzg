{"des":"demo1101_1","exps":[{"key":"tag","para":{"tag":"tag_1"}},{"key":"top","para":{"layer":"chara2"}},{"key":"setLayer","para":{"scaleX":1,"scaleY":1,"layer":"bg","mirrow":false,"trans":false,"x":0,"noOut":false,"y":18,"noIn":false,"bright":1,"img":"bgblack","alpha":0}},{"key":"moveLayer","para":{"scaleX":1,"scaleY":1,"nonStandBright":false,"layer":"bg","mirrow":false,"trans":false,"x":0,"noOut":false,"y":18,"timeBak":300,"noIn":false,"transTime":0,"bright":1,"img":"bgblack","alpha":0}},{"key":"setLayer","para":{"scaleX":1,"scaleY":1,"layer":"chara2","mirrow":false,"trans":true,"x":-95,"noOut":true,"y":-229,"noIn":false,"bright":1,"img":"npc_911_04","alpha":0}},{"key":"moveLayer","para":{"scaleX":1,"scaleY":1,"layer":"chara2","mirrow":false,"trans":true,"x":-95,"noOut":true,"y":-229,"noIn":false,"transTime":300,"bright":1,"img":"npc_911_04","alpha":1}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"charaName":"【樵夫萨契】","text":"[show]你就是刚刚在旅店里闹腾的契约主？这么年轻，还是个人类工匠？办得成事吗？[r]既然有驿站的认可，那我也没什么意见。[l][cm]","nameSide":"left"}},{"key":"tag","para":{"tag":"tag_2"}},{"key":"moveLayer","para":{"scaleX":1,"scaleY":1,"nonStandBright":false,"layer":"chara2","mirrow":false,"trans":false,"x":-95,"noOut":false,"y":-229,"timeBak":300,"noIn":false,"transTime":0,"bright":1,"img":"npc_911_04","alpha":1}},{"key":"text","para":{"charaName":"【樵夫萨契】","text":"[show]总之，我刚劈完手里的柴，斧头柄也全坏了。[r]我需要柴火来劈，还得再修几把斧头，但我的学徒回了老家，我也不想一个人出门被那群黄毛怪咬断腿。[l][cm]","nameSide":"left"}},{"key":"tag","para":{"tag":"tag_3"}},{"key":"moveLayer","para":{"scaleX":1,"scaleY":1,"nonStandBright":false,"layer":"chara2","mirrow":false,"trans":true,"x":-95,"noOut":false,"y":-229,"timeBak":300,"noIn":true,"transTime":0,"bright":1,"img":"npc_911_04","alpha":1}},{"key":"text","para":{"charaName":"【樵夫萨契】","text":"[show]我要没柴劈，伙房就没得火烧，你们就只能每天啃生面疙瘩。[r]去驿站周边的区域，帮我找点深渊杨的木材来。这种木头虽然不经用，但胜在量多。[r]你先带给我[color=ff0000]10[colorEnd]份吧，我得先把斧头修好，再考虑柴火的事。[l][hide][cm]","nameSide":"left"}},{"key":"tag","para":{"tag":"tag_4"}},{"key":"moveLayer","para":{"scaleX":1,"scaleY":1,"layer":"chara2","mirrow":false,"trans":true,"x":-95,"noOut":false,"y":-229,"noIn":true,"transTime":300,"bright":1,"img":"npc_911_04","alpha":0}},{"key":"wait","para":{"time":300}},{"key":"moveLayer","para":{"scaleX":1,"scaleY":1,"nonStandBright":false,"layer":"bg","mirrow":false,"trans":false,"x":0,"noOut":false,"y":18,"timeBak":300,"noIn":false,"transTime":0,"bright":1,"img":"bgblack","alpha":0}},{"key":"text","para":{"charaName":"【樵夫萨契】","text":"[hide]","nameSide":"left"}},{"key":"end","para":{"end":true}}],"script":"demo1101_1"}