    },
    {
      "para": {
        "charaName": "卡夫",
        "text": "[show]唔！[wait=200]——喂喂！[wait=100]大哥……！[wait=300]我怎么一瞬间汗毛都竖起来了……！[l][cm]",
        "nameSide": "left"
      },
      "key": "text"
