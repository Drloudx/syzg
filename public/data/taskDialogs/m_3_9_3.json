a052_1_face_chara052_1e","y":-435,"mirrow":false,"x":560,"transTime":300,"scaleY":1,"bright":0.6},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"tag":"tag_22","text":"即使我不要求你证明自己的立场……"},{"tag":"tag_22","text":"至少你也该给我们一个解释。"}]},"key":"option"},{"para":{"tag":"tag_22"},"key":"tag"},{"para":{"options":[{"tag":"tag_23","text":"作为商会的合作者……"},{"tag":"tag_23","text":"你为什么要对付图洛德？"}]},"key":"option"},{"para":{"tag":"tag_23"},"key":"tag"},{"para":{"img":"chara052_1_face_chara052_1b","layer":"chara3"},"key":"setLayerFace"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara3","noOut":false,"img":"chara052_1","noIn":false,"addImg":"chara052_1_face_chara052_1b","y":-435,"mirrow":false,"x":560,"transTime":300,"scaleY":1,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"塞弗德里克","text":"[cm][show]为什么？这当然是因为我心中的正义感啦——呵，这当然是说笑的。[l][cm]"},"key":"text"},{"para":{"tag":"tag_24"},"key":"tag"},{"para":{"img":"chara052_1_face_chara052_1c","layer":"chara3"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"塞弗德里克","text":"[show]图洛德那个家伙……实在是太危险了。[l][cm]"},"key":"text"},{"para":{"tag":"tag_25"},"key":"tag"},{"para":{"img":"chara052_1_face_chara052_1a","layer":"chara3"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"塞弗德里克","text":"[show]现在所有人都无法离开深渊。你不会以为，我会把性命寄托在一个疯子的理智上吧？[l][cm]"},"key":"text"},{"para":{"tag":"tag_26"},"key":"tag"},{"para":{"alpha":0,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"img":"chara051_1","noIn":false,"addImg":"chara051_1_face_chara051_1h","y":-304,"mirrow":true,"x":-220,"transTime":300,"scaleY":1,"bright":0.6},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"alpha":0,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"img":"chara036_1","noIn":false,"addImg":"chara036_1_face_chara036_1f","y":-218,"mirrow":true,"x":-93,"scaleY":1,"bright":1},"key":"setLayer"},{"para":{"alpha":1,"scaleX"