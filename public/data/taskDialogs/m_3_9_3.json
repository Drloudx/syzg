LayerFace"},{"para":{"nameSide":"left","charaName":"塞弗德里克","text":"[show]如果我们不想把所有人都干掉，对整个湖区进行残酷统治，我们就必须先瓦解他的人望，而这就需要[color=f1401c]确凿的罪证[colorEnd]，让我们可以在击败他之后，揭发他的罪行。[l][cm]"},"key":"text"},{"para":{"tag":"tag_38"},"key":"tag"},{"para":{"alpha":0,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"img":"chara051_1","noIn":false,"addImg":"chara051_1_face_chara051_1h","y":-304,"mirrow":true,"x":-220,"transTime":300,"scaleY":1,"bright":0.6},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"alpha":0,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"img":"chara002_2","noIn":false,"addImg":"chara002_2_face_chara002_2k","y":-180,"mirrow":false,"x":50,"scaleY":1,"bright":1},"key":"setLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"img":"chara002_2","noIn":false,"addImg":"chara002_2_face_chara002_2k","y":-180,"mirrow":false,"x":50,"transTime":300,"scaleY":1,"bright":1},"key":"moveLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara3","noOut":false,"img":"chara052_1","noIn":false,"addImg":"chara052_1_face_chara052_1c","y":-435,"mirrow":false,"x":560,"transTime":300,"scaleY":1,"bright":0.6},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]但是这个确凿的罪证……要从哪儿搞到手呢？[l][cm]"},"key":"text"},{"para":{"tag":"tag_39"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"img":"chara002_2","noIn":false,"addImg":"chara002_2_face_chara002_2k","y":-180,"mirrow":false,"x":50,"transTime":300,"scaleY":1,"bright":0.6},"key":"moveLayer"},{"para":{"img":"chara052_1_face_chara052_1a","layer":"chara3"},"key":"setLayerFace"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara3","noOut":false,"img":"chara052_1","noIn":false,"addImg":"chara052_1_face_chara052_1a","y":-435,"mirrow":false,"x":560,"transTime":300,"scaleY":1,"bright":1},"key":"moveLayer"},