      "key": "text"
    },
    {
      "para": {
        "charaName": "希尔",
        "nameSide": "left",
        "text": "[show]（原来这里也有这么大的村落啊……）[l][cm]"
      },
      "key": "text"
    },
    {
      "para": {
        "charaName": "米托拉",
        "nameSide": "right",
