      "key": "text"
    },
    {
      "para": {
        "charaName": "琳娜",
        "nameSide": "left",
        "text": "[show]我得先处理货物的事情，随后就去和他们说明情况。[r]两位可以先稍事休息一会，之后去旅店里找“契约官”吧！[l][cm]"
      },
      "key": "text"
    },
    {
      "para": {
        "charaName": "希尔",
