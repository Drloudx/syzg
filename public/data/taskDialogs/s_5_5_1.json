"noIn":false,"scaleX":1,"layer":"chara3","img":"chara053_1","transTime":300,"x":510,"y":-416,"bright":0.6,"mirrow":false,"trans":true,"noOut":false,"scaleY":1}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"nameSide":"left","text":"[show]呃……我们是从外面来的契约者，来拜访你是因为……那个……因为……[l]","charaName":"米托拉"}},{"key":"tag","para":{"tag":"tag_5"}},{"key":"moveLayer","para":{"addImg":"chara002_2_face_chara002_2q","alpha":1,"noIn":false,"scaleX":1,"layer":"chara1","img":"chara002_2","transTime":300,"x":50,"y":-180,"bright":0.6,"mirrow":false,"trans":true,"noOut":false,"scaleY":1}},{"key":"wait","para":{"time":300}},{"key":"option","para":{"options":[{"tag":"tag_6","text":"我们是热心的外来者！"},{"tag":"tag_6","text":"愿意帮助一切遇到麻烦的人！"}]}},{"key":"tag","para":{"tag":"tag_6"}},{"key":"top","para":{"layer":"chara3"}},{"key":"setLayerFace","para":{"img":"chara053_1_face_chara053_1h","layer":"chara3"}},{"key":"moveLayer","para":{"addImg":"chara053_1_face_chara053_1h","alpha":1,"noIn":false,"scaleX":1,"layer":"chara3","img":"chara053_1","transTime":300,"x":510,"y":-416,"bright":1,"mirrow":false,"trans":true,"noOut":false,"scaleY":1}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"nameSide":"left","text":"[cm][show]是的……就是……就是这么回事。请问……你遇到什么麻烦了吗？[l][cm]","charaName":"艾薇杜尔"}},{"key":"tag","para":{"tag":"tag_7"}},{"key":"moveLayer","para":{"addImg":"chara053_1_face_chara053_1h","alpha":1,"noIn":false,"scaleX":1,"layer":"chara3","img":"chara053_1","transTime":300,"x":510,"y":-416,"bright":0.6,"mirrow":false,"trans":true,"noOut":false,"scaleY":1}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"nameSide":"left","text":"[show]…………[l][cm]","charaName":"文艺系学生阿莱琳娜"}},{"key":"tag","para":{"tag":"tag_8"}},{"key":"text","para":{"nameSide":"left","text":"[show]哎呀呀，几位不必紧张嘛。先自我介绍一下，我叫阿莱琳娜，是文艺系的学生。[l][cm]","charaName":"文艺系学生阿莱琳娜"}},{"key":"tag","para":{"tag":"tag_9"}},{"key":"text","para":{"nameSide":"left","text":"[show]两位要说麻烦的话……眼下我确实遇到一个不小的麻烦，恐怕还需要两位帮忙才能解决。[l][cm]","charaName":"文艺系学生阿莱琳娜"}},{"key":"tag","para":{"tag":"tag_10"}},{"key":"text","para":{"nameSide":"left","text":"[show]两位外来者经历一路风雪，不远万里来到这里，想必身心已经非常疲惫。你们现在一定很需要有人，来好好安抚你们疲惫的身躯和心灵吧。[l][cm]","charaName":"文艺系学生阿莱琳娜"}},{"key":"tag","para":{"tag":"tag_11"}},{"key":"text","para":{"nameSide":"left","text":"[show]阿莱琳娜……正好也觉得有些寂寞呢，还希望有人能来陪陪我……[l][cm]","charaName":"文艺系学生阿莱琳娜"}},{"key":"tag","para":{"tag":"tag_12"}},{"key":"top","para":{"layer":"chara1"}},{"key":"setLayerFace","para":{"img":"chara002_2_face_chara002_2p","layer":"chara1"}},{"key":"moveLayer","para":{"addImg":"chara002_2_face_chara002_2p","alpha":1,"noIn":false,"scaleX":1,"layer":"chara1","img":"chara002_2","transTime":300,"x":50,"y":-180,"bright":1,"mirrow":false,"trans":true,"noOut":false,"scaleY":1}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"nameSide":"left","text":"[show]（喵呜！这……这种感觉！鸡皮疙瘩都起来了！{myName}，这是什么情况啊？）[l]","charaName":"米托拉"}},{"key":"tag","para":{"tag":"tag_13"}},{"key":"moveLayer","para":{"addImg":"chara002_2_face_chara002_2p","alpha":1,"noIn":false,"scaleX":1,"layer":"chara1","img":"chara002_2","transTime":300,"x":50,"y":-180,"bright":0.6,"mirrow":false,"trans":true,"noOut":false,"scaleY":1}},{"key":"wait","para":{"time":300}},{"key":"option","para":{"options":[{"tag":"tag_14","text":"我们也很寂寞！"},{"tag":"tag_14","text":"我们想和这里的学生一起学习！"}]}},{"key":"tag","para":{"tag":"tag_14"}},{"key":"setLayerFace","para":{"img":"chara002_2_face_chara002_2c","layer":"chara1"}},{"key":"moveLayer","para":{"addImg":"chara002_2_face_chara002_2c","alpha":1,"noIn":false,"scaleX":1,"layer":"chara1","img":"chara002_2","transTime":300,"x":50,"y":-180,"bright":1,"mirrow":false,"trans":true,"noOut":false,"scaleY":1}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"nameSide":"left","text":"[cm][show]（{myName}？！你怎么——喔，又是顺着对方的话套取情报的那种手段吧？我知道了啦……）[l][cm]","charaName":"米托拉"}},{"key":"tag","para":{"tag":"tag_15"}},{"key":"moveLayer","para":{"addImg":"chara002_2_face_chara002_2c","alpha":1,"noIn":false,"scaleX":1,"layer":"chara1",