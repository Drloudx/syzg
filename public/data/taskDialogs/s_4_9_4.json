{"script":"s_4_9_4","exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"nameSide":"left","charaName":"学者里恩尼菈","text":"[show]病人？可我只是一个学者啊，难道那个病人有什么特殊的情况吗？[l]"},"key":"text"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"options":[{"text":"（告知软软的情况。）","tag":"tag_3"}]},"key":"option"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"nameSide":"left","charaName":"学者里恩尼菈","text":"[show][cm]哦？生病的魔物？这倒是稀罕……不过你们说的情况，我大概明白是什么原因了。[l][cm]"},"key":"text"},{"para":{"tag":"tag_4"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"","layer":"bg","x":-500,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"setLayer"},{"para":{"noIn":false,"mirrow":false,"alpha":0.4,"addImg":"","layer":"bg","x":-500,"transTime":300,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"tag":"tag_5"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"chara002_2_face_chara002_2d","layer":"chara2","x":340,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"setLayer"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2d","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]到底是什么原因呢？[l][cm]"},"key":"text"},{"para":{"tag":"tag_6"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2d","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"学者里恩尼菈","text":"[show]布拉格乌尔庄园有很多蕈人常驻，所以这片区域的空气中弥漫着大量的孢子簇。这些含有魔力的孢子簇或多或少会影响来到这里的人，我想软软生病的原因可能就是这个。[l][cm]"},"key":"text"},{"para":{"tag":"tag_7"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2e","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2e","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]孢子簇……这么说每次来到庄园，我都会有种被什么东西黏上的感觉，现在想想可能就是孢子簇导致的，不过我们怎么没事？[l][cm]"},"key":"text"},{"para":{"tag":"tag_8"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2e","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"学者里恩尼菈","text":"[show]每个人每个魔物的敏感程度都会不同。你们说的魔物生病，应该也是一种“过敏”反应。只不过它打出的喷嚏都是火焰罢了。[l]"},"key":"text"},{"para":{"tag":"tag_9"},"key":"tag"},{"para":{"options":[{"text":"原来如此……","tag":"tag_10"},{"text":"有什么医治它的办法吗？","tag":"tag_10"}]},"key":"option"},{"para":{"tag":"tag_10"},"key":"tag"},{"para":{"nameSide":"left","charaName":"学者里恩尼菈","text":"[show][cm]具体的原因我可能还得去巨木那边看看。不过肯定病因肯定就是那些含有魔力的孢子簇。[l][cm]"},"key":"text"},{"para":{"tag":"tag_11"},"key":"tag"},{"para":{"nameSide":"left","charaName":"学者里恩尼菈","text":"[show]这样吧，你们可以找 3 个硫磺吗？我有个用硫磺做配方的粉剂，有脱敏的作用，说不定可以治好它。[l][cm]"},"key":"text"},{"para":{"tag":"tag_12"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2a","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2a","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]3 个硫磺是吗？好，交给我们吧。[l][cm]"},"key":"text"},{"para":{"tag":"tag_13"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2a","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"学者里恩尼菈","text":"[show]好，一会在巨木那边见。[l][cm][hide]"},"key":"text"},{"para":{"tag":"tag_14"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"chara002_2_face_chara002_2a","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"addImg":"","layer":"bg","x":-500,"transTime":300,"y":-125,"scaleX":1.5,"trans":true,"bright":1,"noOut":false,"img":"bgblack","scaleY":1.5},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"","text":"[hide]"},"key":"text"},{"para":{"end":true},"key":"end"}],"des":"我们这边遇到了一个病人。"}