{"exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":0,"scaleX":0.9,"trans":true,"layer":"chara3","noOut":false,"noIn":false,"bright":1,"scaleY":0.9,"x":650,"mirrow":false,"y":-406.4000000000001,"img":"chara003_1","addImg":"chara003_1_face_chara003_1e"},"key":"setLayer"},{"para":{"alpha":1,"scaleX":0.9,"trans":true,"layer":"chara3","noOut":false,"noIn":false,"bright":1,"transTime":300,"scaleY":0.9,"x":650,"mirrow":false,"y":-406.4000000000001,"img":"chara003_1","addImg":"chara003_1_face_chara003_1e"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"菲尔德蕾","text":"[show]你们问我在大兽潮发生前，有没有见过米托拉？[l][cm]"},"key":"text"},{"para":{"tag":"tag_4"},"key":"tag"},{"para":{"layer":"chara3","img":"chara003_1_face_chara003_1b"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"菲尔德蕾","text":"[show]这可真是个有趣的问题。[l][cm]"},"key":"text"},{"para":{"tag":"tag_5"},"key":"tag"},{"para":{"layer":"chara3","img":"chara003_1_face_chara003_1e"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"菲尔德蕾","text":"[show]按理来说，像米托拉这样的高手，如果见过的话，我应该是不会忘记的。[l][cm]"},"key":"text"},{"para":{"tag":"tag_6"},"key":"tag"},{"para":{"nameSide":"left","charaName":"菲尔德蕾","text":"[show]但大兽潮之前那段时间，正是驿站最混乱的时候……如果说忽略了某些生面孔，倒也不是没有可能……[l]"},"key":"text"},{"para":{"tag":"tag_7"},"key":"tag"},{"para":{"alpha":1,"scaleX":0.9,"trans":true,"layer":"chara3","noOut":false,"noIn":false,"bright":0.6,"transTime":300,"scaleY":0.9,"x":650,"mirrow":false,"y":-406.4000000000001,"img":"chara003_1","addImg":"chara003_1_face_chara003_1e"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"text":"（试着描述记忆中的场景。）","tag":"tag_8"}]},"key":"option"},{"para":{"tag":"tag_8"},"key":"tag"},{"para":{"alpha":1,"scaleX":0.9,"trans":true,"layer":"chara3","noOut":false,"noIn":false,"bright":1,"transTime":300,"scaleY":0.9,"x":650,"mirrow":false,"y":-406.4000000000001,"img":"chara003_1","addImg":"chara003_1_face_chara003_1e"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"菲尔德蕾","text":"[cm][show]你说……当一名女孩问及艾尔莎有无异状的时候，我冲了进来，说“大兽潮”即将来临……[l][cm]"},"key":"text"},{"para":{"tag":"tag_9"},"key":"tag"},{"para":{"nameSide":"left","charaName":"菲尔德蕾","text":"[show]没错，这的确是哈萨琳大人下达命令的那天，我有一些印象。[r]说起来，艾尔莎和迦南的确提到，那天好像是有一个客人，口中念念有词……[l][cm]"},"key":"text"},{"para":{"tag":"tag_10"},"key":"tag"},{"para":{"nameSide":"left","charaName":"菲尔德蕾","text":"[show]但那之后，确如哈萨琳大人所说，大兽潮很快就降临了；我们也都没去细想什么。[l][cm]"},"key":"text"},{"para":{"tag":"tag_11"},"key":"tag"},{"para":{"nameSide":"left","charaName":"菲尔德蕾","text":"[show]抱歉……你描述的那个场景，具体的细节我实在是想不起来。[r]但我可以确定，那人并非米托拉的模样，否则艾尔莎和迦南也不会视草原的米托拉如无睹。[l][cm]"},"key":"text"},{"para":{"tag":"tag_12"},"key":"tag"},{"para":{"nameSide":"left","charaName":"菲尔德蕾","text":"[show]说起来，你们为什么会知道有这件事？[l][cm]"},"key":"text"},{"para":{"tag":"tag_13"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"alpha":1,"scaleX":0.9,"trans":true,"layer":"chara3","noOut":false,"noIn":false,"bright":0.6,"transTime":300,"scaleY":0.9,"x":650,"mirrow":false,"y":-406.4000000000001,"img":"chara003_1","addImg":"chara003_1_face_chara003_1e"},"key":"moveLayer"},{"para":{"alpha":0,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"noIn":false,"bright":1,"scaleY":1,"x":50,"mirrow":false,"y":-180,"img":"chara002_2","addImg":"chara002_2_face_chara002_2c"},"key":"setLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"noIn":false,"bright":1,"transTime":300,"scaleY":1,"x":50,"mirrow":false,"y":-180,"img":"chara002_2","addImg":"chara002_2_face_chara002_2c"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]啊？这个嘛……[l]"},"key":"text"},{"para":{"tag":"tag_14"},"key":"tag"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"noIn":false,"bright":0.6,"transTime":300,"scaleY":1,"x":50,"mirrow":false,"y":-180,"img":"chara002_2","addImg":"chara002_2_face_chara002_2c"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"text":"其实事情是这样的……","tag":"tag_15"},{"text":"我们从记忆中得到了一些情报……","tag":"tag_15"}]},"key":"option"},{"para":{"tag":"tag_15"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"alpha":1,"scaleX":0.9,"trans":true,"layer":"chara3","noOut":false,"noIn":false,"bright":1,"transTime":300,"scaleY":0.9,"x":650,"mirrow":false,"y":-406.4000000000001,"img":"chara003_1","addImg":"chara003_1_face_chara003_1e"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"菲尔德蕾","text":"[cm][show]居然能够从魔力之中直接提取记忆？莉拉首座那边还真是搞出了了不得的玩意啊。[l][cm]"},"key":"text"},{"para":{"tag":"tag_16"},"key":"tag"},{"para":{"nameSide":"left","charaName":"菲尔德蕾","text":"[show]很抱歉，没能帮上你们。自那天哈萨琳大人下达了命令，整座深渊都进入了战备状态。[r]随后来临的，便是和魔物们旷日持久的战乱。[r]深渊住民们自那天起，就被刻上了永恒的伤痕。[l][cm]"},"key":"text"},{"para":{"tag":"tag_17"},"key":"tag"},{"para":{"layer":"chara3","img":"chara003_1_face_chara003_1b"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"菲尔德蕾","text":"[show]不过，如果你们还有其它的线索，可以随时过来找我。[r]只要我知道的事情，我一定对你们知无不言、言无不尽。[l]"},"key":"text"},{"para":{"tag":"tag_18"},"key":"tag"},{"para":{"alpha":1,"scaleX":0.9,"trans":true,"layer":"chara3","noOut":false,"noIn":false,"bright":0.6,"transTime":300,"scaleY":0.9,"x":650,"mirrow":false,"y":-406.4000000000001,"img":"chara003_1","addImg":"chara003_1_face_chara003_1b"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"text":"那就多谢老板了。","tag":"tag_19"}]},"key":"option"},{"para":{"tag":"tag_19"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"layer":"chara1","img":"chara002_2_face_chara002_2b"},"key":"setLayerFace"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"noIn":false,"bright":1,"transTime":300,"scaleY":1,"x":50,"mirrow":false,"y":-180,"img":"chara002_2","addImg":"chara002_2_face_chara002_2b"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[cm][show]谢谢老板，老板大气！[l][cm]"},"key":"text"},{"para":{"tag":"tag_20"},"key":"tag"},{"para":{"alpha":0,"scaleX":0.9,"trans":true,"layer":"chara3","noOut":false,"noIn":false,"bright":1,"transTime":600,"scaleY":0.9,"x":850,"mirrow":false,"y":-406.4000000000001,"img":"chara003_1","addImg":"chara003_1_face_chara003_1b"},"key":"moveLayer"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"noIn":false,"bright":0.6,"transTime":600,"scaleY":1,"x":340,"mirrow":false,"y":-180,"img":"chara002_2","addImg":"chara002_2_face_chara002_2b"},"key":"moveLayer"},{"para":{"time":600},"key":"wait"},{"para":{"tag":"tag_21"},"key":"tag"},{"para":{"alpha":0,"scaleX":0.9,"trans":true,"layer":"chara3","noOut":false,"noIn":false,"bright":1,"transTime":600,"scaleY":0.9,"x":850,"mirrow":false,"y":-406.4000000000001,"img":"chara003_1","addImg":"chara003_1_face_chara003_1b"},"key":"moveLayer"},{"para":{"time":600},"key":"wait"},{"para":{"layer":"chara1","img":"chara002_2_face_chara002_2e"},"key":"setLayerFace"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"noIn":false,"bright":1,"transTime":300,"scaleY":1,"x":340,"mirrow":false,"y":-180,"img":"chara002_2","addImg":"chara002_2_face_chara002_2e"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]唉，看来这边也没什么头绪，我们接下来怎么办？[l]"},"key":"text"},{"para":{"tag":"tag_22"},"key":"tag"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"noIn":false,"bright":0.6,"transTime":300,"scaleY":1,"x":340,"mirrow":false,"y":-180,"img":"chara002_2","addImg":"chara002_2_face_chara002_2e"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"text":"她不像在骗我们。","tag":"tag_23"},{"text":"但我也想不明白为什么。","tag":"tag_23"}]},"key":"option"},{"para":{"tag":"tag_23"},"key":"tag"},{"para":{"options":[{"text":"只能把疑问暂时搁置起来了。","tag":"tag_24"}]},"key":"option"},{"para":{"tag":"tag_24"},"key":"tag"},{"para":{"layer":"chara1","img":"chara002_2_face_chara002_2a"},"key":"setLayerFace"},{"para":{"alpha":1,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"noIn":false,"bright":1,"transTime":300,"scaleY":1,"x":340,"mirrow":false,"y":-180,"img":"chara002_2","addImg":"chara002_2_face_chara002_2a"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[cm][show]嗯，我想也是。既然没什么事要做，那我们就快点回去吧！[l][cm]"},"key":"text"},{"para":{"tag":"tag_25"},"key":"tag"},{"para":{"layer":"chara1","img":"chara002_2_face_chara002_2b"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]昨天睡得那么差，我还想赶紧补一觉呢！[l][cm][hide]"},"key":"text"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"alpha":0,"scaleX":1,"trans":true,"layer":"chara1","noOut":false,"noIn":false,"bright":1,"transTime":300,"scaleY":1,"x":340,"mirrow":false,"y":-180,"img":"chara002_2","addImg":"chara002_2_face_chara002_2b"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"nameSide":"left","charaName":"","text":"[hide]"},"key":"text"},{"para":{"end":true},"key":"end"}],"des":"（询问关于回忆的事。）","script":"m_1_12_5"}