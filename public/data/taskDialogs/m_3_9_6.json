Time":300,"alpha":1,"scaleX":1,"trans":true,"noOut":false,"addImg":"chara051_1_face_chara051_1h","noIn":false,"x":-220,"img":"chara051_1","scaleY":1,"bright":1,"layer":"chara1","y":-304,"mirrow":true},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"text":"[cm][show]史莱姆的黏液可能不至于用1700个桶来装吧……[l][cm]","charaName":"阿莱克西娅","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_12"},"key":"tag"},{"para":{"img":"chara051_1_face_chara051_1g","layer":"chara1"},"key":"setLayerFace"},{"para":{"text":"[show]一般来说，是液体，同时也需要用这么多桶来运输的物资，也就只有水、油这类。[l][cm]","charaName":"阿莱克西娅","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_13"},"key":"tag"},{"para":{"text":"[show]而为了节水，目前的湖区没有任何酿造业存在。而同时，这一带也完全没有种植油料作物的空间。[l]","charaName":"阿莱克西娅","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_15"},"key":"tag"},{"para":{"transTime":300,"alpha":1,"scaleX":1,"trans":true,"noOut":false,"addImg":"chara051_1_face_chara051_1g","noIn":false,"x":-220,"img":"chara051_1","scaleY":1,"bright":0.6,"layer":"chara1","y":-304,"mirrow":true},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"text":"会是从外地输入的吗？","tag":"tag_16"}]},"key":"option"},{"para":{"tag":"tag_16"},"key":"tag"},{"para":{"transTime":300,"alpha":1,"scaleX":1,"trans":true,"noOut":false,"addImg":"chara051_1_face_chara051_1g","noIn":false,"x":-220,"img":"chara051_1","scaleY":1,"bright":1,"layer":"chara1","y":-304,"mirrow":true},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"text":"[cm][show]很遗憾，这是不可能的。[l][cm]","charaName":"阿莱克西娅","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_17"},"key":"tag"},{"para":{"text":"[show]湖区的商路受到富魔水的影响，跑商的商人和货车必须加持防水符咒，因此商人们普遍会选择价值更高的香料、金属等商品，而不会选择单价较低的大宗货物。[l]","charaName":"阿莱克西娅","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_18"},"key":"tag"},{"para":{"transTime":300,"alpha":1,"scaleX":1,"trans":true,"noOut":false,"addImg":"chara051_1_face_chara051_1g","noIn":false,"x":-220,"img":"chara051_1","scaleY":1,"bright":0.6,"layer":"chara1","y":-304,"mirrow":true},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"text":"原来如此。答案就很显然了。","tag":"tag_19"}]},"key":"option"},{"para":{"tag":"tag_19"},"key":"tag"},{"para":{"transTime":300,"alpha":1,"scaleX":1,"trans":true,"noOut":false,"addImg":"chara051_1_face_chara051_1g","noIn":false,"x":-220,"img":"chara051_1","scaleY":1,"bright":1,"layer":"chara1","y":-304,"mirrow":true},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"text":"[cm][show]是的，经过排除之后，我认为“水”就是最有可能的答案。[l][cm]","charaName":"阿莱克西娅","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_20"},"key":"tag"},{"para":{"text":"[show]富魔水因为富含紊乱魔素，既无法饮用，也难以作为魔法素材，况且湖泊周围大小水塘满处都是，根本不需要特地装车运输。[l][cm]","charaName":"阿莱克西娅","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_21"},"key":"tag"},{"para":{"text":"[show]也就是说，会被装在水桶里的“水”……[l]","charaName":"阿莱克西娅","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_22"},"key":"tag"},{"para":{"transTime":300,"alpha":1,"scaleX":1,"trans":true,"noOut":false,"addImg":"chara051_1_face_chara051_1g","noIn":false,"x":-220,"img":"chara051_1","scaleY":1,"bright":0.6,"layer":"chara1","y":-304,"mirrow":true},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"text":"是有使用价值的水。","tag":"tag_23"},{"text":"是经过净水仪式的水。","tag":"tag_23"}]},"key":"option"},{"para":{"tag":"tag_23"},"key":"tag"},{"para":{"transTime":300,"alpha":1,"scaleX":1,"trans":true,"noOut":false,"addImg":"chara051_1_face_chara051_1g","noIn":false,"x":-220,"img":"chara051_1","scaleY":1,"bright":1,"layer":"chara1","y":-304,"mirrow":true},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"text":"[cm][show]是的，如果水桶里运送的都是无魔净水，那么两个门的输入量，就非常奇怪了。[l][cm]","charaName":"阿莱克西娅","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_24"},"key":"tag"},{"para":{"text":"[show]湖区目前所有的净水，都是由我们进行净水仪式产生的。运输方向是从[color=ffb64d]尾指村运往大市集[colorEnd]，这样就会经过大市集的“[color=ffb64d]北门[colorEnd]”！[l]","charaName":"阿莱克西娅","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_25"},"key":"tag"},{"para":{"transTime":300,"alpha":1,"scaleX":1,"trans":true,"noOut":false,"addImg":"chara051_1_face_chara051_1g","noIn":false,"x":-220,"img":"chara051_1","scaleY":1,"bright":0.6,"layer":"chara1","y":-304,"mirrow":true},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"text":"但东南门的输入量却是北门的数倍之多！","tag":"tag_26"}]},"key":"option"},{"para":{"tag":"tag_26"},"key":"tag"},{"para":{"transTime":300,"alpha":1,"scaleX":1,"trans":true,"noOut":false,"addImg":"chara051_1_face_chara051_1g","noIn":false,"x":-220,"img":"chara051_1","scaleY":1,"bright":1,"layer":"chara1","y":-304,"mirrow":true},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"text":"[cm][show]是的，这就是问题所在。[l][cm]","charaName":"阿莱克西娅","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_27"},"key":"tag"},{"para":{"text":"[show]无论原因是什么，更多的净水，居然是从“[color=ffb64d]南边[colorEnd]”输入……这显然是不合理的。[l][cm]","charaName":"阿莱克西娅","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_28"},"key":"tag"},{"para":{"text":"[show]因此我怀疑，从南门延伸出去的那条断头路所指向的，更远方的魔爪湖深处……就藏匿着图洛德想隐瞒的秘密！[l][cm]","charaName":"阿莱克西娅","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_29"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"transTime":300,"alpha":1,"scaleX":1,"trans":true,"noOut":false,"addImg":"chara051_1_face_chara051_1g","noIn":false,"x":-220,"img":"chara051_1","scaleY":1,"bright":0.6,"layer":"chara1","y":-304,"mirrow":true},"key":"moveLayer"},{"para":{"alpha":0,"scaleX":1,"trans":true,"noOut":false,"addImg":"chara041_1_face_chara041_1c","noIn":false,"x":588,"img":"chara041_1","scaleY":1,"bright":1,"layer":"chara3","y":-325,"mirrow":false},"key":"setLayer"},{"para":{"transTime":300,"alpha":1,"scaleX":1,"trans":true,"noOut":false,"addImg":"chara041_1_face_chara041_1c","noIn":false,"x":588,"img":"chara041_1","scaleY":1,"bright":1,"layer":"chara3","y":-325,"mirrow":false},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"text":"[show]不可能！图洛德是水商商会的会长，也是湖区所有民众公推的领袖。无论他想做什么，在大市集难道还有做不到的吗？[l][cm]","c