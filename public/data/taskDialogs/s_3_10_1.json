{"script":"s_3_10_1","des":"前往尾指村，询问水占师阿拉迪尔关于笔记本的下落。","exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"nameSide":"left","charaName":"阿拉迪尔","text":"[show]哦，原来如此，你们是从大市集那边来的啊，想要找回那个治安官丢失的笔记本。[l][cm]"},"key":"text"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"nameSide":"left","charaName":"阿拉迪尔","text":"[show]我的确知道那个笔记本的下落。但是尾指村这边现在遇到了困难，我们手上的魔水凝晶储量不够了。如果想知道笔记本的下落，我希望你们能帮一下我们。[l][cm]"},"key":"text"},{"para":{"tag":"tag_4"},"key":"tag"},{"para":{"nameSide":"left","charaName":"阿拉迪尔","text":"[show]可能这种落井下石的要求有点过分……但请见谅，我也有我的理由。[l][cm]"},"key":"text"},{"para":{"tag":"tag_5"},"key":"tag"},{"para":{"alpha":0,"scaleX":1.5,"layer":"bg","img":"bgblack","mirrow":false,"x":-500,"trans":true,"y":-125,"noOut":false,"addImg":"","scaleY":1.5,"noIn":false,"bright":1},"key":"setLayer"},{"para":{"alpha":0.4,"scaleX":1.5,"layer":"bg","img":"bgblack","mirrow":false,"transTime":300,"x":-500,"trans":true,"y":-125,"noOut":false,"addImg":"","scaleY":1.5,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"alpha":0,"scaleX":1,"layer":"chara2","img":"chara002_2","mirrow":false,"x":340,"trans":true,"y":-180,"noOut":false,"addImg":"chara002_2_face_chara002_2a","scaleY":1,"noIn":false,"bright":1},"key":"setLayer"},{"para":{"alpha":1,"scaleX":1,"layer":"chara2","img":"chara002_2","mirrow":false,"transTime":300,"x":340,"trans":true,"y":-180,"noOut":false,"addImg":"chara002_2_face_chara002_2a","scaleY":1,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]倒是没关系。就当是交易嘛，能为尾指村做点事也不错。[l][cm]"},"key":"text"},{"para":{"tag":"tag_6"},"key":"tag"},{"para":{"alpha":0,"scaleX":1,"layer":"chara2","img":"chara002_2","mirrow":false,"transTime":300,"x":340,"trans":true,"y":-180,"noOut":false,"addImg":"chara002_2_face_chara002_2a","scaleY":1,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"alpha":0,"scaleX":1.5,"layer":"bg","img":"bgblack","mirrow":false,"transTime":300,"x":-500,"trans":true,"y":-125,"noOut":false,"addImg":"","scaleY":1.5,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿拉迪尔","text":"[show]那太好了。身为村外人，你们还真是挺热情的。说回正题，我需要你们给我带[color=f1401c]５个魔水凝晶[colorEnd]回来，能做到吗？[l][cm]"},"key":"text"},{"para":{"tag":"tag_7"},"key":"tag"},{"para":{"alpha":0,"scaleX":1.5,"layer":"bg","img":"bgblack","mirrow":false,"x":-500,"trans":true,"y":-125,"noOut":false,"addImg":"","scaleY":1.5,"noIn":false,"bright":1},"key":"setLayer"},{"para":{"alpha":0.4,"scaleX":1.5,"layer":"bg","img":"bgblack","mirrow":false,"transTime":300,"x":-500,"trans":true,"y":-125,"noOut":false,"addImg":"","scaleY":1.5,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"alpha":0,"scaleX":1,"layer":"chara2","img":"chara002_2","mirrow":false,"x":340,"trans":true,"y":-180,"noOut":false,"addImg":"chara002_2_face_chara002_2b","scaleY":1,"noIn":false,"bright":1},"key":"setLayer"},{"para":{"alpha":1,"scaleX":1,"layer":"chara2","img":"chara002_2","mirrow":false,"transTime":300,"x":340,"trans":true,"y":-180,"noOut":false,"addImg":"chara002_2_face_chara002_2b","scaleY":1,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]没关系，这就交给我们吧。[l][cm]"},"key":"text"},{"para":{"tag":"tag_8"},"key":"tag"},{"para":{"alpha":0,"scaleX":1,"layer":"chara2","img":"chara002_2","mirrow":false,"transTime":300,"x":340,"trans":true,"y":-180,"noOut":false,"addImg":"chara002_2_face_chara002_2b","scaleY":1,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"alpha":0,"scaleX":1.5,"layer":"bg","img":"bgblack","mirrow":false,"transTime":300,"x":-500,"trans":true,"y":-125,"noOut":false,"addImg":"","scaleY":1.5,"noIn":false,"bright":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"阿拉迪尔","text":"[show]行，那就拜托你们了。[l][cm][hide]"},"key":"text"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"end":true},"key":"end"}]}