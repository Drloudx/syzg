14"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2d","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"小幽灵","text":"[show]……[l][cm]"},"key":"text"},{"para":{"tag":"tag_15"},"key":"tag"},{"para":{"nameSide":"left","charaName":"小幽灵","text":"[show]好……好吃……当年妈妈给我做的鲜汤……就是这个味道！[l][cm]"},"key":"text"},{"para":{"tag":"tag_16"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2c","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2c","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]咦，他怎么……[l][cm]"},"key":"text"},{"para":{"tag":"tag_17"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2c","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"幽灵雅拉德","text":"[show]好像是恢复神智了。我们出去看看吧。[l][cm]"},"key":"text"},{"para":{"tag":"tag_18"},"key":"tag"},{"para":{"nameSide":"left","charaName":"巨木侍女阿碧约格","text":"[show]那……好吧……我们出去看看……[l][cm]"},"key":"text"},{"para":{"tag":"tag_19"},"key":"tag"},{"para":{"nameSide":"left","charaName":"","text":"[show]（从草丛中钻出。）[l][cm]"},"key":"text"},{"para":{"tag":"tag_20"},"key":"tag"},{"para":{"nameSide":"left","charaName":"小幽灵","text":"[show]你们？你们是……[l]"},"key":"text"},{"para":{"tag":"tag_21"},"key":"tag"},{"para":{"options":[{"text":"（解释身份和发生的事情。）","tag":"tag_22"}]},"key":"option"},{"para":{"tag":"tag_22"},"key":"tag"},{"para":{"nameSide":"left","charaName":"小幽灵","text":"[show][cm]原来如此……给大家添麻烦了，真的非常抱歉！我……我当时觉得脑子里很乱，只知道到处走，真不知道会给你们带来麻烦！[l][cm]"},"key":"text"},{"para":{"tag":"tag_23"},"key":"tag"},{"para":{"nameSide":"left","charaName":"巨木侍女阿碧约格","text":"[show]没事……如果你当时神志不清醒的话，那噪声也不能算是你的错。[l][cm]"},"key":"text"},{"para":{"tag":"tag_24"},"key":"tag"},{"para":{"nameSide":"left","charaName":"巨木侍女阿碧约格","text":"[show]不过我们想知道……你是怎么成为怨灵的？为什么会来到这里？[l][cm]"},"key":"text"},{"para":{"tag":"tag_25"},"key":"tag"},{"para":{"nameSide":"left","charaName":"小幽灵","text":"[show]我……我也不是很清楚……我和爸爸妈妈一起来这附近，参加一场盛大的宴会……但正当宴会进行到高潮的时候，突然有一大群魔物冲了进来！然后的事情我就不太清楚了……[l]"},"key":"text"},{"para":{"tag":"tag_26"},"key":"tag"},{"para":{"options":[{"text":"是灾变之宴。","tag":"tag_27"}]},"key":"option"},{"para":{"tag":"tag_27"},"key":"tag"},{"para":{"nameSide":"left","charaName":"小幽灵","text":"[show][cm]那天我只记得，妈妈告诉我要跑，一直跑一直跑不要停下来，直到安全为止。所以我就一直跑了很久，但我不知道什么是安全，只知道爸爸妈妈不见了，所以我一直在找他们……[l][cm]"},"key":"text"},{"para":{"tag":"tag_28"},"key":"tag"},{"para":{"nameSide":"left","charaName":"巨木侍女阿碧约格","text":"[show]原来如此……是迷失的灵魂啊。[l][cm]"},"key":"text"},{"para":{"tag":"tag_29"},"key":"tag"},{"para":{"nameSide":"left","charaName":"巨木侍女阿碧约格","text":"[show]很遗憾地告诉你……你的爸爸妈妈……恐怕和你一样，已经不在这世界上了。[l][cm]"},"key":"text"},{"para":{"tag":"tag_30"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2e","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2e","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]……[l][cm]"},"key":"text"},{"para":{"tag":"tag_31"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2e","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"小幽灵","text":"[show]……其实我早就有心理准备了，只是一直……一直没办法接受而已。[l][cm]"},"key":"text"},{"para":{"tag":"tag_32"},"key":"tag"},{"para":{"nameSide":"left","charaName":"小幽灵","text":"[show]谢谢你们告诉了我真相，也谢谢你们给我做了我生前最喜欢的食物。我想……我也是时候该离开了……[l][cm]"},"key":"text"},{"para":{"tag":"tag_33"},"key":"tag"},{"para":{"nameSide":"left","charaName":"巨木侍女阿碧约格","text":"[show]不用谢啦，引导迷失的灵魂。也是我们巨木侍女的责任。[l][cm]"},"key":"text"},{"para":{"tag":"tag_34"},"key":"tag"},{"para":{"nameSide":"left","charaName":"小幽灵","text":"[show]嗯……那么……我该离开了……[l][cm]"},"key":"text"},{"para":{"tag":"tag_35"},"key":"tag"},{"para":{"nameSide":"left","charaName":"","text":"[show]（怨灵在微笑中逐渐消散。）[l][cm]"},"key":"text"},{"para":{"tag":"tag_36"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2d","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2d","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":1,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]……他走了吗？[l]"},"key":"text"},{"para":{"tag":"tag_37"},"key":"tag"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2d","layer":"chara2","x":340,"transTime":300,"y":-180,"scaleX":1,"trans":true,"bright":0.6,"noOut":false,"img":"chara002_2","scaleY":1},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"options":[{"text":"应该已经离开了。","tag":"tag_38"}]},"key":"option"},{"para":{"tag":"tag_38"},"key":"tag"},{"para":{"nameSide":"left","charaName":"巨木侍女阿碧约格","text":"[show][cm]虽然吵闹声从此没有了，但自后少了些声音，还真有些寂寞呢……不过罢了，这也不是第一次了。[l][cm]"},"key":"text"},{"para":{"tag":"tag_39"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2k","layer":"chara2"},"key":"setLayerFace"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"addImg":"chara002_2_face_chara002_2k","layer":"chara2","x":340,"transTime":300,"y":-180,"