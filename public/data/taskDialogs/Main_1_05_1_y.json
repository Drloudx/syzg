{"script":"Main_1_05_1_y","des":"被魔物占据的矿坑_有材料","exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"tag":"tag_12"},"key":"tag"},{"para":{"charaName":"武具匠瑟尔妲","text":"[show]你们真的解决了蛇腹矿坑的魔物！我已经听回来的矿工们说了你们的壮举！[l][cm]","nameSide":"right"},"key":"text"},{"para":{"tag":"tag_13"},"key":"tag"},{"para":{"charaName":"武具匠瑟尔妲","text":"[show]不愧是我所看好的人物！看来你们很快就会成为驿站契约者中冉冉上升的新星了。[l][cm]","nameSide":"right"},"key":"text"},{"para":{"tag":"tag_14"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"alpha":0,"bright":1,"scaleY":0.9,"layer":"chara1","noOut":false,"noIn":false,"x":50,"y":-264.80000000000007,"scaleX":0.9,"mirrow":false,"trans":true,"img":"chara002_2"},"key":"setLayer"},{"para":{"alpha":1,"bright":1,"scaleY":0.9,"layer":"chara1","noOut":false,"noIn":false,"x":50,"y":-264.80000000000007,"transTime":300,"scaleX":0.9,"mirrow":false,"trans":true,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"米托拉","text":"[show]哈哈，也没有那么厉害啦！[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_15"},"key":"tag"},{"para":{"alpha":0,"bright":1,"scaleY":0.9,"layer":"chara1","noOut":false,"noIn":false,"x":50,"y":-264.80000000000007,"transTime":300,"scaleX":0.9,"mirrow":false,"trans":true,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"alpha":0,"bright":1,"scaleY":1,"layer":"chara1","noOut":false,"noIn":false,"x":67,"y":-215,"scaleX":1,"mirrow":false,"trans":true,"img":"chara001_0"},"key":"setLayer"},{"para":{"alpha":1,"bright":1,"scaleY":1,"layer":"chara1","noOut":false,"noIn":false,"x":67,"y":-215,"transTime":300,"scaleX":1,"mirrow":false,"trans":true,"img":"chara001_0"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"charaName":"希尔","text":"[show]谢谢您的夸奖，不过比起庆祝，更重要的是，赶紧派人把矿洞深处的洞口给堵上。[l][cm]","nameSide":"left"},"key":"text"},{"para":{"tag":"tag_16"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"alpha":1,"bright":0.6,"scaleY