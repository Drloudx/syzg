{"des":"demo1004_1","exps":[{"key":"tag","para":{"tag":"tag_79"}},{"key":"setLayer","para":{"scaleX":1.36,"scaleY":1.36,"layer":"bg","mirrow":false,"trans":false,"x":-25,"noOut":false,"y":-7.6400000000001,"noIn":false,"bright":1,"img":"bgNew","alpha":0}},{"key":"moveLayer","para":{"scaleX":1.36,"scaleY":1.36,"nonStandBright":false,"layer":"bg","mirrow":false,"trans":false,"x":-25,"noOut":false,"y":-7.6400000000001,"timeBak":300,"noIn":false,"transTime":0,"bright":1,"img":"bgNew","alpha":0}},{"key":"text","para":{"charaName":"【草药师林扎德】","text":"[show]我是驿站的草药师，琳扎德。情况就和你们手里的契约书里写的一样。[r]我不太擅长战斗，荒野也变得有些危险，没法亲自去看。[l][hide]","nameSide":"right"}},{"key":"tag","para":{"tag":"tag_129"}},{"key":"text","para":{"charaName":"【草药师林扎德】","text":"[cm][show]我需要 5 棵随处可见的蓝色药草。[r]如果你们驱赶了妖精花园里的魔物，麻烦带上一些幻相花。[l][hide]","nameSide":"right"}},{"key":"tag","para":{"tag":"tag_130"}},{"key":"top","para":{"layer":"chara3"}},{"key":"setLayer","para":{"scaleX":1,"scaleY":1,"layer":"chara3","mirrow":false,"trans":true,"x":641,"noOut":false,"y":-422,"noIn":false,"bright":1,"img":"chara012_0","alpha":0}},{"key":"moveLayer","para":{"scaleX":1,"scaleY":1,"layer":"chara3","mirrow":false,"trans":true,"x":641,"noOut":false,"y":-422,"noIn":false,"transTime":300,"bright":1,"img":"chara012_0","alpha":1}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"charaName":"【沃夫加】","text":"[cm][show]黑森林里的草木我还很熟悉，荒野就不一定了。[r]你这边有可供比对的样本吗？[l][hide]","nameSide":"right"}},{"key":"tag","para":{"tag":"tag_132"}},{"key":"top","para":{"layer":"chara1"}},{"key":"setLayer","para":{"scaleX":1,"scaleY":1,"layer":"chara1","mirrow":false,"trans":true,"x":121,"noOut":false,"y":-289,"noIn":false,"bright":1,"img":"chara002_0","alpha":0}},{"key":"moveLayer","para":{"scaleX":1,"scaleY":1,"layer":"chara1","mirrow":false,"trans":true,"x":121,"noOut":false,"y":-289,"noIn":false,"transTime":300,"bright":1,"img":"chara002_0","alpha":1}},{"key":"moveLayer","para":{"scaleX":1,"scaleY":1,"layer":"chara3","mirrow":false,"trans":true,"x":641,"noOut":false,"y":-422,"noIn":false,"transTime":300,"bright":0.6,"img":"chara012_0","alpha":1}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"charaName":"【米托拉】","text":"[cm][show]（……把我的话抢了。[r]想不到这个狼人属心还挺细。）[l][hide]","nameSide":"left"}},{"key":"tag","para":{"tag":"tag_134"}},{"key":"moveLayer","para":{"scaleX":1,"scaleY":1,"layer":"chara1","mirrow":false,"trans":true,"x":121,"noOut":false,"y":-289,"noIn":false,"transTime":300,"bright":0.6,"img":"chara002_0","alpha":1}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"charaName":"【草药师林扎德】","text":"[cm][show]我要是有就不需要你们了。你们中应该有认识这种草药的角色，不会给我带错的。[l][hide]","nameSide":"right"}},{"key":"tag","para":{"tag":"tag_135"}},{"key":"moveLayer","para":{"scaleX":1,"scaleY":1,"layer":"chara3","mirrow":false,"trans":true,"x":641,"noOut":false,"y":-422,"noIn":false,"transTime":300,"bright":0.6,"img":"chara012_0","alpha":0}},{"key":"wait","para":{"time":300}},{"key":"top","para":{"layer":"chara3"}},{"key":"setLayer","para":{"scaleX":1,"scaleY":1,"layer":"chara3","mirrow":false,"trans":true,"x":369,"noOut":false,"y":-489,"noIn":false,"bright":1,"img":"chara015_0","alpha":0}},{"key":"moveLayer","para":{"scaleX":1,"scaleY":1,"layer":"chara3","mirrow":false,"trans":true,"x":369,"noOut":false,"y":-489,"noIn":false,"transTime":300,"bright":1,"img":"chara015_0","alpha":1}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"charaName":"【芭杜尔】","text":"[cm][show]唉……？是、是在说我吗……[l][hide]","nameSide":"right"}},{"key":"tag","para":{"tag":"tag_136"}},{"key":"moveLayer","para":{"scaleX":1,"scaleY":1,"layer":"chara3","mirrow":false,"trans":true,"x":369,"noOut":false,"y":-489,"noIn":false,"transTime":300,"bright":0.6,"img":"chara015_0","alpha":1}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"charaName":"【草药师林扎德】","text":"[cm][show]你身上有黑森林里覆盆子的香气，还有点蜂毒草的味道。[r]好了快去吧，我快揭不开药锅了。[l]","nameSide":"right"}},{"key":"option","para":{"options":[{"text":"我们仰仗你了，芭杜尔小姐。","tag":"tag_137"}]}},{"key":"tag","para":{"tag":"tag_137"}},{"key":"moveLayer","para":{"scaleX":1,"scaleY":1,"layer":"chara3","mirrow":false,"trans":true,"x":369,"noOut":false,"y":-489,"noIn":false,"transTime":300,"bright":1,"img":"chara015_0","alpha":1}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"charaName":"【芭杜尔】","text":"[cm][show]啊、是……是的……[r]我会尽我所能……但请不要再和我搭话了……[l][hide]","nameSide":"right"}},{"key":"tag","para":{"tag":"tag_138"}},{"key":"text","para":{"charaName":"【芭杜尔】","text":"[cm][show]（……这么怕人的话就别出来了啦！）[l][hide]","nameSide":"right"}},{"key":"end","para":{"end":true}}],"script":"demo1004_1"}