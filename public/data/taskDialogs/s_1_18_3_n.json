{"script":"s_1_18_3_n","des":"（将粗布交给尼尔。）","exps":[{"para":{"tag":"tag_1"},"key":"tag"},{"para":{"layer":"chara2"},"key":"top"},{"para":{"nameSide":"left","charaName":"卫兵尼尔","text":"[show]嗯？还没好吗？我需要一些粗布哦。[l][cm]"},"key":"text"},{"para":{"tag":"tag_3"},"key":"tag"},{"para":{"nameSide":"left","charaName":"卫兵尼尔","text":"[show]请尽快吧，考虑到我糟糕的手艺，我必须留足时间，才能赶在维斯生日之前把娃娃做出来。[l][cm][hide]"},"key":"text"},{"para":{"tag":"tag_2"},"key":"tag"},{"para":{"nameSide":"left","charaName":"","text":"[hide]"},"key":"text"},{"para":{"end":true},"key":"end"}]}