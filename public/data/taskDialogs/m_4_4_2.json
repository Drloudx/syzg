ide":"left","charaName":"布拉格乌尔","text":"[cm][show]有点什么？颓废？阴暗？[l][cm]"},"key":"text"},{"para":{"tag":"tag_17"},"key":"tag"},{"para":{"nameSide":"left","charaName":"布拉格乌尔","text":"[show]对于一个毕生心血都被大兽潮毁掉的老头子来说，就算是颓废、阴暗一点，又能怎样呢？[l][cm]"},"key":"text"},{"para":{"tag":"tag_18"},"key":"tag"},{"para":{"nameSide":"left","charaName":"布拉格乌尔","text":"[show]那可恶的灾变，毁掉的可不止是我的家，还有我的宴会啊。呵……虽然那也是我不信人言，自作自受吧……[l][cm]"},"key":"text"},{"para":{"tag":"tag_19"},"key":"tag"},{"para":{"layer":"chara1"},"key":"top"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"scaleX":1.5,"addImg":"","layer":"bg","noOut":false,"x":-500,"scaleY":1.5,"trans":true,"bright":1,"y":-125,"img":"bgblack"},"key":"setLayer"},{"para":{"noIn":false,"mirrow":false,"alpha":0.4,"scaleX":1.5,"addImg":"","layer":"bg","noOut":false,"x":-500,"transTime":300,"scaleY":1.5,"trans":true,"bright":1,"y":-125,"img":"bgblack"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"noIn":false,"mirrow":false,"alpha":0,"scaleX":1,"addImg":"chara002_2_face_chara002_2h","layer":"chara1","noOut":false,"x":50,"scaleY":1,"trans":true,"bright":1,"y":-180,"img":"chara002_2"},"key":"setLayer"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2h","layer":"chara1","noOut":false,"x":50,"transTime":300,"scaleY":1,"trans":true,"bright":1,"y":-180,"img":"chara002_2"},"key":"moveLayer"},{"para":{"time":300},"key":"wait"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]哇……这老头到底是怎么了，感觉怨气好重啊！[l][cm]"},"key":"text"},{"para":{"tag":"tag_20"},"key":"tag"},{"para":{"img":"chara002_2_face_chara002_2k","layer":"chara1"},"key":"setLayerFace"},{"para":{"nameSide":"left","charaName":"米托拉","text":"[show]艾薇杜尔，你知道这是怎么回事吗？[l][cm]"},"key":"text"},{"para":{"tag":"tag_21"},"key":"tag"},{"para":{"layer":"chara3"},"key":"top"},{"para":{"noIn":false,"mirrow":false,"alpha":1,"scaleX":1,"addImg":"chara002_2_face_chara002_2k","layer":"chara1","noOut":false,"x":50,"transTime":300,"scaleY":1,"trans":true,"bright"