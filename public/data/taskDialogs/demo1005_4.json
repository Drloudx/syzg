tag_166","text":"可能只是某种魔法。"},{"tag":"tag_166","text":"可能只是某种匠技。"}]}},{"key":"tag","para":{"tag":"tag_166"}},{"key":"top","para":{"layer":"chara1"}},{"key":"moveLayer","para":{"scaleX":1,"scaleY":1,"layer":"chara3","mirrow":false,"trans":true,"x":641,"noOut":false,"y":-422,"noIn":false,"transTime":300,"bright":0.6,"img":"chara012_0","alpha":1}},{"key":"moveLayer","para":{"scaleX":1,"scaleY":1,"layer":"chara1","mirrow":false,"trans":true,"x":121,"noOut":false,"y":-289,"noIn":false,"transTime":300,"bright":1,"img":"chara002_0","alpha":1}},{"key":"wait","para":{"time":300}},{"key":"text","para":{"charaName":"【米托拉】","text":"[cm][show]……最好是这样啦。先回那个毛耳朵那边领赏吧。[r]这些虚无缥缈的东西之后再说。[l][hide][cm]","nameSide":"left"}},{"key":"end","para":{"end":true}}],"script":"demo1005_4"}